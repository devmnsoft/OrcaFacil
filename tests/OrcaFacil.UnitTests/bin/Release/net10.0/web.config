<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers><add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" /></handlers>
      <aspNetCore processPath="dotnet" arguments=".\OrcaFacil.Web.dll" stdoutLogEnabled="false" stdoutLogFile="C:\ProgramData\OrcaFacil\logs\stdout" hostingModel="inprocess">
        <environmentVariables><environmentVariable name="ASPNETCORE_ENVIRONMENT" value="Production" /></environmentVariables>
      </aspNetCore>
      <security><requestFiltering removeServerHeader="true" /></security>
    </system.webServer>
  </location>
</configuration>
