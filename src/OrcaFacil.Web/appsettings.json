{
  "Database": {
    "AllowLegacyPostgresDatabase": true
  },
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "DataProtection": { "ApplicationName": "OrcaFacil", "KeysPath": ".keys" },
  "Application": { "PublicBaseUrl": "http://localhost:5080" },
  "Uploads": { "Path": "data/uploads", "MaximumFileSizeMb": 10 },
  "SystemHealth": { "LogsPath": "logs", "BackupsPath": "backups" },
  "RateLimit": { "PublicRequestsPerMinute": 20 },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Information",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
        "Microsoft.EntityFrameworkCore.Query": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": { "path": "logs/orcafacil-.log", "rollingInterval": "Day", "retainedFileCountLimit": 30 }
      }
    ]
  },
  "Telegram": {
    "Enabled": false
  },
  "EmailOutbox": {
    "ActivePollingSeconds": 2,
    "IdlePollingSeconds": 20,
    "MaximumIdlePollingSeconds": 30,
    "StuckRecoveryIntervalMinutes": 10,
    "BatchSize": 5,
    "MaximumAttempts": 5
  },
  "Email": { "Required": false, "Host": "", "Port": 587, "SocketOptions": "StartTls", "UserName": "", "Password": "" },
  "Security": {
    "CookieSecureInProduction": true,
    "RateLimitPerMinute": 60
  },
  "Plans": {
    "TrialProDays": 7
  },
  "Pdf": {
    "FreeWatermark": "Gerado no plano Free do OrçaFácil"
  },
  "App": {
    "Name": "OrçaFácil",
    "Company": "MNSOFT",
    "Cnpj": "18.160.057/0001-13"
  },
  "AdminSeed": {
    "EmailEnv": "ORCAFACIL_SUPERADMIN_EMAIL",
    "PasswordEnv": "ORCAFACIL_SUPERADMIN_PASSWORD"
  },
  "Legal": {
    "PrivacyContactEmail": "privacidade@mnsoft.com.br"
  }
}
