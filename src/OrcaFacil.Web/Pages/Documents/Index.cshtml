@page
@model OrcaFacil.Web.Pages.Documents.IndexModel
@{ViewData["Title"]="Histórico";}
<header class="of-page-header"><div><p class="of-eyebrow">Documentos</p><h1>Histórico</h1><p>Aqui ficam todos os seus documentos. Você pode editar, duplicar ou gerar PDF novamente.</p></div><div class="d-flex gap-2"><a class="btn btn-primary" asp-page="/Documents/CreateBudget">Novo orçamento</a><a class="btn btn-success" asp-page="/Documents/CreateReceipt">Novo recibo</a></div></header><section class="of-card mb-4"><div class="row g-2"><div class="col-md-4"><label class="form-label" for="filterClient">Buscar cliente</label><input id="filterClient" class="form-control" placeholder="Digite o nome do cliente"/></div><div class="col-md"><label class="form-label" for="filterType">Tipo</label><select id="filterType" class="form-select"><option>Todos</option><option>Orçamentos</option><option>Recibos</option></select></div><div class="col-md"><label class="form-label" for="filterStatus">Status</label><select id="filterStatus" class="form-select"><option>Todos</option><option>Rascunho</option><option>Emitido</option><option>Aprovado</option><option>Recusado</option><option>Cancelado</option></select></div><div class="col-md"><label class="form-label" for="filterPeriod">Período</label><select id="filterPeriod" class="form-select"><option>Todos</option><option>Este mês</option><option>Últimos 90 dias</option></select></div></div></section>@if(Model.Documents.Count==0){<partial name="Partials/_EmptyState" model='new { Title="Nenhum documento ainda.", Text="Crie seu primeiro orçamento e deixe seu atendimento mais profissional.", ActionText="Criar primeiro orçamento", ActionPage="/Documents/CreateBudget", Icon="bi-folder2-open" }' />}else{<partial name="_DocumentTable" model="Model.Documents" />}
