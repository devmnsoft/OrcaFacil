@page
@model OrcaFacil.Web.Pages.Documents.IndexModel
@{ViewData["Title"]="Histórico";}
<header class="of-page-header"><div><p class="of-eyebrow">Documentos</p><h1>Histórico</h1><p>Aqui ficam todos os seus documentos. Você pode editar, duplicar ou gerar PDF novamente.</p></div><div class="of-form-actions"><a class="of-button of-button--primary" asp-page="/Documents/CreateBudget">Novo orçamento</a><a class="of-button of-button--primary" asp-page="/Documents/CreateReceipt">Novo recibo</a></div></header><section class="of-panel"><div class="of-form-grid"><div class="of-field"><label class="of-field-label" for="filterClient">Buscar cliente</label><input id="filterClient" class="of-field-control" placeholder="Digite o nome do cliente"/></div><div class="of-field"><label class="of-field-label" for="filterType">Tipo</label><select id="filterType" class="of-field-control"><option>Todos</option><option>Orçamentos</option><option>Recibos</option></select></div><div class="of-field"><label class="of-field-label" for="filterStatus">Status</label><select id="filterStatus" class="of-field-control"><option>Todos</option><option>Rascunho</option><option>Emitido</option><option>Aprovado</option><option>Recusado</option><option>Cancelado</option></select></div><div class="of-field"><label class="of-field-label" for="filterPeriod">Período</label><select id="filterPeriod" class="of-field-control"><option>Todos</option><option>Este mês</option><option>Últimos 90 dias</option></select></div></div></section>@if(Model.Documents.Count==0){<partial name="Partials/_EmptyState" model='new EmptyStateViewModel { Title="Nenhum documento ainda.", Text="Crie seu primeiro orçamento e deixe seu atendimento mais profissional.", ActionText="Criar primeiro orçamento", ActionPage="/Documents/CreateBudget", Icon="quote" }' />}else{<partial name="_DocumentTable" model="Model.Documents" />}
