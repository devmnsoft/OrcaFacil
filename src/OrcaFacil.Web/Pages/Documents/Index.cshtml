@page
@model OrcaFacil.Web.Pages.Documents.IndexModel
@{ViewData["Title"]="Orçamentos"; ViewData["Section"]="Comercial";}
<partial name="Partials/_PageIntro" model='new PageIntroViewModel("Propostas comerciais", "Orçamentos", "Crie, envie e acompanhe propostas profissionais sem perder o próximo passo.", "quote", "Novo orçamento", "/Documents/CreateBudget", HelpCode: "quotes", WhatThisPageDoes: "Organiza propostas por cliente, validade e situação comercial.", NextStepText: "Crie uma proposta ou retome uma negociação pendente.")' />
<partial name="Partials/_ContextGuide" model='new ContextGuideViewModel("Conduza cada proposta até uma decisão", "Preparar e acompanhar valores e condições enviados ao cliente.", "Itens, versões, validade, compartilhamentos e atividades.", "Uma proposta aprovada pode originar uma ordem de serviço.", "Recibos e pagamentos ficam na Central Financeira.")' />
<section class="of-panel"><h2>Encontre uma proposta</h2><div class="of-form-grid"><div class="of-field"><label for="filterClient">Cliente ou proposta</label><input id="filterClient" class="of-field-control" type="search" placeholder="Nome do cliente ou número"/></div><div class="of-field"><label for="filterStatus">Situação</label><select id="filterStatus" class="of-field-control"><option>Todos</option><option>Rascunho</option><option>Enviado</option><option>Em negociação</option><option>Aprovado</option><option>Encerrado</option></select></div><div class="of-field"><label for="filterPeriod">Período</label><select id="filterPeriod" class="of-field-control"><option>Todos</option><option>Este mês</option><option>Últimos 90 dias</option></select></div></div></section>
@if(Model.Documents.Count==0){<partial name="Partials/_EmptyState" model='new EmptyStateViewModel { Title="Você ainda não criou propostas", Text="Comece com um orçamento simples e envie para seu cliente em PDF.", ActionText="Criar primeiro orçamento", ActionPage="/Documents/CreateBudget", Icon="quote", HelpText="Os dados ficam salvos para você revisar antes do envio." }' />}else{<partial name="_DocumentTable" model="Model.Documents" />}
