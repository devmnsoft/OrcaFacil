@model OrcaFacil.Web.Pages.Documents.IndexModel
@{ViewData["Title"]="Histórico";}<header class="of-page-header"><div><p class="of-eyebrow">Documentos</p><h1>Histórico</h1><p>Encontre, filtre e acesse seus orçamentos e recibos com rapidez.</p></div><div class="d-flex gap-2"><a class="btn btn-primary" asp-page="/Documents/CreateBudget">Novo orçamento</a><a class="btn btn-success" asp-page="/Documents/CreateReceipt">Novo recibo</a></div></header><section class="of-card mb-4"><div class="row g-2"><div class="col-md-5"><label class="form-label">Buscar por cliente</label><input class="form-control" placeholder="Digite o nome do cliente"/></div><div class="col-md"><label class="form-label">Tipo</label><select class="form-select"><option>Todos</option><option>Orçamentos</option><option>Recibos</option></select></div><div class="col-md"><label class="form-label">Status</label><select class="form-select"><option>Todos</option><option>Rascunho</option><option>Emitido</option><option>Aprovado</option><option>Recusado</option><option>Cancelado</option></select></div></div></section>@if(Model.Documents.Count==0){<partial name="_EmptyState" model='"Você ainda não criou documentos."' />}else{<partial name="_DocumentTable" model="Model.Documents" />}
