@page
@model OrcaFacil.Web.Pages.Documents.CreateBudgetModel
@section Styles { <link rel="stylesheet" href="~/css/documents.css" asp-append-version="true" /> }
@{
    ViewData["Title"] = "Novo orçamento";
    ViewData["Section"] = "Comercial";
    ViewData["HelpCode"] = "budget-create";
}

<header class="of-page-header of-budget-heading">
    <div>
        <div class="of-header-badges">
            <span class="of-eyebrow">Orçamento guiado</span>
            @if (Model.Draft is not null)
            {
                <span class="of-badge of-badge-document" title="Número sequencial desta proposta">Doc #@(Model.Draft.Number ?? "Rascunho")</span>
                @if (Model.Draft.LastAutosavedAt.HasValue)
                {
                    <span class="of-badge of-badge-time" title="Horário da última alteração">Salvo em @Model.Draft.LastAutosavedAt.Value.ToString("HH:mm")</span>
                }
            }
        </div>
        <h1>Transforme o pedido em uma proposta clara</h1>
        <p>Avance no seu ritmo. Nada será enviado ao cliente ao finalizar. <a asp-page="/Documents/New">Ver outros rascunhos</a> · <a asp-page="/Documents/BudgetAssistant">Pedir sugestões revisáveis</a></p>
        <details><summary>Como usar</summary><p>Descreva o serviço, revise a sugestão e só então aplique os itens do seu catálogo. Salvar de novo com a mesma tentativa não duplica o rascunho. Se o preço do catálogo mudou, o orçamento mantém o preço já contratado até você confirmar.</p></details>
    </div>
    <div class="of-save-state" data-save-state role="status" aria-live="polite">
        <span aria-hidden="true"></span><strong>Alterações pendentes</strong>
    </div>
</header>

@if (!string.IsNullOrWhiteSpace(Model.OpenError))
{
    <p class="of-form-error" role="alert">@Model.OpenError</p>
}
else
{
<form method="post" class="of-budget-wizard" data-budget-wizard data-document-id="@Model.Draft.DocumentId" data-row-version="@Model.Draft.RowVersion" data-current-step="@Model.Draft.CurrentStep" novalidate>
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" class="of-form-error" role="alert"></div>

    <nav class="of-wizard-steps" aria-label="Etapas do orçamento">
        @foreach (var step in new[] { ("Cliente", "Para quem"), ("Serviços", "O que será feito"), ("Condições", "Prazos e pagamento"), ("Apresentação", "Aparência"), ("Revisão", "Conferência") }.Select((value, index) => (value, index)))
        {
            <button type="button" data-step-target="@step.index" class="@(step.index == 0 ? "is-active" : null)" aria-current="@(step.index == 0 ? "step" : null)">
                <span>@(step.index + 1)</span><span><strong>@step.value.Item1</strong><small>@step.value.Item2</small></span>
            </button>
        }
    </nav>

    <div class="of-wizard-layout">
        <div class="of-wizard-main">
            <section class="of-wizard-panel is-active" data-step="0" aria-labelledby="wizard-client-title">
                <div class="of-wizard-intro"><span class="of-wizard-number">01</span><div><p class="of-eyebrow">Cliente</p><h2 id="wizard-client-title">Quem receberá esta proposta?</h2><p>Localize um cadastro ou informe o nome. Os dados atuais serão copiados para esta versão do orçamento.</p></div></div>
                <label class="of-field"><span>Buscar cliente cadastrado</span><input type="search" data-client-search autocomplete="off" /><small>A seleção vincula o cadastro e congela os dados atuais nesta proposta.</small></label>
                <div class="of-client-choices" data-client-choices>@foreach (var client in Model.Clients) { <button type="button" data-client-option data-client-id="@client.Id" data-client-name="@client.Name" data-search="@($"{client.Name} {client.Document} {client.City}".ToLowerInvariant())" class="@(client.Id == Model.Draft.ClientId ? "is-selected" : null)"><span><strong>@client.Name</strong><small>@(client.City ?? "Cidade não informada") · @(client.Phone ?? client.Email ?? "Contato não informado")</small></span><span>Selecionar</span></button> }</div>
                <input type="hidden" data-client-id value="@Model.Draft.ClientId" /><input type="hidden" data-client-name value="@Model.Draft.ClientName" />
                <div class="of-inline-callout"><partial name="Partials/_Icon" model='new IconViewModel("client", "sm", Decorative: true)' /><div><strong>Cliente novo?</strong><span>Abra o cadastro completo sem perder este fluxo.</span></div><a asp-page="/Clients/Create" asp-route-returnUrl="/Documents/CreateBudget">Cadastrar cliente</a></div>
            </section>

            <section class="of-wizard-panel" data-step="1" aria-labelledby="wizard-items-title" hidden>
                <div class="of-wizard-intro"><span class="of-wizard-number">02</span><div><p class="of-eyebrow">Serviços</p><h2 id="wizard-items-title">O que você vai entregar?</h2><p>Descreva cada resultado, ajuste quantidade, preço e desconto. O total é atualizado na hora.</p></div></div>
                <div class="of-service-catalog-search">
                    <label class="of-field"><span>Buscar no catálogo</span><input type="search" data-service-search autocomplete="off" /></label>
                    <div data-service-results aria-live="polite"></div>
                </div>
                <div class="of-service-examples" aria-label="Exemplos de serviços">
                    @foreach (var example in new[] { "Consultoria por hora", "Instalação elétrica", "Manutenção preventiva", "Limpeza pós-obra" }) { <button type="button" data-service-example="@example">+ @example</button> }
                </div>
                <div class="of-budget-items" data-budget-items>
                    @for (var i = 0; i < (Model.Draft.Items.Count == 0 ? 1 : Model.Draft.Items.Count); i++)
                    {
                        <article class="of-budget-item" data-budget-item>
                            <span class="of-drag-handle" title="Reordenar" aria-hidden="true">⋮⋮</span>
                            <label class="of-field of-item-description"><span>Serviço ou produto</span><input name="Input.Items[@i].Description" value="@(Model.Draft.Items.Count > i ? Model.Draft.Items[i].Description : "")" data-item-description /></label>
                            <label class="of-field"><span>Quantidade</span><input name="Input.Items[@i].Quantity" value="@(Model.Draft.Items.Count > i ? Model.Draft.Items[i].Quantity : 1)" type="number" min="0.01" step="0.01" inputmode="decimal" data-item-quantity /></label>
                            <label class="of-field"><span>Unidade</span><select data-item-unit data-initial-unit="@(Model.Draft.Items.Count > i ? Model.Draft.Items[i].Unit : "serviço")"><option>serviço</option><option>hora</option><option>dia</option><option>unidade</option><option>m²</option></select></label>
                            <label class="of-field"><span>Preço unitário</span><input name="Input.Items[@i].UnitPrice" value="@(Model.Draft.Items.Count > i ? Model.Draft.Items[i].UnitPrice : 0)" type="number" min="0" step="0.01" inputmode="decimal" data-item-price /></label>
                            <label class="of-field"><span>Desconto</span><input name="Input.Items[@i].Discount" value="@(Model.Draft.Items.Count > i ? Model.Draft.Items[i].Discount : 0)" type="number" min="0" step="0.01" inputmode="decimal" data-item-discount /></label>
                            <div class="of-item-result"><small>Total do item</small><strong data-item-total>R$ 0,00</strong><button type="button" data-item-duplicate>Duplicar</button><button type="button" data-item-remove>Remover</button></div>
                        </article>
                    }
                </div>
                <button class="of-button-secondary" type="button" data-item-add>Adicionar item manual</button>
            </section>

            <section class="of-wizard-panel" data-step="2" aria-labelledby="wizard-conditions-title" hidden>
                <div class="of-wizard-intro"><span class="of-wizard-number">03</span><div><p class="of-eyebrow">Condições</p><h2 id="wizard-conditions-title">Combine os detalhes antes de começar</h2><p>Informações objetivas evitam dúvidas e protegem a relação comercial.</p></div></div>
                <div class="of-condition-groups">
                    <fieldset><legend>Prazo</legend><label class="of-field"><span>Validade da proposta</span><input type="date" data-field="validUntil" value="@Model.Draft.ValidUntil?.ToString("yyyy-MM-dd")" required /></label><label class="of-field"><span>Início previsto</span><input type="date" data-field="expectedStartAt" value="@Model.Draft.ExpectedStartAt?.ToString("yyyy-MM-dd")" /></label><label class="of-field"><span>Duração estimada</span><input data-field="estimatedDuration" value="@Model.Draft.EstimatedDuration" /></label></fieldset>
                    <fieldset><legend>Pagamento</legend><label class="of-field"><span>Método preferencial</span><select data-field="paymentMethod" data-initial-value="@Model.Draft.PaymentMethod"><option>Pix</option><option>Transferência</option><option>Dinheiro</option><option>Cartão</option></select></label><label class="of-field"><span>Parcelas</span><input type="number" min="1" max="24" data-field="installmentCount" value="@(Model.Draft.InstallmentCount ?? 1)" /></label><label class="of-field"><span>Sinal</span><input type="number" min="0" step="0.01" data-field="depositAmount" value="@Model.Draft.DepositAmount" /></label><label class="of-field"><span>Chave ou instrução Pix</span><input data-field="pixInformation" value="@Model.Draft.PixInformation" /></label></fieldset>
                </div>
                <details class="of-progressive-fields"><summary>Adicionar garantia, escopo e condições</summary>
                    <label class="of-field"><span>Garantia</span><textarea data-field="warrantyText" rows="3">@Model.Draft.WarrantyText</textarea></label>
                    <label class="of-field"><span>Condições adicionais</span><textarea data-field="conditionsText" rows="5">@Model.Draft.ConditionsText</textarea></label>
                    <label class="of-field"><span>Observações / Escopo</span><textarea data-field="notes" rows="4"></textarea></label>
                    <div style="margin-top:1rem; padding:1rem; background:var(--of-surface-alt, #f8fafc); border-radius:var(--of-radius, 8px); border:1px solid var(--of-border, #e2e8f0);">
                        <div style="display:flex; justify-content:space-between; align-items:center;">
                            <strong>Assistente IA: Revisar escopo e dados faltantes</strong>
                            <button type="button" class="of-button-secondary" id="btn-ai-assist" style="font-size:0.85rem; padding:0.35rem 0.75rem;">Analisar com IA</button>
                        </div>
                        <p style="font-size:0.8rem; color:var(--of-muted); margin:0.25rem 0 0.5rem;">Organiza o escopo, sugere termos e aponta inconsistências sem alterar preços automaticamente.</p>
                        <div id="ai-assist-preview" style="display:none; margin-top:0.75rem; border-top:1px dashed var(--of-border, #cbd5e1); padding-top:0.75rem;">
                            <div id="ai-findings-container" style="margin-bottom:0.75rem;"></div>
                            <label class="of-field">
                                <span>Sugestão para o escopo (você pode editar aqui antes de aplicar):</span>
                                <textarea id="ai-improved-notes" rows="4" style="width:100%; font-size:0.85rem;"></textarea>
                            </label>
                            <div style="display:flex; gap:0.5rem; margin-top:0.5rem;">
                                <button type="button" class="of-button-primary" id="btn-ai-accept" style="font-size:0.85rem;">Aplicar no orçamento</button>
                                <button type="button" class="of-button-secondary" id="btn-ai-discard" style="font-size:0.85rem;">Descartar</button>
                            </div>
                        </div>
                    </div>
                </details>
            </section>

            <section class="of-wizard-panel" data-step="3" aria-labelledby="wizard-template-title" hidden>
                <div class="of-wizard-intro"><span class="of-wizard-number">04</span><div><p class="of-eyebrow">Apresentação</p><h2 id="wizard-template-title">Escolha como sua proposta será apresentada</h2><p>Compare o resultado visual antes de decidir. Recursos indisponíveis continuam demonstráveis.</p></div></div>
                <div class="of-template-gallery">
                    <label class="of-template-option @(Model.Draft.TemplateCode == "essential" ? "is-selected" : null)"><input type="radio" name="presentation" value="essential" checked="@(Model.Draft.TemplateCode == "essential")" /><span class="of-template-preview is-essential"><i></i><b></b><b></b><em></em></span><span><strong>Essencial</strong><small>Claro, direto e disponível no Grátis.</small></span><span class="of-availability">Disponível</span></label>
                    <label class="of-template-option @(Model.Draft.TemplateCode == "professional" ? "is-selected" : null)"><input type="radio" name="presentation" value="professional" checked="@(Model.Draft.TemplateCode == "professional")" /><span class="of-template-preview is-professional"><i>Logo</i><b></b><b></b><em></em></span><span><strong>Profissional</strong><small>Logo, suas cores e cabeçalho refinado.</small></span><span class="of-premium-tag">Profissional</span></label>
                    <label class="of-template-option @(Model.Draft.TemplateCode == "business" ? "is-selected" : null)"><input type="radio" name="presentation" value="business" checked="@(Model.Draft.TemplateCode == "business")" /><span class="of-template-preview is-business"><i>Logo</i><b></b><b></b><em>QR</em></span><span><strong>Negócio</strong><small>Assinatura e apresentação corporativa.</small></span><span class="of-premium-tag">Negócio</span></label>
                </div>
                <p class="of-honest-plan-note">Modelos acima do seu plano servem como demonstração. Você confirma qualquer mudança antes de contratar.</p>
            </section>

            <section class="of-wizard-panel" data-step="4" aria-labelledby="wizard-review-title" hidden>
                <div class="of-wizard-intro"><span class="of-wizard-number">05</span><div><p class="of-eyebrow">Revisão</p><h2 id="wizard-review-title">Tudo pronto para finalizar</h2><p>Confira a proposta. Finalizar cria o documento como Pronto, mas não envia nada automaticamente.</p></div></div>
                <div class="of-review-sheet">
                    <div><small>Cliente</small><strong data-review-client>Não informado</strong></div><div><small>Modelo</small><strong data-review-template>Essencial</strong></div><div><small>Itens</small><strong data-review-items>0 serviços</strong></div><div><small>Total</small><strong data-review-total>R$ 0,00</strong></div>
                </div>
                <div class="of-inline-callout is-success"><partial name="Partials/_Icon" model='new IconViewModel("success", "sm", Decorative: true, Tone: "success")' /><div><strong>Você mantém o controle</strong><span>Depois de finalizar, a próxima ação será compartilhar. Nenhum e-mail ou mensagem será disparado agora.</span></div></div>
            </section>

            <footer class="of-wizard-actions"><button class="of-button-secondary" type="button" data-step-previous hidden>Voltar</button><span></span><a asp-page="/Documents/Index">Cancelar</a><button class="of-button-primary" type="button" data-step-next>Continuar</button><button class="of-button-primary" type="button" data-finish hidden>Finalizar orçamento</button></footer>
        </div>

        <aside class="of-budget-summary" data-budget-summary>
            <button type="button" data-summary-toggle aria-expanded="true"><span><small>Resumo do orçamento</small><strong data-summary-total>R$ 0,00</strong></span><span aria-hidden="true">⌃</span></button>
            <div data-summary-content>
                <p data-summary-client>Nenhum cliente selecionado</p>
                <dl><div><dt>Subtotal</dt><dd data-summary-subtotal>R$ 0,00</dd></div><div><dt>Desconto geral</dt><dd><input value="@Model.Draft.Discount" type="number" min="0" step="0.01" inputmode="decimal" data-general-discount aria-label="Desconto geral" /></dd></div><div class="is-total"><dt>Total</dt><dd data-summary-total>R$ 0,00</dd></div></dl>
                <a class="of-preview-button" data-preview-link href="/Documents/Preview/@Model.Draft.DocumentId">Pré-visualizar proposta salva</a>
                <small>O rascunho é salvo com segurança nesta conta.</small>
            </div>
        </aside>
    </div>
</form>
}

@section Scripts {
    <script type="module" src="~/js/budget-wizard.js" asp-append-version="true"></script>
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const btnAi = document.getElementById('btn-ai-assist');
            if (btnAi) {
                btnAi.addEventListener('click', async () => {
                    btnAi.disabled = true;
                    btnAi.textContent = 'Analisando…';
                    try {
                        const docId = '@Model.Draft?.DocumentId';
                        const notesEl = document.querySelector('[data-field="notes"]');
                        const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
                        const res = await fetch('?handler=AssistScope', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': token },
                            body: JSON.stringify({ documentId: docId, notes: notesEl ? notesEl.value : '' })
                        });
                        const data = await res.json();
                        if (data.succeeded) {
                            const preview = document.getElementById('ai-assist-preview');
                            const findingsBox = document.getElementById('ai-findings-container');
                            const improvedBox = document.getElementById('ai-improved-notes');
                            if (findingsBox && data.findings && data.findings.length > 0) {
                                findingsBox.innerHTML = '<strong style="font-size:0.85rem; color:var(--of-warning, #d97706);">Pontos de atenção / dados faltantes:</strong><ul style="font-size:0.8rem; margin:0.25rem 0 0.5rem 1.25rem;">' + 
                                    data.findings.map(f => '<li><b>[' + f.category + ']</b> ' + f.message + (f.suggestion ? ' <i>(' + f.suggestion + ')</i>' : '') + '</li>').join('') + '</ul>';
                            } else if (findingsBox) {
                                findingsBox.innerHTML = '<span style="font-size:0.8rem; color:var(--of-success, #16a34a);">✓ Nenhum dado faltante crítico detectado.</span>';
                            }
                            if (improvedBox) improvedBox.value = data.improvedNotes || '';
                            if (preview) preview.style.display = 'block';
                        } else {
                            alert(data.error || 'Não foi possível analisar no momento.');
                        }
                    } catch (e) {
                        alert('Falha na comunicação com o assistente. Prossiga manualmente.');
                    } finally {
                        btnAi.disabled = false;
                        btnAi.textContent = 'Analisar com IA';
                    }
                });

                document.getElementById('btn-ai-accept')?.addEventListener('click', () => {
                    const improved = document.getElementById('ai-improved-notes')?.value;
                    const notesEl = document.querySelector('[data-field="notes"]');
                    if (notesEl && improved) {
                        notesEl.value = improved;
                        notesEl.dispatchEvent(new Event('input', { bubbles: true }));
                    }
                    const preview = document.getElementById('ai-assist-preview');
                    if (preview) preview.style.display = 'none';
                });

                document.getElementById('btn-ai-discard')?.addEventListener('click', () => {
                    const preview = document.getElementById('ai-assist-preview');
                    if (preview) preview.style.display = 'none';
                });
            }
        });
    </script>
}
