@page "{id:guid}"
@model OrcaFacil.Web.Pages.Documents.DetailsModel
@section Styles { <link rel="stylesheet" href="~/css/documents.css" asp-append-version="true" /> }
@{var d=Model.Document; ViewData["Title"]=$"Documento {d?.Number}";}
<header class="of-page-header"><div><p class="of-eyebrow">Detalhes</p><h1>@d?.Type @d?.Number</h1><p>Cliente, itens, totais, observações e ações do documento.</p></div><partial name="_StatusBadge" model="d?.Status" /></header>
<div class="row g-4"><div class="col-lg-8"><section class="of-card"><h2 class="h4">Cliente</h2><p class="fs-5 mb-0">@d?.ClientName</p></section><section class="of-card mt-4"><h2 class="h4">Itens</h2><div class="table-responsive"><table class="table"><thead><tr><th>Descrição</th><th>Qtd.</th><th>Unitário</th><th>Desconto</th></tr></thead><tbody>@foreach(var i in d?.Items ?? Enumerable.Empty<OrcaFacil.Domain.Entities.DocumentItem>()){<tr><td>@i.Description</td><td>@i.Quantity</td><td>@i.UnitPrice.ToString("C")</td><td>@i.Discount.ToString("C")</td></tr>}</tbody></table></div></section><section class="of-card mt-4"><h2 class="h4">Observações</h2><p>@(string.IsNullOrWhiteSpace(d?.Notes)?"Sem observações.":d?.Notes)</p></section><section class="of-card mt-4"><h2 class="h4">Timeline</h2><ol class="mb-0"><li>Documento criado e registrado na auditoria.</li><li>Status atual: @d?.Status.</li></ol></section></div><aside class="col-lg-4"><div class="of-card"><p class="of-eyebrow">Total</p><strong class="display-6 text-success">@d?.Total.ToString("C")</strong><div class="d-grid gap-2 mt-4"><a class="btn btn-outline-primary" asp-page="/Documents/Edit" asp-route-id="@d?.Id">Editar</a><a class="btn btn-primary" href="/Documents/Pdf/@d?.Id">Gerar PDF</a><form method="post" asp-page-handler="Duplicate" asp-route-id="@d?.Id">@Html.AntiForgeryToken()<button class="btn btn-outline-secondary w-100">Duplicar</button></form><form method="post" asp-page-handler="PublicLink" asp-route-id="@d?.Id">@Html.AntiForgeryToken()<button class="btn btn-success w-100">Gerar link de aprovação</button></form>@if(TempData["PublicLink"] is string publicLink){<button class="btn btn-outline-primary" type="button" data-copy="@publicLink">Copiar novo link seguro</button>}<form method="post" asp-page-handler="Delete" asp-route-id="@d?.Id">@Html.AntiForgeryToken()<button class="btn btn-danger w-100" data-confirm="Excluir documento?">Excluir</button></form></div></div></aside></div>
