@page "{id:guid}"
@model OrcaFacil.Web.Pages.Documents.DetailsModel
@{var d=Model.Document; ViewData["Title"]=$"Documento {d?.Number}";}<h1>@d?.Type @d?.Number</h1><div class="card p-4"><h2 class="h5">@d?.ClientName</h2><p>Status: <strong>@d?.Status</strong> Total: <strong>@d?.Total.ToString("C")</strong></p><table class="table"><tbody>@foreach(var i in d?.Items ?? Enumerable.Empty<OrcaFacil.Domain.Entities.DocumentItem>()){<tr><td>@i.Description</td><td>@i.Quantity</td><td>@i.UnitPrice.ToString("C")</td></tr>}</tbody></table><p>@d?.Notes</p></div><div class="mt-3 d-flex gap-2"><a class="btn btn-outline-primary" asp-page="/Documents/Edit" asp-route-id="@d?.Id">Editar</a><a class="btn btn-primary" href="/Documents/Pdf/@d?.Id">PDF</a><form method="post" asp-page-handler="Duplicate" asp-route-id="@d?.Id">@Html.AntiForgeryToken()<button class="btn btn-secondary">Duplicar</button></form><form method="post" asp-page-handler="PublicLink" asp-route-id="@d?.Id">@Html.AntiForgeryToken()<button class="btn btn-success">Gerar link público</button></form><form method="post" asp-page-handler="Delete" asp-route-id="@d?.Id" onsubmit="return confirm('Excluir documento?')">@Html.AntiForgeryToken()<button class="btn btn-danger">Excluir</button></form></div>
