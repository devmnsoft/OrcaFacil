@model IReadOnlyList<OrcaFacil.Application.DTOs.DocumentSummaryDto>
<div class="of-responsive-table"><table class="of-table"><thead><tr><th>Número</th><th>Tipo</th><th>Cliente</th><th>Status</th><th>Total</th><th><span class="visually-hidden">Ações</span></th></tr></thead><tbody>@foreach(var x in Model ?? Array.Empty<OrcaFacil.Application.DTOs.DocumentSummaryDto>()){<tr><td>@x.Number</td><td>@x.Type</td><td>@x.ClientName</td><td>@x.Status</td><td>@x.Total.ToString("C")</td><td><a asp-page="/Documents/Details" asp-route-id="@x.Id">Ver detalhes</a></td></tr>}</tbody></table></div>
