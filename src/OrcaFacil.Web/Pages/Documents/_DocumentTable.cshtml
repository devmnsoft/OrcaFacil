@model IReadOnlyList<OrcaFacil.Application.DTOs.DocumentSummaryDto>
<table class="table table-hover bg-white"><thead><tr><th>Número</th><th>Tipo</th><th>Cliente</th><th>Status</th><th>Total</th><th></th></tr></thead><tbody>@foreach(var x in Model ?? Array.Empty<OrcaFacil.Application.DTOs.DocumentSummaryDto>()){<tr><td>@x.Number</td><td>@x.Type</td><td>@x.ClientName</td><td>@x.Status</td><td>@x.Total.ToString("C")</td><td><a asp-page="/Documents/Details" asp-route-id="@x.Id">Ver</a></td></tr>}</tbody></table>
