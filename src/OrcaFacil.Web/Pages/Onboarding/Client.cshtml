@page
@model OrcaFacil.Web.Pages.Onboarding.ClientModel
@{ViewData["Title"]="Cadastre seu primeiro cliente";}
@section Styles {<link rel="stylesheet" href="~/css/onboarding.css" asp-append-version="true" />}
<div class="onboarding-shell"><main class="onboarding-card"><partial name="_Progress" model="2"/><header class="page-intro"><span class="eyebrow">Etapa 3 de 5</span><h1>Cadastre seu primeiro cliente</h1><p>Ao selecionar um cliente, os dados entram na proposta sem redigitação.</p></header><form method="post" data-onboarding-form novalidate><div asp-validation-summary="ModelOnly" class="validation-summary" role="alert" aria-live="assertive"></div><div class="field-grid"><div class="field"><label asp-for="Input.Name">Nome do cliente</label><input asp-for="Input.Name" autocomplete="name" data-preview-source="client" /><span asp-validation-for="Input.Name"></span></div><div class="field"><label asp-for="Input.PersonType">Tipo</label><select asp-for="Input.PersonType" data-person-type><option value="0">Pessoa física</option><option value="1">Pessoa jurídica</option></select><span asp-validation-for="Input.PersonType"></span></div><div class="field"><label asp-for="Input.Document">CPF ou CNPJ (opcional)</label><input asp-for="Input.Document" inputmode="numeric" data-document /><span asp-validation-for="Input.Document"></span></div><div class="field"><label asp-for="Input.Phone">Telefone (opcional)</label><input asp-for="Input.Phone" inputmode="tel" data-phone /><span asp-validation-for="Input.Phone"></span></div><div class="field"><label asp-for="Input.WhatsApp">WhatsApp (opcional)</label><input asp-for="Input.WhatsApp" inputmode="tel" data-phone /><span asp-validation-for="Input.WhatsApp"></span></div><div class="field"><label asp-for="Input.Email">E-mail (opcional)</label><input asp-for="Input.Email" type="email" /><span asp-validation-for="Input.Email"></span></div><div class="field"><label asp-for="Input.City">Cidade (opcional)</label><input asp-for="Input.City"  /><span asp-validation-for="Input.City"></span></div></div><div class="onboarding-actions"><button class="primary" type="submit" data-submit-text="Salvando…">Salvar e continuar</button><button class="secondary" type="submit" asp-page-handler="Skip" formnovalidate>Fazer depois</button></div></form></main><aside class="context-guide"><strong>Prévia do resultado</strong><div class="document-preview" data-preview><small>Preparado para</small><b data-preview-target="client">Seu cliente</b></div><p>Você poderá revisar tudo antes de finalizar.</p></aside></div>
@section Scripts {<partial name="_ValidationScriptsPartial"/><script type="module" src="~/js/onboarding.js" asp-append-version="true"></script>}
