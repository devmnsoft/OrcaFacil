@page
@model OrcaFacil.Web.Pages.Onboarding.DocumentIdentityModel
@{ViewData["Title"]="Identidade do documento";}
@section Styles {<link rel="stylesheet" href="~/css/onboarding.css" asp-append-version="true" />}
<div class="onboarding-shell"><main class="onboarding-card"><partial name="_Progress" model="1"/><header class="page-intro"><span class="eyebrow">Etapa 2 de 5</span><h1>Identidade do documento</h1><p>Defina o cabeçalho que seu cliente verá no orçamento.</p></header><form method="post" data-onboarding-form novalidate><div asp-validation-summary="ModelOnly" class="validation-summary" role="alert" aria-live="assertive"></div><div class="field-grid"><div class="field"><label asp-for="Input.DisplayName">Nome no orçamento</label><input asp-for="Input.DisplayName" data-preview-source="name" /><span asp-validation-for="Input.DisplayName"></span></div><div class="field"><label asp-for="Input.Phone">Telefone comercial</label><input asp-for="Input.Phone" inputmode="tel" data-phone /><span asp-validation-for="Input.Phone"></span></div><div class="field"><label asp-for="Input.Email">E-mail comercial</label><input asp-for="Input.Email" type="email" /><span asp-validation-for="Input.Email"></span></div><div class="field"><label asp-for="Input.City">Cidade</label><input asp-for="Input.City"  /><span asp-validation-for="Input.City"></span></div><div class="field"><label asp-for="Input.Address">Endereço (opcional)</label><input asp-for="Input.Address" autocomplete="street-address" /><span asp-validation-for="Input.Address"></span></div><div class="field"><label asp-for="Input.PixKey">Chave PIX (opcional)</label><input asp-for="Input.PixKey"  /><span asp-validation-for="Input.PixKey"></span></div><div class="field"><label asp-for="Input.DefaultNote">Observação padrão (opcional)</label><textarea asp-for="Input.DefaultNote" rows="3"></textarea><span asp-validation-for="Input.DefaultNote"></span></div></div><div class="onboarding-actions"><button class="primary" type="submit" data-submit-text="Salvando…">Salvar e continuar</button></div></form></main><aside class="context-guide"><strong>Prévia do resultado</strong><div class="document-preview" data-preview><b data-preview-target="name">Sua marca</b><hr><small>ORÇAMENTO · Dados do emitente</small></div><p>Você poderá revisar tudo antes de finalizar.</p></aside></div>
@section Scripts {<partial name="_ValidationScriptsPartial"/><script type="module" src="~/js/onboarding.js" asp-append-version="true"></script>}
