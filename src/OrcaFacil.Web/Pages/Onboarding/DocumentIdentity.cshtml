@page
@model OrcaFacil.Web.Pages.Onboarding.DocumentIdentityModel
@{
    ViewData["Title"] = "Identidade do documento";
}
@section Styles
{
    <link rel="stylesheet" href="~/css/onboarding.css" asp-append-version="true" />
}
<div class="of-onboarding-shell">
<main class="of-onboarding-panel">
<partial name="_Progress" model="1"/>
<header class="of-onboarding-step">
<span class="of-onboarding-eyebrow">Etapa 2 de 5</span>
<h1>Identidade do documento</h1>
<p>Defina o cabeçalho que seu cliente verá no orçamento.</p>
</header>
<form method="post" data-onboarding-form novalidate>
<div asp-validation-summary="ModelOnly" class="of-onboarding-summary" role="alert" aria-live="assertive"></div>
<div class="of-onboarding-field-grid">
<div class="of-onboarding-field">
<label asp-for="Input.DisplayName">Nome no orçamento</label>
<input asp-for="Input.DisplayName" data-preview-source="name" / aria-describedby="Input_DisplayName-help Input_DisplayName-error">
<small id="Input_DisplayName-help" class="of-onboarding-help">Preencha com dados que você usa no atendimento.</small>
<span id="Input_DisplayName-error" asp-validation-for="Input.DisplayName"></span>
</div>
<div class="of-onboarding-field">
<label asp-for="Input.Phone">Telefone comercial</label>
<input asp-for="Input.Phone" inputmode="tel" data-phone / aria-describedby="Input_Phone-help Input_Phone-error">
<small id="Input_Phone-help" class="of-onboarding-help">Preencha com dados que você usa no atendimento.</small>
<span id="Input_Phone-error" asp-validation-for="Input.Phone"></span>
</div>
<div class="of-onboarding-field">
<label asp-for="Input.Email">E-mail comercial</label>
<input asp-for="Input.Email" type="email" / aria-describedby="Input_Email-help Input_Email-error">
<small id="Input_Email-help" class="of-onboarding-help">Preencha com dados que você usa no atendimento.</small>
<span id="Input_Email-error" asp-validation-for="Input.Email"></span>
</div>
<div class="of-onboarding-field">
<label asp-for="Input.City">Cidade</label>
<input asp-for="Input.City"  / aria-describedby="Input_City-help Input_City-error">
<small id="Input_City-help" class="of-onboarding-help">Preencha com dados que você usa no atendimento.</small>
<span id="Input_City-error" asp-validation-for="Input.City"></span>
</div>
<div class="of-onboarding-field">
<label asp-for="Input.Address">Endereço (opcional)</label>
<input asp-for="Input.Address" autocomplete="street-address" / aria-describedby="Input_Address-help Input_Address-error">
<small id="Input_Address-help" class="of-onboarding-help">Preencha com dados que você usa no atendimento.</small>
<span id="Input_Address-error" asp-validation-for="Input.Address"></span>
</div>
<div class="of-onboarding-field">
<label asp-for="Input.PixKey">Chave PIX (opcional)</label>
<input asp-for="Input.PixKey"  / aria-describedby="Input_PixKey-help Input_PixKey-error">
<small id="Input_PixKey-help" class="of-onboarding-help">Preencha com dados que você usa no atendimento.</small>
<span id="Input_PixKey-error" asp-validation-for="Input.PixKey"></span>
</div>
<div class="of-onboarding-field">
<label asp-for="Input.DefaultNote">Observação padrão (opcional)</label>
<textarea asp-for="Input.DefaultNote" rows="3" aria-describedby="Input_DefaultNote-help Input_DefaultNote-error"></textarea>
<small id="Input_DefaultNote-help" class="of-onboarding-help">Preencha com dados que você usa no atendimento.</small>
<span id="Input_DefaultNote-error" asp-validation-for="Input.DefaultNote"></span>
</div>
</div>
<div class="of-onboarding-actions">
<button class="of-onboarding-button of-onboarding-button--primary" type="submit" data-submit-text="Salvando…">Salvar e continuar</button>
</div>
</form>
</main>
<aside class="of-onboarding-aside">
<div class="of-onboarding-brand" aria-label="OrçaFácil, uma solução MNSOFT">OrçaFácil <small>por MNSOFT</small></div>
<strong>Prévia do resultado</strong>
<div class="of-onboarding-document-preview" data-preview><b data-preview-target="name">Sua marca</b>
<hr>
<small>ORÇAMENTO · Dados do emitente</small>
</div>
<p>Você poderá revisar tudo antes de finalizar.</p>
</aside>
</div>
@section Scripts
{
    <partial name="_ValidationScriptsPartial"/><script type="module" src="~/js/onboarding.js" asp-append-version="true"></script>
}
