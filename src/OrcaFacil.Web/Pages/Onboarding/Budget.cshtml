@page
@model OrcaFacil.Web.Pages.Onboarding.BudgetModel
@{
    ViewData["Title"] = "Primeiro orçamento";
}
@section Styles
{
    <link rel="stylesheet" href="~/css/onboarding.css" asp-append-version="true" />
}
<div class="of-onboarding-shell">
<main class="of-onboarding-panel">
<partial name="_Progress" model="4"/>
<header class="of-onboarding-step">
<span class="of-onboarding-eyebrow">Etapa 5 de 5</span>
<h1>Monte seu primeiro orçamento.</h1>
<p>Vamos abrir o editor real com seu cliente selecionado e seu catálogo disponível. O total será recalculado no servidor.</p>
</header>
<div class="of-onboarding-success">
<strong>Seu rascunho está pronto para começar</strong>
<p>Adicione o serviço, ajuste a quantidade e revise antes de finalizar. A prévia não consome geração de PDF.</p>
</div>
<div class="of-onboarding-actions">
<form method="post" data-onboarding-form>
<button type="submit" class="of-onboarding-button of-onboarding-button--primary" data-submit-text="Abrindo editor…">Montar orçamento</button>
</form>
<form method="post" asp-page-handler="Done">
<button type="submit" class="of-onboarding-button of-onboarding-button--secondary">Concluir configuração</button>
</form>
</div>
</main>
<aside class="of-onboarding-aside">
<div class="of-onboarding-brand" aria-label="OrçaFácil, uma solução MNSOFT">OrçaFácil <small>por MNSOFT</small></div>
<strong>Próximo resultado</strong>
<div class="of-onboarding-document-preview">
<small>ORÇAMENTO</small>
<b>Cliente + serviço</b>
<hr>
<span>Total calculado com segurança</span>
</div>
</aside>
</div>
@section Scripts
{
    <script type="module" src="~/js/onboarding.js" asp-append-version="true"></script>
}
