@page
@model OrcaFacil.Web.Pages.Onboarding.IndexModel
@{ ViewData["Title"]="Primeiros passos"; }
<header class="of-page-header"><div><p class="of-eyebrow">Primeiros passos</p><h1>Bem-vindo ao OrçaFácil</h1><p>Em poucos passos você gera seu primeiro orçamento profissional.</p></div><a class="btn btn-outline-primary" asp-page="/Dashboard/Index">Fazer depois</a></header>
<section class="of-card mb-4"><div class="row align-items-center g-4"><div class="col-lg-8"><h2>Seu caminho até o primeiro PDF</h2><p class="of-muted">Complete as etapas na ordem sugerida para criar um orçamento, gerar PDF e enviar ao cliente.</p></div><div class="col-lg-4"><img class="of-illustration" src="/img/illustrations/onboarding-flow.svg" alt="Fluxo de onboarding" /></div></div></section><section class="of-card of-progress-panel mb-4"><div class="of-progress-steps"><span class="is-done">✓ Conta criada</span><span class="@(Model.HasIssuerProfile ? "is-done" : Model.ActiveStep == 1 ? "is-active" : "")">Dados do emitente</span><span class="@(Model.HasDocuments ? "is-done" : Model.ActiveStep == 2 ? "is-active" : "")">Primeiro orçamento</span><span class="@(Model.ActiveStep == 3 ? "is-active" : "")">Primeiro PDF</span></div></section>
<div class="row g-4"><div class="col-md-3"><partial name="Partials/_StepCard" model='new StepCardViewModel { Number="✓", Title="Seus dados", Text="Esses dados aparecerão no PDF.", ActionText="Ver perfil", ActionPage="/Profile/Index", IsActive=Model.ActiveStep==1, IsDone=Model.HasIssuerProfile }' /></div><div class="col-md-3"><partial name="Partials/_StepCard" model='new StepCardViewModel { Number="1", Title="Cadastre os dados que aparecerão no PDF.", Text="Informe nome, documento e contato do prestador.", ActionText="Cadastrar dados do emitente", ActionPage="/Profile/Index", IsActive=Model.ActiveStep==1, IsDone=Model.HasIssuerProfile }' /></div><div class="col-md-3"><partial name="Partials/_StepCard" model='new StepCardViewModel { Number="2", Title="Crie seu primeiro orçamento profissional.", Text="Informe o cliente, os serviços e os valores.", ActionText="Criar orçamento", ActionPage="/Documents/CreateBudget", IsActive=Model.ActiveStep==2, IsDone=Model.HasDocuments }' /></div><div class="col-md-3"><partial name="Partials/_StepCard" model='new StepCardViewModel { Number="3", Title="Gere o PDF e envie ao cliente.", Text="Use o histórico para baixar, editar e compartilhar.", ActionText="Ver histórico", ActionPage="/Documents/Index", IsActive=Model.ActiveStep==3 }' /></div></div>
