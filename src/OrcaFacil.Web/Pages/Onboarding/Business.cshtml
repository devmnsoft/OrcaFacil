@page
@model OrcaFacil.Web.Pages.Onboarding.BusinessModel
@{ViewData["Title"]="Conte sobre o seu negócio";}
@section Styles {<link rel="stylesheet" href="~/css/onboarding.css" asp-append-version="true" />}
<div class="onboarding-shell"><main class="onboarding-card"><partial name="_Progress" model="0"/><header class="page-intro"><span class="eyebrow">Etapa 1 de 5</span><h1>Conte sobre o seu negócio</h1><p>Esses dados identificam sua atividade e mantêm seus documentos consistentes.</p></header><form method="post" data-onboarding-form novalidate><div asp-validation-summary="ModelOnly" class="validation-summary" role="alert" aria-live="assertive"></div><div class="field-grid"><div class="field"><label asp-for="Input.PersonType">Tipo</label><select asp-for="Input.PersonType" data-person-type><option value="0">Pessoa física</option><option value="1">Pessoa jurídica</option></select><span asp-validation-for="Input.PersonType"></span></div><div class="field"><label asp-for="Input.Name">Nome profissional ou fantasia</label><input asp-for="Input.Name" autocomplete="organization" data-preview-source="name" /><span asp-validation-for="Input.Name"></span></div><div class="field"><label asp-for="Input.Document">CPF ou CNPJ</label><input asp-for="Input.Document" inputmode="numeric" data-document /><span asp-validation-for="Input.Document"></span></div><div class="field"><label asp-for="Input.Phone">Telefone</label><input asp-for="Input.Phone" inputmode="tel" autocomplete="tel" data-phone /><span asp-validation-for="Input.Phone"></span></div><div class="field"><label asp-for="Input.WhatsApp">WhatsApp (opcional)</label><input asp-for="Input.WhatsApp" inputmode="tel" data-phone /><span asp-validation-for="Input.WhatsApp"></span></div><div class="field"><label asp-for="Input.Email">E-mail</label><input asp-for="Input.Email" type="email" autocomplete="email" /><span asp-validation-for="Input.Email"></span></div><div class="field"><label asp-for="Input.City">Cidade</label><input asp-for="Input.City" autocomplete="address-level2" /><span asp-validation-for="Input.City"></span></div><div class="field"><label asp-for="Input.State">UF</label><input asp-for="Input.State" maxlength="2" autocomplete="address-level1" /><span asp-validation-for="Input.State"></span></div></div><div class="onboarding-actions"><button class="primary" type="submit" data-submit-text="Salvando…">Salvar e continuar</button></div></form></main><aside class="context-guide"><strong>Prévia do resultado</strong><div class="document-preview" data-preview><b data-preview-target="name">Seu negócio</b><small>Orçamento profissional</small></div><p>Você poderá revisar tudo antes de finalizar.</p></aside></div>
@section Scripts {<partial name="_ValidationScriptsPartial"/><script type="module" src="~/js/onboarding.js" asp-append-version="true"></script>}
