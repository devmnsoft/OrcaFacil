@page "/p/{token}"
@model OrcaFacil.Web.Pages.PublicQuotes.ViewModel
@{ Layout="/Pages/Shared/_PublicLayout.cshtml"; ViewData["Title"]="Aprovação de orçamento"; var d=Model.Document; }
<section class="of-hero"><div class="container"><div class="of-public-card p-4 p-lg-5"><p class="of-eyebrow">Aprovação pública</p><h1 class="h2 text-dark">Orçamento @d?.Number</h1><div class="row g-4"><div class="col-lg-8"><h2 class="h5">Cliente</h2><p>@d?.ClientName</p><div class="table-responsive"><table class="table"><thead><tr><th>Item</th><th>Qtd.</th><th>Unitário</th></tr></thead><tbody>@foreach(var i in d?.Items ?? Enumerable.Empty<OrcaFacil.Domain.Entities.DocumentItem>()){<tr><td>@i.Description</td><td>@i.Quantity</td><td>@i.UnitPrice.ToString("C")</td></tr>}</tbody></table></div><p>@d?.Notes</p></div><div class="col-lg-4"><div class="of-card shadow-none"><span class="of-badge">Total</span><strong class="display-6 text-success d-block">@d?.Total.ToString("C")</strong><p>Validade: @(d?.ValidUntil?.ToString("dd/MM/yyyy") ?? "não informada")</p><a class="btn btn-primary w-100" href="/Documents/Pdf/@d?.Id">Baixar PDF</a><button class="btn btn-success w-100 mt-2" data-bs-toggle="modal" data-bs-target="#approveModal">Aprovar</button><button class="btn btn-outline-danger w-100 mt-2" data-bs-toggle="modal" data-bs-target="#rejectModal">Recusar</button></div></div></div></div></div></section><div class="modal fade" id="approveModal" tabindex="-1"><div class="modal-dialog"><form method="post" asp-page-handler="Approve" class="modal-content">@Html.AntiForgeryToken()<div class="modal-header"><h2 class="h5">Aprovar orçamento</h2><button class="btn-close" data-bs-dismiss="modal"></button></div><div class="modal-body"><label>Nome</label><input asp-for="Input.Name" class="form-control"/><label>Documento opcional</label><input asp-for="Input.Document" class="form-control"/><label>E-mail opcional</label><input asp-for="Input.Email" class="form-control"/><label>Observação</label><textarea asp-for="Input.Note" class="form-control"></textarea><div class="form-check mt-3"><input asp-for="Input.AcceptedTerms" class="form-check-input"/><label class="form-check-label">Li e aceito aprovar este orçamento.</label></div></div><div class="modal-footer"><button class="btn btn-success">Confirmar aprovação</button></div></form></div></div><div class="modal fade" id="rejectModal" tabindex="-1"><div class="modal-dialog"><div class="modal-content"><div class="modal-header"><h2 class="h5">Recusar orçamento</h2><button class="btn-close" data-bs-dismiss="modal"></button></div><div class="modal-body"><label>Nome</label><input class="form-control"/><label>Motivo</label><textarea class="form-control"></textarea><label>E-mail opcional</label><input class="form-control" type="email"/></div><div class="modal-footer"><button class="btn btn-outline-danger" data-bs-dismiss="modal">Registrar recusa</button></div></div></div></div>
