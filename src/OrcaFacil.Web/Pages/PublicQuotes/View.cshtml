@page "/p/{token}"
@model OrcaFacil.Web.Pages.PublicQuotes.ViewModel
@{ Layout="/Pages/Shared/_PublicQuoteLayout.cshtml"; ViewData["Title"]="Aprovação de orçamento"; var d=Model.Document; }
<section class="of-section"><div class="container"><div class="of-public-card p-4 p-lg-5"><div class="of-public-quote-header mb-4"><div class="d-flex flex-column flex-lg-row align-items-center gap-3"><div><partial name="Partials/_MnsoftBrand" /><p class="of-eyebrow text-white-75">Orçamento para aprovação</p><h1>Orçamento @d?.Number</h1><p class="mb-0">Você recebeu um orçamento para conferência. Revise os itens, o valor total e escolha se deseja aprovar ou recusar.</p></div><img class="of-illustration" style="max-width:220px" src="/img/illustrations/public-approval.svg" alt="Aprovação pública" /></div></div><div class="row g-4"><div class="col-lg-8"><section class="of-card shadow-none"><h2 class="h5">Cliente</h2><p>@d?.ClientName</p><div class="table-responsive"><table class="table"><thead><tr><th>Item</th><th>Qtd.</th><th>Unitário</th><th>Total</th></tr></thead><tbody>@foreach(var i in d?.Items ?? Enumerable.Empty<OrcaFacil.Domain.Entities.DocumentItem>()){<tr><td>@i.Description</td><td>@i.Quantity</td><td>@i.UnitPrice.ToString("C")</td><td>@i.CalculateTotal().ToString("C")</td></tr>}</tbody></table></div><h2 class="h5 mt-4">Observações</h2><p>@(string.IsNullOrWhiteSpace(d?.Notes)?"Sem observações adicionais.":d?.Notes)</p></section></div><div class="col-lg-4"><div class="of-card shadow-none"><span class="of-badge">Total em destaque</span><strong class="display-6 text-success d-block">@d?.Total.ToString("C")</strong><p>Validade: @(d?.ValidUntil?.ToString("dd/MM/yyyy") ?? "não informada")</p><a class="btn btn-primary w-100" href="/Documents/Pdf/@d?.Id">Baixar PDF</a><button class="btn btn-success w-100 mt-2" data-bs-toggle="modal" data-bs-target="#approveModal">Aprovar orçamento</button><button class="btn btn-outline-danger w-100 mt-2" data-bs-toggle="modal" data-bs-target="#rejectModal">Recusar</button><p class="form-text mt-3">Este aceite é um registro simples de aprovação comercial. Ele não substitui assinatura digital certificada.</p></div></div></div></div></div></section><div class="modal fade" id="approveModal" tabindex="-1" aria-labelledby="approveTitle"><div class="modal-dialog"><form method="post" asp-page-handler="Approve" class="modal-content">@Html.AntiForgeryToken()<div class="modal-header"><h2 class="h5" id="approveTitle">Aprovar orçamento</h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button></div><div class="modal-body"><p>Informe seu nome para registrar o aceite.</p><label class="form-label" asp-for="Input.Name">Nome</label><input asp-for="Input.Name" class="form-control"/><label class="form-label" asp-for="Input.Email">E-mail opcional</label><input asp-for="Input.Email" class="form-control"/><label class="form-label" asp-for="Input.Document">Documento opcional</label><input asp-for="Input.Document" class="form-control"/><label class="form-label" asp-for="Input.Note">Observação</label><textarea asp-for="Input.Note" class="form-control"></textarea><div class="form-check mt-3"><input asp-for="Input.AcceptedTerms" class="form-check-input" id="acceptedTerms"/><label class="form-check-label" for="acceptedTerms">Li e aprovo este orçamento nas condições apresentadas.</label></div></div><div class="modal-footer"><button class="btn btn-success">Confirmar aprovação</button></div></form></div></div><div class="modal fade" id="rejectModal" tabindex="-1" aria-labelledby="rejectTitle"><div class="modal-dialog"><div class="modal-content"><div class="modal-header"><h2 class="h5" id="rejectTitle">Recusar orçamento</h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button></div><div class="modal-body"><label class="form-label" for="rejectName">Nome</label><input id="rejectName" class="form-control"/><label class="form-label" for="rejectReason">Motivo</label><textarea id="rejectReason" class="form-control"></textarea><label class="form-label" for="rejectEmail">E-mail opcional</label><input id="rejectEmail" class="form-control" type="email"/></div><div class="modal-footer"><button class="btn btn-outline-danger" data-bs-dismiss="modal">Registrar recusa</button></div></div></div></div>
