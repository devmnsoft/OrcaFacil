@page
@model OrcaFacil.Web.Pages.Settings.SettingsPageModel
@{ViewData["Title"]="Identidade visual";}
<partial name="_SettingsNav"/><header class="of-page-heading"><p class="of-eyebrow">Identidade visual</p><h1>Sua marca em cada documento</h1><p>Arquivos são validados no servidor e isolados por conta.</p></header>
<form method="post" enctype="multipart/form-data" class="of-settings-layout"><section class="of-panel"><div asp-validation-summary="ModelOnly" class="of-form-error"></div><div class="of-form-grid">
<label class="of-field"><span>Logo principal</span><input asp-for="MainLogo" type="file" accept="image/png,image/jpeg,image/webp"/></label><label class="of-field"><span>Logo compacta</span><input asp-for="CompactLogo" type="file" accept="image/png,image/jpeg,image/webp"/></label>
<label class="of-field"><span>Cor primária</span><input asp-for="Input.PrimaryColor" type="color"/></label><label class="of-field"><span>Cor secundária</span><input asp-for="Input.SecondaryColor" type="color"/></label><label class="of-field"><span>Cor de destaque</span><input asp-for="Input.AccentColor" type="color"/></label>
<label class="of-field of-field--wide"><span>Assinatura visual</span><input asp-for="Input.VisualSignature" maxlength="180"/></label><label class="of-field of-field--wide"><span>Texto institucional curto</span><textarea asp-for="Input.ShortInstitutionalText" maxlength="500"></textarea></label><label class="of-field of-field--wide"><span>Rodapé padrão</span><textarea asp-for="Input.DocumentFooter" maxlength="500"></textarea></label></div><button class="of-button of-button--primary">Salvar identidade</button></section>
<aside class="of-document-preview" style="--brand:@Model.Input.PrimaryColor;--accent:@Model.Input.AccentColor"><div class="of-document-preview__brand">@if(!string.IsNullOrWhiteSpace(Model.Input.LogoPath)){<img src="@Model.Input.LogoPath" alt="Logo da empresa"/>}else{<strong>@Model.Account.DisplayName</strong>}</div><h2>Prévia da proposta</h2><p>@Model.Input.ShortInstitutionalText</p><hr/><p>@Model.Input.DefaultCommercialTerms</p><footer>@Model.Input.DocumentFooter</footer></aside></form>
