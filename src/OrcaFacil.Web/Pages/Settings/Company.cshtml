@model OrcaFacil.Web.Pages.Settings.CompanyModel
@{ViewData["Title"]="Empresa";}<partial name="_SettingsNav"/><header class="of-page-heading"><h1>Dados da empresa</h1><p>Estas informações identificam o emitente em propostas e recibos.</p></header><form method="post" class="of-panel of-guided-form"><div asp-validation-summary="ModelOnly" class="of-form-error"></div><div class="of-form-grid"><label class="of-field"><span>Nome fantasia *</span><input asp-for="Input.TradeName" required/></label><label class="of-field"><span>Razão social</span><input asp-for="Input.LegalName"/></label><label class="of-field"><span>CNPJ/CPF</span><input asp-for="Input.DocumentNumber"/></label><label class="of-field"><span>Inscrição estadual</span><input asp-for="Input.StateRegistration"/></label><label class="of-field"><span>Inscrição municipal</span><input asp-for="Input.MunicipalRegistration"/></label><label class="of-field"><span>E-mail comercial</span><input asp-for="Input.Email" type="email"/></label><label class="of-field"><span>Telefone</span><input asp-for="Input.Phone" type="tel"/></label><label class="of-field"><span>WhatsApp</span><input asp-for="Input.WhatsApp" type="tel"/></label><label class="of-field"><span>Site</span><input asp-for="Input.Website" type="url"/></label><label class="of-field"><span>CEP</span><input asp-for="Input.PostalCode"/></label><label class="of-field"><span>Cidade</span><input asp-for="Input.City"/></label><label class="of-field"><span>Estado</span><input asp-for="Input.State" maxlength="2"/></label><label class="of-field of-field--wide"><span>Endereço</span><input asp-for="Input.Address"/></label><label class="of-field of-field--wide"><span>Observações institucionais</span><textarea asp-for="Input.Notes"></textarea></label></div><button class="of-button of-button--primary">Salvar empresa</button></form>
