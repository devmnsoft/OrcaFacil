@page
@model OrcaFacil.Web.Pages.Settings.SettingsPageModel
@{ViewData["Title"]="Documentos";}<partial name="_SettingsNav"/><header class="of-page-heading"><h1>Padrões dos documentos</h1><p>Aplicados somente a documentos criados depois da alteração.</p></header><form method="post" class="of-panel of-guided-form"><div asp-validation-summary="ModelOnly" class="of-form-error"></div><div class="of-form-grid">
<label class="of-field"><span>Validade do orçamento (dias)</span><input asp-for="Input.DefaultQuoteValidityDays" min="1" max="365"/></label><label class="of-field"><span>Prazo padrão</span><input asp-for="Input.DefaultDeliveryTerm" maxlength="120"/></label><label class="of-field"><span>Prefixo orçamento</span><input asp-for="Input.QuotePrefix" required maxlength="12"/></label><label class="of-field"><span>Prefixo OS</span><input asp-for="Input.WorkOrderPrefix" required maxlength="12"/></label><label class="of-field"><span>Prefixo recibo</span><input asp-for="Input.ReceiptPrefix" required maxlength="12"/></label><label class="of-field of-field--wide"><span>Condições comerciais</span><textarea asp-for="Input.DefaultCommercialTerms"></textarea></label><label class="of-field of-field--wide"><span>Observação padrão</span><textarea asp-for="Input.DefaultNotes"></textarea></label><label class="of-field of-field--wide"><span>Mensagem de envio</span><textarea asp-for="Input.DefaultSendMessage"></textarea></label><label><input asp-for="Input.ShowSignature"/> Mostrar assinatura</label><label><input asp-for="Input.ShowBankDetails"/> Mostrar dados bancários</label><label class="of-field of-field--wide"><span>Aviso do recibo</span><textarea asp-for="Input.ReceiptNotice"></textarea></label></div><button class="of-button of-button--primary">Salvar padrões</button></form>
