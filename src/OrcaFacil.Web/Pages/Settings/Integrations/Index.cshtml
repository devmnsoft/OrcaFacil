@page "/Settings/Integrations"
@model OrcaFacil.Web.Pages.Settings.Integrations.IndexModel
@{ViewData["Title"]="Integrações";}
<header class="of-page-header"><div><p class="of-eyebrow">Conectividade V1.3</p><h1>Integrações</h1><p>Configurações reais da conta. Senhas salvas nunca voltam para a tela.</p></div><a class="of-button" asp-page="/Settings/IntegrationHealth/Index">Ver diagnóstico</a></header>
<form method="post" class="of-integration-grid"><section class="of-card"><h2>Endereços públicos</h2><label class="of-field"><span>PublicBaseUrl</span><input asp-for="Input.PublicBaseUrl" class="of-field-control" placeholder="https://app.suaempresa.com.br" /></label><label class="of-field"><span>WhatsApp comercial</span><input asp-for="Input.WhatsAppNumber" class="of-field-control" inputmode="tel" /></label><label class="of-field"><span>E-mail de suporte</span><input asp-for="Input.SupportEmail" class="of-field-control" /></label><label class="of-field"><span>Assinatura padrão</span><textarea asp-for="Input.EmailSignature" class="of-field-control"></textarea></label></section><section class="of-card"><div class="of-card-heading"><h2>SMTP</h2><span class="of-status-badge">@(Model.SmtpPasswordConfigured?"Senha protegida":"Não configurado")</span></div><label class="of-field"><span>Host</span><input asp-for="Input.SmtpHost" class="of-field-control" /></label><label class="of-field"><span>Porta</span><input asp-for="Input.SmtpPort" class="of-field-control" /></label><label class="of-field"><span>Usuário</span><input asp-for="Input.SmtpUser" class="of-field-control" autocomplete="username" /></label><label class="of-field"><span>Nova senha (deixe vazia para manter)</span><input asp-for="Input.SmtpPassword" class="of-field-control" autocomplete="new-password" /></label><label><input asp-for="Input.SmtpUseSsl" /> Usar TLS/SSL</label><label><input asp-for="Input.EmailSendingEnabled" /> Habilitar processamento real</label><p class="of-help-text">Sem configuração completa, o sistema mantém a notificação interna e não declara envio.</p></section><div asp-validation-summary="All" class="of-validation"></div><button type="submit" class="of-button of-button-primary">Salvar configurações</button></form>
