@page "/Settings/Integrations"
@model OrcaFacil.Web.Pages.Settings.Integrations.IndexModel
@{ViewData["Title"]="Integrações";}
<header class="of-page-header"><div><p class="of-eyebrow">Conectividade V1.3</p><h1>Integrações</h1><p>Configurações reais da conta. Senhas salvas nunca voltam para a tela.</p></div><a class="of-button" asp-page="/Settings/IntegrationHealth/Index">Ver diagnóstico</a></header>
<form method="post" class="of-integration-grid"><section class="of-card"><h2>Endereços públicos</h2><label class="of-field"><span>PublicBaseUrl</span><input asp-for="Input.PublicBaseUrl" class="of-field-control" placeholder="https://app.suaempresa.com.br" /></label><label class="of-field"><span>WhatsApp comercial</span><input asp-for="Input.WhatsAppNumber" class="of-field-control" inputmode="tel" /></label><label class="of-field"><span>E-mail de suporte</span><input asp-for="Input.SupportEmail" class="of-field-control" /></label><label class="of-field"><span>Assinatura padrão</span><textarea asp-for="Input.EmailSignature" class="of-field-control"></textarea></label></section><section class="of-card"><div class="of-card-heading"><h2>SMTP</h2><span class="of-status-badge">@(Model.SmtpPasswordConfigured?"Senha protegida":"Não configurado")</span></div><label class="of-field"><span>Host</span><input asp-for="Input.SmtpHost" class="of-field-control" /></label><label class="of-field"><span>Porta</span><input asp-for="Input.SmtpPort" class="of-field-control" /></label><label class="of-field"><span>Usuário</span><input asp-for="Input.SmtpUser" class="of-field-control" autocomplete="username" /></label><label class="of-field"><span>Nova senha (deixe vazia para manter)</span><input asp-for="Input.SmtpPassword" class="of-field-control" autocomplete="new-password" /></label><label><input asp-for="Input.SmtpUseSsl" /> Usar TLS/SSL</label><label><input asp-for="Input.EmailSendingEnabled" /> Habilitar processamento real</label><p class="of-help-text">Sem configuração completa, o sistema mantém a notificação interna e não declara envio.</p></section><div asp-validation-summary="All" class="of-validation"></div><button type="submit" class="of-button of-button-primary">Salvar configurações</button></form>

<form method="post" asp-page-handler="WhatsApp" class="of-integration-grid"><section class="of-card"><div class="of-card-heading"><h2>WhatsApp Cloud API (Meta)</h2><span class="of-status-badge">@(Model.WhatsAppStatus ?? "Não configurado")</span></div><p class="of-help-text">Envio oficial pela Cloud API. Nada é simulado: sem conta habilitada, o envio falha com erro explícito. O texto nunca é gravado em claro.</p><label class="of-field"><span>Phone Number ID</span><input asp-for="WhatsApp.PhoneNumberId" class="of-field-control" /></label><label class="of-field"><span>Business Account ID (console da Meta)</span><input asp-for="WhatsApp.BusinessAccount" class="of-field-control" /></label><label class="of-field"><span>Nome exibido</span><input asp-for="WhatsApp.DisplayName" class="of-field-control" /></label><label class="of-field"><span>Access token @(Model.WhatsAppAccessTokenConfigured?"(já salvo — informe apenas para trocar)":"(obrigatório para habilitar)")</span><input asp-for="WhatsApp.AccessToken" class="of-field-control" autocomplete="new-password" /></label><label class="of-field"><span>App secret @(Model.WhatsAppAppSecretConfigured?"(já salvo — informe apenas para trocar)":"(obrigatório para habilitar)")</span><input asp-for="WhatsApp.AppSecret" class="of-field-control" autocomplete="new-password" /></label><label class="of-field"><span>Verify token do webhook</span><input asp-for="WhatsApp.WebhookVerifyToken" class="of-field-control" /></label><label><input asp-for="WhatsApp.IsEnabled" /> Habilitar envio e recebimento</label><span asp-validation-for="WhatsApp.IsEnabled" class="of-validation"></span></section><section class="of-card"><h2>Webhook da Meta</h2><label class="of-field"><span>URL para colar no app da Meta</span><input class="of-field-control" readonly value="@(Model.WhatsAppWebhookUrl ?? "Informe a PublicBaseUrl acima e salve para gerar a URL.")" /></label><p class="of-help-text">O Meta valida a URL com um GET (handshake): respondemos apenas quando o verify token acima corresponde a uma conta habilitada. Todo POST é verificado por assinatura HMAC-SHA256 com o app secret; sem assinatura válida o evento é recusado.</p>@if(!string.IsNullOrEmpty(Model.WhatsAppLastFailure)){<p class="of-help-text">Última falha registrada: @Model.WhatsAppLastFailure</p>}</section><div asp-validation-summary="All" class="of-validation"></div><button type="submit" class="of-button of-button-primary">Salvar conta do WhatsApp</button></form>
