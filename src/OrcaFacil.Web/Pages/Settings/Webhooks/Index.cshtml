@page "/Settings/Webhooks"
@model OrcaFacil.Web.Pages.Settings.Webhooks.IndexModel
@{ViewData["Title"]="Webhooks";}
<header class="of-page-header"><div><p class="of-eyebrow">Eventos de saída</p><h1>Webhooks</h1><p>Endpoints por conta, segredos protegidos e entrega rastreável por idempotência.</p></div></header>
@if(Model.CreatedSecret is { } secret){<section class="of-card of-secret-once"><h2>Segredo criado</h2><code>@secret</code><p>Copie agora; ele não será exibido novamente.</p></section>}
<div class="of-integration-grid"><form method="post" asp-page-handler="Create" class="of-card"><h2>Novo endpoint</h2><label class="of-field"><span>Nome</span><input asp-for="Name" required class="of-field-control"/></label><label class="of-field"><span>URL</span><input asp-for="Url" type="url" required class="of-field-control"/></label><fieldset><legend>Eventos</legend>@foreach(var e in OrcaFacil.Application.Integrations.WebhookEventTypes.Allowed){<label><input type="checkbox" name="Events" value="@e"/> @e</label>}</fieldset><div asp-validation-summary="All"></div><button type="submit" class="of-button of-button-primary">Criar endpoint</button></form><section class="of-card"><h2>Endpoints configurados</h2>@if(Model.Items.Count==0){<p>Nenhum webhook configurado. Nenhuma entrega externa será anunciada.</p>}@foreach(var item in Model.Items){<article class="of-key-row"><div><strong>@item.Name</strong><small>@item.Url</small><small>@item.EventTypes</small></div><form method="post" asp-page-handler="Toggle"><input type="hidden" name="id" value="@item.Id"/><button class="of-button" type="submit">@(item.IsActive?"Desativar":"Ativar")</button></form></article>}</section></div>
