@page "/Settings/IntegrationHealth"
@model OrcaFacil.Web.Pages.Settings.IntegrationHealth.IndexModel
@{ViewData["Title"]="Diagnóstico de integrações";}
<header class="of-page-header"><div><p class="of-eyebrow">Dados reais</p><h1>Diagnóstico de integrações</h1><p>Nenhum segredo é exibido neste painel.</p></div></header><section class="of-health-grid"><article class="of-card"><h2>SMTP</h2><strong>@(Model.Health.SmtpConfigured?"Configurado":"Não configurado")</strong><p>@Model.Health.FailedEmails e-mails falhos.</p></article><article class="of-card"><h2>Links e WhatsApp</h2><p>PublicBaseUrl: @(Model.Health.PublicBaseUrlConfigured?"Configurada":"Pendente")</p><p>WhatsApp: @(Model.Health.WhatsAppConfigured?"Configurado":"Pendente")</p></article><article class="of-card"><h2>Webhooks</h2><strong>@Model.Health.ActiveWebhooks ativos</strong><p>@Model.Health.FailedWebhooks entregas falhas.</p></article><article class="of-card"><h2>API e dados</h2><p>@Model.Health.ActiveApiKeys chaves ativas.</p><p>Última importação: @(Model.Health.LastImport?.ToString("g")??"Nunca")</p><p>Última exportação: @(Model.Health.LastExport?.ToString("g")??"Nunca")</p></article><article class="of-card"><h2>Notificações</h2><strong>@Model.Health.PendingNotifications pendentes</strong></article></section>
