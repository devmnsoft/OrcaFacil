@page "/Settings/ApiKeys"
@model OrcaFacil.Web.Pages.Settings.ApiKeys.IndexModel
@{ViewData["Title"]="API Keys";}
<header class="of-page-header"><div><p class="of-eyebrow">Acesso programático</p><h1>API Keys</h1><p>A chave completa aparece uma única vez. O banco armazena somente SHA-256.</p></div></header>
@if(Model.CreatedKey is { } key){<section class="of-card of-secret-once"><h2>Copie agora</h2><code>@key</code><p>Por segurança, esta chave não poderá ser recuperada.</p></section>}
<section class="of-integration-grid"><form method="post" asp-page-handler="Create" class="of-card"><h2>Nova chave</h2><label class="of-field"><span>Nome</span><input asp-for="Name" required maxlength="120" class="of-field-control" /></label><fieldset><legend>Escopos</legend>@foreach(var scope in OrcaFacil.Application.Integrations.ApiKeyService.AllowedScopes){<label><input type="checkbox" name="Scopes" value="@scope" /> @scope</label>}</fieldset><label class="of-field"><span>Expira em</span><input asp-for="ExpiresAt" type="date" class="of-field-control" /></label><button type="submit" class="of-button of-button-primary">Criar chave real</button></form><section class="of-card"><h2>Chaves da conta</h2>@if(Model.Items.Count==0){<p>Nenhuma chave ativa ou revogada.</p>}else{@foreach(var item in Model.Items){<article class="of-key-row"><div><strong>@item.Name</strong><code>@item.Prefix…</code><small>@item.Scopes</small></div>@if(item.RevokedAt is null){<form method="post" asp-page-handler="Revoke"><input type="hidden" name="id" value="@item.Id"/><button type="submit" class="of-button of-button-danger">Revogar</button></form>}else{<span class="of-status-badge">Revogada</span>}</article>}}</section></section>
