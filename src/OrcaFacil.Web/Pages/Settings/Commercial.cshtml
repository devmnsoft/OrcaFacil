@page
@model OrcaFacil.Web.Pages.Settings.SettingsPageModel
@{ViewData["Title"]="Preferências comerciais";}<partial name="_SettingsNav"/><header class="of-page-heading"><h1>Preferências comerciais</h1><p>Regras usadas nos próximos follow-ups, alertas e mensagens.</p></header><form method="post" class="of-panel of-guided-form"><div asp-validation-summary="ModelOnly" class="of-form-error"></div><div class="of-form-grid"><label class="of-field"><span>Follow-up após envio (dias)</span><input asp-for="Input.FollowUpAfterSentDays" min="0" max="90"/></label><label class="of-field"><span>Após visualização (dias)</span><input asp-for="Input.FollowUpAfterViewedDays" min="0" max="90"/></label><label class="of-field"><span>Alerta antes do vencimento</span><input asp-for="Input.ExpirationAlertDays" min="0" max="90"/></label><label class="of-field"><span>Desconto máximo (%)</span><input asp-for="Input.MaximumDiscountPercent" min="0" max="100"/></label><label class="of-field"><span>Margem mínima (%)</span><input asp-for="Input.DesiredMinimumMarginPercent" min="0" max="100"/></label><label class="of-field of-field--wide"><span>Política de descontos</span><textarea asp-for="Input.DiscountPolicy"></textarea></label><label class="of-field of-field--wide"><span>Mensagem WhatsApp</span><textarea asp-for="Input.WhatsAppMessage"></textarea></label><label class="of-field of-field--wide"><span>Mensagem de e-mail</span><textarea asp-for="Input.EmailMessage"></textarea></label><label class="of-field of-field--wide"><span>Motivo padrão de perda</span><input asp-for="Input.DefaultLossReason"/></label></div><button class="of-button of-button--primary">Salvar preferências</button></form>
