@page
@model OrcaFacil.Web.Pages.Settings.SettingsPageModel
@{ViewData["Title"]="Pagamentos";}<partial name="_SettingsNav"/><header class="of-page-heading"><h1>Pagamentos e recibos</h1><p>Os dados só aparecem em documentos quando a opção correspondente estiver habilitada.</p></header><form method="post" class="of-panel of-guided-form"><div class="of-form-grid"><label class="of-field of-field--wide"><span>Métodos aceitos</span><input asp-for="Input.AcceptedPaymentMethods"/></label><label class="of-field"><span>Banco</span><input asp-for="Input.BankName"/></label><label class="of-field"><span>Agência</span><input asp-for="Input.BankBranch"/></label><label class="of-field"><span>Conta</span><input asp-for="Input.BankAccount"/></label><label class="of-field"><span>Favorecido</span><input asp-for="Input.Beneficiary"/></label><label class="of-field of-field--wide"><span>Chave Pix</span><input asp-for="Input.PixKey"/></label><label class="of-field of-field--wide"><span>Instruções</span><textarea asp-for="Input.PaymentInstructions"></textarea></label><label class="of-field of-field--wide"><span>Texto do recibo</span><textarea asp-for="Input.ReceiptText"></textarea></label><label class="of-field of-field--wide"><span>Mensagem de cobrança</span><textarea asp-for="Input.CollectionMessage"></textarea></label></div><button class="of-button of-button--primary">Salvar pagamentos</button></form>
