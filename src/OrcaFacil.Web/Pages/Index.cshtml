@page
@{ Layout = "/Pages/Shared/_PublicLayout.cshtml"; ViewData["Title"] = "Orçamentos e recibos profissionais"; }
<section class="of-new-hero">
  <div class="container"><div class="row align-items-center g-5"><div class="col-lg-7">
    <span class="of-badge bg-white text-primary mb-3">Simples, profissional e feito para o celular</span>
    <h1>Orçamentos e recibos com a apresentação que o seu trabalho merece.</h1>
    <p class="lead mt-4">Organize seus clientes, prepare seus documentos e envie tudo de forma clara, mesmo pelo celular.</p>
    <div class="d-flex flex-wrap gap-3 mt-4"><a class="btn btn-success btn-lg" asp-page="/Auth/Register">Criar minha conta grátis</a><a class="btn btn-light btn-lg" href="#como-funciona">Ver como funciona</a></div>
  </div><div class="col-lg-5"><div class="of-new-hero-art"><img src="/img/illustrations/landing-budget.svg" alt="Fluxo de orçamento com cliente, PDF e envio" /></div></div></div></div>
</section>
<section id="como-funciona" class="of-content-section"><div class="container"><header class="of-section-title"><p class="of-eyebrow">Do atendimento ao envio</p><h2>Seu documento pronto em quatro passos.</h2><p class="of-text-secondary">Um fluxo guiado reduz retrabalho e deixa cada informação fácil de revisar.</p></header>
<div class="of-step-grid">@foreach(var step in new[]{("1","Cadastre o cliente","Guarde os dados para usar novamente."),("2","Informe o serviço","Descreva itens, quantidades e valores."),("3","Revise o documento","Confira totais, condições e identidade."),("4","Gere e envie","Baixe o PDF e compartilhe com o cliente.")}){<article class="of-step"><span class="of-step-number">@step.Item1</span><h3>@step.Item2</h3><p>@step.Item3</p></article>}</div></div></section>
<section id="recursos" class="of-content-section"><div class="container"><header class="of-section-title"><p class="of-eyebrow">Tudo no lugar</p><h2>Mais clareza para você e para seus clientes.</h2></header><div class="of-benefit-grid">
@foreach(var item in new[]{("client","Seus dados organizados","Clientes e informações disponíveis quando precisar."),("document","Documentos com sua identidade","Uma apresentação consistente do seu trabalho."),("activity","Histórico","Retome documentos e acompanhe o que já criou."),("success","Aprovação","Compartilhe um caminho claro para o cliente decidir.")}){<article class="of-benefit"><svg class="of-icon" aria-hidden="true"><use href="/img/icons/orcafacil-icons.svg#icon-@item.Item1"></use></svg><h3>@item.Item2</h3><p>@item.Item3</p></article>}
</div><article class="of-benefit mt-3"><h3>Funciona no celular</h3><p>Cadastre, revise e acompanhe seus documentos de onde estiver.</p></article></div></section>
<section class="of-content-section of-surface-brand"><div class="container"><div class="of-final-cta"><div><h2>Crie seu primeiro orçamento grátis.</h2><p>Transforme seu atendimento em poucos minutos, com texto sempre legível.</p></div><a class="btn btn-success btn-lg" asp-page="/Auth/Register">Criar minha conta grátis</a></div></div></section>
