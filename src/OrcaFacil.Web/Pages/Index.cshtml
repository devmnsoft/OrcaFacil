@page
@{ Layout="/Pages/Shared/_PublicLayout.cshtml"; ViewData["Title"]="Orçamentos e recibos profissionais"; }
<section class="of-hero"><div class="container"><div class="row align-items-center g-4"><div class="col-lg-7"><p class="of-eyebrow text-white-50">SaaS para prestadores de serviço</p><h1>Orçamentos e recibos profissionais em PDF, em segundos.</h1><p class="lead text-white-50">Crie documentos bonitos, numerados e prontos para enviar ao cliente, sem instalar nada.</p><div class="d-flex flex-column flex-sm-row gap-3 mt-4"><a class="btn btn-success btn-lg" asp-page="/Auth/Register">Começar grátis</a><a class="btn btn-outline-light btn-lg" asp-page="/Auth/Login">Entrar</a><a class="btn btn-light btn-lg" href="#como-funciona">Ver como funciona</a></div></div><div class="col-lg-5"><div class="of-public-card p-4"><span class="of-badge">PDF premium</span><h2 class="h3 mt-3">Documento #000123</h2><p class="text-muted">Cliente: Maria Souza</p><div class="d-flex justify-content-between border-top pt-3"><strong>Total</strong><strong class="text-success">R$ 1.290,00</strong></div></div></div></div></div></section>
<section id="como-funciona" class="of-section bg-white text-dark"><div class="container"><h2 class="fw-black">Como funciona</h2><div class="row g-3 mt-3">@foreach(var x in new[]{"Preencha os dados","Gere o PDF","Envie para o cliente"}){<div class="col-md-4"><div class="of-feature"><h3 class="h5">@x</h3><p>Fluxo guiado, responsivo e pronto para celular.</p></div></div>}</div></div></section>
<section class="of-section"><div class="container"><div class="of-public-card p-4 p-lg-5"><h2>Para quem é</h2><p>Eletricistas, pintores, pedreiros, diaristas, técnicos, designers, fotógrafos, manicures e prestadores de serviço em geral.</p><div class="row g-3 mt-3"><div class="col-md-6"><h3 class="h5">Benefícios</h3><ul><li>Passa mais confiança</li><li>Economiza tempo e organiza histórico</li><li>Funciona no celular</li><li>Recibo com valor por extenso</li><li>Aprovação pública de orçamento quando habilitada</li></ul></div><div class="col-md-6"><h3 class="h5">Planos</h3><div class="row g-3"><div class="col-sm-6"><div class="of-feature"><strong>Free</strong><h4>R$ 0</h4><p>PDF com marca OrçaFácil e limite mensal configurável.</p></div></div><div class="col-sm-6"><div class="of-feature border border-primary"><strong>Pro</strong><h4>R$ 19,90/mês</h4><p>PDF sem marca, documentos ilimitados e histórico completo.</p></div></div></div></div></div><div class="text-center mt-4"><a class="btn btn-success btn-lg" asp-page="/Auth/Register">Comece grátis e gere seu primeiro orçamento agora.</a></div></div></div></section>
