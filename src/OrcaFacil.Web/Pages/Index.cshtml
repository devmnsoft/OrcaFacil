@page
@using OrcaFacil.Web.ViewModels.Components
@{ Layout = "/Pages/Shared/_PublicLayout.cshtml"; ViewData["Title"] = "Início"; }
<section class="of-hero"><div class="container"><div class="row g-5 align-items-center"><div class="col-lg-7 text-white"><span class="of-badge bg-white text-primary mb-3">Um produto MNSOFT</span><h1>Orçamentos e recibos profissionais sem complicar sua rotina.</h1><p class="lead text-white-75 mt-3">O OrçaFácil guia autônomos, MEIs e pequenos prestadores para criar PDFs claros, numerados e prontos para enviar ao cliente em poucos minutos.</p><div class="d-flex gap-2 flex-wrap mt-4"><a class="btn btn-success btn-lg" asp-page="/Auth/Register">Começar grátis</a><a class="btn btn-light btn-lg" href="#como-funciona">Ver como funciona</a></div><div class="of-trust-row mt-4"><span>PDF profissional</span><span>Histórico organizado</span><span>Funciona no celular</span></div></div><div class="col-lg-5"><img class="of-illustration mb-3" src="/img/illustrations/landing-budget-flow.svg" alt="Fluxo de orçamento em PDF" /><div class="of-mock-budget of-premium-card"><strong>Orçamento Nº 000123</strong><p class="text-muted">Cliente: Maria Souza</p><div class="of-mock-row"><span>Instalação elétrica residencial</span><strong>R$ 850,00</strong></div><div class="of-mock-row"><span>Materiais e acabamento</span><strong>R$ 240,00</strong></div><div class="of-total-pill"><span>Total</span><strong>R$ 1.090,00</strong></div></div></div></div></div></section>
<section class="of-section of-section-light"><div class="container"><div class="of-section-heading"><p class="of-eyebrow">O que é</p><h2>Uma plataforma simples para documentos profissionais.</h2><p>O OrçaFácil é uma plataforma simples para criar orçamentos e recibos profissionais em PDF. Você informa seus dados, o cliente, os serviços e os valores. O sistema organiza tudo em um documento claro, bonito e pronto para enviar.</p><p>Em vez de enviar valores soltos por WhatsApp, papel ou mensagens improvisadas, você envia um documento profissional, numerado e fácil de entender.</p><p><strong>Isso ajuda o cliente a confiar mais no seu trabalho e ajuda você a manter tudo organizado.</strong></p></div></div></section>
<section id="recursos" class="of-section of-section-light"><div class="container"><div class="of-section-heading mb-4"><p class="of-eyebrow">Recursos</p><h2>O que você consegue fazer?</h2></div><div class="row g-3">@foreach (var f in new[] { ("bi-file-earmark-plus", "Criar orçamento", "Monte propostas com cliente, itens, condições e total automático."), ("bi-receipt", "Criar recibo", "Emita comprovantes quando o pagamento já foi recebido."), ("bi-filetype-pdf", "Gerar PDF", "Baixe documentos profissionais."), ("bi-clock-history", "Organizar histórico", "Encontre, edite e gere novamente quando precisar."), ("bi-link-45deg", "Aprovação pública", "Compartilhe um link para o cliente aprovar."), ("bi-patch-check", "Plano Pro sem marca", "Evolua para PDFs sem marca OrçaFácil.") }) {<div class="col-md-6 col-lg-4"><div class="of-feature of-feature-premium"><i class="bi @f.Item1 fs-3 text-primary"></i><h3 class="h5 mt-3">@f.Item2</h3><p>@f.Item3</p></div></div>}</div></div></section>
<section id="como-funciona" class="of-section of-section-dark"><div class="container"><div class="of-section-heading mb-4"><p class="of-eyebrow of-on-dark-muted">Como funciona</p><h2>O sistema conduz você em 5 passos.</h2><p>Menos tela em branco, mais velocidade para vender.</p></div><div class="row g-3">@foreach(var step in new[]{("1","Cadastre seus dados","Esses dados aparecem no cabeçalho dos seus PDFs, como nome, telefone, cidade e Pix.","bi-person-badge"),("2","Cadastre ou informe o cliente","Você pode preencher na hora ou salvar clientes para usar de novo.","bi-person-check"),("3","Adicione serviços e valores","Digite manualmente ou use serviços salvos no catálogo.","bi-list-check"),("4","Revise o total","O sistema calcula subtotal, desconto e total do orçamento.","bi-calculator"),("5","Gere o PDF","Baixe o documento e envie ao cliente por WhatsApp, e-mail ou outro canal.","bi-filetype-pdf")}){<div class="col-md-6 col-lg"><partial name="Partials/_StepCard" model='new StepCardViewModel { Number=step.Item1, Title=step.Item2, Text=step.Item3, Icon=step.Item4 }' /></div>}</div><a class="btn btn-light mt-4" asp-page="/Auth/Register">Começar agora</a></div></section>
<section class="of-section of-section-light"><div class="container"><div class="row g-4 align-items-center"><div class="col-lg-5"><p class="of-eyebrow">Exemplo visual</p><h2>Seu cliente entende o valor na primeira leitura.</h2><p>Documento numerado, itens claros, total em destaque, condições e PDF pronto para enviar.</p></div><div class="col-lg-7"><img class="of-illustration" src="/img/illustrations/landing-client-approval.svg" alt="Cliente aprovando orçamento" /></div></div></div></section>
<section class="of-section of-section-light"><div class="container"><div class="of-section-heading mb-4"><p class="of-eyebrow">Para quem é</p><h2>Feito para pequenos prestadores de serviço.</h2><p>Cards claros, com ícones contextuais e texto legível em fundo claro.</p></div><div class="row g-3">@foreach(var job in new[]{new ProfessionCardViewModel{Title="Eletricistas",Description="Instalações e revisões",Icon="bi-lightning-charge",SvgName="profession-electrician.svg"},new ProfessionCardViewModel{Title="Pintores",Description="Paredes e acabamento",Icon="bi-brush",SvgName="profession-painter.svg"},new ProfessionCardViewModel{Title="Pedreiros",Description="Reformas e reparos",Icon="bi-bricks",SvgName="profession-builder.svg"},new ProfessionCardViewModel{Title="Diaristas",Description="Limpeza e organização",Icon="bi-house-heart",SvgName="profession-cleaner.svg"},new ProfessionCardViewModel{Title="Técnicos",Description="Visita e manutenção",Icon="bi-tools",SvgName="profession-technician.svg"},new ProfessionCardViewModel{Title="Designers",Description="Artes e identidade visual",Icon="bi-vector-pen",SvgName="profession-designer.svg"},new ProfessionCardViewModel{Title="Fotógrafos",Description="Ensaios e eventos",Icon="bi-camera",SvgName="profession-photographer.svg"},new ProfessionCardViewModel{Title="Manicure/Beleza",Description="Atendimento e estética",Icon="bi-stars",SvgName="profession-beauty.svg"}}){<div class="col-6 col-md-4 col-lg-3"><partial name="Partials/_ProfessionCard" model="job" /></div>}</div></div></section>
<section class="of-section of-section-light"><div class="container"><div class="of-section-heading mb-4"><p class="of-eyebrow">Modelos</p><h2>Comece mais rápido com modelos por profissão.</h2><p>Escolha seu tipo de serviço e use sugestões de itens comuns para montar o orçamento com mais rapidez.</p></div><div class="row g-3">@foreach(var m in new[]{("Eletricista","Instalação de tomada; Troca de disjuntor; Revisão elétrica","11111111-1111-1111-1111-111111111111"),("Pintor","Pintura de parede; Massa corrida; Acabamento","22222222-2222-2222-2222-222222222222"),("Pedreiro","Reforma; Assentamento; Reparos","33333333-3333-3333-3333-333333333333"),("Técnico","Visita técnica; Diagnóstico; Manutenção","44444444-4444-4444-4444-444444444444"),("Designer","Arte para redes sociais; Logotipo; Identidade visual","55555555-5555-5555-5555-555555555555"),("Fotógrafo","Ensaio; Edição; Entrega digital","66666666-6666-6666-6666-666666666666"),("Diarista","Limpeza; Organização; Pós-obra","77777777-7777-7777-7777-777777777777"),("Manicure/Beleza","Atendimento; Acabamento; Cuidados extras","88888888-8888-8888-8888-888888888888")}){<div class="col-md-6 col-lg-3"><article class="of-card h-100"><h3 class="h5">@m.Item1</h3><ul>@foreach(var x in m.Item2.Split(';')){<li>@x.Trim()</li>}</ul><a class="btn btn-outline-primary" href="/Documents/CreateBudget?templateId=@m.Item3">Usar modelo</a></article></div>}</div></div></section>
<section class="of-section of-section-light"><div class="container"><div class="of-section-heading mb-4"><p class="of-eyebrow">Planos</p><h2>Comece grátis. Evolua quando quiser.</h2></div><div class="row g-4"><div class="col-md-6"><div class="of-price-card"><span class="of-badge">Free</span><h3>Comece grátis</h3><ul><li>PDF com marca OrçaFácil</li><li>Ideal para testar</li><li>Use de imediato</li></ul><a class="btn btn-outline-primary" asp-page="/Auth/Register">Criar conta grátis</a></div></div><div class="col-md-6"><div class="of-price-card pro"><span class="of-badge status-pro">Pro</span><h3>Mais profissional</h3><ul><li>PDF sem marca</li><li>Histórico completo</li><li>Suporte MNSOFT</li></ul><a class="btn btn-primary" asp-page="/Precos">Conhecer Pro</a></div></div></div></div></section>
<section class="of-section of-section-dark"><div class="container"><div class="of-section-heading mb-4"><p class="of-eyebrow of-on-dark-muted">Perguntas rápidas</p><h2>Dúvidas comuns antes de começar</h2></div><div class="row g-3"><div class="col-md-4"><div class="of-card"><h3 class="h5">Emite nota fiscal?</h3><p>Não. O foco é orçamento e recibo profissional em PDF.</p></div></div><div class="col-md-4"><div class="of-card"><h3 class="h5">Posso usar no celular?</h3><p>Sim, a jornada é responsiva para uso diário.</p></div></div><div class="col-md-4"><div class="of-card"><h3 class="h5">Posso alterar modelo?</h3><p>Sim. O modelo só preenche sugestões iniciais.</p></div></div></div><div class="of-cta-band mt-5"><div><h2>Criar meu primeiro orçamento grátis</h2><p>Transforme seu atendimento em poucos minutos.</p></div><a class="btn btn-success" asp-page="/Auth/Register">Criar meu primeiro orçamento grátis</a></div></div></section>
