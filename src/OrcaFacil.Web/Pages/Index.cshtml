@page
@{ Layout = "/Pages/Shared/_PublicLayout.cshtml"; ViewData["Title"] = "Orçamentos profissionais"; }
<section class="of-landing-hero">
  <div class="container"><div class="row g-5 align-items-center">
    <div class="col-lg-7"><p class="of-eyebrow of-on-dark-muted">Simples para trabalhar. Profissional para apresentar.</p><h1>Orçamentos e recibos com a apresentação que o seu trabalho merece.</h1><p class="lead mt-4">Organize seus clientes, prepare seus documentos e envie tudo de forma clara, mesmo pelo celular.</p><div class="d-flex flex-wrap gap-3 mt-4"><a class="btn btn-success btn-lg" asp-page="/Auth/Register"><svg class="of-icon" aria-hidden="true"><use href="/img/icons/orcafacil-icons.svg#icon-success"></use></svg> Criar minha conta grátis</a><a class="btn btn-light btn-lg" href="#como-funciona">Ver como funciona</a></div><div class="of-trust-row mt-4"><span>Sem cartão</span><span>PDF pronto para enviar</span><span>Seus dados organizados</span></div></div>
    <div class="col-lg-5"><img class="of-illustration" src="/img/illustrations/landing-budget.svg" alt="Fluxo com cliente, orçamento, PDF e envio" /></div>
  </div></div>
</section>
<section id="como-funciona" class="of-landing-section"><div class="container"><p class="of-eyebrow">Do atendimento ao envio</p><h2>Seu documento pronto em quatro passos.</h2><div class="row g-3 mt-3">
@foreach (var step in new[]{("1","Cadastre o cliente","Guarde os dados uma vez e reutilize."),("2","Informe o serviço","Descreva o trabalho e os valores."),("3","Revise o documento","Confira itens, condições e total."),("4","Gere e envie","Baixe o PDF e compartilhe com o cliente.")}) { <div class="col-md-6 col-lg-3"><article class="of-step-card"><span>@step.Item1</span><h3 class="h5 mt-3">@step.Item2</h3><p>@step.Item3</p></article></div> }
</div></div></section>
<section class="of-landing-section"><div class="container"><p class="of-eyebrow">Mais clareza na rotina</p><h2>Organização que acompanha o seu trabalho.</h2><div class="of-benefit-grid mt-4">
@foreach (var benefit in new[]{("client","Seus dados organizados"),("document","Documentos com sua identidade"),("activity","Histórico sempre à mão"),("success","Aprovação clara"),("dashboard","Funciona no celular")}) { <article class="of-card"><svg class="of-icon of-icon-lg text-primary" aria-hidden="true"><use href="/img/icons/orcafacil-icons.svg#icon-@benefit.Item1"></use></svg><h3 class="h6 mt-3">@benefit.Item2</h3></article> }
</div></div></section>
<section class="of-final-cta"><div class="container"><div class="of-action-card"><span class="of-action-card__icon"><svg class="of-icon of-icon-lg" aria-hidden="true"><use href="/img/icons/orcafacil-icons.svg#icon-budget"></use></svg></span><div class="flex-grow-1"><h2>Crie seu primeiro orçamento grátis.</h2><p>Transforme seu atendimento em poucos minutos.</p></div><a class="btn btn-success btn-lg" asp-page="/Auth/Register">Criar minha conta grátis</a></div></div></section>
