@page "/Trust/{section?}"
@{Layout="/Pages/Shared/_PublicLayout.cshtml";ViewData["Title"]="Central de confiança";ViewData["Description"]="Informações públicas e verificáveis sobre segurança, privacidade e governança do OrçaFácil.";}
<section class="of-public-hero of-commercial-hero"><div class="of-container"><span class="of-eyebrow">Trust Center</span><h1>Confiança exige transparência</h1><p>Conheça controles do produto sem exposição de infraestrutura, credenciais ou detalhes operacionais sensíveis.</p><a class="of-button of-button-primary" asp-page="/Seguranca">Ver segurança</a></div></section><section class="of-public-section"><div class="of-container"><div class="of-feature-grid"><article><h2>Privacidade e LGPD</h2><p>Finalidade, direitos do titular e canais estão descritos nas páginas públicas.</p><a asp-page="/LGPD">Consultar</a></article><article><h2>Controle e auditoria</h2><p>Permissões protegem ações e operações sensíveis suportam rastreabilidade.</p></article><article><h2>Disponibilidade</h2><p>A página de status usa verificações reais da aplicação, sem métricas inventadas.</p><a asp-page="/Status">Ver status</a></article></div><p>Certificações ou subprocessadores não são anunciados sem documentação pública validada.</p></div></section>
