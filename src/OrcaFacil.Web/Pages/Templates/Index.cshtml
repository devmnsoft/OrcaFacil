@page
@model OrcaFacil.Web.Pages.Templates.IndexModel
@{ ViewData["Title"] = "Modelos"; }
<header class="of-page-header"><div><p class="of-eyebrow">Modelos prontos</p><h1>Modelos por profissão</h1><p>Escolha sugestões de itens comuns, revise os valores e gere um orçamento profissional mais rápido.</p></div><a class="of-button of-button-primary" asp-page="/Documents/New">Orçamento em branco</a></header>
<div class="of-cluster g-3">
@foreach (var t in Model.Templates)
{
    <div ><article class="of-card h-100"><p class="of-eyebrow">@t.Profession</p><h2 class="h5">@t.Title</h2><p>@t.Description</p><ul>@foreach (var item in t.Items.OrderBy(i=>i.SortOrder).Take(3)){<li>@item.Description</li>}</ul><div class="gap-2"><a class="of-button of-button-primary" asp-page="/Documents/New" asp-route-templateId="@t.Id">Usar este modelo</a><a class="of-button of-button-secondary" asp-page="/Templates/Details" asp-route-id="@t.Id">Ver detalhes</a></div></article></div>
}
</div>
