@page "{id:guid}"
@model OrcaFacil.Web.Pages.Templates.DetailsModel
@{ ViewData["Title"] = Model.Template?.Title ?? "Detalhes do modelo"; }

@if (TempData["Success"] is string success) { <div class="of-feedback of-feedback-success" role="status">@success</div> }
@if (TempData["Error"] is string error) { <div class="of-feedback of-feedback-error" role="alert">@error</div> }

@if (Model.Template is not null)
{
    var t = Model.Template;
    <header class="of-page-header">
        <div>
            <p class="of-eyebrow">@t.Profession · @(t.IsSystemTemplate ? "Modelo do OrçaFácil" : "Modelo da Conta")</p>
            <h1>@t.Title</h1>
            <p>@t.Description</p>
        </div>
        <div style="display:flex; gap:0.5rem; align-items:center;">
            <form method="post" action="@Url.Page("/Documents/CreateBudget", "Create")">
                @Html.AntiForgeryToken()
                <input type="hidden" name="templateId" value="@t.Id" />
                <input type="hidden" name="idempotencyKey" value="@Guid.NewGuid().ToString("N")" />
                <button class="of-button of-button-primary" type="submit" disabled="@(!t.IsActive)">Usar este modelo</button>
            </form>
            <a class="of-button of-button-secondary" asp-page="/Templates/Index">Voltar aos modelos</a>
        </div>
    </header>

    <div class="of-cluster g-4" style="align-items:flex-start;">
        <div style="flex:2; min-width:320px;">
            <section class="of-card mb-4">
                <div class="of-section-heading">
                    <div>
                        <p class="of-eyebrow">Estrutura comercial</p>
                        <h2 class="h4">Itens inclusos no modelo</h2>
                    </div>
                    <span>@t.Items.Count item(ns)</span>
                </div>
                <div class="of-responsive-table">
                    <table class="of-table">
                        <thead>
                            <tr>
                                <th>Descrição</th>
                                <th>Qtd.</th>
                                <th>Un.</th>
                                <th>Unitário</th>
                                <th>Desconto</th>
                                <th>Total</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in t.Items.OrderBy(i => i.SortOrder))
                            {
                                var lineTotal = (item.Quantity * item.UnitPrice) - item.Discount;
                                <tr>
                                    <td><strong>@item.Description</strong></td>
                                    <td>@item.Quantity</td>
                                    <td>@item.Unit</td>
                                    <td>@item.UnitPrice.ToString("C")</td>
                                    <td>@(item.Discount > 0 ? item.Discount.ToString("C") : "—")</td>
                                    <td>@lineTotal.ToString("C")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </section>

            <section class="of-card">
                <h2 class="h4 mb-3">Condições e Termos Comerciais</h2>
                <dl class="of-document-summary" style="grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));">
                    <div>
                        <dt>Forma de pagamento padrão</dt>
                        <dd>@(string.IsNullOrWhiteSpace(t.PaymentMethod) ? "Não definida" : t.PaymentMethod)</dd>
                    </div>
                    <div>
                        <dt>Desconto geral no modelo</dt>
                        <dd>@(t.Discount > 0 ? t.Discount.ToString("C") : "Nenhum")</dd>
                    </div>
                </dl>
                @if (!string.IsNullOrWhiteSpace(t.ConditionsText))
                {
                    <div style="margin-top:1rem;">
                        <strong>Condições comerciais:</strong>
                        <p style="white-space:pre-wrap; margin-top:0.25rem; font-size:0.875rem;">@t.ConditionsText</p>
                    </div>
                }
                @if (!string.IsNullOrWhiteSpace(t.WarrantyText))
                {
                    <div style="margin-top:1rem;">
                        <strong>Termos de garantia:</strong>
                        <p style="white-space:pre-wrap; margin-top:0.25rem; font-size:0.875rem;">@t.WarrantyText</p>
                    </div>
                }
                <p class="of-security-note" style="margin-top:1rem;">
                    <span>Ao iniciar um orçamento por este modelo, uma cópia independente é gerada. Clientes, preços finais e condições podem ser alterados livremente sem afetar o modelo original.</span>
                </p>
            </section>
        </div>

        @if (Model.CanEdit)
        {
            <div style="flex:1; min-width:300px;">
                <section class="of-card">
                    <h2 class="h4 mb-3">Editar modelo</h2>
                    <form method="post" asp-page-handler="Update" asp-route-id="@t.Id">
                        @Html.AntiForgeryToken()
                        <div class="mb-3">
                            <label class="of-field">
                                <span>Nome do modelo *</span>
                                <input type="text" asp-for="Title" required class="of-input" />
                            </label>
                        </div>
                        <div class="mb-3">
                            <label class="of-field">
                                <span>Descrição resumida</span>
                                <textarea asp-for="Description" rows="2" class="of-input"></textarea>
                            </label>
                        </div>
                        <div class="mb-3">
                            <label class="of-field">
                                <span>Forma de pagamento padrão</span>
                                <input type="text" asp-for="PaymentMethod" class="of-input" placeholder="Ex: 50% entrada + 50% entrega" />
                            </label>
                        </div>
                        <div class="mb-3">
                            <label class="of-field">
                                <span>Desconto geral padrão (R$)</span>
                                <input type="number" step="0.01" min="0" asp-for="Discount" class="of-input" />
                            </label>
                        </div>
                        <div class="mb-3">
                            <label class="of-field">
                                <span>Condições comerciais</span>
                                <textarea asp-for="ConditionsText" rows="3" class="of-input"></textarea>
                            </label>
                        </div>
                        <div class="mb-3">
                            <label class="of-field">
                                <span>Garantia</span>
                                <textarea asp-for="WarrantyText" rows="2" class="of-input"></textarea>
                            </label>
                        </div>
                        <div style="display:flex; flex-direction:column; gap:0.5rem; margin-top:1rem;">
                            <button class="of-button of-button-primary" type="submit">Salvar alterações</button>
                        </div>
                    </form>

                    <div style="margin-top:1.5rem; border-top:1px solid var(--of-border, #e2e8f0); padding-top:1rem;">
                        <form method="post" asp-page-handler="ToggleActive" asp-route-id="@t.Id">
                            @Html.AntiForgeryToken()
                            <button class="of-button of-button-secondary" type="submit" style="width:100%;">
                                @(t.IsActive ? "Inativar este modelo" : "Ativar este modelo")
                            </button>
                        </form>
                    </div>
                </section>
            </div>
        }
    </div>
}
