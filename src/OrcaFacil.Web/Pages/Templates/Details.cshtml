@page "{id:guid?}"
@model OrcaFacil.Web.Pages.Templates.DetailsModel
@{ ViewData["Title"] = "Detalhes do modelo"; }
@if (Model.Template is not null) {<header class="of-page-header"><div><p class="of-eyebrow">@Model.Template.Profession</p><h1>@Model.Template.Title</h1><p>@Model.Template.Description</p></div><a class="of-button of-button-primary" asp-page="/Documents/New" asp-route-templateId="@Model.Template.Id">Usar este modelo</a></header><section class="of-card"><h2 class="h4">Itens sugeridos</h2><div class="of-responsive-table"><table class="of-table"><thead><tr><th>Descrição</th><th>Qtd.</th><th>Un.</th><th>Valor</th></tr></thead><tbody>@foreach(var item in Model.Template.Items.OrderBy(i=>i.SortOrder)){<tr><td>@item.Description</td><td>@item.Quantity</td><td>@item.Unit</td><td>@item.UnitPrice.ToString("C")</td></tr>}</tbody></table></div><p class="of-security-note"><span>Você pode alterar itens, quantidades e valores antes de salvar.</span></p></section>}
