@page
@model OrcaFacil.Web.Pages.Notifications.IndexModel
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@{
    ViewData["Title"] = "Notificações";
}

<header class="of-page-header">
    <div>
        <p class="of-eyebrow">Central de atividade</p>
        <h1>Notificações</h1>
        <p>Acompanhe avisos de conta, cobrança, documentos, suporte, sistema e plano.</p>
    </div>
    @if (Model.UnreadCount > 0)
    {
        <form method="post" asp-page-handler="MarkAllAsRead">
            @Html.AntiForgeryToken()
            <button type="submit" class="of-button of-button-secondary">Marcar todas como lidas</button>
        </form>
    }
</header>

<section class="of-card">
    @if (!Model.Items.Any())
    {
        <div class="of-empty"><div class="of-empty-icon">🔔</div><h2 class="h5">Nenhuma notificação ainda</h2><p>Quando houver avisos importantes, eles aparecerão aqui.</p></div>
    }
    else
    {
        <div class="list-group list-group-flush">
            @foreach (var item in Model.Items)
            {
                var badge = item.Type switch { "Success" => "text-bg-success", "Warning" => "text-bg-warning", "Danger" => "text-bg-danger", _ => "text-bg-info" };
                <article class="list-group-item gap-3 align-items-start @(item.IsRead ?"opacity-75" : "")">
                    <span class="of-badge @badge">@item.Type</span>
                    <div class="flex-grow-1">
                        <div class="justify-content-between gap-3"><h2 class="h6">@item.Title</h2><small>@item.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</small></div>
                        <p >@item.Message</p>
                        <span class="of-badge border">@item.Category</span>
                        @if (!string.IsNullOrWhiteSpace(item.ActionUrl))
                        {
                            <a class="of-button of-button-secondary" href="@item.ActionUrl">@(item.ActionText ?? "Abrir")</a>
                        }
                    </div>
                    @if (!item.IsRead)
                    {
                        <form method="post" asp-page-handler="MarkAsRead" asp-route-id="@item.Id">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="of-button of-button-secondary">Marcar como lida</button>
                        </form>
                    }
                </article>
            }
        </div>
    }
</section>
