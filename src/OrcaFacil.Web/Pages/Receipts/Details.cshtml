@page "{id:guid}"
@model OrcaFacil.Web.Pages.Receipts.DetailsModel
@section Styles { <link rel="stylesheet" href="~/css/billing.css" asp-append-version="true" /> }
@using OrcaFacil.Domain.Enums
@{
    ViewData["Title"] = "Recibo";
}

<main class="of-finance-page">
    <header class="of-finance-header">
        <div>
            <p class="of-eyebrow">Financeiro</p>
            <h1>@Model.Receipt?.Number</h1>
            <p>Comprovante persistido e isolado na conta ativa.</p>
        </div>
        <a class="of-button" asp-page="Index">Todos os recibos</a>
    </header>

    @if (Model.Receipt is not null)
    {
        <div class="receipt-detail-grid">
            <article class="receipt-document @(Model.Receipt.CancelledAt.HasValue ? "is-cancelled" : null)">
                <p class="receipt-brand">ORÇAFÁCIL</p>
                <h2>Recibo de pagamento</h2>
                @if (Model.Receipt.CancelledAt.HasValue)
                {
                    <strong class="receipt-cancelled">CANCELADO</strong>
                }
                <p class="receipt-value">@Model.Receipt.Amount.ToString("C")</p>
                <p>@Model.Receipt.AmountInWords</p>
                <p>Recebemos de <strong>@Model.Client?.Name</strong>, referente a @Model.Receipt.ServiceDescription.</p>
                <dl>
                    <div><dt>Pagamento</dt><dd>@PaymentMethodCodes.ToDisplayLabel(Model.Receipt.PaymentMethod)</dd></div>
                    <div><dt>Emissão</dt><dd>@Model.Receipt.IssuedAt.ToLocalTime().ToString("dd/MM/yyyy")</dd></div>
                    <div><dt>Origem</dt><dd>@Model.Receipt.OriginType</dd></div>
                </dl>
                <p class="receipt-signature">Assinatura do emitente</p>
                <small>@Model.Receipt.FiscalNotice</small>
            </article>
            <aside class="receipt-actions">
                <h2>Ações</h2>
                @if (!Model.Receipt.CancelledAt.HasValue)
                {
                    <form method="post" asp-page-handler="Share">
                        <button type="submit" class="of-button of-button--primary">Registrar compartilhamento</button>
                    </form>
                    <a class="of-button" href="@Model.WhatsAppShareUrl" rel="noopener noreferrer">WhatsApp</a>
                    <form method="post" asp-page-handler="Cancel">
                        <label>
                            Motivo do cancelamento
                            <textarea asp-for="CancellationReason" required></textarea>
                        </label>
                        <button type="submit" class="of-button of-button--danger">Cancelar recibo</button>
                    </form>
                }
                else
                {
                    <p>Cancelado em @Model.Receipt.CancelledAt.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm"). O histórico foi preservado.</p>
                }
            </aside>
        </div>
    }
</main>
