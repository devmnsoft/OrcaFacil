@page "{id:guid}"
@model OrcaFacil.Web.Pages.Receipts.DetailsModel
@{ ViewData["Title"] = "Recibo"; }
<main class="of-page-shell"><header class="of-page-header"><div><p class="of-eyebrow">Financeiro</p><h1>@Model.Receipt?.Number</h1><p>Comprovante persistido e isolado na conta ativa.</p></div><a class="of-button" asp-page="Index">Todos os recibos</a></header>
@if(Model.Receipt is not null){<div class="receipt-detail-grid"><article class="receipt-document @(Model.Receipt.CancelledAt.HasValue ? "is-cancelled" : "")"><p class="receipt-brand">ORÇAFÁCIL</p><h2>Recibo de pagamento</h2>@if(Model.Receipt.CancelledAt.HasValue){<strong class="receipt-cancelled">CANCELADO</strong>}<p class="receipt-value">@Model.Receipt.Amount.ToString("C")</p><p>@Model.Receipt.AmountInWords</p><p>Recebemos de <strong>@Model.Client?.Name</strong>, referente a @Model.Receipt.ServiceDescription.</p><dl><div><dt>Pagamento</dt><dd>@Model.Receipt.PaymentMethod</dd></div><div><dt>Emissão</dt><dd>@Model.Receipt.IssuedAt.ToLocalTime().ToString("dd/MM/yyyy")</dd></div><div><dt>Origem</dt><dd>@Model.Receipt.OriginType</dd></div></dl><p class="receipt-signature">Assinatura do emitente</p><small>@Model.Receipt.FiscalNotice</small></article><aside class="receipt-actions"><h2>Ações</h2>@if(!Model.Receipt.CancelledAt.HasValue){<form method="post" asp-page-handler="Share"><button class="of-button of-button--primary">Registrar compartilhamento</button></form><a class="of-button" href="https://wa.me/?text=@Uri.EscapeDataString($"Olá, {Model.Client?.Name}. Segue o recibo {Model.Receipt.Number}, referente a {Model.Receipt.ServiceDescription}, no valor de {Model.Receipt.Amount:C}.")">WhatsApp</a><form method="post" asp-page-handler="Cancel"><label>Motivo do cancelamento<textarea asp-for="CancellationReason" required></textarea></label><button class="of-button of-button--danger">Cancelar recibo</button></form>}else{<p>Cancelado em @Model.Receipt.CancelledAt.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm"). O histórico foi preservado.</p>}</aside></div>}</main>
<style>.receipt-detail-grid{display:grid;grid-template-columns:minmax(0,2fr) minmax(260px,1fr);gap:1.5rem}.receipt-document,.receipt-actions{background:#fff;border:1px solid #dce5e1;border-radius:18px;padding:2rem}.receipt-brand{color:#087443;font-weight:800;letter-spacing:.12em}.receipt-value{font-size:2.2rem;font-weight:800}.receipt-document dl div{display:flex;justify-content:space-between;border-top:1px solid #e2e8f0;padding:.7rem}.receipt-signature{border-top:1px solid;margin-top:4rem;padding-top:.5rem;text-align:center}.receipt-actions{display:flex;flex-direction:column;gap:1rem;height:max-content}.receipt-actions form,.receipt-actions label{display:grid;gap:.5rem}.receipt-actions textarea{padding:.7rem;border:1px solid #cbd5e1;border-radius:8px}.receipt-cancelled{display:inline-block;color:#b42318;border:2px solid;padding:.4rem;transform:rotate(-4deg)}.is-cancelled{opacity:.78}@media(max-width:760px){.receipt-detail-grid{grid-template-columns:1fr}}</style>
