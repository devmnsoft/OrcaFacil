@page
@model OrcaFacil.Web.Pages.Receipts.IndexModel
@{ViewData["Title"]="Recibos";}
<main class="of-page-shell"><header class="of-page-header"><div><p class="of-eyebrow">Financeiro</p><h1>Recibos</h1><p>Emissões, compartilhamentos e cancelamentos em um só lugar.</p></div><a class="of-button of-button--primary" asp-page="Create">Novo recibo</a></header><form method="get" class="receipt-filters"><input name="from" type="date" aria-label="Data inicial"/><input name="to" type="date" aria-label="Data final"/><select name="method"><option value="">Todos os métodos</option><option>Pix</option><option>Dinheiro</option><option>Transferência</option><option>Cartão</option><option>Boleto</option></select><button>Filtrar</button></form><div class="receipt-list">@foreach(var receipt in Model.Receipts){<a asp-page="Details" asp-route-id="@receipt.Id"><strong>@receipt.Number</strong><span>@receipt.OriginType</span><span>@receipt.Amount.ToString("C")</span><span>@receipt.PaymentMethod · @receipt.IssuedAt.ToLocalTime().ToString("dd/MM/yyyy")</span><em>@(receipt.CancelledAt.HasValue?"Cancelado":receipt.LastSharedAt.HasValue?"Compartilhado":"Emitido")</em></a>}</div></main>
<style>.receipt-filters{display:flex;gap:.6rem;flex-wrap:wrap;margin:1rem 0}.receipt-filters input,.receipt-filters select,.receipt-filters button{padding:.7rem;border:1px solid #cbd5e1;border-radius:9px;background:#fff}.receipt-list{display:grid;gap:.5rem}.receipt-list a{display:grid;grid-template-columns:1.2fr .8fr .7fr 1.2fr .7fr;gap:1rem;align-items:center;padding:1rem;background:#fff;border:1px solid #e2e8f0;border-radius:12px;color:inherit;text-decoration:none}.receipt-list em{font-style:normal;color:#087443}@media(max-width:760px){.receipt-list a{grid-template-columns:1fr 1fr}.receipt-list strong{grid-column:1/-1}}</style>
