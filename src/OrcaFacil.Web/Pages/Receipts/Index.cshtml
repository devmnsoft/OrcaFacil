@page
@model OrcaFacil.Web.Pages.Receipts.IndexModel
@using OrcaFacil.Domain.Enums
@{
    ViewData["Title"] = "Recibos";
}

<main class="of-finance-page">
    <header class="of-finance-header">
        <div>
            <p class="of-eyebrow">Financeiro</p>
            <h1>Recibos</h1>
            <p>Emissões, compartilhamentos e cancelamentos em um só lugar.</p>
        </div>
        <a class="of-button of-button--primary" asp-page="Create">Novo recibo</a>
    </header>

    <form method="get" class="receipt-filters">
        <label>De <input asp-for="From" type="date" /></label>
        <label>Até <input asp-for="To" type="date" /></label>
        <label>
            Método
            <select asp-for="PaymentMethod">
                <option value="">Todos</option>
                <option value="pix">Pix</option>
                <option value="cash">Dinheiro</option>
                <option value="transfer">Transferência</option>
                <option value="card">Cartão</option>
                <option value="boleto">Boleto</option>
                <option value="other">Outro</option>
            </select>
        </label>
        <label>Ordenação<select asp-for="Sort"><option value="recent">Mais recentes</option><option value="oldest">Mais antigos</option><option value="amount_desc">Maior valor</option><option value="amount_asc">Menor valor</option><option value="client">Cliente</option></select></label>
        <label>Valor mínimo <input asp-for="MinimumAmount" type="number" min="0" step="0.01" /></label>
        <label>Valor máximo <input asp-for="MaximumAmount" type="number" min="0" step="0.01" /></label>
        <label>
            Situação
            <select asp-for="Status">
                <option value="">Todas</option>
                <option value="active">Emitido</option>
                <option value="cancelled">Cancelado</option>
            </select>
        </label>
        <button class="of-button" type="submit">Filtrar</button>
        <a class="of-button" asp-page="Index">Limpar</a>
    </form>

    @if (Model.Receipts.Count == 0)
    {
        <section class="of-finance-empty"><h2>Nenhum recibo encontrado</h2><p>Revise os filtros ou emita um novo recibo.</p></section>
    }
    else
    {
        <div class="receipt-list">
            @foreach (var receipt in Model.Receipts)
            {
                <a asp-page="Details" asp-route-id="@receipt.Id">
                    <strong>@receipt.Number</strong>
                    <span>@receipt.ClientName · @receipt.OriginLabel</span>
                    <span>@receipt.Amount.ToString("C")</span>
                    <span>@receipt.PaymentMethodLabel · @receipt.IssuedAt.ToLocalTime().ToString("dd/MM/yyyy")</span>
                    <em>@receipt.StatusLabel</em>
                </a>
            }
        </div>
        <nav class="of-pagination" aria-label="Paginação de recibos">
            @if (Model.PageNumber > 1)
            {
                <a asp-all-route-data="@Model.GetRouteValues(Model.PageNumber - 1)">Anterior</a>
            }
            <span>Página @Model.PageNumber de @Model.TotalPages</span>
            @if (Model.PageNumber < Model.TotalPages)
            {
                <a asp-all-route-data="@Model.GetRouteValues(Model.PageNumber + 1)">Próxima</a>
            }
        </nav>
    }
</main>
