@page
@model OrcaFacil.Web.Pages.Receipts.CreateModel
@section Styles { <link rel="stylesheet" href="~/css/billing.css" asp-append-version="true" /> }
@using OrcaFacil.Domain.Enums
@{
    ViewData["Title"] = "Criar recibo";
}

<main class="receipt-create">
    <header class="receipt-create__header"><div><p class="of-eyebrow">Financeiro</p><h1>Criar recibo</h1><p>Registre o recebimento e emita um comprovante profissional.</p></div></header>
    <form method="post" class="receipt-create__grid" id="receipt-form">
        <input asp-for="Input.IdempotencyKey" type="hidden" />
        <div class="receipt-create__form">
            <div asp-validation-summary="ModelOnly" class="receipt-errors"></div>
            <section class="receipt-section">
                <div class="receipt-section__heading"><span>1</span><div><h2>Origem</h2><p>Escolha de onde vem este recebimento.</p></div></div>
                <div class="origin-options">
                    <label><input asp-for="Input.OriginType" type="radio" value="WorkOrder" /><strong>Ordem de serviço</strong><small>Vincule a uma entrega concluída.</small></label>
                    <label><input asp-for="Input.OriginType" type="radio" value="Budget" /><strong>Orçamento</strong><small>Registre o recebimento de uma proposta.</small></label>
                    <label><input asp-for="Input.OriginType" type="radio" value="Standalone" /><strong>Recebimento avulso</strong><small>Emita sem ordem ou orçamento.</small></label>
                </div>
                <div class="origin-dependent" data-origin="WorkOrder"><label>Ordem<select asp-for="Input.WorkOrderId" asp-items="Model.WorkOrders"><option value="">Selecione uma ordem</option></select></label></div>
                <div class="origin-dependent" data-origin="Budget"><label>Orçamento<select asp-for="Input.DocumentId" asp-items="Model.Budgets"><option value="">Selecione um orçamento</option></select></label></div>
            </section>
            <section class="receipt-section">
                <div class="receipt-section__heading"><span>2</span><div><h2>Cliente</h2><p>Somente clientes da conta ativa aparecem aqui.</p></div></div>
                <label>Cliente<select asp-for="Input.ClientId" asp-items="Model.Clients" data-preview="client"><option value="">Selecione um cliente</option></select><span asp-validation-for="Input.ClientId"></span></label>
                <a asp-page="/Clients/Create" class="receipt-link">Cadastrar novo cliente</a>
            </section>
            <section class="receipt-section">
                <div class="receipt-section__heading"><span>3</span><div><h2>Recebimento</h2><p>Dados do pagamento registrado manualmente.</p></div></div>
                <div class="receipt-fields"><label>Valor recebido<input asp-for="Input.Amount" type="number" min="0.01" step="0.01" data-preview="amount" /><span asp-validation-for="Input.Amount"></span></label><label>Data<input asp-for="Input.PaidAt" type="date" data-preview="date" /><span asp-validation-for="Input.PaidAt"></span></label></div>
                <fieldset><legend>Forma de pagamento</legend><div class="payment-options">
                    @foreach (var method in Model.PaymentMethods)
                    {
                        <label>
                            <input asp-for="Input.PaymentMethod" type="radio" value="@method.Code" />
                            <svg class="of-icon" aria-hidden="true"><use href="#of-icon-@method.IconName" /></svg>
                            <span>@method.Label</span>
                        </label>
                    }
                </div></fieldset>
                <label>Cidade<input asp-for="Input.City" maxlength="180" /></label>
                <p class="receipt-manual-notice">Este pagamento é registrado manualmente e não representa confirmação bancária automática.</p>
            </section>
            <section class="receipt-section">
                <div class="receipt-section__heading"><span>4</span><div><h2>Serviço</h2><p>Explique com clareza o motivo do recebimento.</p></div></div>
                <label>Descrição<textarea asp-for="Input.ServiceDescription" rows="3" data-preview="service"></textarea><span asp-validation-for="Input.ServiceDescription"></span></label>
                <label>Observações<textarea asp-for="Input.Notes" rows="3" data-preview="notes"></textarea></label>
            </section>
        </div>
        <aside class="receipt-preview" aria-label="Prévia do recibo">
            <div class="receipt-paper"><p class="receipt-paper__brand">ORÇAFÁCIL</p><p class="receipt-paper__number">RECIBO · número provisório</p><h2>Recibo de pagamento</h2><div class="receipt-paper__amount" data-output="amount">R$ 0,00</div><p>Recebemos de <strong data-output="client">cliente selecionado</strong> o valor acima referente a:</p><p data-output="service">descrição do serviço</p><dl><div><dt>Forma</dt><dd data-output="method">Pix</dd></div><div><dt>Data</dt><dd data-output="date">—</dd></div></dl><p class="receipt-paper__signature">Assinatura do emitente</p><small>Este recibo não substitui documento fiscal quando exigido.</small></div>
            <button class="receipt-submit" type="submit">Registrar e emitir recibo</button>
        </aside>
    </form>
</main>


@section Scripts {
    <script type="module"
            src="~/js/receipt-create.js"
            asp-append-version="true"></script>
}
