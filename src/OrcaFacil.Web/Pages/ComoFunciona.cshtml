@page
@{ Layout="/Pages/Shared/_PublicLayout.cshtml"; ViewData["Title"]="Como funciona"; }
<section class="of-hero of-hero-compact"><div class="container"><div class="row g-5 align-items-center"><div class="col-lg-7 text-white"><p class="of-eyebrow text-white-75">Guia simples</p><h1>Como o OrçaFácil funciona?</h1><p class="lead text-white-75">Da configuração inicial ao PDF enviado: veja a jornada completa para organizar orçamento, aprovação, recibo e histórico.</p><div class="d-flex gap-2 flex-wrap mt-4"><a class="btn btn-success" asp-page="/Auth/Register">Começar grátis agora</a><a class="btn btn-light" asp-page="/Index">Voltar para a página inicial</a></div></div><div class="col-lg-5"><img class="of-illustration" src="/img/illustrations/onboarding-budget-flow.svg" alt="Fluxo de criação de documentos no OrçaFácil" /></div></div></div></section>
<section class="of-section of-section-light"><div class="container"><div class="row g-4">
@foreach (var step in new[]{("1","Cadastre seus dados","Informe nome, CNPJ/CPF, telefone e e-mail para aparecerem no PDF.","bi-person-badge"),("2","Crie seu orçamento","Adicione cliente, serviços, quantidades, valores, descontos e validade.","bi-file-earmark-plus"),("3","Gere o PDF","O sistema monta um documento numerado, bonito e pronto para enviar.","bi-filetype-pdf"),("4","Envie ao cliente","Compartilhe o PDF ou o link público de aprovação do orçamento.","bi-send"),("5","Use o histórico","Localize documentos, edite, duplique, gere PDF novamente e acompanhe status.","bi-clock-history"),("6","Crie recibo ao receber","Registre pagamentos com recibos profissionais e organizados.","bi-receipt")}){<div class="col-md-6 col-lg-4"><partial name="Partials/_StepCard" model='new StepCardViewModel { Number=step.Item1, Title=step.Item2, Text=step.Item3, Icon=step.Item4 }' /></div>}
</div><div class="of-cta-band mt-5"><div><p class="of-eyebrow">Próximo passo</p><h2>Crie seu primeiro orçamento hoje.</h2><p>Comece grátis e envie um PDF mais profissional ao seu cliente.</p></div><a class="btn btn-primary" asp-page="/Auth/Register">Começar grátis</a></div></div></section><partial name="Partials/_MnsoftFooter" />
