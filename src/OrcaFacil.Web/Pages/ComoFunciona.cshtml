@page
@{ Layout="/Pages/Shared/_PublicLayout.cshtml"; ViewData["Title"]="Como funciona"; }
<section class="of-hero of-hero-compact"><div class="container"><div class="row g-5 align-items-center"><div class="col-lg-7 text-white"><p class="of-eyebrow text-white-75">Guia simples</p><h1>Como o OrçaFácil funciona?</h1><p class="lead text-white-75">Da configuração inicial ao PDF enviado: veja a jornada guiada para criar orçamento profissional sem complicação.</p><div class="d-flex gap-2 flex-wrap mt-4"><a class="btn btn-success" asp-page="/Auth/Register">Começar agora</a><a class="btn btn-light" asp-page="/Index">Voltar para a página inicial</a></div></div><div class="col-lg-5"><img class="of-illustration" src="/img/illustrations/landing-budget-flow.svg" alt="Fluxo de criação de documentos no OrçaFácil" /></div></div></div></section>
<section class="of-section of-section-light"><div class="container"><div class="of-section-heading mb-4"><p class="of-eyebrow">Passo a passo</p><h2>O sistema conduz você em cada etapa.</h2><p>Cada passo tem campos simples, microcopy de ajuda e revisão antes de salvar.</p></div><div class="row g-4">
@foreach (var step in new[]{("1","Cadastre seus dados","Esses dados aparecem no cabeçalho dos seus PDFs, como nome, telefone, cidade e Pix.","bi-person-badge","Dica: complete o emitente uma vez e reutilize nos próximos PDFs.","register-documents.svg"),("2","Cadastre ou informe o cliente","Você pode preencher na hora ou salvar clientes para usar de novo.","bi-person-check","Use um nome fácil de reconhecer no histórico.","login-documents.svg"),("3","Adicione serviços e valores","Digite manualmente ou use serviços salvos no catálogo.","bi-list-check","Descreva o serviço em linguagem que o cliente entenda.","landing-service-catalog.svg"),("4","Revise o total","O sistema calcula subtotal, desconto e total do orçamento.","bi-calculator","Confira descontos antes de salvar.","landing-history.svg"),("5","Gere o PDF","Baixe o documento e envie ao cliente por WhatsApp, e-mail ou outro canal.","bi-filetype-pdf","Depois acompanhe tudo pelo histórico.","landing-client-approval.svg")}){<div class="col-md-6 col-lg-4"><article class="of-step-card"><span>@step.Item1</span><img class="of-profession-svg" src="/img/illustrations/@step.Item6" alt="Ilustração do passo @step.Item1" /><h3 class="h5"><i class="bi @step.Item4 me-2"></i>@step.Item2</h3><p>@step.Item3</p><small class="of-muted">@step.Item5</small></article></div>}
</div><div class="of-cta-band mt-5"><div><p class="of-eyebrow">Próximo passo</p><h2>Crie seu primeiro orçamento hoje.</h2><p>Comece grátis e envie um PDF mais profissional ao seu cliente.</p></div><a class="btn btn-primary" asp-page="/Auth/Register">Começar agora</a></div></div></section>
