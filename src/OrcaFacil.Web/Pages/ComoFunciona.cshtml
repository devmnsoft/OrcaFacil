@page
@{ Layout="/Pages/Shared/_PublicLayout.cshtml"; ViewData["Title"]="Como funciona"; }
<section class="of-hero of-hero-compact"><div class="container"><div class="of-section-heading text-white"><p class="of-eyebrow text-white-75">Guia simples</p><h1>Como o OrçaFácil funciona?</h1><p>Você cria documentos profissionais em poucos passos, mesmo sem conhecimento técnico.</p><div class="d-flex gap-2 flex-wrap mt-4"><a class="btn btn-success" asp-page="/Auth/Register">Começar grátis agora</a><a class="btn btn-light" asp-page="/Index">Voltar para a página inicial</a></div></div></div></section>
<section class="of-section bg-light"><div class="container"><div class="row g-4">
@foreach (var step in new[]{("1","Cadastre seus dados","Essas informações aparecem no cabeçalho dos seus PDFs.","bi-person-badge"),("2","Crie um orçamento","Informe o cliente, os serviços, os valores e a validade.","bi-file-earmark-plus"),("3","Gere o PDF","O sistema monta um documento bonito, numerado e pronto para enviar.","bi-filetype-pdf"),("4","Acompanhe no histórico","Todos os documentos ficam salvos para editar, duplicar ou gerar novamente.","bi-clock-history"),("5","Transforme em recibo","Quando o serviço for pago, você pode criar um recibo com aparência profissional.","bi-receipt")}){<div class="col-md-6 col-lg-4"><partial name="Partials/_StepCard" model="new { Number=step.Item1, Title=step.Item2, Text=step.Item3, Icon=step.Item4 }" /></div>}
</div><div class="of-cta-band mt-5"><div><p class="of-eyebrow">Próximo passo</p><h2>Crie seu primeiro orçamento hoje.</h2><p>Comece grátis e envie um PDF mais profissional ao seu cliente.</p></div><a class="btn btn-primary" asp-page="/Auth/Register">Começar grátis</a></div></div></section><partial name="Partials/_MnsoftFooter" />
