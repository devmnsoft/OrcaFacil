@page
@model OrcaFacil.Web.Pages.Dashboard.IndexModel
@using OrcaFacil.Web.ViewModels
@{
 ViewData["Title"]="Início"; var d=Model.Dashboard; var plan=d?.Plan ?? "Grátis";
 var usage=new PlanUsageSummaryViewModel(plan.Equals("Free",StringComparison.OrdinalIgnoreCase)?"Grátis":plan,plan.Equals("Free",StringComparison.OrdinalIgnoreCase)?"Grátis":plan,"Disponível",[new("PDFs neste mês",d?.PdfsThisMonth??0,null)],DateTimeOffset.UtcNow.AddMonths(1),"Use sua marca nos documentos.");
}
<header class="of-dashboard-hero"><div><p class="of-eyebrow">Sua rotina hoje</p><h1>Olá, @Model.FirstName. O que vamos preparar hoje?</h1><p>Seus clientes, serviços e documentos estão organizados aqui.</p></div><a class="of-hero-action" asp-page="/Documents/CreateBudget">Novo orçamento <span>Apresente serviços e valores ao cliente</span></a></header>
@if(Model.NextAction is { } next){<section class="of-next-action" aria-labelledby="next-title"><div><p class="of-eyebrow">Próximo passo recomendado</p><h2 id="next-title">@next.Title</h2><p>@next.Explanation</p></div><a asp-page="@next.Page">@next.ActionLabel</a></section>}
<section aria-labelledby="quick-title"><div class="of-section-heading"><div><p class="of-eyebrow">Ações rápidas</p><h2 id="quick-title">Comece pelo resultado que precisa</h2></div></div><div class="of-quick-grid"><a asp-page="/Documents/CreateBudget"><svg class="of-icon"><use href="/img/icons/orcafacil-icons.svg#icon-budget" /></svg><strong>Novo orçamento</strong><span>Apresente serviços, condições e total.</span><small>Resultado: proposta pronta para enviar</small></a><a asp-page="/Documents/CreateReceipt"><svg class="of-icon"><use href="/img/icons/orcafacil-icons.svg#icon-receipt" /></svg><strong>Novo recibo</strong><span>Registre um pagamento informado por você.</span><small>Não substitui nota fiscal</small></a><a asp-page="/Clients/Create"><svg class="of-icon"><use href="/img/icons/orcafacil-icons.svg#icon-client" /></svg><strong>Cadastrar cliente</strong><span>Salve contato e dados comerciais.</span><small>Resultado: preenchimento mais rápido</small></a><a asp-page="/Services/Index"><svg class="of-icon"><use href="/img/icons/orcafacil-icons.svg#icon-service" /></svg><strong>Cadastrar serviço</strong><span>Organize descrição e preço de referência.</span><small>Resultado: catálogo reutilizável</small></a></div></section>
<section class="of-dashboard-columns"><div><div class="of-section-heading"><div><p class="of-eyebrow">Visão do mês</p><h2>Indicadores principais</h2></div></div><div class="of-metric-grid"><article class="is-primary"><span>Orçamentos</span><strong>@d?.TotalBudgets</strong><small>@((d?.BudgetTotal??0).ToString("C")) em propostas</small></article><article><span>Recibos</span><strong>@d?.TotalReceipts</strong><small>@((d?.ReceiptTotal??0).ToString("C")) registrados</small></article><article><span>Documentos</span><strong>@d?.TotalDocuments</strong><small>@d?.DocumentsThisMonth neste mês</small></article><article class="is-usage"><span>PDFs usados</span><strong>@d?.PdfsThisMonth</strong><small>Acompanhe o seu limite abaixo</small></article></div></div><aside class="of-attention"><p class="of-eyebrow">O que precisa de atenção</p><h2>Uma ação por vez</h2>@if(!Model.HasIssuerProfile){<p><strong>Dados do emitente incompletos</strong><span>Complete antes de gerar um documento profissional.</span><a asp-page="/Profile/Index">Resolver agora</a></p>}else if((d?.TotalDocuments??0)==0){<p><strong>Nenhum orçamento criado</strong><span>Prepare a primeira proposta com um fluxo guiado.</span><a asp-page="/Documents/CreateBudget">Começar</a></p>}else{<p class="is-clear"><strong>Tudo organizado por aqui</strong><span>Não encontramos uma pendência prioritária agora.</span></p>}</aside></section>
<section class="of-recent"><div class="of-section-heading"><div><p class="of-eyebrow">Continuidade</p><h2>Documentos recentes</h2></div><a asp-page="/Documents/Index">Ver todos</a></div>@if((d?.LatestDocuments?.Count??0)==0){<partial name="Partials/_EmptyState" model='new EmptyStateViewModel { Title="Seu primeiro documento começa aqui", Text="Crie um orçamento para apresentar serviços, valores, condições e prazo da proposta.", ActionText="Criar orçamento", ActionPage="/Documents/CreateBudget", Icon="bi-file-earmark-plus" }'/>}else{<partial name="_DocumentTable" model="d?.LatestDocuments"/>}</section>
<partial name="_PlanUsageSummary" model="usage" />
<section class="of-guidance"><div><p class="of-eyebrow">Progresso inicial</p><h2>Prepare seu espaço no seu ritmo</h2><p>Confira os dados, cadastre um cliente e um serviço, crie o orçamento, gere o PDF e compartilhe.</p></div><a asp-page="/Onboarding/Index">Continuar guia</a><a asp-page="/Discover">Conhecer benefícios</a></section>
