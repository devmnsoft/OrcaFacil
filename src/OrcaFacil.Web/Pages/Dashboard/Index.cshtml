@page
@model OrcaFacil.Web.Pages.Dashboard.IndexModel
@{ViewData["Title"]="Dashboard"; var d=Model.Dashboard;}
<header class="of-page-header"><div><p class="of-eyebrow">Visão geral</p><h1>Dashboard</h1><p>Acompanhe documentos, valores e próximos passos do seu negócio.</p></div></header>
<div class="row g-3"><div class="col-sm-6 col-xl-3"><div class="of-metric"><span>Total de documentos</span><strong>@d?.TotalDocuments</strong><small>Histórico completo</small></div></div><div class="col-sm-6 col-xl-3"><div class="of-metric"><span>Orçamentos</span><strong>@d?.TotalBudgets</strong><small>Propostas emitidas</small></div></div><div class="col-sm-6 col-xl-3"><div class="of-metric"><span>Recibos</span><strong>@d?.TotalReceipts</strong><small>Recebimentos registrados</small></div></div><div class="col-sm-6 col-xl-3"><div class="of-metric"><span>Plano atual</span><strong>@d?.Plan</strong><small>@d?.PdfsThisMonth PDFs no mês</small></div></div><div class="col-md-4"><div class="of-metric"><span>Valor em orçamentos</span><strong>@((d?.BudgetTotal ?? 0).ToString("C"))</strong><small>Potencial em aberto</small></div></div><div class="col-md-4"><div class="of-metric"><span>Valor em recibos</span><strong>@((d?.ReceiptTotal ?? 0).ToString("C"))</strong><small>Receita documentada</small></div></div><div class="col-md-4"><div class="of-metric"><span>PDFs gerados</span><strong>@d?.PdfsThisMonth</strong><small>Uso deste mês</small></div></div></div>
<section class="of-card mt-4"><h2 class="h4">Ações rápidas</h2><div class="row g-2 mt-2"><div class="col-md"><a class="btn btn-primary w-100" asp-page="/Documents/CreateBudget">Novo orçamento</a></div><div class="col-md"><a class="btn btn-success w-100" asp-page="/Documents/CreateReceipt">Novo recibo</a></div><div class="col-md"><a class="btn btn-outline-primary w-100" asp-page="/Documents/Index">Ver histórico</a></div><div class="col-md"><a class="btn btn-outline-primary w-100" asp-page="/Profile/Index">Dados do emitente</a></div><div class="col-md"><a class="btn btn-outline-primary w-100" asp-page="/Subscription/Index">Minha assinatura</a></div></div></section>
<section class="mt-4"><h2 class="h4">Últimos documentos</h2>@if((d?.LatestDocuments?.Count ?? 0)==0){<partial name="_EmptyState" model='"Você ainda não criou documentos. Comece criando seu primeiro orçamento."' />}else{<partial name="_DocumentTable" model="d?.LatestDocuments" />}</section>
