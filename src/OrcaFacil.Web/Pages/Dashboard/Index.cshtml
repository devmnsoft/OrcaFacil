@page
@model OrcaFacil.Web.Pages.Dashboard.IndexModel
@{ ViewData["Title"]="Dashboard"; var d=Model.Dashboard; var hasDocs=(d?.TotalDocuments ?? 0)>0; var isFree=string.Equals(d?.Plan,"Free",StringComparison.OrdinalIgnoreCase); }
<header class="of-page-header"><div><p class="of-eyebrow">Visão geral</p><h1>Dashboard</h1><p>Comece criando um orçamento para enviar ao seu cliente e acompanhe tudo em um só lugar.</p></div><a class="btn btn-outline-primary" asp-page="/Onboarding/Index">Ver primeiros passos</a></header>
<section class="of-next-step mb-4"><div class="row g-3 align-items-center"><div class="col-lg"><p class="of-eyebrow">Seu próximo passo</p>@if(!Model.HasIssuerProfile){<h2>Cadastre seus dados para que eles apareçam no PDF.</h2><p>Esses dados aparecem no cabeçalho dos seus orçamentos e recibos.</p>}else if(!hasDocs){<h2>Crie seu primeiro orçamento.</h2><p>Informe o cliente, os serviços e os valores para gerar seu primeiro PDF.</p>}else{<h2>Gere o PDF e envie ao cliente.</h2><p>Use o histórico para baixar, editar ou reenviar documentos.</p>}@if(isFree){<p class="mb-0"><strong>Quer remover a marca OrçaFácil dos PDFs?</strong> Conheça o plano Pro.</p>}</div><div class="col-lg-auto d-grid gap-2">@if(!Model.HasIssuerProfile){<a class="btn btn-primary" asp-page="/Profile/Index">Cadastrar emitente</a>}else if(!hasDocs){<a class="btn btn-primary" asp-page="/Documents/CreateBudget">Criar orçamento</a>}else{<a class="btn btn-primary" asp-page="/Documents/Index">Ver histórico</a>}@if(isFree){<a class="btn btn-outline-primary" asp-page="/Subscription/Index">Conhecer plano Pro</a>}</div></div></section>
<div class="row g-3"><div class="col-sm-6 col-xl-3"><div class="of-metric"><span>Documentos</span><strong>@d?.TotalDocuments</strong><small>Histórico completo</small></div></div><div class="col-sm-6 col-xl-3"><div class="of-metric"><span>Orçamentos</span><strong>@d?.TotalBudgets</strong><small>Propostas emitidas</small></div></div><div class="col-sm-6 col-xl-3"><div class="of-metric"><span>Recibos</span><strong>@d?.TotalReceipts</strong><small>Recebimentos registrados</small></div></div><div class="col-sm-6 col-xl-3"><div class="of-metric"><span>Plano atual</span><strong>@d?.Plan</strong><small>@d?.PdfsThisMonth PDFs no mês</small></div></div><div class="col-md-4"><div class="of-metric"><span>Valor em orçamentos</span><strong>@((d?.BudgetTotal ?? 0).ToString("C"))</strong><small>Potencial enviado</small></div></div><div class="col-md-4"><div class="of-metric"><span>Valor em recibos</span><strong>@((d?.ReceiptTotal ?? 0).ToString("C"))</strong><small>Receita documentada</small></div></div><div class="col-md-4"><div class="of-metric"><span>PDFs do mês</span><strong>@d?.PdfsThisMonth</strong><small>Uso deste mês</small></div></div></div>
<section class="of-card mt-4"><h2 class="h4">Ações rápidas</h2><div class="row g-2 mt-2"><div class="col-md"><a class="btn btn-primary w-100" asp-page="/Documents/CreateBudget">Novo orçamento</a></div><div class="col-md"><a class="btn btn-success w-100" asp-page="/Documents/CreateReceipt">Novo recibo</a></div><div class="col-md"><a class="btn btn-outline-primary w-100" asp-page="/Documents/Index">Ver histórico</a></div><div class="col-md"><a class="btn btn-outline-primary w-100" asp-page="/Profile/Index">Cadastrar emitente</a></div><div class="col-md"><a class="btn btn-outline-primary w-100" asp-page="/Subscription/Index">Ativar Pro</a></div></div></section>
<section class="of-card mt-4"><h2 class="h4">Ajuda rápida</h2><div class="row g-3"><div class="col-md-4"><partial name="Partials/_ExplainerCard" model='new { Title="Como criar orçamento?", Text="Clique em Novo orçamento e informe cliente, serviços e valores.", Icon="bi-file-earmark-plus" }' /></div><div class="col-md-4"><partial name="Partials/_ExplainerCard" model='new { Title="Como gerar recibo?", Text="Use Novo recibo quando quiser registrar um pagamento recebido.", Icon="bi-receipt" }' /></div><div class="col-md-4"><partial name="Partials/_ExplainerCard" model='new { Title="Como enviar PDF?", Text="Abra o histórico, gere o PDF e envie ao cliente pelo canal que preferir.", Icon="bi-send" }' /></div></div></section>
<section class="mt-4"><h2 class="h4">Últimos documentos</h2>@if((d?.LatestDocuments?.Count ?? 0)==0){<partial name="Partials/_EmptyState" model='new { Title="Nenhum documento ainda.", Text="Crie seu primeiro orçamento e deixe seu atendimento mais profissional.", ActionText="Criar primeiro orçamento", ActionPage="/Documents/CreateBudget", Icon="bi-file-earmark-plus" }' />}else{<partial name="_DocumentTable" model="d?.LatestDocuments" />}</section>
