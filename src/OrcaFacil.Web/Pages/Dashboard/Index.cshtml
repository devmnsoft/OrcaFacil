@page
@model OrcaFacil.Web.Pages.Dashboard.IndexModel
@using OrcaFacil.Web.ViewModels
@{
    ViewData["Title"] = "Visão geral";
    ViewData["Section"] = "Início";
    ViewData["HelpCode"] = "dashboard";
    var dashboard = Model.Dashboard;
    var plan = dashboard?.Plan ?? "Grátis";
    var planName = plan.Equals("Free", StringComparison.OrdinalIgnoreCase) ? "Grátis" : plan;
    var usage = new PlanUsageSummaryViewModel(
        planName,
        planName,
        "Disponível",
        [new("PDFs neste mês", dashboard?.PdfsThisMonth ?? 0, null)],
        DateTimeOffset.UtcNow.AddMonths(1),
        "Use sua marca nos documentos.");
}
<section class="of-dashboard-hero" aria-labelledby="welcome-title">
    <div class="of-hero-copy">
        <p class="of-eyebrow">Seu comando comercial</p>
        <h1 id="welcome-title">Olá, @Model.FirstName. Transforme o próximo pedido em uma proposta clara.</h1>
        <p>Hoje você pode preparar, acompanhar e concluir seu trabalho sem perder o contexto.</p>
        <div class="of-hero-actions">
            <a class="of-button-primary" asp-page="/Documents/CreateBudget">Criar novo orçamento</a>
            <a class="of-button-secondary" asp-page="/Documents/Index">Continuar de onde parei</a>
        </div>
        <dl class="of-day-summary">
            <div><dt>Propostas</dt><dd>@(dashboard?.TotalBudgets ?? 0)</dd></div>
            <div><dt>Em documentos</dt><dd>@((dashboard?.BudgetTotal ?? 0).ToString("C"))</dd></div>
            <div><dt>Plano atual</dt><dd>@planName</dd></div>
        </dl>
    </div>
    <div class="of-hero-visual">
        <img src="~/img/illustrations/dashboard-command-center.svg" alt="Prévia do centro de comando com orçamento, aprovação e evolução comercial" />
    </div>
</section>

@if (Model.NextAction is { } next)
{
    <section class="of-next-action" aria-labelledby="next-title">
        <div class="of-next-icon"><svg class="of-icon"><use href="/img/icons/orcafacil-icons.svg#icon-success" /></svg></div>
        <div>
            <p class="of-eyebrow">Próximo passo recomendado · cerca de 2 minutos</p>
            <h2 id="next-title">@next.Title</h2>
            <p>@next.Explanation</p>
            <small>Benefício: seus próximos documentos ficam mais completos e fáceis de reutilizar.</small>
        </div>
        <a class="of-button-secondary" asp-page="@next.Page">@next.ActionLabel</a>
        <img src="~/img/illustrations/client-management.svg" alt="" aria-hidden="true" />
    </section>
}

<section class="of-dashboard-columns" aria-labelledby="attention-title">
    <div class="of-attention-list">
        <div class="of-section-heading">
            <div><p class="of-eyebrow">Prioridades</p><h2 id="attention-title">O que precisa de atenção</h2></div>
            <a asp-page="/Notifications/Index">Ver todas as pendências</a>
        </div>
        @if (!Model.HasIssuerProfile)
        {
            <article class="of-attention-item is-warning">
                <span class="of-attention-icon"><svg class="of-icon"><use href="/img/icons/orcafacil-icons.svg#icon-alert" /></svg></span>
                <div><small>Cadastro profissional · atenção</small><h3>Complete os dados do emitente</h3><p>O cabeçalho dos documentos depende dessas informações.</p></div>
                <time>Hoje</time><a asp-page="/Profile/Index">Resolver</a>
            </article>
        }
        else if ((dashboard?.TotalDocuments ?? 0) == 0)
        {
            <article class="of-attention-item is-opportunity">
                <span class="of-attention-icon"><svg class="of-icon"><use href="/img/icons/orcafacil-icons.svg#icon-budget" /></svg></span>
                <div><small>Primeira venda · oportunidade</small><h3>Prepare sua primeira proposta</h3><p>Use o fluxo guiado para organizar cliente, serviços e condições.</p></div>
                <time>Agora</time><a asp-page="/Documents/CreateBudget">Começar</a>
            </article>
        }
        else
        {
            <article class="of-attention-item is-clear">
                <span class="of-attention-icon"><svg class="of-icon"><use href="/img/icons/orcafacil-icons.svg#icon-success" /></svg></span>
                <div><small>Rotina · informativo</small><h3>Nenhuma pendência prioritária</h3><p>Seu espaço está organizado. Confira os documentos recentes.</p></div>
                <time>Agora</time><a asp-page="/Documents/Index">Revisar</a>
            </article>
        }
    </div>
    <aside class="of-quick-actions" aria-labelledby="quick-title">
        <p class="of-eyebrow">Atalhos</p><h2 id="quick-title">Crie com contexto</h2>
        <a class="of-quick-primary" asp-page="/Documents/CreateBudget"><svg class="of-icon"><use href="/img/icons/orcafacil-icons.svg#icon-budget" /></svg><span><strong>Novo orçamento</strong><small>Proposta pronta para enviar</small></span></a>
        <div><a asp-page="/Documents/CreateReceipt">Novo recibo</a><a asp-page="/Clients/Create">Novo cliente</a><a asp-page="/Services/Index">Novo serviço</a></div>
    </aside>
</section>

<section aria-labelledby="metrics-title">
    <div class="of-section-heading"><div><p class="of-eyebrow">Visão comercial</p><h2 id="metrics-title">O mês em quatro sinais</h2></div><a asp-page="/Documents/Index">Ver relatório completo</a></div>
    <div class="of-metric-grid">
        <article><span>Orçamentos enviados</span><strong>@(dashboard?.TotalBudgets ?? 0)</strong><small>@((dashboard?.TotalBudgets ?? 0) == 0 ? "Você ainda não enviou um orçamento neste mês." : "Propostas preparadas no período.")</small></article>
        <article class="is-money"><span>Valor em propostas</span><strong>@((dashboard?.BudgetTotal ?? 0).ToString("C"))</strong><small>Total apresentado aos clientes.</small></article>
        <article><span>Respostas aguardando</span><strong>—</strong><small>Disponível após compartilhar propostas.</small></article>
        <article class="is-success"><span>Registrado em recibos</span><strong>@((dashboard?.ReceiptTotal ?? 0).ToString("C"))</strong><small>Valores informados por você no período.</small></article>
    </div>
</section>

<section class="of-recent" aria-labelledby="recent-title">
    <div class="of-section-heading"><div><p class="of-eyebrow">Continuidade</p><h2 id="recent-title">Documentos recentes</h2></div><a asp-page="/Documents/Index">Ver todos</a></div>
    @if ((dashboard?.LatestDocuments?.Count ?? 0) == 0)
    {
        <partial name="Partials/_EmptyState" model='new EmptyStateViewModel { Title="Seu primeiro documento começa aqui", Text="Crie um orçamento para apresentar serviços, valores, condições e prazo da proposta.", ActionText="Criar orçamento", ActionPage="/Documents/CreateBudget", Icon="bi-file-earmark-plus" }' />
    }
    else
    {
        <partial name="_DocumentTable" model="dashboard?.LatestDocuments" />
    }
</section>

<div class="of-dashboard-lower">
    <partial name="_PlanUsageSummary" model="usage" />
    <section class="of-guidance"><div><p class="of-eyebrow">Guia inicial</p><h2>Prepare seu espaço no seu ritmo</h2><p>Complete os dados, cadastre um cliente e transforme a oportunidade em documento.</p></div><a asp-page="/Onboarding/Index">Continuar guia</a><a asp-page="/Discover">Conhecer recursos</a></section>
</div>
