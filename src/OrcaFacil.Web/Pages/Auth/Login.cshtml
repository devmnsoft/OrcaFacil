@page
@model OrcaFacil.Web.Pages.Auth.LoginModel
@{ Layout="/Pages/Shared/_PublicLayout.cshtml"; ViewData["Title"]="Entrar"; }
<section class="of-hero"><div class="container"><div class="of-public-card p-4 p-lg-5"><div class="of-auth-grid"><div><p class="of-eyebrow">Bem-vindo de volta</p><h1 class="h2 text-dark">Entre para gerar PDFs profissionais.</h1><p class="text-muted">Acesse seu histórico, crie orçamentos e recibos numerados e envie documentos mais claros ao cliente.</p><div class="of-pdf-mini mt-4"><strong>Prévia do PDF</strong><div class="of-preview-lines"><span></span><span></span><span></span></div><div class="of-total-pill"><span>Total</span><strong>R$ 1.090,00</strong></div></div><p class="mt-3"><img src="/img/mnsoft-logo.png" alt="MNSOFT" class="of-mnsoft-logo" onerror="this.style.display='none'" /> <span class="of-logo-text">Um produto MNSOFT</span></p></div><div><form method="post" class="of-card shadow-none">@Html.AntiForgeryToken()<div asp-validation-summary="ModelOnly" class="alert alert-danger"></div><p class="form-text">Se aparecer erro, confira: e-mail ou senha incorretos.</p><label asp-for="Input.Email" class="form-label">E-mail</label><input asp-for="Input.Email" class="form-control" autocomplete="email"/><span asp-validation-for="Input.Email" class="text-danger"></span><label asp-for="Input.Password" class="form-label">Senha</label><input asp-for="Input.Password" class="form-control" autocomplete="current-password"/><span asp-validation-for="Input.Password" class="text-danger"></span><button class="btn btn-primary w-100 mt-4" data-loading>Entrar</button><a class="btn btn-outline-primary w-100 mt-2" asp-page="/Auth/Register">Criar conta grátis</a><a class="btn btn-link w-100 mt-2" asp-page="/Support/Index">Falar com a MNSOFT</a></form></div></div></div></div></section>
