@page
@model OrcaFacil.Web.Pages.Auth.LoginModel
@{ ViewData["Title"] = "Entrar"; }
<div class="auth-card">
  <h1>Entrar</h1>
  <p class="text-muted">Acesse seu painel OrçaFácil.</p>
  <form method="post">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <label class="form-label">E-mail</label><input asp-for="Input.Email" class="form-control" />
    <label class="form-label mt-3">Senha</label><input asp-for="Input.Password" class="form-control" type="password" />
    <button class="btn btn-primary w-100 mt-4">Entrar</button>
  </form>
  <p class="mt-3">Ainda não tem conta? <a asp-page="/Auth/Register">Começar grátis</a></p>
</div>
