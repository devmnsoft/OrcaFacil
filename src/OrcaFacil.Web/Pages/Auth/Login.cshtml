@page
@model OrcaFacil.Web.Pages.Auth.LoginModel
@{ Layout="/Pages/Shared/_PublicLayout.cshtml"; ViewData["Title"]="Entrar"; }
<section class="of-public-auth"><div class="container"><div class="of-auth-shell"><aside class="of-auth-aside"><p class="of-eyebrow of-on-dark-muted">Bem-vindo de volta</p><h1 class="display-5 fw-bold of-on-dark">Entre para gerar PDFs profissionais.</h1><p class="lead of-on-dark-muted">Acesse seu histórico, crie orçamentos e recibos numerados e envie documentos mais claros ao cliente.</p><div class="of-illustration-card my-4"><img class="of-illustration" src="~/img/illustrations/login-hero.svg" alt="Documento PDF do OrçaFácil" /></div><ul class="of-benefit-list"><li><i class="bi bi-clock-history"></i> Histórico organizado</li><li><i class="bi bi-file-earmark-pdf"></i> PDF pronto para enviar</li><li><i class="bi bi-patch-check"></i> Documentos mais confiáveis</li></ul></aside><div class="of-auth-panel"><form method="post" class="of-card shadow-none">@Html.AntiForgeryToken()<p class="of-eyebrow">Acesso</p><h2 class="h1 fw-bold">Entrar</h2><p class="of-muted">Informe seu e-mail e senha para continuar.</p><div asp-validation-summary="ModelOnly" class="alert alert-danger"></div><label asp-for="Input.Email" class="form-label"><i class="bi bi-envelope me-1"></i> E-mail</label><div class="of-input-icon"><i class="bi bi-envelope"></i><input asp-for="Input.Email" class="form-control" autocomplete="email" placeholder="seuemail@exemplo.com" /></div><span asp-validation-for="Input.Email" class="text-danger"></span><label asp-for="Input.Password" class="form-label"><i class="bi bi-lock me-1"></i> Senha</label><div class="of-input-icon"><i class="bi bi-lock"></i><input asp-for="Input.Password" class="form-control" autocomplete="current-password" placeholder="Sua senha" /></div><span asp-validation-for="Input.Password" class="text-danger"></span><button class="btn btn-primary btn-lg w-100 mt-4" data-loading>Entrar <i class="bi bi-arrow-right-circle ms-1"></i></button><a class="btn btn-outline-primary w-100 mt-2" asp-page="/Auth/Register">Criar conta grátis</a><a class="btn btn-link w-100 mt-2" asp-page="/Support/Index"><i class="bi bi-chat-dots"></i> Falar com a MNSOFT</a></form></div></div></div></section>
