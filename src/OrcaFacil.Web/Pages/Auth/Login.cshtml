@page
@model OrcaFacil.Web.Pages.Auth.LoginModel
@{ Layout="/Pages/Shared/_PublicLayout.cshtml"; ViewData["Title"]="Entrar"; }
<section class="of-public-auth of-section-light"><div class="container"><div class="of-auth-shell"><aside class="auth-side-panel of-section-dark"><p class="of-eyebrow of-on-dark-muted">Bem-vindo de volta</p><h1 class="display-5 fw-bold">Entre para gerar PDFs profissionais.</h1><p class="lead">Acesse seu histórico, crie orçamentos e recibos numerados e envie documentos mais claros ao cliente.</p><div class="of-illustration-card my-4"><img class="of-illustration" src="~/img/illustrations/login-documents.svg" alt="Documento PDF do OrçaFácil com recibo e aprovação" /></div><ul class="of-benefit-list"><li><i class="bi bi-clock-history"></i> Histórico organizado</li><li><i class="bi bi-file-earmark-pdf"></i> PDF pronto para enviar</li><li><i class="bi bi-patch-check"></i> Documentos mais confiáveis</li></ul></aside><div class="of-auth-panel"><form method="post" class="of-form-card of-card shadow-none">@Html.AntiForgeryToken()<p class="of-eyebrow">Acesso</p><h2 class="h1 fw-bold">Entrar</h2><p class="of-muted">Informe seu e-mail e senha para continuar.</p><div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div><label asp-for="Input.Email" class="form-label">E-mail</label><div class="of-input-field"><i class="bi bi-envelope of-input-icon" aria-hidden="true"></i><input asp-for="Input.Email" class="form-control of-input with-icon" autocomplete="email" placeholder="seuemail@exemplo.com" /></div><span asp-validation-for="Input.Email" class="text-danger d-block mt-1"></span><label asp-for="Input.Password" class="form-label">Senha</label><div class="of-password-field"><i class="bi bi-lock of-input-icon" aria-hidden="true"></i><input asp-for="Input.Password" type="password" class="form-control of-input with-icon with-toggle" autocomplete="current-password" placeholder="Sua senha" /><button type="button" class="of-password-toggle" data-password-toggle aria-label="Mostrar senha"><i class="bi bi-eye" aria-hidden="true"></i></button></div><span asp-validation-for="Input.Password" class="text-danger d-block mt-1"></span><button class="btn btn-primary btn-lg w-100 mt-4" data-loading>Entrar <i class="bi bi-arrow-right-circle ms-1"></i></button><a class="btn btn-outline-primary w-100 mt-2" asp-page="/Auth/Register">Criar conta grátis</a><a class="btn btn-link w-100 mt-2" asp-page="/Support/Index"><i class="bi bi-chat-dots"></i> Falar com a MNSOFT</a></form></div></div></div></section>
