@page
@model OrcaFacil.Web.Pages.Auth.LoginModel
@{
  Layout = "/Pages/Shared/_PublicLayout.cshtml";
  ViewData["Title"] = "Entrar";
  var emailInvalid = ViewData.ModelState["Input.Email"]?.Errors.Count > 0;
  var passwordInvalid = ViewData.ModelState["Input.Password"]?.Errors.Count > 0;
}
<section class="of-public-auth"><div class="of-container"><div class="of-auth-premium-shell">
  <aside class="of-auth-benefit"><a class="of-auth-product" asp-page="/Index" aria-label="OrçaFácil, voltar ao início"><span>OrçaFácil</span><small>uma solução MNSOFT</small></a><p class="of-eyebrow">Bem-vindo de volta</p><h1>Continue vendendo seu trabalho com confiança.</h1><p>Seus clientes, propostas, ordens, pagamentos e recibos continuam organizados no mesmo fluxo.</p><ul><li><partial name="Partials/_Icon" model='new IconViewModel("history", "sm", Decorative: true)' /> Histórico para retomar conversas</li><li><partial name="Partials/_Icon" model='new IconViewModel("quote", "sm", Decorative: true)' /> Propostas prontas para compartilhar</li><li><partial name="Partials/_Icon" model='new IconViewModel("success", "sm", Decorative: true)' /> Próxima ação sempre visível</li></ul><p class="of-auth-trust"><partial name="Partials/_Icon" model='new IconViewModel("protected-data", "sm", Decorative: true)' /> Acesso protegido e sem dependência de serviços externos.</p></aside>
  <div class="of-auth-card"><form method="post" class="of-form-section" data-focus-first-error>@Html.AntiForgeryToken()<p class="of-eyebrow">Acesso seguro</p><h2>Entre na sua conta</h2><p class="of-text-secondary">Use o e-mail cadastrado para abrir sua área de trabalho.</p><div asp-validation-summary="ModelOnly" class="of-form-summary" role="alert" tabindex="-1"></div>
    <div class="of-field"><label asp-for="Input.Email" class="of-field-label">E-mail</label><div class="of-auth-input"><partial name="Partials/_Icon" model='new IconViewModel("email", "sm", Decorative: true)' /><input asp-for="Input.Email" class="of-field-control" autocomplete="email" inputmode="email" placeholder="voce@seunegocio.com.br" aria-describedby="login-email-help login-email-error" aria-invalid="@(emailInvalid ? "true" : "false")" /></div><small id="login-email-help" class="of-field-help">O mesmo e-mail usado na criação da conta.</small><span id="login-email-error" asp-validation-for="Input.Email" class="of-field-error"></span></div>
    <div class="of-field"><div class="of-field-heading"><label asp-for="Input.Password" class="of-field-label">Senha</label><a asp-page="/Auth/ForgotPassword">Esqueci minha senha</a></div><div class="of-password-field"><input asp-for="Input.Password" type="password" class="of-field-control" autocomplete="current-password" aria-describedby="login-password-error caps-lock-message" aria-invalid="@(passwordInvalid ? "true" : "false")" /><button type="button" class="of-password-toggle" data-password-toggle aria-label="Mostrar senha" aria-pressed="false"><partial name="Partials/_Icon" model='new IconViewModel("preview", "sm", Decorative: true)' /></button></div><small id="caps-lock-message" class="of-field-warning" data-caps-lock hidden>Caps Lock está ativado.</small><span id="login-password-error" asp-validation-for="Input.Password" class="of-field-error"></span></div>
    <div class="of-human-check" aria-hidden="true"><label asp-for="Input.Website">Deixe este campo vazio</label><input asp-for="Input.Website" tabindex="-1" autocomplete="off" /></div>
    <div class="of-form-actions of-form-actions-stack"><button class="of-button of-button-primary" type="submit" data-loading>Entrar</button><a class="of-button of-button-secondary" asp-page="/Auth/Register">Criar conta grátis</a></div><p class="of-auth-support">Problemas para entrar? <a asp-page="/Support/Index">Fale com o suporte MNSOFT</a>.</p>
  </form></div>
</div></div></section>
