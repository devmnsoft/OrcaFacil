@page
@model OrcaFacil.Web.Pages.Auth.LoginModel
@{ Layout="/Pages/Shared/_PublicLayout.cshtml"; ViewData["Title"]="Entrar"; }
<section class="of-public-auth of-surface-soft"><div class="container"><div class="of-auth-shell">
  <aside class="of-auth-aside of-auth-context"><p class="of-eyebrow of-on-dark-muted">Bem-vindo de volta</p><h1>Entre no seu espaço.</h1><p class="lead">Continue seus documentos, clientes e atendimentos de onde parou.</p><img class="of-illustration mt-4" src="/img/illustrations/login-access.svg" alt="Acesso protegido aos documentos do OrçaFácil" /><div class="of-security-note mt-4"><svg class="of-icon" aria-hidden="true"><use href="/img/icons/orcafacil-icons.svg#icon-shield"></use></svg> Seu acesso é individual e protegido.</div></aside>
  <div class="of-auth-panel of-auth-form"><form method="post">@Html.AntiForgeryToken()<p class="of-eyebrow">Acesso</p><h2>Bom ter você aqui.</h2><p class="of-text-secondary">Informe seus dados para continuar.</p><div asp-validation-summary="ModelOnly" class="of-alert-danger" role="alert"></div>
    <label asp-for="Input.Email" class="form-label">E-mail</label><input asp-for="Input.Email" class="form-control" autocomplete="email" placeholder="seuemail@exemplo.com" /><span asp-validation-for="Input.Email" class="text-danger"></span>
    <label asp-for="Input.Password" class="form-label">Senha</label><div class="of-password-field"><input asp-for="Input.Password" type="password" class="form-control with-toggle" autocomplete="current-password" /><button type="button" class="of-password-toggle" data-password-toggle aria-label="Mostrar senha" aria-pressed="false"><svg class="of-icon" aria-hidden="true"><use href="/img/icons/orcafacil-icons.svg#icon-eye"></use></svg></button></div><span asp-validation-for="Input.Password" class="text-danger"></span>
    <button class="btn btn-success btn-lg w-100 mt-4" type="submit" data-loading>Entrar</button><a class="btn btn-outline-primary w-100 mt-2" asp-page="/Auth/Register">Criar minha conta grátis</a><a class="btn btn-link w-100 mt-2" asp-page="/Support/Index">Preciso de ajuda para acessar</a>
  </form></div>
</div></div></section>
