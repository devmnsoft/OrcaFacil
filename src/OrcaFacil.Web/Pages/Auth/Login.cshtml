@model OrcaFacil.Web.Pages.Auth.LoginModel
@{ Layout="/Pages/Shared/_PublicLayout.cshtml"; ViewData["Title"]="Entrar"; }
<section class="of-hero"><div class="container"><div class="of-public-card p-4 p-lg-5"><div class="row g-4 align-items-center"><div class="col-lg-5"><p class="of-eyebrow">Bem-vindo de volta</p><h1 class="h2 text-dark">Entre para gerar PDFs profissionais.</h1><ul class="text-muted"><li>Histórico organizado</li><li>Orçamentos e recibos numerados</li><li>Acesso seguro por cookie</li></ul></div><div class="col-lg-7"><form method="post" class="of-card shadow-none">@Html.AntiForgeryToken()<div asp-validation-summary="ModelOnly" class="text-danger"></div><label asp-for="Input.Email" class="form-label">E-mail</label><input asp-for="Input.Email" class="form-control" autocomplete="email"/><span asp-validation-for="Input.Email" class="text-danger"></span><label asp-for="Input.Password" class="form-label">Senha</label><input asp-for="Input.Password" class="form-control" autocomplete="current-password"/><span asp-validation-for="Input.Password" class="text-danger"></span><button class="btn btn-primary w-100 mt-4" data-loading>Entrar</button><div class="d-flex justify-content-between mt-3"><a asp-page="/Auth/Register">Criar conta</a><a href="#">Esqueci minha senha (em breve)</a></div></form></div></div></div></div></section>
