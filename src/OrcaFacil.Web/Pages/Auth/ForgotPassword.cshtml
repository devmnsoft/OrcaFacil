@page
@model OrcaFacil.Web.Pages.Auth.ForgotPasswordModel
@{ Layout = "/Pages/Shared/_PublicLayout.cshtml"; ViewData["Title"] = "Recuperar acesso"; }
<section class="of-public-auth">
<div class="of-container">
<div class="of-auth-card of-auth-card-standalone">
<form method="post" class="of-form-section">@Html.AntiForgeryToken()<p class="of-eyebrow">Recuperação segura</p>
<h1>Vamos ajudar você a recuperar o acesso.</h1>
<p class="of-text-secondary">Informe o e-mail usado na sua conta. Enviaremos as próximas instruções quando o endereço estiver cadastrado.</p>
<div asp-validation-summary="ModelOnly" class="of-form-summary">
</div>
<label asp-for="Email" class="of-field-label">E-mail</label>
<input asp-for="Email" class="of-field-control" autocomplete="email" autofocus />
<span asp-validation-for="Email" class="of-field-error">
</span>
<button type="submit" class="of-button of-button-primary of-button-block">Enviar instruções</button>
<a asp-page="/Auth/Login" class="of-button of-button-tertiary of-button-block">Voltar para entrar</a>
<a asp-page="/Auth/Register" class="of-button of-button-tertiary of-button-block">Criar uma conta</a>
<a asp-page="/Support/Index" class="of-button of-button-tertiary of-button-block">Falar com o suporte</a>
</form>
</div>
</div>
</section>
