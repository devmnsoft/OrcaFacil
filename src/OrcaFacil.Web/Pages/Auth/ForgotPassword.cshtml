@page
@model OrcaFacil.Web.Pages.Auth.ForgotPasswordModel
@{ Layout = "/Pages/Shared/_PublicLayout.cshtml"; ViewData["Title"] = "Recuperar acesso"; }
<section class="of-public-auth of-section-light">
<div class="container">
<div class="of-auth-panel mx-auto">
<form method="post" class="of-form-card of-card">@Html.AntiForgeryToken()<p class="of-eyebrow">Recuperação segura</p>
<h1>Vamos ajudar você a recuperar o acesso.</h1>
<p class="of-muted">Informe o e-mail usado na sua conta. Enviaremos as próximas instruções quando o endereço estiver cadastrado.</p>
<div asp-validation-summary="ModelOnly" class="alert alert-danger">
</div>
<label asp-for="Email" class="form-label">E-mail</label>
<input asp-for="Email" class="form-control of-input" autocomplete="email" autofocus />
<span asp-validation-for="Email" class="text-danger">
</span>
<button class="btn btn-primary btn-lg w-100 mt-4">Enviar instruções</button>
<a asp-page="/Auth/Login" class="btn btn-link w-100">Voltar para entrar</a>
<a asp-page="/Auth/Register" class="btn btn-link w-100">Criar uma conta</a>
<a asp-page="/Support/Index" class="btn btn-link w-100">Falar com o suporte</a>
</form>
</div>
</div>
</section>
