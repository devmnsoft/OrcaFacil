@page
@model OrcaFacil.Web.Pages.Auth.RegisterModel
@{ Layout = "/Pages/Shared/_PublicLayout.cshtml"; ViewData["Title"] = "Criar sua conta"; }
<section class="of-public-auth of-surface-soft">
  <div class="container py-5">
    <div class="of-auth-shell">
      <aside class="of-auth-aside of-auth-context">
        <p class="of-eyebrow of-on-dark-muted">Comece no plano Grátis</p>
        <h1>Seu trabalho organizado desde o primeiro orçamento.</h1>
        <p data-account-context>Esses dados ajudam a identificar sua conta e preparar os documentos do seu trabalho.</p>
        <img class="of-illustration" data-account-illustration src="/img/illustrations/register-person.svg" alt="Cadastro de pessoa física" />
        <div class="of-security-note mt-4"><svg class="of-icon" aria-hidden="true"><use href="/img/icons/orcafacil-icons.svg#icon-shield"></use></svg><span>Senha protegida e dados usados somente para administrar sua conta.</span></div>
      </aside>
      <div class="of-auth-panel of-auth-form">
      <form method="post" data-account-registration novalidate>
        <p class="of-eyebrow">Sua conta</p>
        <h2 class="h1">Crie seu espaço.</h2>
        <p class="of-text-secondary">Escolha uma opção para mostrarmos somente os dados necessários.</p>
        <ol class="of-progress" aria-label="Etapas do cadastro"><li class="is-active">Como você trabalha</li><li>Seus dados</li><li>Seu acesso</li><li>Termos e privacidade</li></ol>
        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

        <fieldset class="mb-4">
          <legend class="visually-hidden">Tipo da conta</legend>
          <div class="row g-3">
            <div class="col-md-6"><label class="of-account-choice of-card h-100" for="account-individual"><input asp-for="Input.AccountType" id="account-individual" type="radio" value="Individual" /><strong>Pessoa Física</strong><span>Para autônomos e profissionais que trabalham usando o próprio CPF.</span></label></div>
            <div class="col-md-6"><label class="of-account-choice of-card h-100" for="account-company"><input asp-for="Input.AccountType" id="account-company" type="radio" value="Company" /><strong>Pessoa Jurídica</strong><span>Para MEIs, empresas e negócios que trabalham usando CNPJ.</span></label></div>
          </div>
          <span asp-validation-for="Input.AccountType" class="text-danger d-block mt-2"></span>
        </fieldset>
        <p class="visually-hidden" aria-live="polite" data-account-announcement></p>

        <div class="row g-3">
          <div class="col-md-6" data-individual-field><label asp-for="Input.Name" class="form-label">Nome completo</label><input asp-for="Input.Name" class="form-control" autocomplete="name" /><div class="form-text">Como seu nome deve aparecer nos documentos?</div><span asp-validation-for="Input.Name" class="text-danger"></span></div>
          <div class="col-md-6" data-individual-field><label asp-for="Input.ProfessionalName" class="form-label">Nome profissional <span class="text-muted">(opcional)</span></label><input asp-for="Input.ProfessionalName" class="form-control" /><div class="form-text">Use este campo quando seus clientes conhecem você por outro nome.</div></div>
          <div class="col-md-6" data-company-field><label asp-for="Input.LegalName" class="form-label">Razão social</label><input asp-for="Input.LegalName" class="form-control" /><div class="form-text">Nome oficial registrado da empresa.</div><span asp-validation-for="Input.LegalName" class="text-danger"></span></div>
          <div class="col-md-6" data-company-field><label asp-for="Input.TradeName" class="form-label">Nome fantasia</label><input asp-for="Input.TradeName" class="form-control" /><div class="form-text">Nome pelo qual seus clientes conhecem seu negócio.</div></div>
          <div class="col-md-6" data-company-field><label asp-for="Input.ResponsibleName" class="form-label">Nome do responsável</label><input asp-for="Input.ResponsibleName" class="form-control" autocomplete="name" /><div class="form-text">Pessoa responsável por esta conta no OrçaFácil.</div><span asp-validation-for="Input.ResponsibleName" class="text-danger"></span></div>
          <div class="col-md-6"><label asp-for="Input.DocumentNumber" class="form-label" data-document-label>CPF ou CNPJ</label><input asp-for="Input.DocumentNumber" class="form-control" inputmode="numeric" data-account-document /><div class="form-text" data-document-help>O documento identifica sua conta e será usado nos dados de cobrança.</div><span asp-validation-for="Input.DocumentNumber" class="text-danger"></span></div>
          <div class="col-md-6"><label asp-for="Input.Phone" class="form-label">Telefone ou WhatsApp</label><input asp-for="Input.Phone" class="form-control" inputmode="tel" autocomplete="tel" data-phone /><span asp-validation-for="Input.Phone" class="text-danger"></span></div>
          <div class="col-md-6"><label asp-for="Input.Email" class="form-label">E-mail</label><input asp-for="Input.Email" class="form-control" autocomplete="email" /><span asp-validation-for="Input.Email" class="text-danger"></span></div>
          <div class="col-md-4" data-company-field><label asp-for="Input.PostalCode" class="form-label">CEP</label><input asp-for="Input.PostalCode" class="form-control" inputmode="numeric" data-postal-code /><span asp-validation-for="Input.PostalCode" class="text-danger"></span></div>
          <div class="col-md-8" data-company-field><label asp-for="Input.Street" class="form-label">Rua</label><input asp-for="Input.Street" class="form-control" autocomplete="street-address" /><span asp-validation-for="Input.Street" class="text-danger"></span></div>
          <div class="col-md-4" data-company-field><label asp-for="Input.StreetNumber" class="form-label">Número</label><input asp-for="Input.StreetNumber" class="form-control" /><span asp-validation-for="Input.StreetNumber" class="text-danger"></span></div>
          <div class="col-md-4" data-company-field><label asp-for="Input.Complement" class="form-label">Complemento <span class="text-muted">(opcional)</span></label><input asp-for="Input.Complement" class="form-control" /></div>
          <div class="col-md-4" data-company-field><label asp-for="Input.District" class="form-label">Bairro</label><input asp-for="Input.District" class="form-control" /><span asp-validation-for="Input.District" class="text-danger"></span></div>
          <div class="col-md-8"><label asp-for="Input.City" class="form-label">Cidade</label><input asp-for="Input.City" class="form-control" autocomplete="address-level2" /><span asp-validation-for="Input.City" class="text-danger"></span></div>
          <div class="col-md-4"><label asp-for="Input.State" class="form-label">Estado</label><input asp-for="Input.State" class="form-control text-uppercase" maxlength="2" autocomplete="address-level1" placeholder="UF" /><span asp-validation-for="Input.State" class="text-danger"></span></div>
          <div class="col-md-6"><label asp-for="Input.Password" class="form-label">Senha</label><div class="of-password-field"><input asp-for="Input.Password" type="password" class="form-control with-toggle" autocomplete="new-password" aria-describedby="password-requirements" /><button type="button" class="of-password-toggle" data-password-toggle aria-label="Mostrar senha" aria-pressed="false"><svg class="of-icon" aria-hidden="true"><use href="/img/icons/orcafacil-icons.svg#icon-eye"></use></svg></button></div><p id="password-requirements" class="of-password-requirements">Use pelo menos 8 caracteres.</p><span asp-validation-for="Input.Password" class="text-danger"></span></div>
          <div class="col-md-6"><label asp-for="Input.ConfirmPassword" class="form-label">Confirmar senha</label><div class="of-password-field"><input asp-for="Input.ConfirmPassword" type="password" class="form-control with-toggle" autocomplete="new-password" /><button type="button" class="of-password-toggle" data-password-toggle aria-label="Mostrar confirmação de senha" aria-pressed="false"><svg class="of-icon" aria-hidden="true"><use href="/img/icons/orcafacil-icons.svg#icon-eye"></use></svg></button></div><span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span></div>
        </div>
        <div class="form-check mt-4"><input asp-for="Input.AcceptTerms" class="form-check-input" /><label asp-for="Input.AcceptTerms" class="form-check-label">Li e concordo com os <a asp-page="/Termos">Termos de Uso</a>.</label><span asp-validation-for="Input.AcceptTerms" class="text-danger d-block"></span></div>
        <div class="form-check mt-2"><input asp-for="Input.AcceptPrivacy" class="form-check-input" /><label asp-for="Input.AcceptPrivacy" class="form-check-label">Li o <a asp-page="/Privacidade">Aviso de Privacidade</a> e entendi como meus dados serão utilizados para criar e administrar minha conta.</label><span asp-validation-for="Input.AcceptPrivacy" class="text-danger d-block"></span></div>
        <div class="form-check mt-2"><input asp-for="Input.AcceptMarketing" class="form-check-input" /><label asp-for="Input.AcceptMarketing" class="form-check-label">Quero receber novidades e comunicações comerciais. <strong>(opcional)</strong></label></div>
        <button class="btn btn-success btn-lg w-100 mt-4" type="submit" data-loading>Criar minha conta grátis</button>
        <p class="text-center mt-3 mb-0"><a asp-page="/Auth/Login">Já tenho uma conta</a></p>
      </form></div>
    </div>
  </div>
</section>
