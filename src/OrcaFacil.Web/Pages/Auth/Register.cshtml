@page
@model OrcaFacil.Web.Pages.Auth.RegisterModel
@{ Layout="/Pages/Shared/_PublicLayout.cshtml"; ViewData["Title"]="Criar conta"; }
<section class="of-hero"><div class="container"><div class="of-public-card p-4 p-lg-5"><div class="of-auth-grid"><div><p class="of-eyebrow">Plano Free</p><h1 class="h2 text-dark">Crie sua conta grátis.</h1><p class="text-muted">Conta criada com sucesso? O próximo passo será configurar seus dados para aparecerem no PDF.</p><ul class="text-muted"><li>Orçamentos e recibos em PDF</li><li>Histórico organizado</li><li>Upgrade Pro quando quiser</li></ul><p class="mt-3"><img src="/img/mnsoft-logo.png" alt="MNSOFT" class="of-mnsoft-logo" onerror="this.style.display='none'" /> <span class="of-logo-text">Um produto MNSOFT</span></p></div><div><form method="post" class="of-card shadow-none">@Html.AntiForgeryToken()<div asp-validation-summary="ModelOnly" class="alert alert-danger"></div><p class="form-text">Se o e-mail já estiver cadastrado, entre ou fale com a MNSOFT.</p><label asp-for="Input.Name" class="form-label">Nome ou empresa</label><input asp-for="Input.Name" class="form-control" autocomplete="organization"/><span asp-validation-for="Input.Name" class="text-danger"></span><label asp-for="Input.Email" class="form-label">E-mail</label><input asp-for="Input.Email" class="form-control" autocomplete="email"/><span asp-validation-for="Input.Email" class="text-danger"></span><label asp-for="Input.Password" class="form-label">Senha</label><input asp-for="Input.Password" class="form-control" autocomplete="new-password"/><span asp-validation-for="Input.Password" class="text-danger"></span><label class="form-label" for="ConfirmPassword">Confirmar senha</label><input id="ConfirmPassword" name="ConfirmPassword" type="password" class="form-control" minlength="6" required autocomplete="new-password" /><div class="form-check mt-3"><input asp-for="Input.AcceptTerms" class="form-check-input" type="checkbox" required id="terms"><label class="form-check-label" for="terms">Aceito os termos.</label></div><div class="form-check mt-2"><input asp-for="Input.AcceptPrivacy" class="form-check-input" type="checkbox" required id="privacy"><label class="form-check-label" for="privacy">Aceito a <a asp-page="/Privacidade">política de privacidade</a>.</label></div><button class="btn btn-success w-100 mt-4" data-loading>Criar conta grátis</button><a class="btn btn-link w-100 mt-2" asp-page="/Support/Index">Falar com a MNSOFT</a></form></div></div></div></div></section>
