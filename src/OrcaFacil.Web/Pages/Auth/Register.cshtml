@page
@model OrcaFacil.Web.Pages.Auth.RegisterModel
@{ Layout="/Pages/Shared/_PublicLayout.cshtml"; ViewData["Title"]="Criar conta"; }
<section class="of-hero"><div class="container"><div class="of-public-card p-4 p-lg-5"><div class="row g-4"><div class="col-lg-5"><p class="of-eyebrow">Plano Free</p><h1 class="h2 text-dark">Crie sua conta grátis.</h1><p class="text-muted">Comece com PDF com marca OrçaFácil e evolua para Pro quando quiser.</p></div><div class="col-lg-7"><form method="post" class="of-card shadow-none">@Html.AntiForgeryToken()<div asp-validation-summary="ModelOnly" class="text-danger"></div><label asp-for="Input.Name" class="form-label">Nome/empresa</label><input asp-for="Input.Name" class="form-control"/><span asp-validation-for="Input.Name" class="text-danger"></span><label asp-for="Input.Email" class="form-label">E-mail</label><input asp-for="Input.Email" class="form-control"/><span asp-validation-for="Input.Email" class="text-danger"></span><label asp-for="Input.Password" class="form-label">Senha</label><input asp-for="Input.Password" class="form-control"/><span asp-validation-for="Input.Password" class="text-danger"></span><label class="form-label" for="ConfirmPassword">Confirmar senha</label><input id="ConfirmPassword" name="ConfirmPassword" type="password" class="form-control" minlength="6" required /><div class="form-check mt-3"><input asp-for="Input.AcceptTerms" class="form-check-input" type="checkbox" required id="terms"><label class="form-check-label" for="terms">Aceito os termos.</label></div><div class="form-check mt-2"><input asp-for="Input.AcceptPrivacy" class="form-check-input" type="checkbox" required id="privacy"><label class="form-check-label" for="privacy">Aceito a <a asp-page="/Privacidade">privacidade</a>.</label></div><button class="btn btn-success w-100 mt-4" data-loading>Criar conta grátis</button></form></div></div></div></div></section>
