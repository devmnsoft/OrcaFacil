@page
@model OrcaFacil.Web.Pages.Auth.RegisterModel
@{ ViewData["Title"] = "Cadastro"; }
<div class="auth-card"><h1>Começar grátis</h1><form method="post">@Html.AntiForgeryToken()<div asp-validation-summary="ModelOnly" class="text-danger"></div><label class="form-label">Nome</label><input asp-for="Input.Name" class="form-control"/><label class="form-label mt-2">E-mail</label><input asp-for="Input.Email" class="form-control"/><label class="form-label mt-2">Senha</label><input asp-for="Input.Password" type="password" class="form-control"/><div class="form-check mt-3"><input asp-for="Input.AcceptTerms" class="form-check-input"/><label class="form-check-label">Aceito os termos</label></div><div class="form-check"><input asp-for="Input.AcceptPrivacy" class="form-check-input"/><label class="form-check-label">Aceito a política de privacidade</label></div><button class="btn btn-success w-100 mt-3">Cadastrar</button></form></div>
