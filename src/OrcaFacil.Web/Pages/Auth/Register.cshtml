@page
@model OrcaFacil.Web.Pages.Auth.RegisterModel
@{ Layout="/Pages/Shared/_PublicLayout.cshtml"; ViewData["Title"]="Criar conta"; }
<section class="of-public-auth of-section-light">
  <div class="container">
    <div class="of-auth-shell">
      <aside class="auth-side-panel of-section-dark">
        <p class="of-eyebrow of-on-dark-muted">OrçaFácil · um produto MNSOFT</p>
        <h1 class="display-5 fw-black">Crie sua conta grátis.</h1>
        <p class="lead">Gere orçamentos e recibos profissionais em PDF, organize seu histórico e envie documentos mais confiáveis para seus clientes.</p>
        <div class="of-illustration-card my-4"><img class="of-illustration" src="~/img/illustrations/register-documents.svg" alt="Documentos de orçamento e recibo com PDF, cliente e aprovação" /></div>
        <ul class="of-benefit-list">
          <li><i class="bi bi-file-earmark-text"></i> Orçamentos profissionais em PDF</li>
          <li><i class="bi bi-receipt"></i> Recibos com aparência organizada</li>
          <li><i class="bi bi-clock-history"></i> Histórico salvo</li>
          <li><i class="bi bi-phone"></i> Funciona no celular</li>
          <li><i class="bi bi-check-circle"></i> Comece grátis</li>
          <li><i class="bi bi-life-preserver"></i> Suporte MNSOFT</li>
        </ul>
      </aside>
      <div class="of-auth-panel">
        <form method="post" class="of-form-card of-card shadow-none" novalidate>@Html.AntiForgeryToken()
          <p class="of-eyebrow">Cadastro</p><h2 class="h1 fw-bold">Começar grátis</h2><p class="of-muted">Preencha seus dados para criar sua conta.</p>
          <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
          <label asp-for="Input.Name" class="form-label">Nome ou empresa</label><div class="of-input-field"><i class="bi bi-person of-input-icon" aria-hidden="true"></i><input asp-for="Input.Name" class="form-control of-input with-icon" autocomplete="organization" placeholder="Ex.: Marcelo Serviços" aria-describedby="Input_Name-error" /></div><span asp-validation-for="Input.Name" class="text-danger d-block mt-1"></span>
          <label asp-for="Input.Email" class="form-label">E-mail</label><div class="of-input-field"><i class="bi bi-envelope of-input-icon" aria-hidden="true"></i><input asp-for="Input.Email" class="form-control of-input with-icon" autocomplete="email" placeholder="seuemail@exemplo.com" aria-describedby="Input_Email-error" /></div><span asp-validation-for="Input.Email" class="text-danger d-block mt-1"></span>
          <label asp-for="Input.Password" class="form-label">Senha</label><div class="of-password-field"><i class="bi bi-lock of-input-icon" aria-hidden="true"></i><input asp-for="Input.Password" type="password" class="form-control of-input with-icon with-toggle" placeholder="Mínimo de 6 caracteres" autocomplete="new-password" aria-describedby="Input_Password-error" /><button type="button" class="of-password-toggle" data-password-toggle aria-label="Mostrar senha"><i class="bi bi-eye" aria-hidden="true"></i></button></div><span asp-validation-for="Input.Password" class="text-danger d-block mt-1"></span>
          <label asp-for="Input.ConfirmPassword" class="form-label">Confirmar senha</label><div class="of-password-field"><i class="bi bi-lock of-input-icon" aria-hidden="true"></i><input asp-for="Input.ConfirmPassword" type="password" class="form-control of-input with-icon with-toggle" placeholder="Repita sua senha" autocomplete="new-password" aria-describedby="Input_ConfirmPassword-error" /><button type="button" class="of-password-toggle" data-password-toggle aria-label="Mostrar senha"><i class="bi bi-eye" aria-hidden="true"></i></button></div><span asp-validation-for="Input.ConfirmPassword" class="text-danger d-block mt-1"></span>
          <div class="of-check-row mt-3"><input asp-for="Input.AcceptTerms" class="form-check-input" type="checkbox" id="terms"><label class="form-check-label" for="terms">Aceito os <a asp-page="/Termos">termos</a> para continuar.</label></div><span asp-validation-for="Input.AcceptTerms" class="text-danger d-block mt-1"></span>
          <div class="of-check-row mt-2"><input asp-for="Input.AcceptPrivacy" class="form-check-input" type="checkbox" id="privacy"><label class="form-check-label" for="privacy">Aceito a <a asp-page="/Privacidade">política de privacidade</a> para continuar.</label></div><span asp-validation-for="Input.AcceptPrivacy" class="text-danger d-block mt-1"></span>
          <div class="of-security-note mt-3"><i class="bi bi-shield-lock" aria-hidden="true"></i><span>Seus dados serão usados para organizar seus documentos e melhorar sua experiência no OrçaFácil.</span></div>
          <button class="btn btn-success btn-lg w-100 mt-4" data-loading>Criar conta grátis <i class="bi bi-arrow-right-circle ms-1"></i></button>
          <div class="d-grid d-sm-flex gap-2 mt-2"><a class="btn btn-outline-primary flex-fill" asp-page="/Auth/Login">Já tenho conta</a><a class="btn btn-link flex-fill" asp-page="/Support/Index"><i class="bi bi-chat-dots"></i> Falar com a MNSOFT</a></div>
        </form>
      </div>
    </div>
  </div>
</section>
