@page
@model OrcaFacil.Web.Pages.Auth.ResetPasswordModel
@{ Layout = "/Pages/Shared/_PublicLayout.cshtml"; ViewData["Title"] = "Criar nova senha"; }
<section class="of-public-auth of-section-light">
<div class="container">
<div class="of-auth-panel mx-auto">@if(!Model.Available){
<div class="of-form-card of-card">
<h1>Este link não está mais disponível.</h1>
<a asp-page="/Auth/ForgotPassword" class="btn btn-primary">Solicitar novo link</a>
<a asp-page="/Auth/Login" class="btn btn-link">Voltar para entrar</a>
<a asp-page="/Support/Index" class="btn btn-link">Falar com o suporte</a>
</div>
}else{
<form method="post" class="of-form-card of-card">@Html.AntiForgeryToken()<input asp-for="Token" type="hidden"/>
<h1>Crie uma nova senha.</h1>
<p class="of-muted">Use pelo menos 8 caracteres, combinando letras e números.</p>
<div asp-validation-summary="ModelOnly" class="alert alert-danger">
</div>
<label asp-for="Password" class="form-label">Nova senha</label>
<input asp-for="Password" type="password" class="form-control" autocomplete="new-password"/>
<label asp-for="Confirmation" class="form-label mt-3">Confirmar nova senha</label>
<input asp-for="Confirmation" type="password" class="form-control" autocomplete="new-password"/>
<button class="btn btn-primary btn-lg w-100 mt-4">Atualizar senha</button>
</form>
}</div>
</div>
</section>
