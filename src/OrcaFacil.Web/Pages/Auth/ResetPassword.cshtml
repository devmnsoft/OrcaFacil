@page
@model OrcaFacil.Web.Pages.Auth.ResetPasswordModel
@{ Layout = "/Pages/Shared/_PublicLayout.cshtml"; ViewData["Title"] = "Criar nova senha"; }
<section class="of-public-auth">
<div class="of-container">
<div class="of-auth-card of-auth-card-standalone">@if(!Model.Available){
<div class="of-form-section">
<h1>Este link não está mais disponível.</h1>
<a asp-page="/Auth/ForgotPassword" class="of-button of-button-primary">Solicitar novo link</a>
<a asp-page="/Auth/Login" class="of-button of-button-tertiary">Voltar para entrar</a>
<a asp-page="/Support/Index" class="of-button of-button-tertiary">Falar com o suporte</a>
</div>
}else{
<form method="post" class="of-form-section">@Html.AntiForgeryToken()<input asp-for="Token" type="hidden"/>
<h1>Crie uma nova senha.</h1>
<p class="of-text-secondary">Use pelo menos 8 caracteres, combinando letras e números.</p>
<div asp-validation-summary="ModelOnly" class="of-form-summary">
</div>
<label asp-for="Password" class="of-field-label">Nova senha</label>
<input asp-for="Password" type="password" class="of-field-control" autocomplete="new-password"/>
<label asp-for="Confirmation" class="of-field-label">Confirmar nova senha</label>
<input asp-for="Confirmation" type="password" class="of-field-control" autocomplete="new-password"/>
<button type="submit" class="of-button of-button-primary of-button-block">Atualizar senha</button>
</form>
}</div>
</div>
</section>
