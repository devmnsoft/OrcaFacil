@page "/Admin/QualityGate"
@model OrcaFacil.Web.Pages.Admin.QualityGateModel
@{
    ViewData["Title"] = "Quality Gate V6.2";
    var snapshot = Model.Snapshot;
}
<div class="page-shell quality-gate-page">
    <nav class="breadcrumb" aria-label="Navegação estrutural"><a asp-page="/Admin/Index">Administração</a><span aria-hidden="true">/</span><span aria-current="page">Quality Gate</span></nav>
    <header class="page-hero quality-gate-hero">
        <div><span class="priority-badge">Governança V6.2</span><h1>Quality Gate</h1><p>Diagnóstico real de schema, rotas críticas e segurança da interface.</p></div>
        @if (snapshot is not null) { <div class="quality-score" aria-label="Pontuação geral"><strong>@snapshot.Score%</strong><span>@(snapshot.IsApproved ? "Aprovado" : "Requer ação")</span></div> }
    </header>

    @if (Model.LoadMessage is not null)
    {
        <section class="alert is-danger" role="alert" aria-live="assertive"><h2>Diagnóstico indisponível</h2><p>@Model.LoadMessage</p></section>
    }
    else if (snapshot is not null)
    {
        <section class="quality-summary" aria-label="Resumo do gate">
            <article class="summary-card"><span>Regras aprovadas</span><strong>@snapshot.Passed</strong></article>
            <article class="summary-card"><span>Regras com falha</span><strong>@snapshot.Failed</strong></article>
            <article class="summary-card"><span>Rotas testadas</span><strong>@snapshot.Rules.Count(x => x.Category == "Rotas")</strong></article>
            <article class="summary-card"><span>Última execução</span><strong>@snapshot.ExecutedAt.ToLocalTime().ToString("dd/MM HH:mm")</strong></article>
        </section>
        <section class="schema-health-card"><div class="section-header"><div><h2>Resultado dos controles</h2><p>Responsável: @snapshot.Responsible</p></div><span class="status-badge @(snapshot.IsApproved ? "is-success" : "is-warning")">@(snapshot.IsApproved ? "Saudável" : "Atenção")</span></div>
            <div class="quality-rule-list">
            @foreach (var rule in snapshot.Rules)
            {
                <article class="quality-gate-card @(rule.Passed ? "is-passed" : "is-failed")">
                    <div><span class="risk-badge">@rule.Category</span><h3>@rule.Description</h3><p>@rule.Evidence</p></div>
                    <span class="status-badge @(rule.Passed ? "is-success" : "is-danger")">@(rule.Passed ? "Aprovada" : "Falhou")</span>
                </article>
            }
            </div>
        </section>
        <aside class="alert is-info" role="status" aria-live="polite"><strong>Próxima ação recomendada</strong><p>@snapshot.NextAction</p></aside>
    }
    else { <section class="loading-state" aria-busy="true"><span class="skeleton-card"></span><p>Preparando diagnóstico…</p></section> }
</div>
