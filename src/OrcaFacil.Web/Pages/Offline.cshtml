@page "/Offline"
@{
  Layout = "Shared/_PublicLayout";
  ViewData["Title"] = "Sem conexão";
}
<section class="of-offline-page" aria-labelledby="offline-title">
  <img src="~/img/brand/orcafacil-symbol.svg" width="88" height="88" alt="" />
  <p class="of-eyebrow">Conexão indisponível</p>
  <h1 id="offline-title">Você está sem conexão</h1>
  <p>Algumas áreas do OrçaFácil precisam de internet para salvar dados com segurança. Verifique sua conexão e tente novamente.</p>
  <button class="of-button of-button-primary" type="button" data-offline-retry>Tentar novamente</button>
</section>
