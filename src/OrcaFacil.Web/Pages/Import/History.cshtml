@page "/Import/History"
@model OrcaFacil.Web.Pages.Import.IndexModel
@{ ViewData["Title"]="Histórico de importações"; ViewData["Section"]="Cadastros"; }
<header class="of-import-hero"><div><p class="of-eyebrow">Governança</p><h1>Histórico de importações</h1><p>Acompanhe os arquivos processados e seus resultados, sempre limitados à conta ativa.</p></div><a class="of-button" asp-page="/Import/Index">Nova importação</a></header>
<section class="of-import-history">@if(Model.Recent.Count==0){<div class="of-empty-state"><h2>Histórico vazio</h2><p>As validações e importações concluídas aparecerão aqui.</p></div>}else{<div class="of-table-scroll"><table class="of-import-table"><thead><tr><th>Data</th><th>Arquivo</th><th>Tipo</th><th>Status</th><th>Total</th><th>Importados</th><th>Erros</th><th>Ações</th></tr></thead><tbody>@foreach(var item in Model.Recent){<tr><td data-label="Data">@item.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td><td data-label="Arquivo">@item.FileName</td><td data-label="Tipo">@item.Type</td><td data-label="Status">@item.Status</td><td data-label="Total">@item.TotalRows</td><td data-label="Importados">@item.ImportedRows</td><td data-label="Erros">@item.FailedRows</td><td data-label="Ações">@if(item.FailedRows>0){<a asp-page-handler="Errors" asp-route-id="@item.Id">CSV de erros</a>}</td></tr>}</tbody></table></div>}</section>
