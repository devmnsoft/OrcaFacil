@model OrcaFacil.Application.Commercial.CommercialDashboardView
<div class="of-product-visual of-pipeline-preview" aria-label="Pipeline comercial da conta">
    <header><span><i></i><strong>Pipeline</strong></span><small>Dados reais da conta</small></header>
    <div class="of-pipeline-columns">
        @foreach (var column in Model.Pipeline)
        {
            <section>
                <div class="of-pipeline-column-title"><strong>@column.Title</strong><span>@column.Count</span></div>
                <small>@column.Total.ToString("C") em oportunidades</small>
                @if (column.Cards.Count == 0) { <p class="of-pipeline-empty">Nenhuma proposta neste estágio.</p> }
                @foreach (var card in column.Cards)
                {
                    <a class="of-pipeline-card" asp-page="/Documents/Details" asp-route-id="@card.DocumentId">
                        <strong>@card.ClientName</strong><span>@card.Number · @card.Total.ToString("C")</span><em>@card.Context</em>
                    </a>
                }
            </section>
        }
    </div>
</div>
