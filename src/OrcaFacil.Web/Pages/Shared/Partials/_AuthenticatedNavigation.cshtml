@model string
@using OrcaFacil.Application.Abstractions
@using OrcaFacil.Application.Security
@inject ICurrentAccountService CurrentAccount
@{ string Active(string path) => Model.StartsWith(path, StringComparison.OrdinalIgnoreCase) ? "is-active" : string.Empty; }
<nav class="of-menu">
  <a class="@Active("/Dashboard")" asp-page="/Dashboard/Index">Dashboard</a><a class="@Active("/CommercialPipeline")" asp-page="/CommercialPipeline/Index">Pipeline</a><a class="@Active("/CommercialRoutine")" asp-page="/CommercialRoutine/Index">Rotina comercial</a>
  <a class="@Active("/Documents/New")" asp-page="/Documents/New">Novo orçamento</a><a class="@Active("/Documents/Index")" asp-page="/Documents/Index">Orçamentos</a>
  <a class="@Active("/Clients")" asp-page="/Clients/Index">Clientes</a><a class="@Active("/Services")" asp-page="/Services/Index">Serviços</a><a class="@Active("/Contracts")" asp-page="/Contracts/Index">Contratos</a><a class="@Active("/Contracts/Dashboard")" asp-page="/Contracts/Dashboard">Dashboard de contratos</a>
  <a class="@Active("/WorkOrders")" asp-page="/WorkOrders/Index">OS</a><a class="@Active("/Schedule")" asp-page="/Schedule/Index">Agenda</a>
  <span class="of-menu-heading">Financeiro</span><a class="@Active("/Receivables")" asp-page="/Receivables/Index">Contas a receber</a><a class="@Active("/Payments")" asp-page="/Payments/Index">Pagamentos</a><a class="@Active("/Receipts")" asp-page="/Receipts/Index">Recibos</a><a class="@Active("/CashFlow")" asp-page="/CashFlow/Index">Fluxo de caixa</a><a class="@Active("/Reports/Financial")" asp-page="/Reports/Financial">Relatórios financeiros</a>
  <a class="@Active("/Reports")" asp-page="/Reports/Index">Relatórios</a><a class="@Active("/Alerts")" asp-page="/Alerts/Index">Alertas</a><a class="@Active("/MessageTemplates")" asp-page="/MessageTemplates/Index">Templates de mensagem</a>
  @if (await CurrentAccount.HasPermissionAsync(PermissionCodes.MarketplaceView)) { <span class="of-menu-heading">Ecossistema</span><a class="@Active("/Marketplace")" asp-page="/Marketplace/Index">Marketplace</a><a class="@Active("/Marketplace/Installations")" asp-page="/Marketplace/Installations">Pacotes instalados</a> }
  @if (await CurrentAccount.HasPermissionAsync(PermissionCodes.AnalyticsExecutive)) { <span class="of-menu-heading">Analytics</span><a class="@Active("/Analytics/Executive")" asp-page="/Analytics/Executive">BI Executivo</a> }
  @if (await CurrentAccount.HasPermissionAsync(PermissionCodes.AnalyticsForecast)) { <a class="@Active("/Analytics/Forecast")" asp-page="/Analytics/Forecast">Forecast</a> }
  @if (await CurrentAccount.HasPermissionAsync(PermissionCodes.DataQualityView)) { <a class="@Active("/Analytics/DataQuality")" asp-page="/Analytics/DataQuality">Qualidade dos Dados</a> }
  @if (await CurrentAccount.HasPermissionAsync(PermissionCodes.AccountHealthView)) { <a class="@Active("/Analytics/AccountHealth")" asp-page="/Analytics/AccountHealth">Saúde da Conta</a> }
  <a class="@Active("/Help")" asp-page="/Help/Index">Ajuda</a><a class="@Active("/Feedback")" asp-page="/Feedback/Index">Feedback</a><a class="@Active("/Settings/Setup")" asp-page="/Settings/Setup">Checklist de implantação</a>
  <a class="@Active("/Settings")" asp-page="/Settings/Index">Configurações</a><a class="@Active("/Subscription")" asp-page="/Subscription/Index">Meu plano</a><a class="@Active("/Support")" asp-page="/Support/Index">Suporte</a>
  @if (User.IsInRole("SuperAdmin")) { <a asp-area="Admin" asp-page="/Dashboard">Admin</a><a asp-page="/Diagnostico">Diagnóstico</a> }
</nav>
