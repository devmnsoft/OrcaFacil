@model string
@using OrcaFacil.Web.Services
@inject IUserMenuComposer MenuComposer
@{ string Active(string path) => Model.StartsWith(path, StringComparison.OrdinalIgnoreCase) ? "is-active" : string.Empty; }
<nav class="of-menu">
  @{ string? group = null; }
  @foreach (var item in await MenuComposer.ComposeAsync()) {
    if (!string.Equals(group, item.Group, StringComparison.Ordinal)) { group = item.Group; <span class="of-menu-heading">@group</span> }
    <a class="@Active(item.Page.Replace("/Index", ""))" asp-page="@item.Page">@item.Label</a>
  }
</nav>
