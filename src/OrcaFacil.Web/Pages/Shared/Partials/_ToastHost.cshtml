@using OrcaFacil.Web.Extensions
@{ var toasts = TempData.ReadToasts(); }
<div class="toast-container position-fixed top-0 end-0 p-3" id="toastHost" data-toast-host aria-live="polite" aria-atomic="true">
@foreach (var toast in toasts)
{
  <div class="toast of-toast of-toast-@toast.Type" role="@(toast.Type == "danger" ? "alert" : "status")" data-bs-delay="5200">
    <div class="toast-header">
      <i class="bi @toast.IconCss me-2" aria-hidden="true"></i><strong class="me-auto">@toast.Title</strong>
      <button type="button" class="btn-close" data-bs-dismiss="toast" aria-label="Fechar"></button>
    </div>
    <div class="toast-body">@toast.Message</div>
  </div>
}
</div>
