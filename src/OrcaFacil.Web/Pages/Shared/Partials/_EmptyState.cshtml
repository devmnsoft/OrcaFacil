@model OrcaFacil.Web.ViewModels.Components.EmptyStateViewModel
<div class="of-empty"><div class="of-empty-icon"><i class="bi @Model.Icon" aria-hidden="true"></i></div><h2 class="h4">@Model.Title</h2><p>@Model.Text</p>@if(!string.IsNullOrWhiteSpace(Model.ActionText)&&!string.IsNullOrWhiteSpace(Model.ActionPage)){<a class="btn btn-primary" asp-page="@Model.ActionPage">@Model.ActionText</a>}</div>
