@model OrcaFacil.Web.ViewModels.Components.StepCardViewModel
<article class="of-step-card @(Model.IsActive ? "is-active" : "") @(Model.IsDone ? "is-done" : "")">
    <div class="of-step-number">
        <span aria-hidden="true">@Model.Number</span>
    </div>
    <h3>@Model.Title</h3>
    <p>@Model.Text</p>
    @if (!string.IsNullOrWhiteSpace(Model.ActionText) && !string.IsNullOrWhiteSpace(Model.ActionPage))
    {
        <a class="of-button of-button-primary" asp-page="@Model.ActionPage">@Model.ActionText</a>
    }
</article>
