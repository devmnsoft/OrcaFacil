@model string
@inject OrcaFacil.Web.Services.IContextualHelpService Help
@{ var guide = Help.Find(Model); }
@if (guide is not null) {
<aside class="help-drawer" data-help-drawer>
 <details><summary class="help-trigger">Ajuda</summary><div class="help-drawer__panel"><header><span class="eyebrow">Guia da tela</span><h2>@guide.Title</h2></header><p>@guide.Summary</p><h3>Quando usar</h3><p>@guide.WhenToUse</p><h3>Próximo passo</h3><p>@guide.WhatHappensNext</p><h3>Passos importantes</h3><ol>@foreach(var step in guide.Steps){<li>@step</li>}</ol><h3>Erros comuns</h3><ul>@foreach(var error in guide.CommonErrors){<li>@error</li>}</ul><a class="button button-secondary" href="/Training">Abrir guia completo</a></div></details>
</aside>}
