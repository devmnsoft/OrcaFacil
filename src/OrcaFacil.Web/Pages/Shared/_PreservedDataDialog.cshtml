@model OrcaFacil.Web.ViewModels.DialogViewModel
<section id="@Model.Id" class="of-experience-dialog" hidden role="dialog" aria-modal="true" aria-labelledby="@($"{Model.Id}-title")" aria-describedby="@($"{Model.Id}-description")">
 <div><button type="button" data-dialog-close aria-label="Fechar">×</button><h2 id="@($"{Model.Id}-title")">@Model.Title</h2><p id="@($"{Model.Id}-description")">@Model.Description</p>@if(!string.IsNullOrWhiteSpace(Model.ConfirmPage)){<a href="@Model.ConfirmPage">@Model.ConfirmLabel</a>}else{<button type="button" data-dialog-close>@Model.ConfirmLabel</button>}</div>
</section>
