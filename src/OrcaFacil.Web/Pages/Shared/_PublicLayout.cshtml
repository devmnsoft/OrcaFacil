<!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>@ViewData["Title"] · OrçaFácil</title>
  <meta name="description" content="Orçamentos, clientes, serviços e recibos organizados em um só lugar." />
  <link rel="stylesheet" href="~/css/tokens.css" asp-append-version="true" />
  <link rel="stylesheet" href="~/css/icons.css" asp-append-version="true" />
  <link rel="stylesheet" href="~/css/base.css" asp-append-version="true" />
  <link rel="stylesheet" href="~/css/surfaces.css" asp-append-version="true" />
  <link rel="stylesheet" href="~/css/components.css" asp-append-version="true" />
  <link rel="stylesheet" href="~/css/forms.css" asp-append-version="true" />
  <link rel="stylesheet" href="~/css/overlays.css" asp-append-version="true" />
  <link rel="stylesheet" href="~/css/feedback.css" asp-append-version="true" />
  <link rel="stylesheet" href="~/css/public.css" asp-append-version="true" />
  <link rel="stylesheet" href="~/css/responsive.css" asp-append-version="true" />
  @await RenderSectionAsync("Styles", false)
</head>
<body class="of-public">
  <partial name="Partials/_IconSprite" />
  <a class="of-skip-link" href="#main-content">Ir para o conteúdo</a>
  <header class="of-public-header">
    <nav class="of-public-nav of-container" aria-label="Navegação institucional">
      <a class="of-public-brand" asp-page="/Index" aria-label="OrçaFácil, página inicial"><img src="~/img/brand/orcafacil-wordmark-light.svg" width="190" height="42" alt="OrçaFácil — um produto MNSOFT" /></a>
      <button class="of-public-menu-button" type="button" data-public-menu-button aria-controls="public-menu" aria-expanded="false"><svg class="of-icon" aria-hidden="true"><use href="#of-icon-menu" /></svg><span>Menu</span></button>
      <div class="of-public-menu" id="public-menu" data-public-menu>
        <a href="/#como-funciona">Como funciona</a><a href="/#recursos">Recursos</a><a asp-page="/Precos">Preços</a><a asp-page="/Support/Index">Suporte</a>
        <a class="of-button of-button-secondary of-button-on-dark" asp-page="/Auth/Login">Entrar</a><a class="of-button of-button-primary" asp-page="/Auth/Register">Começar grátis</a>
      </div>
    </nav>
  </header>
  <main id="main-content"><partial name="Partials/_ToastHost" />@RenderBody()</main>
  <footer class="of-public-footer"><div class="of-container of-public-footer-grid"><div><img src="~/img/brand/orcafacil-wordmark-light.svg" width="190" height="42" alt="OrçaFácil — um produto MNSOFT" /><p>Seu trabalho organizado, do orçamento ao recibo.</p></div><nav aria-label="Links do rodapé"><strong>OrçaFácil</strong><a href="/#como-funciona">Como funciona</a><a href="/#recursos">Recursos</a><a asp-page="/Precos">Preços</a></nav><div><strong>Atendimento MNSOFT</strong><a href="mailto:comercial@mnsoft.com.br">comercial@mnsoft.com.br</a><span>CNPJ 18.160.057/0001-13</span></div></div><div class="of-container of-footer-bottom">© @DateTime.UtcNow.Year OrçaFácil. Todos os direitos reservados.</div></footer>
  <partial name="Partials/_OverlayHost" />
  <script type="module" src="~/js/public.js" asp-append-version="true"></script>
  <script type="module" src="~/js/ui/feedback.js" asp-append-version="true"></script>
  @await RenderSectionAsync("Scripts", false)
</body>
</html>
