<!doctype html>
@using OrcaFacil.Application.Localization
@{ var currentLocale = System.Globalization.CultureInfo.CurrentUICulture.Name; }
<html lang="@currentLocale" dir="ltr">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  @{ var seoTitle = ViewData["Title"]?.ToString() ?? "Gestão de serviços"; var seoDescription = ViewData["Description"]?.ToString() ?? "Crie orçamentos, organize clientes, acompanhe aprovações, registre pagamentos e emita recibos profissionais."; var publicBaseUrl = Context.RequestServices.GetRequiredService<IConfiguration>()["PublicSite:BaseUrl"]?.TrimEnd('/'); var canonical = string.IsNullOrWhiteSpace(publicBaseUrl) ? $"{Context.Request.Scheme}://{Context.Request.Host}{Context.Request.Path}" : $"{publicBaseUrl}{Context.Request.Path}"; }
  <title>@seoTitle · OrçaFácil</title>
  <meta name="description" content="@seoDescription" />
  <link rel="canonical" href="@canonical" />
  <meta property="og:type" content="website" /><meta property="og:site_name" content="OrçaFácil" /><meta property="og:title" content="@seoTitle" /><meta property="og:description" content="@seoDescription" /><meta property="og:url" content="@canonical" />
  <meta name="twitter:card" content="summary" /><meta name="twitter:title" content="@seoTitle" /><meta name="twitter:description" content="@seoDescription" />
  <script type="application/ld+json">{"@@context":"https://schema.org","@@type":"Organization","name":"OrçaFácil","url":"@canonical","legalName":"MNSOFT"}</script>
  <meta name="theme-color" content="#0B1F33" />
  <link rel="manifest" href="~/site.webmanifest" />
  <link rel="icon" type="image/svg+xml" href="~/favicon.svg" />
  <link rel="stylesheet" href="~/css/tokens.css" asp-append-version="true" />
  <link rel="stylesheet" href="~/css/icons.css" asp-append-version="true" />
  <link rel="stylesheet" href="~/css/base.css" asp-append-version="true" />
  <link rel="stylesheet" href="~/css/surfaces.css" asp-append-version="true" />
  <link rel="stylesheet" href="~/css/components.css" asp-append-version="true" />
  <link rel="stylesheet" href="~/css/forms.css" asp-append-version="true" />
  <link rel="stylesheet" href="~/css/overlays.css" asp-append-version="true" />
  <link rel="stylesheet" href="~/css/feedback.css" asp-append-version="true" />
  <link rel="stylesheet" href="~/css/public.css" asp-append-version="true" />
  <link rel="stylesheet" href="~/css/responsive.css" asp-append-version="true" />
  @await RenderSectionAsync("Styles", false)
  <link rel="stylesheet" href="~/css/support.css" asp-append-version="true" />
</head>
<body class="of-public-shell">
  <partial name="Partials/_IconSprite" />
  <a class="of-skip-link" href="#main-content">Ir para o conteúdo principal</a>
  <header class="of-public-header" data-public-header>
    <nav class="of-public-nav of-container" aria-label="Navegação principal">
      <a class="of-public-brand" asp-page="/Index" aria-label="OrçaFácil, início">
        <img src="~/img/brand/orcafacil-wordmark-light.svg" width="190" height="42" alt="OrçaFácil" />
        <span>um produto <strong>MNSOFT</strong></span>
      </a>
      <button class="of-public-menu-button" type="button" data-public-menu-button aria-controls="public-menu" aria-expanded="false" aria-label="Abrir menu de navegação">
        <svg class="of-icon of-menu-open" aria-hidden="true"><use href="#of-icon-menu" /></svg>
        <svg class="of-icon of-menu-close" aria-hidden="true"><use href="#of-icon-close" /></svg><span>Menu</span>
      </button>
      <div class="of-public-menu" id="public-menu" data-public-menu>
        <a asp-page="/Recursos/Index">Recursos</a>
        <a asp-page="/Segmentos/Index">Segmentos</a>
        <a asp-page="/Precos">Preços</a>
        <a asp-page="/Blog/Index">Blog</a><a asp-page="/Recursos/Materiais">Materiais</a><a asp-page="/Seguranca">Segurança</a><a asp-page="/Status">Status</a><a asp-page="/Contato">Contato</a>
        <form method="post" action="/locale" class="of-locale-selector">
          <input type="hidden" name="returnUrl" value="@(Context.Request.Path + Context.Request.QueryString)" />
          <label class="of-sr-only" for="public-locale">Idioma</label>
          <select id="public-locale" name="culture" aria-label="Idioma" onchange="this.form.submit()">
            @foreach (var locale in SupportedLocales.All.Values.Where(x => x.IsActive && x.IsPublicEnabled))
            { <option value="@locale.Code" selected="@(locale.Code == currentLocale)">@locale.NativeName</option> }
          </select>
          <noscript><button type="submit" class="of-button of-button-secondary">Aplicar idioma</button></noscript>
        </form>
        <span class="of-public-menu-actions"><a class="of-button of-button-secondary of-button-on-dark" asp-page="/Auth/Login">Entrar</a><a class="of-button of-button-primary" asp-page="/Auth/Register">Começar grátis</a></span>
      </div>
    </nav>
  </header>
  <main id="main-content" tabindex="-1"><partial name="Partials/_ToastHost" />@RenderBody()</main>
  <footer class="of-public-footer">
    <div class="of-container of-public-footer-grid">
      <div class="of-footer-brand"><img src="~/img/brand/orcafacil-wordmark-light.svg" width="190" height="42" alt="OrçaFácil" /><p class="of-footer-endorsement">Um produto <strong>MNSOFT</strong></p><p>Orçamentos, clientes, serviços, pagamentos e recibos organizados para valorizar o seu trabalho.</p></div>
      <nav aria-label="Produto"><strong>Produto</strong><a asp-page="/Index">Início</a><a asp-page="/Recursos/Index">Recursos</a><a asp-page="/Segmentos/Index">Segmentos</a><a asp-page="/Precos">Preços</a><a asp-page="/Status">Status</a></nav>
      <nav aria-label="Conta e ajuda"><strong>Conta e ajuda</strong><a asp-page="/Auth/Login">Entrar</a><a asp-page="/Auth/Register">Criar conta</a><a asp-page="/Help/Index">Ajuda</a><a asp-page="/Support/Index">Suporte</a></nav>
      <nav aria-label="Informações legais"><strong>Legal</strong><a asp-page="/Termos">Termos de uso</a><a asp-page="/Privacidade">Privacidade</a><a asp-page="/Cookies">Cookies</a><a asp-page="/LGPD">LGPD</a><a asp-page="/Trust/Index">Trust Center</a></nav>
      <div class="of-footer-contact"><strong>Contato</strong><a href="mailto:comercial@mnsoft.com.br">comercial@mnsoft.com.br</a><span>CNPJ 18.160.057/0001-13</span><a class="of-button of-button-primary" asp-page="/Auth/Register">Criar conta grátis</a></div>
    </div>
    <div class="of-container of-footer-bottom"><span>© @DateTime.UtcNow.Year MNSOFT. Todos os direitos reservados.</span><span>OrçaFácil, feito para quem presta serviços.</span></div>
  </footer>
  <partial name="Partials/_OverlayHost" />
  <environment include="Development"><script src="~/js/diagnostics/js-health.js" asp-append-version="true"></script></environment>
  <script src="~/js/public.js" asp-append-version="true"></script>
  <script src="~/js/cookie-consent.js" asp-append-version="true"></script>
  <script src="~/js/pwa.js" asp-append-version="true"></script>
  <script src="~/js/pwa-install.js" asp-append-version="true"></script>
  <script src="~/js/offline-status.js" asp-append-version="true"></script>
  <script type="module" src="~/js/ui/feedback.js" asp-append-version="true"></script>
  @await RenderSectionAsync("Scripts", false)
</body>
</html>
