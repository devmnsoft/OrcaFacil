@using OrcaFacil.Web.Services
@inject IClientShellViewModelFactory ShellFactory
@{
    var authenticated = User.Identity?.IsAuthenticated == true;
    var shell = authenticated ? await ShellFactory.CreateAsync(Context.RequestAborted) : null;
    var currentPath = Context.Request.Path.Value ?? string.Empty;
    var pageTitle = ViewData["Title"]?.ToString() ?? "OrçaFácil";
    var pageSection = ViewData["Section"]?.ToString() ?? "Início";
    var helpCode = ViewData["HelpCode"]?.ToString() ?? "dashboard";
}
<!doctype html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>@pageTitle · OrçaFácil</title>
    <link rel="stylesheet" href="~/css/tokens.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/icons.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/base.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/surfaces.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/components.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/forms.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/app-layout.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/overlays.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/feedback.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/responsive.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", false)
</head>
<body>
    <partial name="Partials/_IconSprite" />
    <a class="of-skip-link" href="#main-content">Ir para o conteúdo</a>
    @if (shell is not null)
    {
        <div class="of-client-shell" data-client-shell>
            <aside class="of-client-sidebar" id="client-sidebar" aria-label="Navegação principal">
                <div class="of-sidebar-brand-row">
                    <a class="of-shell-brand" asp-page="/Dashboard/Index">
                        <img src="~/img/brand/orcafacil-wordmark-light.svg" alt="OrçaFácil, um produto MNSOFT" />
                    </a>
                    <button class="of-sidebar-toggle" type="button" data-sidebar-toggle aria-label="Recolher menu" aria-controls="client-sidebar" aria-expanded="true">
                        <svg class="of-icon" aria-hidden="true"><use href="#of-icon-menu" /></svg>
                    </button>
                </div>
                <button class="of-account-summary" type="button" data-account-switcher-open aria-haspopup="dialog" aria-controls="account-switcher" aria-label="Trocar conta">
                    <span class="of-avatar" aria-hidden="true">@shell.AccountName[..1].ToUpperInvariant()</span>
                    <span class="of-account-copy">
                        <strong>@shell.AccountName</strong>
                        <small>@shell.AccountRole</small>
                        <span class="of-plan-pill">@shell.EffectivePlanName · @shell.PlanAccessStatus</span>
                    </span>
                    <partial name="Partials/_Icon" model='new IconViewModel("chevron-down", "sm")' />
                </button>
                <a class="of-primary-create" asp-page="/Documents/CreateBudget" title="Novo orçamento">
                    <svg class="of-icon" aria-hidden="true"><use href="#of-icon-quote" /></svg>
                    <span>Novo orçamento</span>
                </a>
                <nav class="of-grouped-menu" aria-label="Áreas de trabalho">
                    @foreach (var group in shell.Menus)
                    {
                        <section>
                            <h2>@group.Label</h2>
                            @foreach (var item in group.Items)
                            {
                                var active = currentPath.StartsWith(item.Page, StringComparison.OrdinalIgnoreCase);
                                <a class="@(active ? "is-active" : null)" asp-page="@item.Page" aria-current="@(active ? "page" : null)" title="@item.Label">
                                    <svg class="of-icon" aria-hidden="true"><use href="#of-icon-@item.Icon" /></svg>
                                    <span class="of-menu-label">@item.Label</span>
                                    @if (item.Premium)
                                    {
                                        <span class="of-premium-tag" title="Disponível no plano @item.RequiredPlan">@item.RequiredPlan</span>
                                    }
                                </a>
                            }
                        </section>
                    }
                </nav>
                <div class="of-sidebar-profile">
                    <span class="of-avatar" aria-hidden="true">@shell.FirstName[..1].ToUpperInvariant()</span>
                    <span class="of-profile-copy"><strong>@shell.FirstName</strong><small>Minha conta</small></span>
                    <form method="post" asp-page="/Auth/Logout">
                        @Html.AntiForgeryToken()
                        <button type="submit" title="Sair" aria-label="Sair"><partial name="Partials/_Icon" model='new IconViewModel("logout", "sm")' /><span class="of-menu-label">Sair</span></button>
                    </form>
                </div>
            </aside>
            <div class="of-shell-stage">
                <header class="of-client-topbar">
                    <div class="of-topbar-heading">
                        <nav class="of-breadcrumb" aria-label="Breadcrumb">
                            <a asp-page="/Dashboard/Index">Início</a><span aria-hidden="true">/</span>
                            @if (pageSection != "Início") { <span>@pageSection</span><span aria-hidden="true">/</span> }
                            <span aria-current="page">@pageTitle</span>
                        </nav>
                        <strong>@pageTitle</strong>
                    </div>
                    <div class="of-topbar-actions">
                        <button class="of-search-trigger" type="button" data-search-open aria-haspopup="dialog">
                            <svg class="of-icon" aria-hidden="true"><use href="#of-icon-search" /></svg>
                            <span>Buscar</span><kbd>Ctrl K</kbd>
                        </button>
                        <button class="of-icon-button" type="button" data-help-open data-help-code="@helpCode" aria-haspopup="dialog" aria-label="Como usar esta página">
                            <svg class="of-icon" aria-hidden="true"><use href="#of-icon-help" /></svg>
                        </button>
                        <a class="of-icon-button" asp-page="/Notifications/Index" aria-label="Notificações: @shell.UnreadNotifications não lidas">
                            <svg class="of-icon" aria-hidden="true"><use href="#of-icon-notification" /></svg>
                            @if (shell.UnreadNotifications > 0) { <span class="of-notification-count">@shell.UnreadNotifications</span> }
                        </a>
                        <button class="of-topbar-avatar" type="button" data-profile-menu-trigger aria-label="Abrir menu do usuário" aria-haspopup="menu" aria-expanded="false">@shell.FirstName[..1].ToUpperInvariant()</button>
                        <div class="of-profile-menu" data-profile-menu hidden role="menu">
                            <header><span class="of-avatar" aria-hidden="true">@shell.FirstName[..1].ToUpperInvariant()</span><span><strong>@shell.FirstName</strong><small>@shell.MaskedEmail</small></span></header>
                            <div class="of-profile-context"><small>@shell.AccountName</small><span>@shell.AccountRole · @shell.EffectivePlanName</span></div>
                            <a role="menuitem" asp-page="/Profile/Index">Minha conta</a>
                            <a role="menuitem" asp-page="/Subscription/Index">Meu plano</a>
                            <a role="menuitem" asp-page="/Profile/Index" asp-fragment="security">Segurança</a>
                            <button role="menuitem" type="button" data-account-switcher-open>Trocar conta</button>
                            <form method="post" asp-page="/Auth/Logout">@Html.AntiForgeryToken()<button role="menuitem" type="submit">Sair</button></form>
                        </div>
                    </div>
                </header>
                <main class="of-content" id="main-content" tabindex="-1">
                    <partial name="Partials/_ToastHost" />
                    @RenderBody()
                </main>
            </div>
        </div>
        <nav class="of-mobile-nav" aria-label="Navegação móvel">
            <a asp-page="/Dashboard/Index"><svg class="of-icon"><use href="#of-icon-dashboard" /></svg><span>Início</span></a>
            <a asp-page="/Documents/Index"><svg class="of-icon"><use href="#of-icon-quote" /></svg><span>Orçamentos</span></a>
            <button type="button" class="of-mobile-new" data-action-open aria-haspopup="dialog"><partial name="Partials/_Icon" model='new IconViewModel("plus", "lg")' /><span>Novo</span></button>
            <a asp-page="/Clients/Index"><svg class="of-icon"><use href="#of-icon-client" /></svg><span>Clientes</span></a>
            <button type="button" data-menu-open><svg class="of-icon"><use href="#of-icon-menu" /></svg><span>Menu</span></button>
        </nav>
        <div class="of-action-sheet" data-action-sheet hidden role="dialog" aria-modal="true" aria-labelledby="action-title">
            <div class="of-sheet-panel">
                <span class="of-sheet-handle" aria-hidden="true"></span><h2 id="action-title">O que você quer criar?</h2>
                <p>Escolha o resultado que precisa agora.</p>
                <a asp-page="/Documents/CreateBudget"><svg class="of-icon"><use href="#of-icon-quote" /></svg><span><strong>Novo orçamento</strong><small>Prepare uma proposta com serviços, valores e condições.</small></span><span class="of-plan-pill">@shell.EffectivePlanName</span></a>
                <a asp-page="/Receipts/Create"><svg class="of-icon"><use href="#of-icon-receipt" /></svg><span><strong>Novo recibo</strong><small>Registre um valor recebido de forma organizada.</small></span><span class="of-plan-pill">@shell.EffectivePlanName</span></a>
                <a asp-page="/Clients/Create"><svg class="of-icon"><use href="#of-icon-client" /></svg><span><strong>Novo cliente</strong><small>Salve dados para reutilizar nos documentos.</small></span><span class="of-plan-pill">@shell.EffectivePlanName</span></a>
                <a asp-page="/Services/Index"><svg class="of-icon"><use href="#of-icon-service" /></svg><span><strong>Novo serviço</strong><small>Organize o catálogo usado nos seus orçamentos.</small></span><span class="of-plan-pill">Disponível</span></a>
                <button type="button" data-dialog-close>Cancelar</button>
            </div>
        </div>
        <div class="of-drawer" id="account-switcher" data-account-switcher hidden role="dialog" aria-modal="true" aria-labelledby="account-switcher-title">
            <div>
                <header>
                    <div><p class="of-eyebrow">Espaço de trabalho</p><h2 id="account-switcher-title">Trocar de conta</h2></div>
                    <button type="button" data-account-switcher-close aria-label="Fechar seletor de conta"><partial name="Partials/_Icon" model='new IconViewModel("close")' /></button>
                </header>
                <div class="of-account-switcher-current">
                    <span class="of-avatar" aria-hidden="true">@shell.AccountName[..1].ToUpperInvariant()</span>
                    <span><small>Conta atual</small><strong>@shell.AccountName</strong><span>@shell.AccountRole · @shell.EffectivePlanName</span></span>
                </div>
                <label class="of-account-search" hidden data-account-search-wrap>
                    <span>Buscar conta</span><input type="search" data-account-search autocomplete="off" placeholder="Digite o nome da conta" />
                </label>
                <form method="post" data-account-switch-form>
                    @Html.AntiForgeryToken()
                    <div class="of-account-switcher-list" data-account-list aria-live="polite" aria-busy="false">
                        <p>Carregando contas autorizadas…</p>
                    </div>
                    <p class="of-inline-message" data-account-error role="alert" hidden></p>
                </form>
            </div>
        </div>
        <div class="of-command-palette" data-search-dialog hidden role="dialog" aria-modal="true" aria-labelledby="search-title">
            <div>
                <header><svg class="of-icon"><use href="#of-icon-search" /></svg><label id="search-title" class="sr-only" for="global-search">Busca global</label><input id="global-search" type="search" placeholder="Buscar clientes, serviços e documentos" autocomplete="off" data-global-search /><kbd>Esc</kbd></header>
                <section aria-live="polite" aria-busy="false" data-search-results><p>Digite ao menos dois caracteres para buscar nesta conta.</p></section>
            </div>
        </div>
        <div class="of-drawer" data-help-drawer hidden role="dialog" aria-modal="true" aria-labelledby="help-title">
            <div>
                <header><div><p class="of-eyebrow">Como usar esta página</p><h2 id="help-title" data-help-title>Carregando ajuda…</h2></div><button type="button" data-dialog-close aria-label="Fechar ajuda"><partial name="Partials/_Icon" model='new IconViewModel("close")' /></button></header>
                <div data-help-content aria-live="polite" aria-busy="true"><p>Buscando orientações específicas para esta etapa.</p></div>
            </div>
        </div>
    }
    <partial name="Partials/_OverlayHost" />
    else
    {
        <main id="main-content"><partial name="Partials/_ToastHost" />@RenderBody()</main>
    }
    <script src="~/js/experience.js" asp-append-version="true"></script>
    <script type="module" src="~/js/shell.js" asp-append-version="true"></script>
    <script type="module" src="~/js/account-switcher.js" asp-append-version="true"></script>
    <script type="module" src="~/js/profile-menu.js" asp-append-version="true"></script>
    <script type="module" src="~/js/ui/feedback.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", false)
</body>
</html>
