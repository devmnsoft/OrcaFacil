<!doctype html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>@ViewData["Title"] · OrçaFácil</title>
    <link rel="stylesheet" href="~/css/tokens.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/base.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/surfaces.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/components.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/documents.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/responsive.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", false)
</head>
<body class="of-public-quote">
    <a class="of-skip-link" href="#quote-content">Ir para o orçamento</a>
    <header class="of-quote-brand of-container"><img src="~/img/brand/orcafacil-wordmark-dark.svg" width="180" alt="OrçaFácil — um produto MNSOFT" /></header>
    <main id="quote-content">@RenderBody()</main>
    <footer class="of-container of-quote-footer"><small>OrçaFácil · Um produto MNSOFT</small></footer>
    @await RenderSectionAsync("Scripts", false)
</body>
</html>
