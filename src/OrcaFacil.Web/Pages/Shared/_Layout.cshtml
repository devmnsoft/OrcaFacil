@using OrcaFacil.Application.Abstractions
@inject INotificationService NotificationService
@inject ICurrentUserService CurrentUser
@{
  var unreadNotifications = User.Identity?.IsAuthenticated == true ? await NotificationService.GetUnreadCountAsync(CurrentUser.UserId) : 0;
  var currentPath = Context.Request.Path.Value ?? string.Empty;
  string Active(string path) => currentPath.StartsWith(path, StringComparison.OrdinalIgnoreCase) ? "is-active" : string.Empty;
}
<!doctype html>
<html lang="@System.Globalization.CultureInfo.CurrentUICulture.Name" dir="ltr">
<head>
  <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>@ViewData["Title"] · Fechô</title>
  <meta name="theme-color" content="#0B3835" />
  <link rel="manifest" href="~/site.webmanifest" />
  <link rel="icon" type="image/svg+xml" href="~/favicon.svg" />
  <link rel="apple-touch-icon" href="~/img/brand/apple-touch-icon.png" />
  <link rel="stylesheet" href="~/css/app.css" asp-append-version="true" />
  <link rel="stylesheet" href="~/css/support.css" asp-append-version="true" />
  <link rel="stylesheet" href="~/css/mobile-app.css" asp-append-version="true" />
</head>
<body class="of-app-shell">
<a class="of-skip-link" href="#main-content">Ir para o conteúdo principal</a>
@if (User.Identity?.IsAuthenticated == true)
{
  <aside class="of-sidebar" aria-label="Menu principal">
    <a class="of-brand" asp-page="/Dashboard/Index"><img src="~/img/brand/fecho-symbol.svg" width="28" height="28" alt="" aria-hidden="true" /><span>Fechô</span></a>
    <partial name="Partials/_AuthenticatedNavigation" model="currentPath" />
    <div class="of-sidebar-footer"><a asp-page="/Notifications/Index">Notificações (@unreadNotifications)</a><small>@User.Identity?.Name</small><form method="post" asp-page="/Auth/Logout">@Html.AntiForgeryToken()<button type="submit" class="of-button">Sair</button></form></div>
  </aside>
  <header class="of-mobilebar"><button class="of-menu-toggle" type="button" data-menu-toggle aria-expanded="false" aria-controls="authenticated-menu" aria-label="Abrir menu"><span aria-hidden="true">☰</span></button><a class="of-brand" asp-page="/Dashboard/Index"><img src="~/img/brand/fecho-symbol.svg" width="28" height="28" alt="" aria-hidden="true" /><span>Fechô</span></a></header>
  <aside class="of-mobile-menu" id="authenticated-menu" data-menu-panel aria-hidden="true" aria-label="Menu principal móvel"><div class="of-mobile-menu__header"><strong>Menu</strong><button type="button" data-menu-close aria-label="Fechar menu"><span aria-hidden="true">×</span></button></div><partial name="Partials/_AuthenticatedNavigation" model="currentPath" /><form method="post" asp-page="/Auth/Logout">@Html.AntiForgeryToken()<button type="submit" class="of-button">Sair</button></form></aside>
  <main class="of-main" id="main-content" tabindex="-1"><partial name="_ToastHost" /><div class="of-page-container">@RenderBody()</div></main>
}
else { <main id="main-content" tabindex="-1"><partial name="_ToastHost" />@RenderBody()</main> }
<partial name="_ConfirmDialog" />
@if (User.Identity?.IsAuthenticated == true) { <aside class="of-feedback-widget" data-feedback-widget><button type="button" class="of-button of-button-secondary" data-feedback-open>Feedback</button><div class="of-feedback-panel" data-feedback-panel hidden><button type="button" class="of-feedback-close" data-feedback-close aria-label="Fechar">×</button><strong>Como foi sua experiência?</strong><form method="post" asp-page="/Feedback/Index"><input name="PageUrl" type="hidden" value="@currentPath" /><input name="CorrelationId" type="hidden" value="@Context.TraceIdentifier" />@foreach(var option in new[]{"Gostei","Não gostei","Algo está confuso","Encontrei um erro","Sugestão"}){<label><input name="Rating" type="radio" value="@option" required /> @option</label>}<label for="feedback-message">Detalhes opcionais</label><textarea id="feedback-message" name="Message" maxlength="2000" rows="3" placeholder="Não inclua dados sigilosos."></textarea><button type="submit" class="of-button of-button-primary">Enviar</button><a asp-page="/Support/Tickets">Precisa de resposta? Abra um chamado</a></form></div></aside> }
<environment include="Development"><script src="~/js/diagnostics/js-health.js" asp-append-version="true"></script></environment>
<script src="~/js/app.js" asp-append-version="true"></script>
<script src="~/js/pwa.js" asp-append-version="true"></script>
<script src="~/js/pwa-install.js" asp-append-version="true"></script>
<script src="~/js/offline-status.js" asp-append-version="true"></script>
<script type="module" src="~/js/feedback.js" asp-append-version="true"></script>
<script type="module" src="~/js/dialogs.js" asp-append-version="true"></script>
<script type="module" src="~/js/forms.js" asp-append-version="true"></script>
<script type="module" src="~/js/ui/feedback-widget.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", false)
@if (User.Identity?.IsAuthenticated == true)
{
  <nav class="of-app-tabbar" aria-label="Navegação principal">
    <a href="/Dashboard" data-path-prefix="/Dashboard"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 11l9-8 9 8"/><path d="M5 10v10h5v-6h4v6h5V10"/></svg>Início</a>
    <a href="/Schedule" data-path-prefix="/Schedule"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="17" rx="2"/><path d="M3 9h18M8 2v4M16 2v4"/></svg>Agenda</a>
    <a href="/WorkOrders" data-path-prefix="/WorkOrders"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="6" y="4" width="12" height="17" rx="2"/><path d="M9 4h6v2H9zM9 12l2 2 4-5"/></svg>Ordens</a>
    <a href="/Payments" data-path-prefix="/Payments"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="5" width="20" height="14" rx="2"/><path d="M2 10h20"/></svg>Pagamentos</a>
    <a href="/Fiscal" data-path-prefix="/Fiscal"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 2h9l5 5v15H6z"/><path d="M14 2v6h6M9 13h6M9 17h6"/></svg>Fiscal</a>
  </nav>
}
<script src="~/js/mobile-app-shell.js" asp-append-version="true"></script>
</body>
</html>
