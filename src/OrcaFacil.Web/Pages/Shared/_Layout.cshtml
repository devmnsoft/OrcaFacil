@using OrcaFacil.Application.Abstractions
@inject INotificationService NotificationService
@inject ICurrentUserService CurrentUser
@{
  var unreadNotifications = User.Identity?.IsAuthenticated == true ? await NotificationService.GetUnreadCountAsync(CurrentUser.UserId) : 0;
  var currentPath = Context.Request.Path.Value ?? string.Empty;
  string Active(string path) => currentPath.StartsWith(path, StringComparison.OrdinalIgnoreCase) ? "is-active" : string.Empty;
}
<!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>@ViewData["Title"] · OrçaFácil</title>
  <link rel="stylesheet" href="~/css/app.css" asp-append-version="true" />
</head>
<body class="of-app-shell">
@if (User.Identity?.IsAuthenticated == true)
{
  <aside class="of-sidebar" aria-label="Menu principal">
    <a class="of-brand" asp-page="/Dashboard/Index"><span class="of-brand-mark">OF</span><span>OrçaFácil</span></a>
    <partial name="Partials/_AuthenticatedNavigation" model="currentPath" />
    <div class="of-sidebar-footer"><a asp-page="/Notifications/Index">Notificações (@unreadNotifications)</a><small>@User.Identity?.Name</small><form method="post" asp-page="/Auth/Logout">@Html.AntiForgeryToken()<button type="submit" class="of-button">Sair</button></form></div>
  </aside>
  <header class="of-mobilebar"><button class="of-menu-toggle" type="button" data-menu-toggle aria-expanded="false" aria-controls="authenticated-menu" aria-label="Abrir menu">☰</button><a class="of-brand" asp-page="/Dashboard/Index"><span class="of-brand-mark">OF</span><span>OrçaFácil</span></a></header>
  <aside class="of-mobile-menu" id="authenticated-menu" data-menu-panel aria-hidden="true" aria-label="Menu principal móvel"><div class="of-mobile-menu__header"><strong>Menu</strong><button type="button" data-menu-close aria-label="Fechar menu">×</button></div><partial name="Partials/_AuthenticatedNavigation" model="currentPath" /><form method="post" asp-page="/Auth/Logout">@Html.AntiForgeryToken()<button type="submit" class="of-button">Sair</button></form></aside>
  <main class="of-main"><partial name="Partials/_ToastHost" /><div class="of-page-container">@RenderBody()</div></main>
}
else { <main><partial name="Partials/_ToastHost" />@RenderBody()</main> }
<partial name="Partials/_OverlayHost" />
<environment include="Development"><script src="~/js/diagnostics/js-health.js" asp-append-version="true"></script></environment>
<script src="~/js/app.js" asp-append-version="true"></script>
<script type="module" src="~/js/ui/feedback.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", false)
</body>
</html>
