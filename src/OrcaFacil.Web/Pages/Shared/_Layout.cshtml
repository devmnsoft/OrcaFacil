<!doctype html><html lang="pt-br"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>@ViewData["Title"] - OrçaFácil</title><link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"/><link rel="stylesheet" href="~/css/app.css" asp-append-version="true"/></head><body><nav class="navbar navbar-expand-lg navbar-dark main-nav"><div class="container-fluid"><a class="navbar-brand fw-bold" asp-page="/Index">OrçaFácil</a><button class="navbar-toggler" data-bs-toggle="collapse" data-bs-target="#menu"><span class="navbar-toggler-icon"></span></button><div id="menu" class="collapse navbar-collapse"><ul class="navbar-nav me-auto"><li><a class="nav-link" asp-page="/Dashboard/Index">Dashboard</a></li><li><a class="nav-link" asp-page="/Documents/CreateBudget">Novo orçamento</a></li><li><a class="nav-link" asp-page="/Documents/CreateReceipt">Novo recibo</a></li><li><a class="nav-link" asp-page="/Documents/Index">Histórico</a></li><li><a class="nav-link" asp-page="/Profile/Index">Emitente</a></li><li><a class="nav-link" asp-page="/Precos">Minha assinatura</a></li><li><a class="nav-link" asp-page="/Ajuda">Ajuda</a></li>@if(User.IsInRole("SuperAdmin")){<li><a class="nav-link" asp-area="Admin" asp-page="/Dashboard">Admin Geral</a></li>}</ul>@if(User.Identity?.IsAuthenticated==true){<form method="post" asp-page="/Auth/Logout">@Html.AntiForgeryToken()<button class="btn btn-outline-light">Sair</button></form>}else{<a class="btn btn-outline-light me-2" asp-page="/Auth/Login">Entrar</a><a class="btn btn-success" asp-page="/Auth/Register">Começar grátis</a>}</div></div></nav><main class="container py-4">@if(TempData["Success"] is string msg){<div class="alert alert-success">@msg</div>}@RenderBody()</main><script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>@await RenderSectionAsync("Scripts", false)</body></html>
