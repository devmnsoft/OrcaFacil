@using OrcaFacil.Application.Abstractions
@inject INotificationService NotificationService
@inject ICurrentUserService CurrentUser
@{
    var unreadNotifications = User.Identity?.IsAuthenticated == true ? await NotificationService.GetUnreadCountAsync(CurrentUser.UserId) : 0;
}
<!doctype html>
<html lang="pt-br">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>@ViewData["Title"] - OrçaFácil</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
  <link rel="stylesheet" href="~/css/app.css" asp-append-version="true" />
</head>
<body class="of-app-shell">
@if (User.Identity?.IsAuthenticated == true)
{
  <aside class="of-sidebar d-none d-lg-flex" aria-label="Menu principal">
    <a class="of-brand" asp-page="/Dashboard/Index"><span class="of-brand-mark">OF</span><span>OrçaFácil</span></a>
    <nav class="of-menu">
      <a asp-page="/Dashboard/Index"><i class="bi bi-speedometer2 me-2"></i>Dashboard</a><a asp-page="/Documents/CreateBudget"><i class="bi bi-file-earmark-text me-2"></i>Novo orçamento</a><a asp-page="/Documents/CreateReceipt"><i class="bi bi-receipt me-2"></i>Novo recibo</a><a asp-page="/Documents/Index"><i class="bi bi-clock-history me-2"></i>Histórico</a><a asp-page="/Clients/Index"><i class="bi bi-people me-2"></i>Clientes</a><a asp-page="/Services/Index"><i class="bi bi-tools me-2"></i>Serviços</a><a asp-page="/Templates/Index"><i class="bi bi-magic me-2"></i>Modelos</a><a asp-page="/Profile/Index"><i class="bi bi-person-badge me-2"></i>Emitente</a><a asp-page="/Subscription/Index"><i class="bi bi-stars me-2"></i>Assinatura</a><a asp-page="/Support/Index"><i class="bi bi-life-preserver me-2"></i>Ajuda</a>
      @if (User.IsInRole("SuperAdmin")) { <a asp-area="Admin" asp-page="/Dashboard"><i class="bi bi-shield-lock me-2"></i>Admin Geral</a> }
    </nav>
    <div class="of-sidebar-footer"><a class="btn btn-outline-light w-100 position-relative" asp-page="/Notifications/Index" aria-label="Abrir notificações"><i class="bi bi-bell me-2"></i>Notificações@if (unreadNotifications > 0) { <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill text-bg-danger">@unreadNotifications</span> }</a><span class="of-plan-badge">Free</span><small>@User.Identity?.Name</small><form method="post" asp-page="/Auth/Logout">@Html.AntiForgeryToken()<button class="btn btn-outline-light w-100">Sair</button></form></div>
  </aside>
  <div class="of-mobilebar d-lg-none"><button class="btn btn-light" type="button" data-bs-toggle="offcanvas" data-bs-target="#ofMobileMenu" aria-label="Abrir menu">☰</button><a class="of-brand text-decoration-none" asp-page="/Dashboard/Index"><span class="of-brand-mark">OF</span><span>OrçaFácil</span></a></div>
  <div class="offcanvas offcanvas-start" tabindex="-1" id="ofMobileMenu"><div class="offcanvas-header"><h5>OrçaFácil</h5><button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Fechar"></button></div><div class="offcanvas-body"><nav class="of-menu mobile"><a asp-page="/Dashboard/Index"><i class="bi bi-speedometer2 me-2"></i>Dashboard</a><a asp-page="/Documents/CreateBudget"><i class="bi bi-file-earmark-text me-2"></i>Novo orçamento</a><a asp-page="/Documents/CreateReceipt"><i class="bi bi-receipt me-2"></i>Novo recibo</a><a asp-page="/Documents/Index"><i class="bi bi-clock-history me-2"></i>Histórico</a><a asp-page="/Clients/Index"><i class="bi bi-people me-2"></i>Clientes</a><a asp-page="/Services/Index"><i class="bi bi-tools me-2"></i>Serviços</a><a asp-page="/Templates/Index"><i class="bi bi-magic me-2"></i>Modelos</a><a asp-page="/Profile/Index"><i class="bi bi-person-badge me-2"></i>Emitente</a><a asp-page="/Subscription/Index"><i class="bi bi-stars me-2"></i>Assinatura</a><a asp-page="/Notifications/Index"><i class="bi bi-bell me-2"></i>Notificações@if (unreadNotifications > 0) { <span class="badge text-bg-danger ms-2">@unreadNotifications</span> }</a><a asp-page="/Support/Index"><i class="bi bi-life-preserver me-2"></i>Ajuda</a></nav></div></div>
  <main class="of-main"><partial name="Partials/_ToastHost" /><div class="container-fluid py-4">@RenderBody()</div></main>
}
else
{
  <main><partial name="Partials/_ToastHost" />@RenderBody()</main>
}
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/app.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", false)
</body>
</html>
