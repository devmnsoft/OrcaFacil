@model IReadOnlyList<OrcaFacil.Application.DTOs.DocumentSummaryDto>
<div class="of-table-desktop"><table class="of-table"><thead><tr><th>Número</th><th>Tipo</th><th>Cliente</th><th>Status</th><th>Total</th><th>Ações</th></tr></thead><tbody>@foreach(var x in Model ?? Array.Empty<OrcaFacil.Application.DTOs.DocumentSummaryDto>()){<tr><td><strong>@x.Number</strong></td><td><span class="of-badge">@x.Type</span></td><td>@x.ClientName</td><td><partial name="_StatusBadge" model="x.Status" /></td><td>@x.Total.ToString("C")</td><td><div class="of-inline-actions"><a asp-page="/Documents/Details" asp-route-id="@x.Id">Ver</a><a asp-page="/Documents/Edit" asp-route-id="@x.Id">Editar</a><a href="/Documents/Pdf/@x.Id">PDF</a></div></td></tr>}</tbody></table></div>
<div class="of-doc-card">@foreach(var x in Model ?? Array.Empty<OrcaFacil.Application.DTOs.DocumentSummaryDto>()){<article class="of-card mb-3"><div class="d-flex justify-content-between"><strong>@x.Number</strong><partial name="_StatusBadge" model="x.Status" /></div><p class="mb-1">@x.ClientName</p><p class="text-muted mb-3">@x.Type · @x.Total.ToString("C")</p><div class="d-grid gap-2"><a class="btn btn-outline-primary" asp-page="/Documents/Details" asp-route-id="@x.Id">Ver detalhes</a><a class="btn btn-primary" href="/Documents/Pdf/@x.Id">PDF</a></div></article>}</div>
