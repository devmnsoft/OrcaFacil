@model IReadOnlyList<OrcaFacil.Application.DTOs.DocumentSummaryDto>
<div class="table-responsive of-table-desktop"><table class="table table-hover bg-white"><thead><tr><th>Número</th><th>Tipo</th><th>Cliente</th><th>Status</th><th>Total</th><th class="text-end">Ações</th></tr></thead><tbody>@foreach(var x in Model ?? Array.Empty<OrcaFacil.Application.DTOs.DocumentSummaryDto>()){<tr><td class="fw-bold">@x.Number</td><td><span class="of-badge">@x.Type</span></td><td>@x.ClientName</td><td><partial name="_StatusBadge" model="x.Status" /></td><td>@x.Total.ToString("C")</td><td class="text-end"><div class="dropdown"><button class="btn btn-sm btn-outline-primary dropdown-toggle" data-bs-toggle="dropdown">Ações</button><ul class="dropdown-menu dropdown-menu-end"><li><a class="dropdown-item" asp-page="/Documents/Details" asp-route-id="@x.Id">Ver detalhes</a></li><li><a class="dropdown-item" asp-page="/Documents/Edit" asp-route-id="@x.Id">Editar</a></li><li><a class="dropdown-item" href="/Documents/Pdf/@x.Id">PDF</a></li></ul></div></td></tr>}</tbody></table></div>
<div class="of-doc-card">@foreach(var x in Model ?? Array.Empty<OrcaFacil.Application.DTOs.DocumentSummaryDto>()){<article class="of-card mb-3"><div class="d-flex justify-content-between"><strong>@x.Number</strong><partial name="_StatusBadge" model="x.Status" /></div><p class="mb-1">@x.ClientName</p><p class="text-muted mb-3">@x.Type · @x.Total.ToString("C")</p><div class="d-grid gap-2"><a class="btn btn-outline-primary" asp-page="/Documents/Details" asp-route-id="@x.Id">Ver detalhes</a><a class="btn btn-primary" href="/Documents/Pdf/@x.Id">PDF</a></div></article>}</div>
