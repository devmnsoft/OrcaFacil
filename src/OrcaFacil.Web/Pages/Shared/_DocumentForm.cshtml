@model OrcaFacil.Web.Pages.Documents.DocumentForm
<form method="post">@Html.AntiForgeryToken()<div asp-validation-summary="ModelOnly" class="text-danger"></div><div class="row g-4"><div class="col-lg-8"><section class="of-card"><p class="of-eyebrow">Cliente</p><h2 class="h4">Dados do cliente</h2><label asp-for="ClientName" class="form-label">Nome do cliente</label><input asp-for="ClientName" class="form-control" placeholder="Ex.: Maria Souza"/><div class="row"><div class="col-md-6"><label class="form-label">CPF/CNPJ</label><input class="form-control" placeholder="Opcional"/></div><div class="col-md-6"><label class="form-label">Telefone</label><input class="form-control" data-phone placeholder="(00) 00000-0000"/></div><div class="col-md-6"><label class="form-label">E-mail</label><input class="form-control" type="email" placeholder="cliente@email.com"/></div><div class="col-md-6"><label class="form-label">Cidade</label><input class="form-control" placeholder="Cidade/UF"/></div></div></section><section class="of-card mt-4"><p class="of-eyebrow">Itens</p><h2 class="h4">Itens do documento</h2><div id="items">@for(var i=0;i<Model.Items.Count;i++){<div class="row g-2 mt-2 item align-items-end"><div class="col-md-5"><label class="form-label">Descrição</label><input name="Input.Items[@i].Description" value="@Model.Items[i].Description" class="form-control" placeholder="Serviço ou produto"/></div><div class="col-6 col-md-2"><label class="form-label">Qtd.</label><input name="Input.Items[@i].Quantity" value="@Model.Items[i].Quantity" class="form-control qty" type="number" step="0.01"/></div><div class="col-6 col-md-2"><label class="form-label">Valor</label><input name="Input.Items[@i].UnitPrice" value="@Model.Items[i].UnitPrice" class="form-control price" type="number" step="0.01"/></div><div class="col-6 col-md-2"><label class="form-label">Desconto</label><input name="Input.Items[@i].Discount" value="@Model.Items[i].Discount" class="form-control discount" type="number" step="0.01"/></div><div class="col-6 col-md-1 text-end"><small>Total</small><strong data-item-total>R$ 0,00</strong></div></div>}</div><button type="button" class="btn btn-outline-primary mt-3" disabled title="Em breve">Adicionar item</button></section><section class="of-card mt-4"><p class="of-eyebrow">Condições</p><h2 class="h4">Observações</h2><label class="form-label">Observações do documento</label><textarea asp-for="Notes" class="form-control" rows="4" placeholder="Prazo, forma de pagamento, validade ou condições comerciais."></textarea></section></div><aside class="col-lg-4"><div class="of-card position-sticky" style="top:1rem"><p class="of-eyebrow">Resumo</p><h2 class="h4">Resumo financeiro</h2><div class="d-flex justify-content-between"><span>Subtotal</span><strong data-subtotal>R$ 0,00</strong></div><label class="form-label">Desconto geral</label><input asp-for="Discount" data-document-discount class="form-control" type="number" step="0.01"/><hr/><div class="d-flex justify-content-between fs-4"><span>Total</span><strong class="text-success" data-total>R$ 0,00</strong></div><div class="d-grid gap-2 mt-4"><button class="btn btn-primary" data-loading>Salvar</button><button class="btn btn-success" name="generatePdf" value="true" data-loading>Salvar e gerar PDF</button><a class="btn btn-outline-secondary" asp-page="/Documents/Index">Voltar</a></div></div></aside></div></form>
