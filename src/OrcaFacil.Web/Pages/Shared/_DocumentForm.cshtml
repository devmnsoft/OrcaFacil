@model OrcaFacil.Web.Pages.Documents.DocumentForm
<form method="post" class="card p-4">@Html.AntiForgeryToken()<div asp-validation-summary="ModelOnly" class="text-danger"></div><label>Cliente</label><input asp-for="ClientName" class="form-control"/><div id="items">@for(var i=0;i<Model.Items.Count;i++){<div class="row g-2 mt-2 item"><div class="col-md-6"><input name="Input.Items[@i].Description" value="@Model.Items[i].Description" class="form-control" placeholder="Descrição"/></div><div class="col"><input name="Input.Items[@i].Quantity" value="@Model.Items[i].Quantity" class="form-control qty" type="number" step="0.01"/></div><div class="col"><input name="Input.Items[@i].UnitPrice" value="@Model.Items[i].UnitPrice" class="form-control price" type="number" step="0.01"/></div><div class="col"><input name="Input.Items[@i].Discount" value="@Model.Items[i].Discount" class="form-control" type="number" step="0.01"/></div></div>}</div><label class="mt-3">Desconto</label><input asp-for="Discount" class="form-control" type="number" step="0.01"/><label>Observações</label><textarea asp-for="Notes" class="form-control"></textarea><button class="btn btn-primary mt-3">Salvar</button></form>
