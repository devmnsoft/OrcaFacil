@model OrcaFacil.Web.Models.InfrastructureUnavailableViewModel
<section class="of-infrastructure" role="alert" aria-labelledby="infrastructure-title">
    <svg class="of-infrastructure__icon" aria-hidden="true"><use href="/img/icons/orcafacil-icons.svg#icon-connection" /></svg>
    <div>
        <h2 id="infrastructure-title">@Model.Title</h2>
        <p>@Model.Message</p>
        @if (Model.IsDevelopment && !string.IsNullOrWhiteSpace(Model.DeveloperHint)) { <p><strong>Desenvolvimento:</strong> @Model.DeveloperHint</p> }
        <small>Código de correlação: <strong>@Model.CorrelationId</strong></small>
        <div class="of-infrastructure__actions">
            @if (Model.CanRetry) { <button class="btn btn-primary" type="button" onclick="location.reload()">Tentar novamente</button> }
            <a class="btn btn-outline-primary" href="@Model.SupportUrl">Falar com o suporte</a>
        </div>
    </div>
</section>
