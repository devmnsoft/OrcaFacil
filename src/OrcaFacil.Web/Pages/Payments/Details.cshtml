@page "{id:guid}"
@model OrcaFacil.Web.Pages.Payments.DetailsModel
@section Styles { <link rel="stylesheet" href="~/css/billing.css" asp-append-version="true" /> }
@using OrcaFacil.Domain.Enums
@{
    ViewData["Title"] = "Pagamento";
}

<main class="of-finance-page">
    <header class="of-finance-header">
        <div>
            <p class="of-eyebrow">Financeiro</p>
            <h1>Pagamento @Model.Payment?.Amount.ToString("C")</h1>
            <p>@PaymentMethodCodes.ToDisplayLabel(Model.Payment?.PaymentMethod) · @Model.Payment?.PaidAt.ToLocalTime().ToString("dd/MM/yyyy")</p>
        </div>
    </header>

    @if (Model.Payment is not null)
    {
        <section class="of-card">
            <p>Situação: <strong>@Model.Payment.Status</strong></p>
            @if (Model.Receipt is not null)
            {
                <a class="of-button" asp-page="/Receipts/Details" asp-route-id="@Model.Receipt.Id">
                    Abrir recibo @Model.Receipt.Number
                </a>
            }
            @if (Model.Payment.Status == FinancialRecordStatus.Active)
            {
                <form method="post" asp-page-handler="Reverse" class="reversal-form">
                    <label>
                        Motivo da correção
                        <textarea asp-for="ReversalReason" required></textarea>
                    </label>
                    <p>Esta ação corrige o registro interno e não executa movimentação financeira no banco ou operadora.</p>
                    <button class="of-button of-button--danger">Confirmar estorno interno</button>
                </form>
            }
        </section>
    }
</main>
