@page "{id:guid}"
@model OrcaFacil.Web.Pages.Payments.DetailsModel
@{ViewData["Title"]="Pagamento";}
<main class="of-page-shell"><header class="of-page-header"><div><p class="of-eyebrow">Financeiro</p><h1>Pagamento @Model.Payment?.Amount.ToString("C")</h1><p>@Model.Payment?.PaymentMethod · @Model.Payment?.PaidAt.ToLocalTime().ToString("dd/MM/yyyy")</p></div></header>@if(Model.Payment is not null){<section class="of-card"><p>Situação: <strong>@Model.Payment.Status</strong></p>@if(Model.Receipt is not null){<a class="of-button" asp-page="/Receipts/Details" asp-route-id="@Model.Receipt.Id">Abrir recibo @Model.Receipt.Number</a>}@if(Model.Payment.Status==OrcaFacil.Domain.Enums.FinancialRecordStatus.Active){<form method="post" asp-page-handler="Reverse" class="reversal-form"><label>Motivo da correção<textarea asp-for="ReversalReason" required></textarea></label><p>Esta ação corrige o registro interno e não executa movimentação financeira no banco ou operadora.</p><button class="of-button of-button--danger">Confirmar estorno interno</button></form>}</section>}</main><style>.reversal-form{display:grid;gap:.7rem;max-width:600px;margin-top:2rem}.reversal-form label{display:grid;gap:.4rem}.reversal-form textarea{padding:.8rem;border:1px solid #cbd5e1;border-radius:9px}</style>
