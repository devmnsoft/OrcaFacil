@page "{id:guid}"
@model OrcaFacil.Web.Pages.Payments.RegisterModel
@section Styles { <link rel="stylesheet" href="~/css/billing.css" asp-append-version="true" /> }
@{ ViewData["Title"] = "Registrar pagamento"; }
<main class="of-finance-page">
    <header class="of-finance-header">
        <div><p class="of-eyebrow">Recebimento</p><h1>Registrar pagamento</h1><p>Ordem @Model.WorkOrder?.Number</p></div>
    </header>
    <section class="of-finance-summary" aria-label="Resumo financeiro da ordem">
        <article><span>Total da ordem</span><strong>@Model.WorkOrder?.TotalSnapshot.ToString("C")</strong></article>
        <article><span>Já recebido</span><strong>@Model.PaidAmount.ToString("C")</strong></article>
        <article><span>Saldo em aberto</span><strong>@Model.Balance.ToString("C")</strong></article>
    </section>
    <form method="post" class="payment-register-form" data-payment-form novalidate>@Html.AntiForgeryToken()
        <input asp-for="Input.IdempotencyKey" type="hidden" />
        <div asp-validation-summary="ModelOnly" class="receipt-errors" tabindex="-1" data-validation-summary></div>
        <p class="receipt-manual-notice"><strong>Pagamento registrado manualmente.</strong> A informação não representa confirmação automática do banco, cartão ou operadora. Registrar um recebimento não aprova o orçamento nem conclui o serviço.</p>
        <details><summary>Como usar</summary><p>Informe o valor até o saldo recalculado no servidor. A mesma tentativa não lança o recebimento duas vezes. Uma chave já usada com outro valor, forma ou data é recusada.</p></details>
        <label asp-for="Input.Amount">Valor recebido</label>
        <input asp-for="Input.Amount" inputmode="decimal" min="0.01" max="@Model.Balance" step="0.01" aria-describedby="amount-help" />
        <small id="amount-help">Você pode registrar um pagamento parcial de até @Model.Balance.ToString("C").</small>
        <span asp-validation-for="Input.Amount"></span>
        <label asp-for="Input.PaymentMethod">Forma de pagamento</label>
        <select asp-for="Input.PaymentMethod"><option>Pix</option><option>Dinheiro</option><option>Transferência</option><option>Cartão</option><option>Boleto</option><option>Outro</option></select>
        <span asp-validation-for="Input.PaymentMethod"></span>
        <label asp-for="Input.PaidAt">Recebido em</label>
        <input asp-for="Input.PaidAt" type="datetime-local" />
        <span asp-validation-for="Input.PaidAt"></span>
        <label asp-for="Input.Notes">Observação</label>
        <textarea asp-for="Input.Notes" rows="4" maxlength="1000"></textarea>
        <span asp-validation-for="Input.Notes"></span>
        <button class="receipt-submit" type="submit">Registrar pagamento</button>
    </form>
</main>
@section Scripts { <script type="module" src="~/js/payment-register.js" asp-append-version="true"></script> }
