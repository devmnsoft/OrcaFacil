@page
@model OrcaFacil.Web.Pages.Payments.IndexModel
@using OrcaFacil.Domain.Enums
@{
    ViewData["Title"] = "Central financeira";
}

<main class="of-finance-page">
    <header class="of-finance-header">
        <div>
            <p class="of-eyebrow">Financeiro</p>
            <h1>Central financeira</h1>
            <p>Acompanhe os recebimentos registrados pela equipe na conta ativa.</p>
        </div>
        <a class="of-button of-button--primary" asp-page="/Receipts/Create">Registrar pagamento</a>
    </header>
<partial name="Partials/_ContextGuide" model='new ContextGuideViewModel("Registre valores recebidos","Manter um controle interno do que sua empresa recebeu.","Valor, método, data, origem e responsável pelo registro.","Você pode emitir um recibo para o cliente.","Pagamento registrado manualmente. A informação não representa confirmação automática do banco, cartão ou operadora.")' />

    <section class="of-finance-summary" aria-label="Resumo financeiro">
        <article>
            <small>Total ativo registrado</small>
            <strong>@Model.TotalReceived.ToString("C")</strong>
        </article>
        <article>
            <small>Registros ativos</small>
            <strong>@Model.ActivePayments</strong>
        </article>
        <article>
            <small>Estornos</small>
            <strong>@Model.ReversedPayments</strong>
        </article>
    </section>

    @if (Model.Payments.Count == 0)
    {
        <section class="of-finance-empty">
            <h2>Nenhum pagamento registrado</h2>
            <p>Registre o primeiro recebimento para iniciar o histórico financeiro.</p>
            <a class="of-button of-button--primary" asp-page="/Receipts/Create">Registrar pagamento</a>
        </section>
    }
    else
    {
        <div class="of-payment-list" aria-label="Pagamentos">
            @foreach (var payment in Model.Payments)
            {
                <a class="of-payment-row" asp-page="Details" asp-route-id="@payment.Id">
                    <strong>@payment.Amount.ToString("C")</strong>
                    <span>@PaymentMethodCodes.ToDisplayLabel(payment.PaymentMethod)</span>
                    <span>@payment.PaidAt.ToLocalTime().ToString("dd/MM/yyyy")</span>
                    <em class="of-payment-status">@payment.Status</em>
                </a>
            }
        </div>
    }
</main>
