@page
@model OrcaFacil.Web.Pages.Payments.IndexModel
@{ViewData["Title"]="Pagamentos";}
<main class="of-page-shell"><header class="of-page-header"><div><p class="of-eyebrow">Financeiro</p><h1>Pagamentos</h1><p>Histórico dos recebimentos informados pela equipe.</p></div></header><section class="of-card"><small>Total ativo registrado</small><h2>@Model.TotalReceived.ToString("C")</h2></section><div class="payment-list">@foreach(var payment in Model.Payments){<a asp-page="Details" asp-route-id="@payment.Id"><strong>@payment.Amount.ToString("C")</strong><span>@payment.PaymentMethod</span><span>@payment.PaidAt.ToLocalTime().ToString("dd/MM/yyyy")</span><em>@payment.Status</em></a>}</div></main><style>.payment-list{display:grid;gap:.5rem;margin-top:1rem}.payment-list a{display:grid;grid-template-columns:1fr 1fr 1fr .7fr;padding:1rem;border:1px solid #e2e8f0;border-radius:12px;background:#fff;color:inherit;text-decoration:none}@media(max-width:650px){.payment-list a{grid-template-columns:1fr 1fr}}</style>
