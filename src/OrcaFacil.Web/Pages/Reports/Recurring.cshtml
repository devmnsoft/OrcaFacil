@page
@model OrcaFacil.Web.Pages.Reports.RecurringModel
@{ViewData["Title"]="Relatório de recorrência";}
@section Styles { <link rel="stylesheet" href="~/css/contracts.css" asp-append-version="true" /> }
<main class="of-contract-page"><header class="of-contract-hero"><div><p class="of-eyebrow">Indicadores reais</p><h1>Relatório de recorrência</h1><p>Valores calculados apenas a partir de contratos e pagamentos registrados.</p></div><a class="of-button-secondary" asp-page="/Contracts/Index">Abrir contratos</a></header><section class="of-contract-metrics of-contract-metrics-wide"><article><span>Receita prevista</span><strong>@Model.Forecast.ToString("C")</strong></article><article><span>Receita recebida</span><strong>@Model.Received.ToString("C")</strong></article><article><span>Em atraso</span><strong>@Model.Overdue.ToString("C")</strong></article><article><span>Contratos ativos</span><strong>@Model.Active</strong></article><article><span>Clientes recorrentes</span><strong>@Model.RecurringClients</strong></article></section><section class="of-contract-panel"><h2>Saúde da carteira</h2><dl class="of-contract-data"><div><dt>Cancelados</dt><dd>@Model.Canceled</dd></div><div><dt>Vencidos</dt><dd>@Model.Expired</dd></div><div><dt>Churn</dt><dd>@(Model.HasStatisticalBase ? $"{(Model.Canceled * 100m / Math.Max(1, Model.Active + Model.Canceled)):N1}%" : "Dados insuficientes")</dd></div></dl></section></main>
