@model OrcaFacil.Web.Pages.Reports.ReportPageModel
<header class="report-hero">
  <div><span class="eyebrow">INTELIGÊNCIA COMERCIAL</span><h1>@Model.Report.Title</h1><p>Dados reais da conta selecionada, consolidados para o período.</p></div>
  <a class="of-button-primary" asp-route-handler="Export" asp-route-from="@Model.From?.ToString("yyyy-MM-dd")" asp-route-to="@Model.To?.ToString("yyyy-MM-dd")" asp-route-clientId="@Model.ClientId" asp-route-status="@Model.Status" asp-route-paymentMethod="@Model.PaymentMethod">Exportar CSV</a>
</header>
<details class="report-filters" open><summary>Filtros do relatório</summary>
 <form method="get" class="filter-grid"><label>De<input type="date" asp-for="From" /></label><label>Até<input type="date" asp-for="To" /></label><label>Status<input asp-for="Status" placeholder="Todos" /></label><label>Forma de pagamento<input asp-for="PaymentMethod" placeholder="Todas" /></label><div class="filter-actions"><a href="@Context.Request.Path" class="of-button-secondary">Limpar</a><button class="of-button-primary" type="submit">Aplicar filtros</button></div></form>
</details>
<section class="metric-grid">
@foreach (var metric in Model.Report.Metrics) { <article class="metric-card"><span>@metric.Label</span><strong>@(metric.Value < 0 ? "Dados insuficientes" : metric.IsMoney ? metric.Value.ToString("C") : $"{metric.Value:0.##}{metric.Suffix}")</strong></article> }
</section>
@if (Model.Report.Rows.Count == 0) { <section class="report-empty"><h2>Dados insuficientes</h2><p>Não há movimentações reais para os filtros selecionados.</p></section> }
else { <div class="report-table-wrap"><table class="report-table"><thead><tr><th>Etapa / item</th><th>Quantidade</th><th>Proposto</th><th>Aprovado</th><th>Recebido</th><th>Indicador</th></tr></thead><tbody>@foreach (var row in Model.Report.Rows) { <tr><td data-label="Item"><strong>@row.Label</strong></td><td data-label="Quantidade">@row.Count</td><td data-label="Proposto">@row.Proposed.ToString("C")</td><td data-label="Aprovado">@row.Approved.ToString("C")</td><td data-label="Recebido">@row.Received.ToString("C")</td><td data-label="Indicador">@(row.Extra?.ToString("0.##") ?? "Dados insuficientes")</td></tr> }</tbody></table></div> }
