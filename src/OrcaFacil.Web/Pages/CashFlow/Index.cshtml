@page
@model OrcaFacil.Web.Pages.CashFlow.IndexModel
@{ViewData["Title"]="Fluxo de caixa";}<link rel="stylesheet" href="~/css/finance.css" asp-append-version="true" />
<header class="of-page-header"><div><span class="of-eyebrow">Financeiro</span><h1>Fluxo de caixa</h1><p>Valores efetivamente registrados e previsões do período selecionado.</p></div></header>
<form method="get" class="of-filter-bar"><label>Início <input asp-for="From" type="date" /></label><label>Fim <input asp-for="To" type="date" /></label><button class="of-button of-button-primary" type="submit">Atualizar</button></form>
<section class="of-finance-metrics"><article class="of-finance-card is-positive"><span>Recebido no período</span><strong>@Model.Received.ToString("C")</strong></article><article class="of-finance-card"><span>A receber</span><strong>@Model.Receivable.ToString("C")</strong></article><article class="of-finance-card is-danger"><span>Vencido</span><strong>@Model.Overdue.ToString("C")</strong></article><article class="of-finance-card"><span>Hoje</span><strong>@Model.Today.ToString("C")</strong></article><article class="of-finance-card"><span>Últimos 7 dias</span><strong>@Model.Week.ToString("C")</strong></article><article class="of-finance-card"><span>Mês atual</span><strong>@Model.Month.ToString("C")</strong></article></section>
<div class="of-finance-grid"><section class="of-panel"><h2>Por método</h2>@if(Model.ByMethod.Count==0){<p class="of-muted">Sem recebimentos no período.</p>}else{<ul class="of-breakdown">@foreach(var row in Model.ByMethod){<li><span>@row.Label</span><strong>@row.Total.ToString("C")</strong></li>}</ul>}</section><section class="of-panel"><h2>A receber por origem</h2>@if(Model.ByOrigin.Count==0){<p class="of-muted">Sem previsões no período.</p>}else{<ul class="of-breakdown">@foreach(var row in Model.ByOrigin){<li><span>@row.Label</span><strong>@row.Total.ToString("C")</strong></li>}</ul>}</section></div>
