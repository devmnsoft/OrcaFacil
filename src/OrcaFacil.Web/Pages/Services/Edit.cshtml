@page "{id:guid}"
@model OrcaFacil.Web.Pages.Services.EditModel
@{ViewData["Title"]="Editar serviço";ViewData["Section"]="Comercial";}
<header class="commercial-header"><div><p class="of-eyebrow">Catálogo</p><h1>Editar serviço</h1><p>Alterações de preço ficam registradas e valem somente para novos usos.</p></div></header><form method="post" class="commercial-editor"><input asp-for="Id" type="hidden" /><input asp-for="Version" type="hidden" /><main><partial name="_Form" model="Model.Input" /><section class="commercial-form-block"><label><span>Motivo do reajuste</span><input asp-for="PriceChangeReason" placeholder="Ex.: reajuste anual" /></label></section></main><aside class="commercial-preview"><h2>Resumo</h2><strong data-preview-name>@Model.Input.Name</strong><p data-preview-description>@Model.Input.Description</p><span data-preview-price>@Model.Input.StandardPrice.ToString("C")</span></aside><footer><a class="of-button" asp-page="Details" asp-route-id="@Model.Id">Cancelar</a><button class="of-button of-button--primary" type="submit">Salvar alterações</button></footer></form>@section Scripts{<script type="module" src="~/js/service-catalog.js" asp-append-version="true"></script>}
