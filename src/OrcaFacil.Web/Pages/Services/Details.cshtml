@page "{id:guid}"
@model OrcaFacil.Web.Pages.Services.DetailsModel
@section Styles { <link rel="stylesheet" href="~/css/services.css" asp-append-version="true" /> }
@{ViewData["Title"]=Model.Item.Name;ViewData["Section"]="Comercial";}
<header class="commercial-header"><div><p class="of-eyebrow">Serviço · @(Model.Item.Code??"sem código")</p><h1>@Model.Item.Name</h1><p>@(Model.Item.Description??"Sem descrição comercial.")</p></div><div class="commercial-actions"><a class="of-button" asp-page="Edit" asp-route-id="@Model.Item.Id">Editar</a><a class="of-button of-button--primary" asp-page="/Documents/New" asp-route-serviceId="@Model.Item.Id">Usar em orçamento</a></div></header><section class="commercial-metrics"><article><span>Preço padrão</span><strong>@Model.Item.StandardPrice.ToString("C")</strong></article><article><span>Custo estimado</span><strong>@Model.Item.EstimatedCost.ToString("C")</strong></article><article><span>Margem estimada</span><strong>@Model.Item.Margin.ToString("C")</strong></article><article><span>Uso</span><strong>@Model.Item.UseCount</strong></article></section><section class="commercial-form-block"><h2>Histórico de preços</h2>@if(Model.History.Count==0){<p>Nenhum reajuste registrado.</p>}else{<div class="commercial-table">@foreach(var h in Model.History){<div><strong>@h.ChangedAt.ToString("dd/MM/yyyy HH:mm")</strong><span>@h.PreviousPrice.ToString("C") → @h.NewPrice.ToString("C")</span><small>@(h.Reason??"Sem motivo informado")</small></div>}</div>}</section>
