@page
@model OrcaFacil.Web.Pages.Services.CategoriesModel
@{ ViewData["Title"]="Categorias de serviços"; ViewData["Section"]="Comercial"; }
<header class="commercial-header"><div><p class="of-eyebrow">Catálogo</p><h1>Categorias</h1><p>Organize a descoberta e a apresentação dos serviços.</p></div><a class="of-button" asp-page="Index">Voltar ao catálogo</a></header>
<form method="post" asp-page-handler="Create" class="commercial-form-block">@Html.AntiForgeryToken()<div asp-validation-summary="ModelOnly" class="of-form-errors"></div><h2>Nova categoria</h2><label><span>Nome</span><input asp-for="Name" required maxlength="80" /></label><label><span>Descrição</span><input asp-for="Description" maxlength="300" /></label><label><span>Ordem</span><input asp-for="SortOrder" type="number" /></label><button class="of-button of-button--primary">Criar categoria</button></form>
<section class="commercial-form-block"><h2>Categorias cadastradas</h2>@if(Model.Items.Count==0){<p>Nenhuma categoria cadastrada.</p>}else{<div class="commercial-table">@foreach(var category in Model.Items){<article><div><strong>@category.Name</strong><p>@(category.Description??"Sem descrição")</p></div><span>@category.Services serviços</span><a asp-page="Index" asp-route-categoryId="@category.Id">Abrir listagem</a><form method="post" asp-page-handler="Toggle" asp-route-id="@category.Id">@Html.AntiForgeryToken()<button class="of-button">@(category.IsActive?"Desativar":"Ativar")</button></form></article>}</div>}</section>
