@model OrcaFacil.Web.ViewModels.Services.ServiceEditorViewModel
<section class="commercial-form-block">
<label><span>Nome <small>obrigatório</small></span><input asp-for="Input.Name" required maxlength="180" aria-describedby="service-name-help" /><small id="service-name-help">Como o serviço aparecerá nas propostas.</small><span asp-validation-for="Input.Name"></span></label>
<label><span>Código</span><input asp-for="Input.Code" maxlength="40" /></label>
<label><span>Descrição</span><textarea asp-for="Input.Description" maxlength="1200"></textarea></label>
<label><span>Unidade</span><select asp-for="Input.UnitCode">@foreach(var unit in Model.UnitOptions){<option value="@unit.Code">@unit.Label</option>}</select></label>
<label><span>Preço padrão</span><input asp-for="Input.StandardPrice" type="number" min="0" step="0.01" /><small>Valor sugerido ao adicionar o serviço.</small><span asp-validation-for="Input.StandardPrice"></span></label>
<label><span>Custo interno</span><input asp-for="Input.EstimatedCost" type="number" min="0" step="0.01" aria-describedby="service-cost-help" /><small id="service-cost-help">Visível somente para sua empresa; usado para estimar a margem.</small><span asp-validation-for="Input.EstimatedCost"></span></label>
<label><span>Margem desejada (%)</span><input asp-for="Input.DesiredMarginPercentage" type="number" min="0" max="99.99" step="0.01" /><small>Orienta a sugestão de preço sem expor o custo ao cliente.</small></label>
<label><span>Duração sugerida</span><input asp-for="Input.SuggestedDurationMinutes" type="number" min="1" /></label>
<label><span>Prazo padrão</span><input asp-for="Input.DefaultDeliveryTerm" maxlength="120" placeholder="Ex.: 5 dias úteis" /></label>
<label><span>Tags</span><input asp-for="Input.Tags" maxlength="500" placeholder="Separe por vírgulas" /></label>
<label><span>Observação padrão</span><textarea asp-for="Input.DefaultNotes" maxlength="2000"></textarea></label>
<label><span>Notas internas</span><textarea asp-for="Input.InternalNotes" maxlength="2000"></textarea></label>
<label><input asp-for="Input.IsFavorite" /> Favorito</label><label><input asp-for="Input.IsRecurring" /> Recorrente</label><label><input asp-for="Input.IsRecommended" /> Recomendado</label><label><input asp-for="Input.IsActive" /> Ativo</label>
<fieldset class="of-recurring-service-fields"><legend>Configuração recorrente</legend><label><span>Periodicidade padrão</span><select asp-for="Input.DefaultPeriodicity" asp-items="Html.GetEnumSelectList<OrcaFacil.Domain.Entities.RecurrencePeriod>()"></select></label><label><span>Valor mensal sugerido</span><input asp-for="Input.SuggestedMonthlyPrice" type="number" min="0" step="0.01" /></label><label><span>Custo mensal estimado</span><input asp-for="Input.EstimatedMonthlyCost" type="number" min="0" step="0.01" /></label><label><span>SLA de atendimento (horas)</span><input asp-for="Input.DefaultResponseSlaHours" type="number" min="1" /></label><label><span>SLA de execução (horas)</span><input asp-for="Input.DefaultExecutionSlaHours" type="number" min="1" /></label><label><span>Checklist padrão da OS</span><textarea asp-for="Input.DefaultChecklist" maxlength="4000" placeholder="Uma etapa por linha"></textarea></label></fieldset>
</section>
