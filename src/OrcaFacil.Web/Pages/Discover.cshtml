@page
@{ ViewData["Title"]="Conheça os recursos"; }
<header class="of-page-heading"><p class="of-eyebrow">Centro de demonstrações</p><h1>Conheça o que o OrçaFácil pode fazer</h1><p>Explore resultados antes de escolher um plano. Tudo nesta página é demonstração e nunca se mistura aos seus dados.</p></header>
<div class="of-demo-grid">
@foreach(var demo in new[]{("PDF com OrçaFácil","Veja um documento claro e pronto para compartilhar.","Grátis"),("PDF com sua marca","Use seu logo e remova a identificação do OrçaFácil.","Profissional"),("Aprovação online","Receba a resposta do cliente diretamente pelo orçamento.","Profissional"),("Pipeline","Veja quais propostas precisam de atenção.","Profissional"),("Modelos","Reaproveite estruturas que funcionam para sua rotina.","Profissional"),("Equipe","Compartilhe a rotina com outras pessoas.","Empresarial"),("Relatórios","Acompanhe resultados comerciais em um só lugar.","Empresarial"),("Ordem de serviço","Transforme a proposta aceita em execução organizada.","Empresarial"),("Agenda","Planeje visitas e entregas sem perder contexto.","Empresarial")}){
<article><span class="of-demo-label">Demonstração</span><h2>@demo.Item1</h2><p>@demo.Item2</p><small>Disponível no plano @demo.Item3</small><button type="button" data-demo-title="@demo.Item1">Ver demonstração</button></article>}
</div>
<div class="of-experience-dialog" data-demo-dialog hidden role="dialog" aria-modal="true" aria-labelledby="demo-dialog-title"><div><button type="button" data-dialog-close aria-label="Fechar demonstração">×</button><span class="of-demo-label">Demonstração</span><h2 id="demo-dialog-title">Recurso</h2><p>Esta prévia usa conteúdo ilustrativo. Nenhum cliente, documento ou configuração real foi alterado.</p><a asp-page="/Subscription/Index">Comparar planos</a></div></div>
