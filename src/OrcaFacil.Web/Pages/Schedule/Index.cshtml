@page "/Schedule"
@model OrcaFacil.Web.Pages.Schedule.IndexModel
@{ ViewData["Title"] = "Agenda"; }
<partial name="Partials/_PageIntro" model='new PageIntroViewModel("Agenda operacional", "Agenda", "Veja compromissos, horários e serviços programados em uma visão simples.", "calendar", SecondaryActions: new[]{new PageIntroActionViewModel("Ver ordens", "/WorkOrders/Index", "work-order")}, HelpCode: "schedule", WhatThisPageDoes: "Organiza as ordens agendadas por data e horário.", NextStepText: "Abra uma ordem para agendar ou ajustar a execução.")' />
<section class="of-panel"><div class="of-segmented-control" aria-label="Período"><a class="of-button" asp-route-view="today">Hoje</a><a class="of-button" asp-route-view="week">Semana</a><a class="of-button" asp-route-view="list">Lista</a></div>
@if(Model.Orders.Count == 0){<partial name="Partials/_EmptyState" model='new EmptyStateViewModel { Icon="calendar", Title="Nenhum serviço agendado neste período", Text="Defina data e horário em uma ordem para organizar sua rotina e orientar o cliente.", ActionText="Ver ordens", ActionPage="/WorkOrders/Index" }' />}else{<div class="of-record-list">@foreach(var item in Model.Orders){<a class="of-record-item" asp-page="/WorkOrders/Details" asp-route-id="@item.Id"><strong>@item.ScheduledStart?.ToLocalTime().ToString("dd/MM HH:mm")</strong> · @item.Title · @item.Status</a>}</div>}</section>
