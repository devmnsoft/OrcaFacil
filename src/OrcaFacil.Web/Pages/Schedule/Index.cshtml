@page "/Schedule"
@model OrcaFacil.Web.Pages.Schedule.IndexModel
@{ ViewData["Title"] = "Agenda"; }
<header class="of-page-header"><div><p class="of-eyebrow">Agenda operacional</p><h1>Serviços desta semana</h1><p>Horários, clientes e estado da execução em uma visão leve.</p></div></header>
<section class="of-card"><div class="btn-group mb-3" aria-label="Período"><a class="btn btn-outline-primary" asp-route-view="today">Hoje</a><a class="btn btn-outline-primary" asp-route-view="week">Semana</a><a class="btn btn-outline-primary" asp-route-view="list">Lista</a></div>
@if(Model.Orders.Count == 0){<p>Nenhum serviço agendado neste período.</p>}else{<div class="list-group">@foreach(var item in Model.Orders){<a class="list-group-item" asp-page="/WorkOrders/Details" asp-route-id="@item.Id"><strong>@item.ScheduledStart?.ToLocalTime().ToString("dd/MM HH:mm")</strong> · @item.Title · @item.Status</a>}</div>}</section>
