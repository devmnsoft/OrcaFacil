@page "/Schedule"
@model OrcaFacil.Web.Pages.Schedule.IndexModel
@section Styles { <link rel="stylesheet" href="~/css/work-orders.css" asp-append-version="true" /> }
@{ ViewData["Title"] = "Agenda"; }
<partial name="Partials/_PageIntro" model='new PageIntroViewModel("Agenda operacional", "Agenda", "Veja compromissos, horários e serviços programados em uma visão simples.", "calendar", SecondaryActions: new[]{new PageIntroActionViewModel("Ver ordens", "/WorkOrders/Index", "work-order")}, HelpCode: "schedule", WhatThisPageDoes: "Organiza as ordens agendadas por data e horário na zona de negócio.", NextStepText: "Abra uma ordem para agendar ou ajustar a execução.")' />
<section class="of-panel">
    <div class="of-segmented-control" aria-label="Período">
        <a class="of-button @(Model.View == "today" ? "is-active" : "")" asp-route-view="today">Hoje</a>
        <a class="of-button @(Model.View == "week" ? "is-active" : "")" asp-route-view="week">Semana</a>
        <a class="of-button @(Model.View == "overdue" ? "is-active" : "")" asp-route-view="overdue">Atrasadas</a>
        <a class="of-button @(Model.View == "unscheduled" ? "is-active" : "")" asp-route-view="unscheduled">Sem agenda</a>
    </div>
    @if(Model.ConflictCount > 0)
    {
        <p class="of-alert" role="alert" style="border-color:#e6c34a;background:#fff8ec;color:#725008;border-radius:12px">@Model.ConflictCount serviço(s) com horário sobreposto para o mesmo responsável. Revise antes de despachar.</p>
    }
    @if(Model.Items.Count == 0)
    {
        <partial name="Partials/_EmptyState" model='new EmptyStateViewModel { Icon="calendar", Title="Nenhum serviço agendado neste período", Text="Defina data e horário em uma ordem para organizar sua rotina e orientar o cliente.", ActionText="Ver ordens", ActionPage="/WorkOrders/Index" }' />
    }
    else
    {
        <div class="of-schedule-list">
            @foreach(var item in Model.Items)
            {
                <article style="@(item.Conflict ? "border-left:3px solid #e0a12b" : "")">
                    <time><strong>@(item.StartLabel ?? "Sem data")</strong><span>@(item.StartDayLabel ?? "—")</span></time>
                    <div>
                        <span class="of-status">@item.Status</span>
                        @if(item.Conflict){<span class="of-badge of-badge-warning">Horário sobreposto</span>}
                        <h3>@item.Title <small>@item.Number</small></h3>
                        <p>@(item.EndLabel != null ? $"Até {item.EndLabel}" : "Término a definir") · @(item.HasResource ? "Responsável definido" : "Sem responsável")</p>
                    </div>
                    <a class="of-button" asp-page="/WorkOrders/Details" asp-route-id="@item.Id">Abrir ordem</a>
                </article>
            }
        </div>
    }
</section>
