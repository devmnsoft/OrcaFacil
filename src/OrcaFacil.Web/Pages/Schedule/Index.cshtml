@page "/Schedule"
@model OrcaFacil.Web.Pages.Schedule.IndexModel
@section Styles { <link rel="stylesheet" href="~/css/work-orders.css" asp-append-version="true" /> }
@{ ViewData["Title"] = "Agenda"; }
<partial name="Partials/_PageIntro" model='new PageIntroViewModel("Agenda operacional", "Agenda", "Veja compromissos, horários e serviços programados em uma visão simples.", "calendar", SecondaryActions: new[]{new PageIntroActionViewModel("Ver ordens", "/WorkOrders/Index", "work-order")}, HelpCode: "schedule", WhatThisPageDoes: "Organiza as ordens agendadas por data e horário.", NextStepText: "Abra uma ordem para agendar ou ajustar a execução.")' />
<section class="of-panel"><div class="of-segmented-control" aria-label="Período"><a class="of-button @(Model.View == "today" ? "is-active" : "")" asp-route-view="today">Hoje</a><a class="of-button @(Model.View == "week" ? "is-active" : "")" asp-route-view="week">Semana</a><a class="of-button @(Model.View == "overdue" ? "is-active" : "")" asp-route-view="overdue">Atrasadas</a><a class="of-button @(Model.View == "unscheduled" ? "is-active" : "")" asp-route-view="unscheduled">Sem agenda</a></div>
@if(Model.Orders.Count == 0){<partial name="Partials/_EmptyState" model='new EmptyStateViewModel { Icon="calendar", Title="Nenhum serviço agendado neste período", Text="Defina data e horário em uma ordem para organizar sua rotina e orientar o cliente.", ActionText="Ver ordens", ActionPage="/WorkOrders/Index" }' />}else{<div class="of-schedule-list">@foreach(var item in Model.Orders){<article><time datetime="@item.ScheduledStart?.ToString("O")"><strong>@item.ScheduledStart?.ToLocalTime().ToString("HH:mm")</strong><span>@item.ScheduledStart?.ToLocalTime().ToString("ddd, dd/MM")</span></time><div><span class="of-status">@item.Status</span><h3>@item.Title</h3><p>@(item.ScheduledEnd.HasValue ? $"Até {item.ScheduledEnd.Value.ToLocalTime():HH:mm}" : "Horário de término a definir") · @(item.AssignedUserId.HasValue ? "Responsável definido" : "Sem responsável")</p></div><a class="of-button" asp-page="/WorkOrders/Details" asp-route-id="@item.Id">Abrir ordem</a></article>}</div>}</section>
