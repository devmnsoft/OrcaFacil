@page "/Schedule"
@model OrcaFacil.Web.Pages.Schedule.IndexModel
@{ ViewData["Title"] = "Agenda"; }
<header class="of-page-header"><div><p class="of-eyebrow">Agenda operacional</p><h1>Serviços desta semana</h1><p>Horários, clientes e estado da execução em uma visão leve.</p></div></header>
<section class="of-panel"><div class="of-segmented-control" aria-label="Período"><a class="of-button" asp-route-view="today">Hoje</a><a class="of-button" asp-route-view="week">Semana</a><a class="of-button" asp-route-view="list">Lista</a></div>
@if(Model.Orders.Count == 0){<div class="of-purpose-empty"><h2>Nenhum serviço agendado neste período</h2><p>Defina uma data em uma ordem de serviço para organizar a execução.</p><a class="of-button" asp-page="/WorkOrders/Index">Ver ordens</a></div>}else{<div class="of-record-list">@foreach(var item in Model.Orders){<a class="of-record-item" asp-page="/WorkOrders/Details" asp-route-id="@item.Id"><strong>@item.ScheduledStart?.ToLocalTime().ToString("dd/MM HH:mm")</strong> · @item.Title · @item.Status</a>}</div>}</section>
