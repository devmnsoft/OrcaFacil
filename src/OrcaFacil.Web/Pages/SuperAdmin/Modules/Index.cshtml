@page
@model OrcaFacil.Web.Pages.SuperAdmin.Modules.IndexModel
@{ViewData["Title"]="Módulos SaaS";}<main class="page-shell"><header class="page-hero"><nav class="breadcrumb"><a asp-page="/SuperAdmin/Index">SuperAdmin</a> / Módulos</nav><h1>Catálogo de módulos</h1><p>Cada módulo ativo tem preço, rota e permissão explícitos.</p><a asp-page="New" class="of-button of-button-primary">Novo módulo</a></header><div class="responsive-table"><table class="premium-table"><thead><tr><th>Módulo</th><th>Categoria</th><th>Mensal</th><th>Anual</th><th>Proteção</th><th>Status</th><th></th></tr></thead><tbody>@foreach(var x in Model.Modules){<tr><td><strong>@x.Name</strong><small>@x.Code</small></td><td>@x.Category</td><td>@x.Monthly.ToString("C")</td><td>@x.Annual.ToString("C")</td><td>@x.Permission<br/><small>@x.Route</small></td><td>@(x.Active?"Ativo":"Inativo")</td><td><a asp-page="Edit" asp-route-id="@x.Id">Editar</a></td></tr>}</tbody></table></div></main>
