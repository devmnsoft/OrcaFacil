@model OrcaFacil.Web.Pages.SuperAdmin.Users.NewModel
@{ViewData["Title"]="Novo usuário";}<main class="page-shell"><header class="page-hero"><nav class="breadcrumb"><a asp-page="Index">Usuários</a> / Novo</nav><h1>Novo usuário</h1><p>A senha temporária nunca é registrada em auditoria.</p></header><form method="post" class="form-panel" data-submit-lock data-confirm="Criar este usuário e atribuir o perfil selecionado?">@Html.AntiForgeryToken()<div asp-validation-summary="All" class="validation-summary"></div><div class="form-grid"><div class="of-field"><label asp-for="Input.Name">Nome</label><input asp-for="Input.Name" class="of-field-control"/></div><div class="of-field"><label asp-for="Input.Email">E-mail institucional</label><input asp-for="Input.Email" class="of-field-control"/></div><div class="of-field"><label asp-for="Input.Document">CPF/CNPJ</label><input asp-for="Input.Document" class="of-field-control"/></div><div class="of-field"><label asp-for="Input.TemporaryPassword">Senha temporária</label><input asp-for="Input.TemporaryPassword" type="password" class="of-field-control" autocomplete="new-password"/></div><div class="of-field"><label asp-for="Input.PlatformRole">Perfil global</label><select asp-for="Input.PlatformRole" class="of-field-control"><option value="User">Usuário de cliente</option><option>SuperAdmin</option><option>GlobalSupport</option><option>GlobalBilling</option><option>GlobalAuditor</option></select></div><div class="of-field"><label asp-for="Input.ClientKey">Conta do cliente</label><select asp-for="Input.ClientKey" class="of-field-control"><option value="">Nenhuma (perfil global)</option>@foreach(var a in Model.Accounts){<option value="@a.Id">@a.Name</option>}</select></div><div class="of-field"><label asp-for="Input.AccountProfile">Perfil na conta</label><select asp-for="Input.AccountProfile" class="of-field-control">@foreach(var role in Model.AccountProfiles){<option>@role</option>}</select></div></div><button type="submit" class="of-button of-button-primary" data-loading>Criar usuário</button></form></main>
