@model OrcaFacil.Web.Pages.SuperAdmin.Users.IndexModel
@{ViewData["Title"]="Usuários globais";}<main class="page-shell"><header class="page-hero"><nav class="breadcrumb"><a asp-page="/SuperAdmin/Index">SuperAdmin</a> / Usuários</nav><h1>Todos os usuários</h1><p>Identidade global e vínculos separados por cliente.</p><a asp-page="New" class="of-button of-button-primary">Novo usuário</a></header><div class="responsive-table"><table class="premium-table"><thead><tr><th>Usuário</th><th>Documento</th><th>Tipo</th><th>Contas</th><th>Status</th><th></th></tr></thead><tbody>@foreach(var x in Model.Users){<tr><td><strong>@x.Name</strong><small>@x.Email</small></td><td>@x.Document</td><td>@x.Role</td><td>@x.Accounts</td><td>@x.Status</td><td><a asp-page="Edit" asp-route-id="@x.Id">Gerenciar</a></td></tr>}</tbody></table></div></main>
