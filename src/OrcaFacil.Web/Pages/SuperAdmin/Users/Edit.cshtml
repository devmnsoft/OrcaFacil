@page
@model OrcaFacil.Web.Pages.SuperAdmin.Users.EditModel
@{ViewData["Title"]="Editar usuário";}<main class="page-shell"><header class="page-hero"><nav class="breadcrumb"><a asp-page="Index">Usuários</a> / Editar</nav><h1>@Model.UserView.Name</h1><p>@Model.UserView.Email · @Model.UserView.Role</p></header><div class="action-bar"><form method="post" asp-page-handler="Block" data-confirm="Bloquear este usuário e revogar as sessões?">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@Model.UserView.Id"/><input name="reason" required minlength="5" placeholder="Motivo"/><button type="submit" class="of-button of-button-danger">Bloquear</button></form><form method="post" asp-page-handler="Reactivate" data-confirm="Reativar este usuário?">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@Model.UserView.Id"/><button type="submit" class="of-button">Reativar</button></form><form method="post" asp-page-handler="Delete" data-confirm="Excluir logicamente o usuário? Os vínculos serão preservados para auditoria.">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@Model.UserView.Id"/><button type="submit" class="of-button of-button-danger">Excluir</button></form></div><section class="form-panel"><h2>Vínculos</h2>@foreach(var a in Model.UserView.Accounts){<p>@a</p>}</section></main>
