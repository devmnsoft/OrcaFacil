@page
@model OrcaFacil.Web.Pages.SuperAdmin.Clients.BillingModel
@{ViewData["Title"]="Billing do cliente";}<main class="page-shell"><header class="page-hero"><nav class="breadcrumb"><a asp-page="Details" asp-route-id="@Model.ClientKey">Cliente</a> / Billing</nav><h1>Billing modular</h1><p>Valores efetivamente contratados e cobranças persistidas.</p></header><section class="of-metric-grid"><article class="metric-card"><span>MRR modular</span><strong>@Model.Mrr.ToString("C")</strong></article><article class="metric-card"><span>Faturas pendentes</span><strong>@Model.PendingInvoices</strong></article><article class="metric-card"><span>Valor em aberto</span><strong>@Model.OpenAmount.ToString("C")</strong></article></section><a asp-page="Modules" asp-route-id="@Model.ClientKey" class="of-button">Alterar módulos</a></main>
