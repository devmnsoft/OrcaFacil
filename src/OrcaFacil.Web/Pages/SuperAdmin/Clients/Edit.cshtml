@page
@model OrcaFacil.Web.Pages.SuperAdmin.Clients.EditModel
@{ViewData["Title"]="Editar cliente";}
<main class="page-shell"><header class="page-hero"><nav class="breadcrumb"><a asp-page="Index">Clientes</a> / Editar</nav><h1>Editar cliente</h1></header><form method="post" class="form-panel" data-submit-lock>@Html.AntiForgeryToken()<div asp-validation-summary="ModelOnly" class="validation-summary"></div><div class="form-grid"><input asp-for="Input.Id" type="hidden"/><div class="of-field"><label asp-for="Input.Name">Nome</label><input asp-for="Input.Name" class="of-field-control"/><span asp-validation-for="Input.Name" class="field-validation"></span></div><div class="of-field"><label asp-for="Input.Email">E-mail</label><input asp-for="Input.Email" class="of-field-control"/><span asp-validation-for="Input.Email" class="field-validation"></span></div><div class="of-field"><label asp-for="Input.Plan">Plano principal</label><input asp-for="Input.Plan" class="of-field-control"/></div><div class="of-field"><label asp-for="Input.FinancialStatus">Situação financeira</label><select asp-for="Input.FinancialStatus" class="of-field-control"><option>Current</option><option>Overdue</option><option>Negotiation</option></select></div><div class="of-field"><label asp-for="Input.Responsible">Responsável</label><input asp-for="Input.Responsible" class="of-field-control"/></div><div class="of-field"><label asp-for="Input.Notes">Observações internas</label><textarea asp-for="Input.Notes" class="of-field-control"></textarea></div></div><div class="form-actions"><button type="submit" class="of-button of-button-primary" data-loading>Salvar</button></div></form>
<section class="action-bar"><form method="post" asp-page-handler="Block" data-confirm="Bloquear esta conta e impedir o login dos usuários comuns?">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@Model.Input.Id"/><input name="reason" required minlength="5" placeholder="Motivo do bloqueio"/><button type="submit" class="of-button of-button-danger">Bloquear</button></form><form method="post" asp-page-handler="Reactivate" data-confirm="Reativar esta conta?">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@Model.Input.Id"/><button type="submit" class="of-button">Reativar</button></form><form method="post" asp-page-handler="Delete" data-confirm="Excluir logicamente esta conta? Os dados serão preservados para auditoria.">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@Model.Input.Id"/><button type="submit" class="of-button of-button-danger">Excluir</button></form></section></main>
