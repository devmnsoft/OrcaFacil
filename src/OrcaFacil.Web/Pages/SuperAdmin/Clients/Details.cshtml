@page
@model OrcaFacil.Web.Pages.SuperAdmin.Clients.DetailsModel
@{ViewData["Title"]="Detalhes do cliente";}
<main class="page-shell"><header class="page-hero"><nav class="breadcrumb"><a asp-page="Index">Clientes</a> / Detalhes</nav><h1>@Model.Client.Name</h1><p>@Model.Client.Document · @Model.Client.Email</p><div class="action-bar"><span class="of-badge">@Model.Client.Status</span><a asp-page="Edit" asp-route-id="@Model.Client.Id" class="of-button of-button-secondary">Editar</a></div></header>
<section class="of-metric-grid"><article class="metric-card"><span>Usuários</span><strong>@Model.Client.Users</strong></article><article class="metric-card"><span>Módulos ativos</span><strong>@Model.Client.Modules</strong></article><article class="metric-card"><span>Eventos em 30 dias</span><strong>@Model.Client.Usage</strong></article><article class="metric-card"><span>MRR</span><strong>@Model.Client.Mrr.ToString("C")</strong></article></section>
<nav class="tabs" aria-label="Gestão do cliente"><a asp-page="Modules" asp-route-id="@Model.Client.Id">Módulos</a><a asp-page="Users" asp-route-id="@Model.Client.Id">Usuários</a><a asp-page="Billing" asp-route-id="@Model.Client.Id">Billing</a><a asp-page="Usage" asp-route-id="@Model.Client.Id">Uso</a></nav>
<section class="form-panel"><h2>Dados da conta</h2><dl class="form-grid"><div><dt>Plano</dt><dd>@Model.Client.Plan</dd></div><div><dt>Situação financeira</dt><dd>@Model.Client.Financial</dd></div><div><dt>Responsável</dt><dd>@(Model.Client.Responsible??"Não informado")</dd></div><div><dt>Localidade</dt><dd>@Model.Client.Location</dd></div></dl></section></main>
