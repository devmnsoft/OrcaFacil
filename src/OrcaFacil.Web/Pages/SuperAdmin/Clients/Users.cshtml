@page
@model OrcaFacil.Web.Pages.SuperAdmin.Clients.UsersModel
@{ViewData["Title"]="Usuários do cliente";}<main class="page-shell"><header class="page-hero"><nav class="breadcrumb"><a asp-page="Details" asp-route-id="@Model.ClientKey">Cliente</a> / Usuários</nav><h1>Usuários do cliente</h1></header>@if(Model.Users.Count==0){<div class="empty-state"><h2>Nenhum usuário vinculado</h2><p>Crie um usuário pela gestão global.</p></div>}else{<div class="responsive-table"><table class="premium-table"><thead><tr><th>Nome</th><th>Identificadores</th><th>Perfil</th><th>Status</th><th>Último login</th></tr></thead><tbody>@foreach(var item in Model.Users){<tr><td>@item.Name<br/><small>@item.Email</small></td><td>@item.Document</td><td>@item.Profile</td><td>@item.Status</td><td>@item.LastLogin</td></tr>}</tbody></table></div>}</main>
