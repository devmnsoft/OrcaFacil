@page
@model OrcaFacil.Web.Pages.SuperAdmin.Clients.NewModel
@{ViewData["Title"]="Novo cliente";}
<main class="page-shell"><header class="page-hero"><nav class="breadcrumb"><a asp-page="Index">Clientes</a> / Novo</nav><h1>Novo cliente SaaS</h1><p>A conta será criada ativa e toda a ação ficará auditada.</p></header><form method="post" class="form-panel" data-submit-lock data-confirm="Confirma a criação desta conta cliente?">@Html.AntiForgeryToken()<div asp-validation-summary="ModelOnly" class="validation-summary"></div><div class="form-grid">
<div class="of-field"><label asp-for="Input.LegalName">Razão social / nome</label><input asp-for="Input.LegalName" class="of-field-control"/><span asp-validation-for="Input.LegalName" class="field-validation"></span></div><div class="of-field"><label asp-for="Input.TradeName">Nome fantasia</label><input asp-for="Input.TradeName" class="of-field-control"/></div>
<div class="of-field"><label asp-for="Input.Document">CPF/CNPJ</label><input asp-for="Input.Document" class="of-field-control" inputmode="numeric"/><span asp-validation-for="Input.Document" class="field-validation"></span></div><div class="of-field"><label asp-for="Input.Email">E-mail institucional</label><input asp-for="Input.Email" class="of-field-control" autocomplete="email"/><span asp-validation-for="Input.Email" class="field-validation"></span></div>
<div class="of-field"><label asp-for="Input.Phone">Telefone</label><input asp-for="Input.Phone" class="of-field-control"/></div><div class="of-field"><label asp-for="Input.Responsible">Responsável</label><input asp-for="Input.Responsible" class="of-field-control"/></div><div class="of-field"><label asp-for="Input.City">Cidade</label><input asp-for="Input.City" class="of-field-control"/></div><div class="of-field"><label asp-for="Input.State">UF</label><input asp-for="Input.State" class="of-field-control" maxlength="2"/></div></div><div class="form-actions"><button type="submit" class="of-button of-button-primary" data-loading>Criar cliente</button><a asp-page="Index" class="of-button of-button-secondary">Cancelar</a></div></form></main>
