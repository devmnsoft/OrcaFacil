@page
@model OrcaFacil.Web.Pages.AccountAdmin.Modules.IndexModel
@{ViewData["Title"]="Módulos da conta";}<main class="page-shell"><header class="page-hero"><nav class="breadcrumb"><a asp-page="/AccountAdmin/Index">Administração</a> / Módulos</nav><h1>Módulos e funcionalidades</h1><p>Solicitações precisam de aprovação global antes de gerar entitlement.</p></header><div asp-validation-summary="ModelOnly" class="validation-summary"></div><div class="of-card-grid">@foreach(var x in Model.Modules){<article class="form-panel"><h2>@x.Name</h2><p>@x.Description</p><p><strong>@x.Monthly.ToString("C")/mês</strong> · @x.Annual.ToString("C")/ano</p><span class="of-badge">@x.Status</span>@if(x.CanRequest){<form method="post" data-confirm="Solicitar a contratação deste módulo?">@Html.AntiForgeryToken()<input type="hidden" name="moduleCode" value="@x.Code"/><select name="billingPeriod"><option value="Monthly">Mensal</option><option value="Annual">Anual</option></select><button type="submit" class="of-button of-button-primary">Solicitar contratação</button></form>}</article>}</div></main>
