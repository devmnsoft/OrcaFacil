@page
@model OrcaFacil.Web.Pages.AccountAdmin.Users.NewModel
@{ViewData["Title"]="Novo usuário da conta";}<main class="page-shell"><header class="page-hero"><nav class="breadcrumb"><a asp-page="Index">Usuários</a> / Novo</nav><h1>Novo usuário</h1></header><form method="post" class="form-panel" data-submit-lock data-confirm="Criar ou vincular este usuário à conta atual?">@Html.AntiForgeryToken()<div asp-validation-summary="All" class="validation-summary"></div><div class="form-grid"><div class="of-field"><label asp-for="Input.Name">Nome</label><input asp-for="Input.Name" class="of-field-control"/></div><div class="of-field"><label asp-for="Input.Email">E-mail</label><input asp-for="Input.Email" class="of-field-control"/></div><div class="of-field"><label asp-for="Input.Document">CPF</label><input asp-for="Input.Document" class="of-field-control"/></div><div class="of-field"><label asp-for="Input.TemporaryPassword">Senha temporária</label><input asp-for="Input.TemporaryPassword" type="password" class="of-field-control" autocomplete="new-password"/></div><div class="of-field"><label asp-for="Input.Profile">Perfil</label><select asp-for="Input.Profile" class="of-field-control">@foreach(var role in Model.Profiles){<option>@role</option>}</select></div></div><button type="submit" class="of-button of-button-primary" data-loading>Criar usuário</button></form></main>
