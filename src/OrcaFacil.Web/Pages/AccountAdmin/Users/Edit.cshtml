@page
@model OrcaFacil.Web.Pages.AccountAdmin.Users.EditModel
@{ViewData["Title"]="Editar vínculo";}<main class="page-shell"><header class="page-hero"><nav class="breadcrumb"><a asp-page="Index">Usuários</a> / Editar</nav><h1>@Model.Name</h1><p>As ações afetam somente o vínculo com esta conta.</p></header><form method="post" class="form-panel" data-submit-lock data-confirm="Alterar o perfil deste usuário na conta atual?">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@Model.MemberKey"/><label>Perfil <select name="profile" class="of-field-control">@foreach(var role in Model.Profiles){<option selected="@(role==Model.Profile)">@role</option>}</select></label><button type="submit" class="of-button of-button-primary">Salvar perfil</button></form><div class="action-bar"><form method="post" asp-page-handler="Disable" data-confirm="Bloquear o acesso deste usuário apenas nesta conta?">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@Model.MemberKey"/><button type="submit" class="of-button of-button-danger">Bloquear vínculo</button></form><form method="post" asp-page-handler="Reactivate" data-confirm="Reativar este vínculo?">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@Model.MemberKey"/><button type="submit" class="of-button">Reativar vínculo</button></form><form method="post" asp-page-handler="Delete" data-confirm="Excluir logicamente este vínculo? O usuário continuará existindo em outras contas."> @Html.AntiForgeryToken()<input type="hidden" name="id" value="@Model.MemberKey"/><button type="submit" class="of-button of-button-danger">Excluir vínculo</button></form></div></main>
