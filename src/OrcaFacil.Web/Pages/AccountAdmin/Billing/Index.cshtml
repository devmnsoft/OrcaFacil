@page
@model OrcaFacil.Web.Pages.AccountAdmin.Billing.IndexModel
@{ViewData["Title"]="Billing da conta";}<main class="page-shell"><header class="page-hero"><nav class="breadcrumb"><a asp-page="/AccountAdmin/Index">Administração</a> / Billing</nav><h1>Plano e cobrança</h1><p>O cliente vê apenas seus valores contratados.</p></header><section class="of-metric-grid"><article class="metric-card"><span>Mensalidade modular</span><strong>@Model.Mrr.ToString("C")</strong></article><article class="metric-card"><span>Faturas pendentes</span><strong>@Model.Pending</strong></article></section><table class="premium-table"><thead><tr><th>Módulo</th><th>Período</th><th>Preço contratado</th><th>Status</th></tr></thead><tbody>@foreach(var x in Model.Items){<tr><td>@x.Module</td><td>@x.Period</td><td>@x.Price.ToString("C")</td><td>@x.Status</td></tr>}</tbody></table></main>
