@page "/Segmentos/{slug?}"
@model OrcaFacil.Web.Pages.Segmentos.IndexModel
@{Layout="/Pages/Shared/_PublicLayout.cshtml";ViewData["Title"]=Model.Title;ViewData["Description"]=Model.Description;}
<section class="of-public-hero of-commercial-hero"><div class="of-container"><span class="of-eyebrow">Soluções por segmento</span><h1>@Model.Title</h1><p>@Model.Description</p><div class="of-home-actions"><a class="of-button of-button-primary" asp-page="/Auth/Register">Começar trial</a><a class="of-button of-button-secondary" asp-page="/Demo">Pedir demonstração</a></div></div></section><section class="of-public-section"><div class="of-container"><h2>Fluxo recomendado</h2><ol><li>Centralize clientes e serviços.</li><li>Crie e acompanhe propostas.</li><li>Conecte aprovação, execução e financeiro.</li></ol><h2>Módulos recomendados</h2><div class="of-feature-grid">@foreach(var module in Model.Modules){<article><h3>@module</h3><p>Disponibilidade sujeita ao plano e às permissões configuradas.</p></article>}</div><div class="of-faq-list"><details><summary>Preciso mudar todo o processo de uma vez?</summary><p>Não. Comece por um fluxo verificável e amplie depois da validação com a equipe.</p></details></div></div></section>
