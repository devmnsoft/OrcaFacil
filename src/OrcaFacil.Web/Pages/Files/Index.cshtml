@page
@model OrcaFacil.Web.Pages.Files.IndexModel
@{ ViewData["Title"] = "Central de arquivos"; }
<section class="page-header"><div><span class="eyebrow">DOCUMENTOS V1.4</span><h1>Central de arquivos</h1><p>Arquivos privados da conta, disponíveis somente por download autorizado.</p></div></section>
@if (!ViewData.ModelState.IsValid) { <div class="alert alert-error" asp-validation-summary="All"></div> }
<section class="card file-upload-card"><h2>Enviar arquivo</h2><form method="post" enctype="multipart/form-data" asp-page-handler="Upload"><label asp-for="Upload">Arquivo (PDF, imagem, CSV ou TXT; até 10 MB)</label><input asp-for="Upload" type="file" accept=".pdf,.png,.jpg,.jpeg,.webp,.csv,.txt" required /><label asp-for="UploadCategory">Categoria</label><select asp-for="UploadCategory" asp-items="Html.GetEnumSelectList<OrcaFacil.Domain.Entities.FileAssetCategory>()"></select><button class="btn btn-primary" type="submit">Armazenar com segurança</button></form></section>
<form method="get" class="card file-filters"><label asp-for="Search">Buscar</label><input asp-for="Search" placeholder="Nome do arquivo" /><label asp-for="Category">Categoria</label><select asp-for="Category" asp-items="Html.GetEnumSelectList<OrcaFacil.Domain.Entities.FileAssetCategory>()"><option value="">Todas</option></select><button type="submit" class="btn btn-secondary">Filtrar</button></form>
<section class="file-grid">@if(Model.Items.Count==0){<div class="card empty-state"><h2>Nenhum arquivo encontrado</h2><p>Envie o primeiro documento ou ajuste os filtros.</p></div>}@foreach(var item in Model.Items){<article class="card file-card"><span class="badge">@item.Category</span><h2>@item.OriginalFileName</h2><p>@((item.SizeInBytes/1024d).ToString("N1")) KB · @item.CreatedAt.ToLocalTime().ToString("g")</p><div class="file-actions"><a class="btn btn-secondary" asp-page="/Files/Index" asp-page-handler="Download" asp-route-id="@item.Id">Baixar</a><form method="post" asp-page-handler="Delete"><input type="hidden" name="id" value="@item.Id"/><button type="submit" class="btn btn-danger">Excluir</button></form></div></article>}</section>
@section Styles { <link rel="stylesheet" href="~/css/files.css" asp-append-version="true" /> }
