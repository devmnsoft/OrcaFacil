@page
@model OrcaFacil.Web.Pages.Approvals.IndexModel
@{ViewData["Title"]="Aprovações";}
<section class="of-page-header"><div><span class="of-eyebrow">Workflow comercial</span><h1>Fila de aprovações</h1><p>Decisões internas preservadas com responsável, motivo e horário.</p></div></section>
<form method="get" class="of-card of-form-row"><label>Status<select asp-for="Status" asp-items="Html.GetEnumSelectList<OrcaFacil.Domain.Entities.ApprovalStatus>()"><option value="">Todos</option></select></label><button type="submit" class="of-btn">Filtrar</button></form>
<div class="of-card-grid">@if(Model.Requests.Count==0){<article class="of-card"><h2>Nenhuma aprovação neste filtro</h2><p>Solicitações geradas pelas políticas de desconto aparecerão aqui.</p></article>}@foreach(var item in Model.Requests){<article class="of-card"><div class="of-card-heading"><h2>Solicitação @item.Id.ToString()[..8]</h2><span class="of-badge">@item.Status</span></div><p>@item.Reason</p><p><time datetime="@item.RequestedAt.ToString("O")">@item.RequestedAt.ToLocalTime().ToString("g")</time></p>@if(item.Status==OrcaFacil.Domain.Entities.ApprovalStatus.Pending){<div class="of-actions"><form method="post" asp-page-handler="Approve"><input type="hidden" name="id" value="@item.Id"/><button type="submit" class="of-btn of-btn-primary">Aprovar</button></form><form method="post" asp-page-handler="Reject"><input type="hidden" name="id" value="@item.Id"/><label>Motivo da recusa<input name="reason" required maxlength="1000"/></label><button type="submit" class="of-btn">Recusar</button></form></div>}</article>}</div>
