@page
@model OrcaFacil.Web.Pages.Profile.Privacy.IndexModel
@{ ViewData["Title"] = "Central de Privacidade"; }
@section Styles { <link rel="stylesheet" href="~/css/privacy-center.css" asp-append-version="true" /> }
<header class="privacy-hero"><div><p class="of-eyebrow">Privacidade sob seu controle</p><h1>Central de Privacidade</h1><p>Consulte registros, gerencie consentimentos e exerça seus direitos pela LGPD em um único lugar.</p></div><span class="privacy-hero-badge">Ambiente seguro</span></header>
@if (TempData["Success"] is string success) { <div class="of-feedback of-feedback-success" role="status" tabindex="-1">@success</div> }
@if (TempData["Error"] is string error) { <div class="of-feedback of-feedback-error" role="alert" tabindex="-1">@error</div> }
<div class="privacy-grid">
<section class="of-card privacy-panel"><header><p class="of-eyebrow">Transparência</p><h2>Documentos aceitos</h2></header>@if(Model.Acceptances.Count == 0){<div class="privacy-empty"><strong>Nenhum aceite registrado</strong><p>Uma nova versão dos termos poderá exigir seu aceite.</p></div>}else{<ul class="privacy-record-list">@foreach(var item in Model.Acceptances){<li><span>@item.AcceptanceSource</span><time>@item.AcceptedAt.ToLocalTime().ToString("g")</time></li>}</ul>}</section>
<section class="of-card privacy-panel"><header><p class="of-eyebrow">Preferências</p><h2>Comunicações opcionais</h2></header>@if(Model.Consents.Count == 0){<div class="privacy-empty"><strong>Nenhum consentimento opcional</strong><p>Você mantém apenas as comunicações essenciais da conta.</p></div>}else{@foreach(var consent in Model.Consents){<div class="consent-row"><div><strong>@consent.Channel</strong><span>@consent.Purpose</span></div><span class="privacy-badge" data-active="@consent.Granted.ToString().ToLowerInvariant()">@(consent.Granted ? "Ativo" : "Revogado")</span>@if(consent.Granted){<form method="post" asp-page-handler="RevokeMarketing"><input type="hidden" name="consentId" value="@consent.Id"/><button class="of-button-danger-secondary" type="submit">Revogar</button></form>}</div>}}</section>
<section class="of-card privacy-request"><header><p class="of-eyebrow">Direitos do titular</p><h2>Exercer um direito</h2><p>Abra uma solicitação formal e acompanhe pelo protocolo.</p></header><form method="post" asp-page-handler="Request"><div class="of-field"><label asp-for="RequestType">Tipo de solicitação</label><select class="of-input" asp-for="RequestType" asp-items="Html.GetEnumSelectList<OrcaFacil.Domain.Entities.DataSubjectRequestType>()"></select></div><div class="of-field"><label asp-for="Description">Descrição</label><textarea class="of-input" asp-for="Description" rows="5" maxlength="4000" required aria-describedby="privacy-retention"></textarea><span class="of-field-error" asp-validation-for="Description"></span></div><p id="privacy-retention" class="privacy-help">Seus dados serão preservados enquanto avaliamos obrigações legais e de retenção.</p><button class="of-button-primary" type="submit" data-submit-label="Enviando solicitação…">Enviar solicitação</button></form></section>
<section class="of-card privacy-panel"><header><p class="of-eyebrow">Acompanhamento</p><h2>Solicitações</h2></header>@if(Model.Requests.Count == 0){<div class="privacy-empty"><strong>Nenhuma solicitação aberta</strong><p>Use o formulário ao lado quando precisar exercer um direito.</p></div>}else{<ul class="privacy-record-list">@foreach(var request in Model.Requests){<li><span><strong>@request.Type</strong><small>Protocolo @request.CorrelationId.ToString("N")</small></span><span class="privacy-badge">@request.Status</span></li>}</ul>}</section>
<section class="of-card privacy-panel"><header><p class="of-eyebrow">Ecossistema</p><h2>Fornecedores aprovados</h2></header>@if(Model.Vendors.Count == 0){<div class="privacy-empty"><strong>Nenhum fornecedor publicado</strong><p>Fornecedores só aparecem após validação administrativa.</p></div>}else{<ul class="privacy-record-list">@foreach(var vendor in Model.Vendors){<li><span><a href="@vendor.PrivacyUrl" rel="noopener noreferrer">@vendor.Name</a><small>@vendor.Purpose</small></span></li>}</ul>}</section>
<section class="of-card privacy-contact"><p class="of-eyebrow">Contato direto</p><h2>Canal de privacidade</h2><p>Fale com nossa equipe. O protocolo permite acompanhar o prazo estimado de resposta.</p><a class="of-button-secondary" href="mailto:@Model.PrivacyContactEmail">@Model.PrivacyContactEmail</a></section>
</div>
@section Scripts { <script type="module" src="~/js/privacy-center.js" asp-append-version="true"></script> }
