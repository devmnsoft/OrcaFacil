@page
@model OrcaFacil.Web.Pages.Profile.IndexModel
@{ViewData["Title"]="Emitente";}
<header class="of-page-header"><div><p class="of-eyebrow">Perfil</p><h1>Perfil do Emitente</h1><p>Esses dados aparecem no cabeçalho e rodapé dos PDFs.</p></div></header><div class="row g-4"><div class="col-lg-7"><form method="post" class="of-card">@Html.AntiForgeryToken()<div asp-validation-summary="ModelOnly" class="text-danger"></div><label asp-for="Input.BusinessName" class="form-label">Nome/Razão Social</label><input asp-for="Input.BusinessName" class="form-control"/><label asp-for="Input.DocumentNumber" class="form-label">CPF/CNPJ</label><input asp-for="Input.DocumentNumber" class="form-control"/><label asp-for="Input.Phone" class="form-label">Telefone</label><input asp-for="Input.Phone" class="form-control" data-phone/><label asp-for="Input.Email" class="form-label">E-mail</label><input asp-for="Input.Email" class="form-control"/><label asp-for="Input.Address" class="form-label">Endereço</label><input asp-for="Input.Address" class="form-control"/><label asp-for="Input.City" class="form-label">Cidade</label><input asp-for="Input.City" class="form-control"/><label asp-for="Input.PixKey" class="form-label">Pix</label><input asp-for="Input.PixKey" class="form-control"/><div class="alert alert-info mt-3">Logo personalizada: em breve.</div><button class="btn btn-primary mt-3" data-loading>Salvar perfil</button></form></div><div class="col-lg-5"><div class="of-card"><p class="of-eyebrow">Preview PDF</p><h2 class="h4">@Model.Input.BusinessName</h2><p>@Model.Input.DocumentNumber · @Model.Input.Phone</p><p>@Model.Input.Email<br/>@Model.Input.Address<br/>@Model.Input.City</p><hr/><p class="text-muted">O cabeçalho do PDF seguirá a identidade azul-marinho do OrçaFácil.</p></div></div></div>
