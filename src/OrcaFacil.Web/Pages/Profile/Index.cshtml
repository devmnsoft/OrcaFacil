@page
@model OrcaFacil.Web.Pages.Profile.IndexModel
@{ViewData["Title"]="Perfil"; ViewData["Section"]="Conta";}
<partial name="Partials/_PageIntro" model='new PageIntroViewModel("Minha conta", "Perfil e empresa", "Mantenha seus dados profissionais corretos para gerar documentos confiáveis.", "account", SecondaryActions: new[]{new PageIntroActionViewModel("Privacidade", "/Profile/Privacy/Index", "shield"), new PageIntroActionViewModel("Meu plano", "/Subscription/Index", "plan")}, HelpCode: "profile", WhatThisPageDoes: "Define a identificação e os contatos exibidos nos documentos.", NextStepText: "Revise os dados e salve para atualizar os próximos PDFs.")' />
<div class="of-profile-layout">
 <form method="post" class="of-panel of-guided-form" data-prevent-double-submit>
  @Html.AntiForgeryToken()
  <div asp-validation-summary="ModelOnly" class="of-form-error" role="alert" tabindex="-1"></div>
  <header><p class="of-eyebrow">Dados profissionais</p><h2>Como seus clientes identificam você</h2><p>Use informações que você reconhece e mantém atualizadas.</p></header>
  <div class="of-form-grid">
   <label class="of-field" asp-for="Input.BusinessName"><span>Nome ou razão social</span><small>Nome exibido no cabeçalho dos documentos.</small><input asp-for="Input.BusinessName" autocomplete="organization"/><span asp-validation-for="Input.BusinessName"></span></label>
   <label class="of-field" asp-for="Input.DocumentNumber"><span>CPF ou CNPJ</span><small>Informe apenas o documento do emitente.</small><input asp-for="Input.DocumentNumber" inputmode="numeric"/><span asp-validation-for="Input.DocumentNumber"></span></label>
   <label class="of-field" asp-for="Input.Phone"><span>Telefone</span><small>Contato comercial principal.</small><input asp-for="Input.Phone" type="tel" autocomplete="tel" data-phone/><span asp-validation-for="Input.Phone"></span></label>
   <label class="of-field" asp-for="Input.Email"><span>E-mail</span><small>Canal para respostas do cliente.</small><input asp-for="Input.Email" type="email" autocomplete="email"/><span asp-validation-for="Input.Email"></span></label>
   <label class="of-field of-field--wide" asp-for="Input.Address"><span>Endereço</span><small>Logradouro e número do emitente.</small><input asp-for="Input.Address" autocomplete="street-address"/><span asp-validation-for="Input.Address"></span></label>
   <label class="of-field" asp-for="Input.City"><span>Cidade</span><small>Município usado nos documentos.</small><input asp-for="Input.City" autocomplete="address-level2"/><span asp-validation-for="Input.City"></span></label>
   <label class="of-field" asp-for="Input.PixKey"><span>Chave Pix</span><small>Opcional; confira antes de compartilhar.</small><input asp-for="Input.PixKey"/><span asp-validation-for="Input.PixKey"></span></label>
  </div>
  <footer class="of-form-actions"><button class="of-button of-button--primary" type="submit" data-loading>Salvar perfil</button><span aria-live="polite" data-submit-status></span></footer>
 </form>
 <aside class="of-panel of-profile-preview" aria-labelledby="preview-title"><p class="of-eyebrow">Prévia do documento</p><h2 id="preview-title">@Model.Input.BusinessName</h2><p>@Model.Input.DocumentNumber · @Model.Input.Phone</p><p>@Model.Input.Email<br/>@Model.Input.Address<br/>@Model.Input.City</p><div><partial name="Partials/_Icon" model='new IconViewModel("information", "sm", Decorative: true)' /><span>As alterações aparecem nos próximos PDFs depois de salvar.</span></div></aside>
</div>
