@page "{id:guid}"
@model OrcaFacil.Web.Pages.Contracts.DetailsModel
@{ var c=Model.Contract; ViewData["Title"]=$"Contrato {c.Number}"; var today=DateOnly.FromDateTime(DateTime.Today); }
@section Styles { <link rel="stylesheet" href="~/css/contracts.css" asp-append-version="true" /> }
<main class="of-contract-page">@if(TempData["Error"] is string error){<div class="of-feedback of-feedback-error">@error</div>}
<header class="of-contract-detail-hero"><div><p class="of-eyebrow">@c.Number · @Model.ClientName</p><h1>@c.Title</h1><p>@(c.Description ?? "Contrato recorrente sem descrição adicional.")</p><div class="of-contract-tags"><span class="of-contract-status" data-status="@c.Status">@c.Status</span><span>@c.Periodicity</span><span>SLA: @(c.ResponseSlaHours?.ToString() ?? "—")h atendimento</span></div></div><div class="of-contract-value"><span>Valor recorrente</span><strong>@c.RecurringAmount.ToString("C")</strong><small>vence no dia @c.DueDay</small></div></header>
<nav class="of-contract-tabs"><a href="#overview">Visão geral</a><a href="#orders">OS recorrentes</a><a href="#payments">Pagamentos</a><a href="#renewal">Renovação</a><a href="#timeline">Timeline</a></nav>
<div class="of-contract-detail-grid"><div>
<section id="overview" class="of-contract-panel"><header><h2>Visão geral</h2><a asp-page="/Clients/Details" asp-route-id="@c.ClientId">Abrir cliente</a></header><dl class="of-contract-data"><div><dt>Vigência</dt><dd>@c.StartDate.ToString("dd/MM/yyyy") — @(c.EndDate?.ToString("dd/MM/yyyy") ?? "indeterminada")</dd></div><div><dt>Próxima cobrança</dt><dd>@(c.NextBillingDate?.ToString("dd/MM/yyyy") ?? "a definir")</dd></div><div><dt>Próxima entrega</dt><dd>@(c.NextServiceDate?.ToString("dd/MM/yyyy") ?? "a definir")</dd></div><div><dt>Renovação</dt><dd>@(c.AutoRenew ? "Automática, conforme configuração" : "Manual") · aviso @c.RenewalNoticeDays dias</dd></div></dl>@if(c.SourceDocumentId is {} source){<a asp-page="/Documents/Details" asp-route-id="@source">Abrir proposta de origem</a>}</section>
<section class="of-contract-panel"><h2>Serviços vinculados</h2>@if(c.Items.Count==0){<p class="of-muted">Nenhum item vinculado.</p>}else{<div class="of-contract-items">@foreach(var item in c.Items){<article><strong>@item.Description</strong><span>@item.Quantity × @item.UnitPrice.ToString("C")</span></article>}</div>}</section>
<section id="orders" class="of-contract-panel"><header><div><p class="of-eyebrow">Execução real</p><h2>Ordens recorrentes</h2></div><form method="post" asp-page-handler="WorkOrder"><label>Competência da OS<input type="month" name="competence" value="@DateTime.Today.ToString("yyyy-MM")" required/></label><button class="of-button-primary" type="submit">Gerar OS do mês</button></form></header>@if(Model.WorkOrders.Count==0){<p class="of-muted">Nenhuma OS recorrente gerada.</p>}else{<div class="of-contract-list">@foreach(var order in Model.WorkOrders){<a asp-page="/WorkOrders/Details" asp-route-id="@order.Id"><strong>@order.Number</strong><span>@order.Title · @order.Status</span></a>}</div>}</section>
<section id="payments" class="of-contract-panel"><header><div><p class="of-eyebrow">Faturamento recorrente</p><h2>Pagamentos</h2></div></header><form method="post" asp-page-handler="Payment" class="of-contract-inline-form"><label>Competência<input name="competence" type="month" value="@DateTime.Today.ToString("yyyy-MM")" required /></label><label>Vencimento<input name="dueDate" type="date" value="@DateTime.Today.ToString("yyyy-MM-dd")" required /></label><label>Valor<input name="amount" type="number" min="0.01" step="0.01" value="@c.RecurringAmount.ToString(System.Globalization.CultureInfo.InvariantCulture)" required /></label><button class="of-button-primary" type="submit">Registrar previsão</button></form>@if(Model.Payments.Count==0){<p class="of-muted">Nenhum pagamento previsto.</p>}else{<div class="of-contract-payment-list">@foreach(var p in Model.Payments){<article><div><strong>@p.Competence.ToString("MM/yyyy") · @p.Amount.ToString("C")</strong><span>Vence @p.DueDate.ToString("dd/MM/yyyy") · @p.Status</span></div>@if(p.Status is not OrcaFacil.Domain.Entities.RecurringPaymentStatus.Paid){<form method="post" asp-page-handler="Pay"><input type="hidden" name="paymentId" value="@p.Id"/><label>Método de pagamento<select name="paymentMethod"><option>Pix</option><option>Dinheiro</option><option>Cartão</option><option>Transferência</option></select></label><button class="of-button-secondary" type="submit">Marcar pago e emitir recibo</button></form>}else if(p.ManualPaymentId is {} paymentId){<a asp-page="/Receipts/Create" asp-route-paymentId="@paymentId">Emitir recibo</a>}</article>}</div>}</section>
<section id="renewal" class="of-contract-panel"><h2>Renovar com histórico</h2><p>Uma nova vigência será criada; este contrato será preservado e encerrado.</p><form method="post" asp-page-handler="Renew" class="of-contract-inline-form"><label>Novo início<input name="startDate" type="date" value="@((c.EndDate?.AddDays(1) ?? today).ToString("yyyy-MM-dd"))" required /></label><label>Novo fim<input name="endDate" type="date" /></label><label>Novo valor<input name="amount" type="number" min="0.01" step="0.01" value="@c.RecurringAmount.ToString(System.Globalization.CultureInfo.InvariantCulture)" required /></label><button class="of-button-primary" type="submit">Renovar contrato</button></form></section>
<section id="timeline" class="of-contract-panel"><h2>Timeline do contrato</h2>@if(Model.Timeline.Count==0){<p class="of-muted">Nenhum evento registrado.</p>}else{<ol class="of-contract-timeline">@foreach(var e in Model.Timeline){<li><span></span><div><small>@e.CreatedAt.ToLocalTime().ToString("g") · @e.Type</small><p>@e.Description</p>@if(e.RelatedUrl is not null){<a href="@e.RelatedUrl">Abrir registro relacionado</a>}</div></li>}</ol>}</section>
</div><aside class="of-contract-command"><h2>Ações</h2>@if(c.Status!=OrcaFacil.Domain.Entities.ContractStatus.Active){<form method="post" asp-page-handler="Status"><input type="hidden" name="status" value="Active"/><button type="submit">Ativar contrato</button></form>}@if(c.Status==OrcaFacil.Domain.Entities.ContractStatus.Active){<form method="post" asp-page-handler="Status"><input type="hidden" name="status" value="Paused"/><button type="submit">Pausar contrato</button></form>}<form method="post" asp-page-handler="Status" class="of-contract-cancel"><input type="hidden" name="status" value="Canceled"/><label>Motivo do cancelamento<input name="reason" maxlength="500" required /></label><button type="submit">Cancelar contrato</button></form></aside></div></main>
