@page
@model OrcaFacil.Web.Pages.Contracts.CreateModel
@{ ViewData["Title"] = "Criar contrato"; }
@section Styles { <link rel="stylesheet" href="~/css/contracts.css" asp-append-version="true" /> }
<main class="of-contract-page"><header class="of-contract-hero"><div><p class="of-eyebrow">Nova recorrência</p><h1>Criar contrato</h1><p>Defina uma vigência e regras reais para a operação recorrente.</p></div></header>
<form method="post" class="of-contract-form"><div asp-validation-summary="ModelOnly" class="of-feedback of-feedback-error"></div><input asp-for="Input.SourceDocumentId" type="hidden" />
<section><h2>Identificação</h2><div class="of-contract-fields"><label>Cliente<select asp-for="Input.ClientId" required><option value="">Selecione</option>@foreach(var c in Model.Clients){<option value="@c.Id">@c.Name</option>}</select><span asp-validation-for="Input.ClientId"></span></label><label>Título<input asp-for="Input.Title" required /><span asp-validation-for="Input.Title"></span></label><label class="of-field-wide">Descrição<textarea asp-for="Input.Description" rows="3"></textarea></label></div></section>
<section><h2>Recorrência e vigência</h2><div class="of-contract-fields"><label>Início<input asp-for="Input.StartDate" type="date" /></label><label>Fim<input asp-for="Input.EndDate" type="date" /></label><label>Valor recorrente<input asp-for="Input.RecurringAmount" type="number" min="0.01" step="0.01" /></label><label>Periodicidade<select asp-for="Input.Periodicity" asp-items="Html.GetEnumSelectList<OrcaFacil.Domain.Entities.RecurrencePeriod>()"></select></label><label>Dia de vencimento<input asp-for="Input.DueDay" type="number" min="1" max="28" /></label><label>Aviso de renovação (dias)<input asp-for="Input.RenewalNoticeDays" type="number" min="1" max="365" /></label><label class="of-contract-check"><input asp-for="Input.AutoRenew" /> Renovação automática configurada</label></div></section>
<section><h2>SLA simples</h2><div class="of-contract-fields"><label>Prazo de atendimento (horas)<input asp-for="Input.ResponseSlaHours" type="number" min="1" /></label><label>Prazo de execução (horas)<input asp-for="Input.ExecutionSlaHours" type="number" min="1" /></label></div></section>
<section><h2>Condições e observações</h2><div class="of-contract-fields"><label class="of-field-wide">Condições comerciais<textarea asp-for="Input.CommercialTerms" rows="4"></textarea></label><label>Observações internas<textarea asp-for="Input.InternalNotes" rows="4"></textarea></label><label>Observações para o cliente<textarea asp-for="Input.CustomerNotes" rows="4"></textarea></label></div></section>
<footer class="of-contract-form-actions"><a class="of-button-secondary" asp-page="Index">Cancelar</a><button class="of-button-primary" type="submit">Salvar contrato</button></footer></form></main>
