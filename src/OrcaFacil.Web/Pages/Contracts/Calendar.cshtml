@page
@model OrcaFacil.Web.Pages.Contracts.CalendarModel
@{ViewData["Title"]="Agenda de contratos";}
@section Styles { <link rel="stylesheet" href="~/css/contracts.css" asp-append-version="true" /> }
<main class="of-contract-page"><header class="of-contract-hero"><div><p class="of-eyebrow">Agenda real</p><h1>Agenda de contratos</h1><p>Vencimentos, serviços e pagamentos registrados.</p></div><a class="of-button-secondary" asp-page="Index">Ver contratos</a></header><form class="of-contract-filters"><label>De<input name="start" type="date" value="@Model.Start.ToString("yyyy-MM-dd")"/></label><label>Até<input name="end" type="date" value="@Model.End.ToString("yyyy-MM-dd")"/></label><button class="of-button-secondary">Aplicar</button></form>@if(Model.Events.Count==0){<section class="of-contract-empty"><h2>Nenhum evento no período</h2><p>A agenda só exibe vencimentos, OS e pagamentos reais.</p></section>}else{<div class="of-calendar-list">@foreach(var e in Model.Events){<a asp-page="Details" asp-route-id="@e.ContractId"><time>@e.Date.ToString("dd/MM")</time><span><small>@e.Type</small><strong>@e.Title</strong></span></a>}</div>}</main>
