@page "{id:guid}"
@model OrcaFacil.Web.Pages.WorkOrders.DetailsModel
@using OrcaFacil.Domain.Enums
@section Styles { <link rel="stylesheet" href="~/css/work-orders.css" asp-append-version="true" /> }
@{ ViewData["Title"] = "Ordem de serviço"; var order = Model.Order!; var paid = Model.Payments.Where(x => x.Status == FinancialRecordStatus.Active).Sum(x => x.Amount); }
<header class="of-page-header"><div><p class="of-eyebrow">Ordem @order.Number</p><h1>@order.Title</h1><p><span class="of-status">@order.Status</span> · Cliente vinculado · @order.TotalSnapshot.ToString("C")</p></div></header>
<div aria-live="polite">@if(TempData["Success"] is string success){<p class="of-feedback" role="status">@success</p>}@if(TempData["Error"] is string error){<p class="of-feedback of-feedback--error" role="alert">@error</p>}</div>
<main class="of-workspace">
 <div class="of-workspace-main">
  <section class="of-panel"><h2>Execução</h2><dl class="of-order-facts"><div><dt>Origem</dt><dd>@(order.SourceDocumentId.HasValue ? "Orçamento aprovado" : "Ordem direta")</dd></div><div><dt>Prevista</dt><dd>@(order.ScheduledStart?.ToLocalTime().ToString("dd/MM/yyyy HH:mm") ?? "Não agendada")</dd></div><div><dt>Início</dt><dd>@(order.StartedAt?.ToLocalTime().ToString("dd/MM/yyyy HH:mm") ?? "—")</dd></div><div><dt>Conclusão</dt><dd>@(order.CompletedAt?.ToLocalTime().ToString("dd/MM/yyyy HH:mm") ?? "—")</dd></div></dl><p>@(order.Description ?? "Escopo preservado a partir da proposta de origem.")</p>@if(!string.IsNullOrWhiteSpace(order.Notes)){<p><strong>Observações:</strong> @order.Notes</p>}</section>
  <section class="of-panel" aria-labelledby="checklist-title"><div class="of-section-heading"><div><p class="of-eyebrow">Execução segura</p><h2 id="checklist-title">Checklist (@Model.Checklist.Count(x=>x.IsCompleted)/@Model.Checklist.Count)</h2></div></div>
   <div class="of-checklist">@foreach(var item in Model.Checklist){<form method="post" asp-page-handler="ToggleChecklist" class="of-checklist-item @(item.IsCompleted ? "is-complete" : "")"><input type="hidden" name="itemId" value="@item.Id"/><button type="submit" class="of-check-toggle" aria-label="@(item.IsCompleted ? "Reabrir" : "Concluir") @item.Description">@(item.IsCompleted ? "✓" : "○")</button><div><strong>@item.Description</strong>@if(item.CompletedAt.HasValue){<small>Concluída em @item.CompletedAt.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</small>}@if(!string.IsNullOrWhiteSpace(item.CompletionNote)){<small>@item.CompletionNote</small>}</div><label><span class="of-sr-only">Observação ao concluir</span><input name="CompletionNote" maxlength="1000" placeholder="Observação opcional" class="of-field-control" /></label></form>}</div>
   <form method="post" asp-page-handler="AddChecklist" class="of-inline-field"><label class="of-sr-only" asp-for="NewItemDescription">Nova tarefa</label><input asp-for="NewItemDescription" class="of-field-control" placeholder="Adicionar tarefa real"/><button class="of-button of-button--secondary">Adicionar</button></form>
  </section>
  <section class="of-panel"><h2>Timeline</h2><ol class="of-timeline">@foreach(var evt in Model.Timeline){<li><span></span><div><strong>@evt.Summary</strong><time datetime="@evt.CreatedAt.ToString("O")">@evt.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</time></div></li>}@if(Model.Timeline.Count==0){<li><div>Nenhum evento operacional registrado.</div></li>}</ol></section>
 </div>
 <aside class="of-workspace-rail"><section class="of-panel"><h2>Próxima ação</h2><div class="of-action-stack"><a class="of-button of-button--secondary" asp-page="/Schedule/Index">Agendar</a>@if(order.Status is WorkOrderStatus.Planned or WorkOrderStatus.Scheduled){<form method="post" asp-page-handler="Start"><button class="of-button of-button--primary">Iniciar execução</button></form>}@if(order.Status == WorkOrderStatus.InProgress){<form method="post" asp-page-handler="Complete"><button class="of-button of-button--primary">Concluir OS</button></form>}<a class="of-button of-button--success" asp-page="/Payments/Register" asp-route-id="@order.Id">Registrar pagamento</a></div></section>
 <section class="of-panel"><h2>Financeiro</h2><p><strong>@paid.ToString("C")</strong> recebido de @order.TotalSnapshot.ToString("C")</p><p>Saldo: <strong>@Math.Max(0, order.TotalSnapshot-paid).ToString("C")</strong></p>@foreach(var payment in Model.Payments){<p><a asp-page="/Payments/Details" asp-route-id="@payment.Id">@payment.Amount.ToString("C") · @payment.PaymentMethod</a></p>}@foreach(var receipt in Model.Receipts){<p><a asp-page="/Receipts/Details" asp-route-id="@receipt.Id">Recibo @receipt.Number</a></p>}</section></aside>
</main>
