@page
@model OrcaFacil.Web.Pages.WorkOrders.IndexModel
@{ ViewData["Title"] = "Ordens de serviço"; }
<header class="of-page-header"><div><p class="of-eyebrow">Operação</p><h1>Ordens de serviço</h1><p>Acompanhe do planejamento à conclusão sem perder o orçamento de origem.</p></div><a class="of-button" asp-page="/Schedule/Index">Abrir agenda</a></header>
<form method="get" class="of-panel"><label class="of-field-label" for="search">Buscar por número ou título</label><div class="of-inline-field"><input id="search" name="search" value="@Model.Search" class="of-field-control"/><button class="of-button of-button--primary">Buscar</button></div></form>
<section class="of-panel" aria-labelledby="orders-title"><h2 id="orders-title" >Resultados</h2>
@if (Model.Orders.Count == 0) { <div class="of-purpose-empty"><h3>Você ainda não tem ordens de serviço</h3><p>Uma proposta aprovada pode virar uma ordem com responsável, agenda e próxima ação.</p><a class="of-button of-button--primary" asp-page="/Documents/Index">Ver propostas</a></div> } else { <div class="of-record-list">@foreach(var order in Model.Orders){<a class="of-record-item" asp-page="Details" asp-route-id="@order.Id"><strong>@order.Number</strong> — @order.Title <span class="of-status">@order.Status</span></a>}</div> }
</section>
