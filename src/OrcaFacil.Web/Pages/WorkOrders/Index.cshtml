@page
@model OrcaFacil.Web.Pages.WorkOrders.IndexModel
@section Styles { <link rel="stylesheet" href="~/css/work-orders.css" asp-append-version="true" /> }
@{ ViewData["Title"] = "Ordens de serviço"; }
<partial name="Partials/_PageIntro" model='new PageIntroViewModel("Operação", "Ordens de serviço", "Transforme propostas aprovadas em trabalho planejado, executado e registrado.", "work-order", SecondaryActions: new[]{new PageIntroActionViewModel("Abrir agenda", "/Schedule/Index", "calendar")}, HelpCode: "work-orders", WhatThisPageDoes: "Reúne cliente, responsável, agenda, execução e financeiro de cada serviço.", NextStepText: "Localize uma ordem ou aprove uma proposta para iniciar a operação.")' />
@if (Model.Agenda == "upcoming" || Model.Phase == "active" || Model.Finance == "open")
{
    <p class="of-filter-note">Esta lista usa o mesmo recorte da visão geral.
        @if (Model.Agenda == "upcoming") { <span>Serviços agendados para os próximos 7 dias.</span> }
        @if (Model.Phase == "active") { <span>Execução ainda não concluída.</span> }
        @if (Model.Finance == "open") { <span>Saldo em aberto.</span> }
        <a asp-page="./Index">Limpar filtro</a>
    </p>
}
<form method="get" class="of-panel of-filter-bar">
    @if (!string.IsNullOrEmpty(Model.Phase)) { <input type="hidden" name="phase" value="@Model.Phase" /> }
    @if (!string.IsNullOrEmpty(Model.Finance)) { <input type="hidden" name="finance" value="@Model.Finance" /> }
    @if (!string.IsNullOrEmpty(Model.Agenda)) { <input type="hidden" name="agenda" value="@Model.Agenda" /> }
    <label>Buscar<input id="search" name="search" value="@Model.Search" class="of-field-control"/></label>
    <label>Situação<select name="status" class="of-field-control"><option value="">Todas</option>@foreach(var value in Enum.GetValues<OrcaFacil.Domain.Enums.WorkOrderStatus>()){<option value="@value" selected="@(Model.Status == value)">@OrcaFacil.Web.Services.CommercialPresentation.WorkOrderStatus(value.ToString())</option>}</select></label>
    <label>Origem<select name="origin" class="of-field-control"><option value="">Todas</option><option value="proposal" selected="@(Model.Origin == "proposal")">Proposta</option><option value="manual" selected="@(Model.Origin == "manual")">Direta ou contrato</option></select></label>
    <label>De<input type="date" name="from" class="of-field-control"/></label>
    <label>Até<input type="date" name="to" class="of-field-control"/></label>
    <button type="submit" class="of-button of-button--primary">Filtrar</button>
</form>
<section class="of-panel" aria-labelledby="orders-title"><h2 id="orders-title" >Resultados</h2>
@if (Model.Orders.Count == 0) { <partial name="Partials/_EmptyState" model='new EmptyStateViewModel { Icon="work-order", Title="Nenhuma ordem neste recorte", Text="Ordens nascem de propostas aprovadas e concentram agenda, responsável e execução.", ActionText="Ver propostas", ActionPage="/Documents/Index", HelpText="Aprove uma proposta para começar sem cadastrar tudo novamente." }' /> } else { <div class="of-execution-grid">@foreach(var order in Model.Orders){<article class="of-execution-card"><header><span class="of-status">@OrcaFacil.Web.Services.CommercialPresentation.WorkOrderStatus(order.Status.ToString())</span><small>@order.Number</small></header><div><h3>@order.Title</h3><p>@(order.Description ?? "Execução sem observações adicionais.")</p></div><div class="of-execution-meta"><span>Agenda: @(order.ScheduledStart?.ToLocalTime().ToString("dd/MM/yyyy HH:mm") ?? "a definir")</span><span>Origem: @(order.SourceDocumentId.HasValue ? "proposta aprovada" : "ordem direta")</span></div><a class="of-button of-button--primary" asp-page="Details" asp-route-id="@order.Id">Abrir execução</a></article>}</div> }
</section>
