@page
@model OrcaFacil.Web.Pages.WorkOrders.IndexModel
@{ ViewData["Title"] = "Ordens de serviço"; }
<partial name="Partials/_PageIntro" model='new PageIntroViewModel("Operação", "Ordens de serviço", "Transforme propostas aprovadas em trabalho planejado, executado e registrado.", "work-order", SecondaryActions: new[]{new PageIntroActionViewModel("Abrir agenda", "/Schedule/Index", "calendar")}, HelpCode: "work-orders", WhatThisPageDoes: "Reúne cliente, responsável, agenda, execução e financeiro de cada serviço.", NextStepText: "Localize uma ordem ou aprove uma proposta para iniciar a operação.")' />
<form method="get" class="of-panel"><label class="of-field-label" for="search">Buscar por número ou título</label><div class="of-inline-field"><input id="search" name="search" value="@Model.Search" class="of-field-control"/><button class="of-button of-button--primary">Buscar</button></div></form>
<section class="of-panel" aria-labelledby="orders-title"><h2 id="orders-title" >Resultados</h2>
@if (Model.Orders.Count == 0) { <partial name="Partials/_EmptyState" model='new EmptyStateViewModel { Icon="work-order", Title="Você ainda não tem ordens de serviço", Text="Ordens nascem de propostas aprovadas e concentram agenda, responsável e execução.", ActionText="Ver propostas", ActionPage="/Documents/Index", HelpText="Aprove uma proposta para começar sem cadastrar tudo novamente." }' /> } else { <div class="of-record-list">@foreach(var order in Model.Orders){<a class="of-record-item" asp-page="Details" asp-route-id="@order.Id"><strong>@order.Number</strong> — @order.Title <span class="of-status">@order.Status</span></a>}</div> }
</section>
