@page "/Feedback"
@model OrcaFacil.Web.Pages.Feedback.IndexModel
@{ViewData["Title"]="Enviar feedback";}
<header class="of-page-header"><div><p class="of-eyebrow">Sua experiência</p><h1>Conte como podemos melhorar</h1><p>Feedback rápido ajuda a aprimorar o produto. Para acompanhar um problema, abra um chamado.</p></div><a class="of-button of-button-secondary" asp-page="/Support/Tickets">Abrir chamado</a></header>
<section class="of-card of-narrow"><form method="post" class="of-form-stack"><div asp-validation-summary="ModelOnly"></div><input asp-for="PageUrl" type="hidden"/><input asp-for="CorrelationId" type="hidden" value="@ViewContext.HttpContext.TraceIdentifier"/><fieldset><legend>Como foi sua experiência?</legend><div class="of-choice-grid">@foreach(var choice in new[]{"Gostei","Não gostei","Algo está confuso","Encontrei um erro","Sugestão"}){<label class="of-choice"><input asp-for="Rating" type="radio" value="@choice"/> <span>@choice</span></label>}</div><span asp-validation-for="Rating"></span></fieldset><label asp-for="Message">Conte um pouco mais <small>(opcional)</small></label><textarea asp-for="Message" rows="5" maxlength="2000" placeholder="Não inclua senhas, tokens ou dados sigilosos."></textarea><button type="submit" class="of-button of-button-primary" data-submit-once>Enviar feedback</button></form></section>
