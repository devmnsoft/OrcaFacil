@page
@model OrcaFacil.Web.Pages.Marketplace.InstallationsModel
@{ViewData["Title"]="Instalações do Marketplace";}
<link rel="stylesheet" href="~/css/marketplace.css" asp-append-version="true"/><header class="marketplace-hero"><div><p class="of-eyebrow">Auditoria da conta</p><h1>Pacotes instalados</h1><p>Acompanhe versão, resultado e itens efetivamente aplicados.</p></div><a class="btn btn-primary" asp-page="/Marketplace/Index">Explorar pacotes</a></header>
<section class="preview-panel">@if(Model.Items.Count==0){<div class="empty"><h2>Nenhuma instalação</h2><p>Explore o marketplace e revise uma prévia para começar.</p></div>}@foreach(var item in Model.Items){<article class="installation-row"><div><h2>@item.Name</h2><p>Versão @item.Version · @item.Applied item(ns) aplicado(s) · @item.CompletedAt?.ToString("g")</p></div><span class="badge">@item.Status</span>@if(item.Status is OrcaFacil.Domain.Entities.PackageInstallationStatus.Installed or OrcaFacil.Domain.Entities.PackageInstallationStatus.PartiallyInstalled){<details><summary>Rollback controlado</summary><p>@OrcaFacil.Persistence.Marketplace.PackageRollbackService.ImpactMessage</p><form method="post" asp-page-handler="Rollback"><input type="hidden" name="id" value="@item.Id"/><label>Digite <strong>DESATIVAR</strong><input name="confirmation" required autocomplete="off"/></label><button type="submit" class="of-button of-button-danger">Desativar configurações</button></form></details>}</article>}</section>
