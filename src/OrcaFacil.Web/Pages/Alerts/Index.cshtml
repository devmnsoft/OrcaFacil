@page "/Alerts"
@model OrcaFacil.Web.Pages.Alerts.IndexModel
@using OrcaFacil.Domain.Enums
@{ ViewData["Title"] = "Alertas operacionais"; }
<header class="report-hero">
  <div><span class="eyebrow">ROTINA DE HOJE</span><h1>Central de alertas</h1><p>Prioridades geradas a partir dos dados reais da sua conta.</p></div>
  <a class="of-button-primary" asp-page-handler="Export" asp-route-type="@Model.Type" asp-route-status="@Model.Status">Exportar CSV</a>
</header>
<details class="report-filters" open>
  <summary>Filtros dos alertas</summary>
  <form method="get" class="filter-grid">
    <label>Tipo
      <select asp-for="Type">
        <option value="">Todos</option>
        @foreach (var category in Enum.GetValues<NotificationCategory>()) { <option value="@category">@category</option> }
      </select>
    </label>
    <label>Status
      <select asp-for="Status"><option value="">Todos</option><option value="open">Abertos</option><option value="closed">Encerrados</option></select>
    </label>
    <div class="filter-actions"><a asp-page="/Alerts/Index" class="of-button-secondary">Limpar filtros</a><button class="of-button-primary" type="submit">Aplicar filtros</button></div>
  </form>
</details>
@if (Model.Items.Count == 0) { <section class="report-empty"><h2>Tudo em dia</h2><p>Nenhum alerta operacional foi identificado com os filtros atuais.</p></section> }
<section class="operational-list">
@foreach (var item in Model.Items) {
  <article class="metric-card operational-card is-@item.Type.ToString().ToLowerInvariant()">
    <div><span>@item.Type · @item.Category · @item.CreatedAt.ToLocalTime().ToString("g")</span><h2>@item.Title</h2><p>@Model.Description(item)</p><strong>@(item.IsRead ? "Encerrado" : "Aberto")</strong></div>
    <div class="filter-actions">
      @if (!string.IsNullOrWhiteSpace(item.ActionUrl)) { <a class="of-button-secondary" href="@item.ActionUrl">@item.ActionText</a> }
      @if (!item.IsRead) {
        <form method="post" asp-page-handler="Resolve" asp-route-type="@Model.Type" asp-route-status="@Model.Status"><input type="hidden" name="id" value="@item.Id"/><button type="submit" class="of-button-primary">Resolver</button></form>
        <form method="post" asp-page-handler="Ignore" asp-route-type="@Model.Type" asp-route-status="@Model.Status"><input type="hidden" name="id" value="@item.Id"/><button type="submit" class="of-button-secondary">Ignorar</button></form>
      }
    </div>
  </article>
}
</section>
