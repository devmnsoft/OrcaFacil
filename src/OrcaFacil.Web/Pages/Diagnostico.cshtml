@page "/diagnostico"
@model OrcaFacil.Web.Pages.DiagnosticoModel
@using OrcaFacil.Persistence.Diagnostics
@{ ViewData["Title"] = "Diagnóstico"; var db = Model.Database; }
<h1>Diagnóstico</h1>
<ul>
  <li>Ambiente: @Model.EnvironmentName</li>
  <li>Modo: @(Model.EnvironmentName == "Development" ? "Development" : "Production")</li>
  <li>Banco: @(db?.CanConnect == true ? "OK" : "Falha")</li>
  <li>Nome do banco: @db?.DatabaseName</li>
  <li>Schema: @DatabaseDiagnosticsService.ExpectedSchema (@(db?.SchemaExists == true ? "encontrado" : "não encontrado"))</li>
  <li>Tabelas ausentes: @(db?.MissingTables.Count ?? 0)</li>
  <li>Arquivos estáticos: OK</li>
  <li>PDF service: configurado</li>
  <li>Autenticação: cookie auth configurada</li>
</ul>
@if (!string.IsNullOrWhiteSpace(db?.Error)) { <p class="text-danger">@db.Error</p> }
