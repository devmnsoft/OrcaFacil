@page "/SystemHealth/Database"
@model OrcaFacil.Web.Pages.DiagnosticoModel
@using OrcaFacil.Persistence.Diagnostics
@{ ViewData["Title"] = "Diagnóstico"; var db = Model.Database; }
<h1>Diagnóstico operacional</h1>
<p>Status geral: <strong>@(db?.CanConnect == true && db.MissingTables.Count == 0 && (db.MissingColumns?.Count ?? 0) == 0 ? "Saudável" : "Ação necessária")</strong></p>
<ul>
  <li>Ambiente: @Model.EnvironmentName</li>
  <li>Modo: @(Model.EnvironmentName == "Development" ? "Development" : "Production")</li>
  <li>Banco: @(db?.CanConnect == true ? "OK" : "Falha")</li>
  <li>Configuração: @Model.ConfigurationState.Source (@Model.ConfigurationState.ValidationCode)</li>
  <li>Destino: @Model.ConfigurationState.Host:@Model.ConfigurationState.Port / @Model.ConfigurationState.Database</li>
  <li>Fingerprint seguro: @Model.ConfigurationState.Fingerprint</li>
  <li>Nome do banco: @db?.DatabaseName</li>
  <li>Schema: @DatabaseDiagnosticsService.ExpectedSchema (@(db?.SchemaExists == true ? "encontrado" : "não encontrado"))</li>
  <li>Tabelas ausentes: @(db?.MissingTables.Count ?? 0)</li>
  <li>Colunas ausentes: @(db?.MissingColumns?.Count ?? 0)</li>
  <li>Índices críticos ausentes: @(db?.MissingIndexes?.Count ?? 0)</li>
  <li>Latência: @(db?.LatencyMilliseconds ?? 0) ms</li>
  <li>Arquivos estáticos: OK</li>
  <li>PDF service: configurado</li>
  <li>Autenticação: cookie auth configurada</li>
</ul>
@if (db?.CanConnect != true || db.MissingTables.Count > 0 || (db.MissingColumns?.Count ?? 0) > 0) { <div class="callout"><strong>Como corrigir</strong><p>Para corrigir somente o login, execute <code>psql -v ON_ERROR_STOP=1 -f database/patch_fix_users_login_security_columns.sql</code>. Para atualizar todo o schema, execute <code>psql -v ON_ERROR_STOP=1 -f database/script_completop.sql</code>. Depois, atualize esta página.</p></div> }
@if (db?.MissingTables.Contains("account_onboarding_states", StringComparer.OrdinalIgnoreCase) == true) { <div class="callout"><strong>Banco desatualizado: tabela account_onboarding_states ausente.</strong><p>Execute <code>database/patch_fix_account_onboarding_states.sql</code> ou <code>database/script_completop.sql</code>.</p></div> }
<details><summary>Ver detalhes técnicos</summary><dl><dt>PostgreSQL</dt><dd>@db?.PostgreSqlVersion</dd><dt>Usuário</dt><dd>@db?.ConnectedUser</dd><dt>search_path</dt><dd>@db?.SearchPath</dd><dt>Permissões</dt><dd>Leitura: @db?.CanRead; criação: @db?.CanWrite</dd><dt>Tabelas faltantes</dt><dd>@string.Join(", ", db?.MissingTables ?? [])</dd><dt>Colunas faltantes</dt><dd>@string.Join(", ", db?.MissingColumns ?? [])</dd></dl></details>
@if (!string.IsNullOrWhiteSpace(db?.Error)) { <p class="text-danger">@db.Error</p> }
<section class="of-panel" aria-labelledby="drift-title">
<h2 id="drift-title">Varredura de schema drift</h2>
<p><strong>Schema atualizado:</strong> @(db?.CanConnect == true && db.MissingTables.Count == 0 && (db.MissingColumns?.Count ?? 0) == 0 && (db.MissingIndexes?.Count ?? 0) == 0 ? "Sim" : "Não")</p>
<table class="of-table"><thead><tr><th>Severidade</th><th>Módulo impactado</th><th>Rota impactada</th><th>Diagnóstico</th><th>Patch recomendado</th></tr></thead><tbody>
@if ((db?.MissingColumns?.Count ?? 0) == 0 && (db?.MissingIndexes?.Count ?? 0) == 0) { <tr><td><span class="of-badge">OK</span></td><td>Todos</td><td>—</td><td>Nenhuma coluna ou índice crítico ausente.</td><td>Nenhuma ação</td></tr> }
else {
 @foreach (var column in db?.MissingColumns ?? []) { var commercial = column.StartsWith("documents.", StringComparison.OrdinalIgnoreCase); <tr><td><span class="of-badge is-critical">Crítica</span></td><td>@(commercial ? "Comercial" : "Plataforma")</td><td>@(commercial ? "/CommercialRoutine" : "/SystemHealth/Database")</td><td>Coluna ausente: <code>@column</code></td><td><code>database/patch_release_candidate_schema.sql</code></td></tr> }
 @foreach (var index in db?.MissingIndexes ?? []) { <tr><td><span class="of-badge is-important">Alta</span></td><td>Performance</td><td>/SystemHealth/Database</td><td>Índice ausente: <code>@index</code></td><td><code>database/patch_release_candidate_schema.sql</code></td></tr> }
}
</tbody></table></section>
