@page "/diagnostico"
@model OrcaFacil.Web.Pages.DiagnosticoModel
@{ ViewData["Title"] = "Diagnóstico"; var db = Model.Database; }
<h1>Diagnóstico</h1>
<ul>
  <li>Ambiente: @Model.EnvironmentName</li>
  <li>Banco: @db?.Database</li>
  <li>Schema: @OrcaFacil.Web.Diagnostics.DatabaseDiagnosticsService.ExpectedSchema (@(db?.SchemaFound == true ? "encontrado" : "não encontrado"))</li>
  <li>Versão: @db?.AppVersion</li>
  <li>Health checks: @(db?.Connected == true && db.RequiredTables.Values.All(x => x) ? "OK" : "Falha")</li>
</ul>
<h2>Migrations aplicadas</h2>
<ul>@foreach (var migration in db?.AppliedMigrations ?? Array.Empty<string>()) { <li>@migration</li> }</ul>
@if (!string.IsNullOrWhiteSpace(db?.LastError)) { <p class="text-danger">@db.LastError</p> }
