@page "/Support/Tickets/{id:guid}"
@model OrcaFacil.Web.Pages.Support.TicketDetailsModel
@{ViewData["Title"]="Chamado "+Model.Ticket.Protocol;}
<header class="of-page-header"><div><p class="of-eyebrow">@Model.Ticket.Protocol</p><h1>@Model.Ticket.Subject</h1><p>@Model.Ticket.Category · <span class="of-status-badge">@Model.Ticket.Status</span></p></div><a class="of-button of-button-secondary" asp-page="Tickets">Voltar</a></header>
<section class="of-card"><div class="of-timeline">@foreach(var message in Model.Messages){<article class="of-timeline-item"><strong>@(message.IsAdminReply?"Equipe OrçaFácil":"Você")</strong><time>@message.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</time><p>@message.Body</p></article>}</div>@if(Model.Ticket.Status!=OrcaFacil.Domain.Enums.SupportTicketStatus.Closed){<form method="post" asp-page-handler="Reply" asp-route-id="@Model.Ticket.Id" class="of-form-stack"><div asp-validation-summary="ModelOnly"></div><label asp-for="Reply">Adicionar resposta</label><textarea asp-for="Reply" rows="5" maxlength="5000"></textarea><span asp-validation-for="Reply"></span><div class="of-inline-actions"><button type="submit" class="of-button of-button-primary">Enviar resposta</button><button type="submit" class="of-button of-button-secondary" asp-page-handler="Close" formnovalidate>Encerrar chamado</button></div></form>}</section>
