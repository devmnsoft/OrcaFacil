@page
@{ ViewData["Title"]="Ajuda e suporte"; var phone="5591981809035"; var msg=System.Net.WebUtility.UrlEncode("Olá, preciso de ajuda com o OrçaFácil."); }
<header class="of-page-header"><div><p class="of-eyebrow">Suporte MNSOFT</p><h1>Como podemos ajudar?</h1><p>Encontre uma resposta rápida ou fale com a equipe da MNSOFT.</p></div></header>
<section class="of-card mb-4"><div class="row align-items-center g-4"><div class="col-lg-4"><img class="of-illustration" src="/img/illustrations/support-human.svg" alt="Atendimento humano da MNSOFT" /></div><div class="col-lg-8"><label for="support-search" class="form-label">Busque uma resposta</label><div class="position-relative"><svg class="of-icon of-input-icon" aria-hidden="true"><use href="/img/icons/orcafacil-icons.svg#icon-search"></use></svg><input id="support-search" class="form-control of-input with-icon" type="search" placeholder="Digite o que você precisa resolver" data-support-search /></div><p class="form-text" aria-live="polite" data-support-results>Explore as categorias ou use um dos atalhos abaixo.</p></div></div></section>
<section aria-labelledby="support-categories"><h2 id="support-categories">Encontre por assunto</h2><div class="row g-3" data-support-content>
@foreach (var category in new[]{"Primeiros passos","Clientes","Orçamentos","Recibos","PDFs","Modelos","Meu plano","Pagamentos","Acesso","Segurança e privacidade"}) { <div class="col-6 col-lg-3" data-support-item><article class="of-card h-100"><svg class="of-icon text-primary" aria-hidden="true"><use href="/img/icons/orcafacil-icons.svg#icon-help"></use></svg><h3 class="h6 mt-2">@category</h3></article></div> }
</div></section>
<div class="row g-4 mt-4"><section class="col-lg-8"><div class="of-card h-100"><h2>Atalhos para resolver agora</h2><div class="row g-3">@foreach(var shortcut in new[]{("Criar primeiro orçamento","/Documents/CreateBudget"),("Cadastrar cliente","/Clients/Create"),("Gerar PDF","/Help/GerarPdf"),("Usar modelo","/Help/Modelos"),("Entender meu plano","/Subscription/Index"),("Resolver pagamento","/Subscription/BillingProfile"),("Recuperar acesso","/Support/Index")}) { <div class="col-md-6"><a class="of-help-shortcut" href="@shortcut.Item2"><svg class="of-icon" aria-hidden="true"><use href="/img/icons/orcafacil-icons.svg#icon-success"></use></svg><strong>@shortcut.Item1</strong></a></div> }</div></div></section>
<aside class="col-lg-4"><div class="of-card h-100"><h2 class="h4">Fale com a MNSOFT</h2><p><strong>MNSOFT</strong><br />CNPJ 18.160.057/0001-13<br /><a href="mailto:comercial@mnsoft.com.br">comercial@mnsoft.com.br</a></p><a class="btn btn-success w-100 mb-2" href="https://wa.me/@phone?text=@msg" target="_blank" rel="noopener">WhatsApp</a><a class="btn btn-outline-primary w-100" href="mailto:comercial@mnsoft.com.br">Enviar e-mail</a></div></aside></div>
