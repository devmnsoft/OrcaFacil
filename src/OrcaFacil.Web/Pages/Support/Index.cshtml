@page
@model OrcaFacil.Web.Pages.Support.IndexModel
@{ ViewData["Title"]="Ajuda e suporte"; var phone="5591981809035"; var msg=System.Net.WebUtility.UrlEncode("Olá, preciso de ajuda com o OrçaFácil."); }
<header class="of-page-header"><div><p class="of-eyebrow">Suporte MNSOFT</p><h1>Como podemos ajudar?</h1><p>Encontre uma resposta rápida ou fale com a equipe da MNSOFT.</p></div></header>
<section class="of-card mb-4"><form method="get" role="search"><label for="help-search" class="form-label fw-bold">O que você precisa resolver?</label><div class="d-flex gap-2"><input id="help-search" asp-for="Query" class="form-control" placeholder="Digite o que você precisa resolver" /><button class="btn btn-primary" type="submit"><svg class="of-icon" aria-hidden="true"><use href="/img/icons/orcafacil-icons.svg#icon-search"></use></svg> Buscar</button></div></form></section>
<div class="row g-4"><div class="col-lg-8"><section aria-labelledby="topics-title"><h2 id="topics-title" class="h4 mb-3">Categorias de ajuda</h2><div class="row g-3">@foreach(var topic in Model.Results){<div class="col-md-6"><a class="of-card d-block h-100 text-decoration-none" href="@topic.Url"><svg class="of-icon" aria-hidden="true"><use href="/img/icons/orcafacil-icons.svg#icon-@topic.Icon"></use></svg><h3 class="h5 mt-3">@topic.Title</h3><p class="of-text-secondary mb-0">@topic.Description</p></a></div>}@if(Model.Results.Count==0){<div class="col-12"><div class="of-surface-warning p-4 rounded" role="status"><h3 class="h5">Nenhum guia encontrado</h3><p class="mb-0">Tente outro termo ou fale diretamente com nossa equipe.</p></div></div>}</div></section></div>
<aside class="col-lg-4"><div class="of-card"><img class="of-illustration mb-3" src="/img/illustrations/support-human.svg" alt="Atendimento humano da MNSOFT" /><h2 class="h4">Fale com a equipe</h2><p><strong>MNSOFT</strong><br />CNPJ 18.160.057/0001-13<br /><a href="mailto:comercial@mnsoft.com.br">comercial@mnsoft.com.br</a></p><a class="btn btn-success w-100 mb-2" href="https://wa.me/@phone?text=@msg" target="_blank" rel="noopener">WhatsApp</a><a class="btn btn-outline-primary w-100" href="mailto:comercial@mnsoft.com.br">Enviar e-mail</a></div></aside></div>
