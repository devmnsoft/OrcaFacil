@page
@{ Layout="/Pages/Shared/_PublicLayout.cshtml"; ViewData["Title"]="Ajuda e suporte"; var phone="5591981809035"; var msg=System.Net.WebUtility.UrlEncode("Olá, preciso de ajuda com o OrçaFácil."); }
<section class="of-section of-surface-soft"><div class="of-container"><div class="of-benefit-layout"><div><span class="of-kicker">Suporte MNSOFT</span><h1>Como podemos ajudar?</h1><p class="lead">Encontre uma resposta rápida ou fale com a equipe da MNSOFT.</p><label for="support-search" class="form-label">Busque na central de ajuda</label><div class="of-password-field"><input id="support-search" class="form-control" type="search" placeholder="Digite o que você precisa resolver" data-support-search/><button type="button" class="of-password-toggle" aria-label="Buscar"><svg class="of-icon"><use href="#of-icon-search"></use></svg></button></div></div><img src="~/img/illustrations/support-human.svg" class="of-section-art" alt="Atendimento humano para dúvidas sobre o OrçaFácil"/></div></div></section>
<section class="of-section of-surface-page"><div class="of-container"><h2>Encontre por assunto</h2><div class="of-step-grid" data-support-items>@foreach(var item in new[]{("Primeiros passos","Crie sua conta e prepare o primeiro documento."),("Clientes","Cadastre, encontre e atualize seus clientes."),("Orçamentos","Crie, revise, aprove e gere PDF."),("Recibos e PDFs","Registre recebimentos e baixe documentos."),("Modelos","Comece com itens sugeridos para seu trabalho."),("Meu plano e pagamentos","Entenda limites, acesso e cobrança."),("Acesso","Entre na conta e recupere seu acesso."),("Segurança e privacidade","Proteja sua conta e conheça seus direitos.")}){<article class="of-card" data-support-item><h3>@item.Item1</h3><p>@item.Item2</p></article>}</div><div class="of-final-cta of-surface-light mt-5"><div class="of-cta-icon"><svg class="of-icon"><use href="#of-icon-support"></use></svg></div><div><h2>Fale com a MNSOFT</h2><p>MNSOFT · CNPJ 18.160.057/0001-13 · comercial@mnsoft.com.br</p></div><div class="of-actions"><a class="of-button of-button-primary" href="https://wa.me/@phone?text=@msg" target="_blank" rel="noopener">WhatsApp</a><a class="of-button of-button-secondary" href="mailto:comercial@mnsoft.com.br">Enviar e-mail</a></div></div></div></section>
@section Scripts{<script>document.querySelector('[data-support-search]')?.addEventListener('input',function(){const q=this.value.toLocaleLowerCase('pt-BR').trim();document.querySelectorAll('[data-support-item]').forEach(x=>x.hidden=q&&!x.textContent.toLocaleLowerCase('pt-BR').includes(q));});</script>}
