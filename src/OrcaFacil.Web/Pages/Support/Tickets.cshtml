@page "/Support/Tickets"
@model OrcaFacil.Web.Pages.Support.TicketsModel
@{ ViewData["Title"] = "Meus chamados"; }
<header class="of-page-header"><div><p class="of-eyebrow">Suporte</p><h1>Meus chamados</h1><p>Acompanhe cada solicitação e mantenha o histórico em um só lugar.</p></div></header>
<div class="of-admin-detail-grid">
<section class="of-card"><h2>Abrir solicitação</h2><form method="post" class="of-form-stack"><div asp-validation-summary="ModelOnly"></div><div class="of-field"><label asp-for="Category">Tipo do problema</label><select asp-for="Category" asp-items="Html.GetEnumSelectList<OrcaFacil.Domain.Enums.SupportTicketCategory>()"></select></div><div class="of-field"><label asp-for="Priority">Prioridade</label><select asp-for="Priority" asp-items="Html.GetEnumSelectList<OrcaFacil.Domain.Enums.SupportTicketPriority>()"></select></div><div class="of-field"><label asp-for="Subject">Assunto</label><input asp-for="Subject" maxlength="180"/><span asp-validation-for="Subject"></span></div><div class="of-field"><label asp-for="RelatedPage">Tela relacionada <small>(opcional)</small></label><input asp-for="RelatedPage" maxlength="300" placeholder="Ex.: Novo orçamento"/></div><div class="of-field"><label asp-for="CorrelationId">Código de correlação <small>(opcional)</small></label><input asp-for="CorrelationId" maxlength="100" value="@Context.TraceIdentifier"/></div><div class="of-field"><label asp-for="Description">O que aconteceu?</label><textarea asp-for="Description" rows="7" maxlength="5000" placeholder="Descreva o que tentou fazer e a mensagem exibida. Não informe senhas ou tokens."></textarea><span asp-validation-for="Description"></span></div><button class="of-button of-button-primary" type="submit" data-submit-once>Abrir chamado</button></form></section>
<section class="of-card"><h2>Histórico</h2>@if(Model.Tickets.Count==0){<div class="of-empty-state"><h3>Nenhum chamado aberto</h3><p>Quando precisar, envie os detalhes pelo formulário.</p></div>}else{<div class="of-list-stack">@foreach(var ticket in Model.Tickets){<a class="of-list-row" asp-page="TicketDetails" asp-route-id="@ticket.Id"><span><strong>@ticket.Subject</strong><small>@ticket.Protocol · @ticket.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</small></span><span class="of-status-badge">@ticket.Status</span></a>}</div>}</section>
</div>
