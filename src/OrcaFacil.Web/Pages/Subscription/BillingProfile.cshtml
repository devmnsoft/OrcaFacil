@page
@model OrcaFacil.Web.Pages.Subscription.BillingProfileModel
@section Styles { <link rel="stylesheet" href="~/css/billing.css" asp-append-version="true" /> }
@{ViewData["Title"]="Perfil de cobrança";}
<header class="of-page-header"><div><p class="of-eyebrow">Cobrança</p><h1>Perfil de cobrança</h1><p>Esses dados serão usados para gerar sua cobrança do plano Pro.</p></div></header>
<form method="post" class="of-card"><div class="of-form-grid"><div class="of-field"><label asp-for="Input.PersonType">Tipo</label><select asp-for="Input.PersonType" class="of-field-control"><option value="Individual">Pessoa Física</option><option value="Company">Pessoa Jurídica</option></select></div><div class="of-field"><label asp-for="Input.DocumentNumber">CPF/CNPJ</label><input asp-for="Input.DocumentNumber" class="of-field-control"/><span asp-validation-for="Input.DocumentNumber" class="of-field-error"></span></div><div class="of-field"><label asp-for="Input.Name">Nome/Razão social</label><input asp-for="Input.Name" class="of-field-control" required/></div><div class="of-field"><label asp-for="Input.TradeName">Nome fantasia</label><input asp-for="Input.TradeName" class="of-field-control"/></div><div class="of-field"><label asp-for="Input.Email">E-mail</label><input asp-for="Input.Email" class="of-field-control"/></div><div class="of-field"><label asp-for="Input.Phone">Telefone</label><input asp-for="Input.Phone" class="of-field-control"/></div><div class="of-field"><label asp-for="Input.City">Cidade</label><input asp-for="Input.City" class="of-field-control"/></div><div class="of-field"><label asp-for="Input.Address">Endereço</label><input asp-for="Input.Address" class="of-field-control"/></div></div><div class="of-form-actions"><button type="submit" class="of-button of-button-primary">Salvar perfil</button></div></form>
