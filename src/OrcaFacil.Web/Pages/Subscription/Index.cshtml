@page
@model OrcaFacil.Web.Pages.Subscription.IndexModel
@section Styles { <link rel="stylesheet" href="~/css/billing.css" asp-append-version="true" /> }
@{ViewData["Title"]="Meu plano";var p=Model.Plan;}
<header class="of-page-heading"><p class="of-eyebrow">Plano e acesso</p><h1>Entenda o que está disponível agora</h1><p>Planos controlam acesso e capacidade. Eles não apagam os dados.</p></header>
<partial name="Partials/_ContextGuide" model='new ContextGuideViewModel("Escolha a capacidade da sua operação","Entender benefícios, limites e situação do plano.","Preferências de plano e dados necessários à cobrança.","Benefícios mudam sem apagar seus dados comerciais.","Revise valores e periodicidade antes de contratar ou regularizar.")' />
@if(p.IsUsingFreeFallback){<section class="of-plan-warning"><strong>Seus benefícios pagos estão pausados.</strong><p>Você está usando o plano Grátis neste momento. Seus clientes, documentos e configurações continuam seguros.</p><a href="https://wa.me/5591981809035">Regularizar</a><button type="button" data-preserved-open>Ver o que está pausado</button></section>}
<section class="of-plan-state"><article><span>Plano escolhido</span><h2>@p.SelectedPlanName</h2><p>Código @p.SelectedPlanCode · plano escolhido para sua conta.</p></article><article><span>Plano disponível agora</span><h2>@p.EffectivePlanName</h2><p>Código @p.EffectivePlanCode · benefícios liberados neste momento.</p></article><div><span>Situação</span><strong>@p.Status</strong>@if(p.DueAt.HasValue){<small>Vencimento: @p.DueAt.Value.ToString("dd/MM/yyyy")</small>}</div></section>
<section class="of-subscription-section"><h2>Uso e limites</h2>@if(p.UsageItems.Count==0){<p>Não há limites mensais configurados para mostrar neste momento.</p>}@foreach(var item in p.UsageItems){<div class="of-usage-row"><div><strong>@item.Label</strong>@if(item.Limit.HasValue){<span>@item.Used de @item.Limit usados.</span>}else{<span>Uso sem limite definido para este recurso.</span>}</div>@if(item.Limit.HasValue){<progress value="@item.Used" max="@item.Limit"></progress>}</div>}</section>
<div class="of-benefit-columns"><section><h2>Benefícios ativos</h2><ul>@foreach(var item in p.ActiveBenefits){<li>@item</li>}</ul></section><section><h2>Benefícios pausados</h2>@if(p.PausedBenefits.Count==0){<p>Nenhum benefício está pausado.</p>}else{<ul>@foreach(var item in p.PausedBenefits){<li>@item</li>}</ul>}</section></div>
<section class="of-subscription-section"><div class="of-section-heading"><div><p class="of-eyebrow">Comparação carregada do catálogo</p><h2>Escolha pelos resultados que precisa</h2></div></div><div class="of-plan-comparison">@foreach(var plan in p.Plans){<article class="@(plan.IsRecommended?"is-recommended":null)">@if(plan.IsRecommended){<span>Recomendado</span>}<h3>@plan.Name</h3><p>@plan.Description</p><strong>@plan.MonthlyPrice.ToString("C")<small>/mês</small></strong><p>Anual: @plan.AnnualPrice.ToString("C")</p><a asp-page="/Discover">Ver demonstrações</a></article>}</div></section>
<section class="of-preservation"><h2>Seus dados continuam aqui</h2><p>Mesmo se os benefícios mudarem, estes itens permanecem armazenados e disponíveis conforme as regras de acesso:</p><ul>@foreach(var item in p.PreservedDataItems){<li>@item</li>}</ul><p><strong>Quando regularizar:</strong> os benefícios são restaurados e suas configurações voltam a ser aplicadas, sem recriar ou duplicar dados.</p></section>
<section class="of-subscription-section"><h2>Pagamento e cobrança</h2><p>@p.ContextualRecommendation</p><a asp-page="/Subscription/BillingProfile">Atualizar perfil de cobrança</a> <a href="https://wa.me/5591981809035">Falar com a MNSOFT</a></section>
