@page "{id:guid}"
@model OrcaFacil.Web.Pages.Clients.DetailsModel
@section Styles { <link rel="stylesheet" href="~/css/clients.css" asp-append-version="true" /> }
@using OrcaFacil.Domain.Enums
@{
    ViewData["Title"] = "Cliente 360";
    ViewData["Section"] = "Comercial";
    var client = Model.Details.Client;
    var primary = Model.Details.Contacts.FirstOrDefault(contact => contact.IsPrimary && contact.IsActive);
}

<header class="client-page-head client-hero">
    <div class="client-identity">
        <span class="client-avatar">@client.Name[..1].ToUpperInvariant()</span>
        <div><p class="of-eyebrow">Cliente 360</p><h1>@client.Name</h1><p>@(client.PersonType == PersonType.Company ? "PJ" : "PF") · @Model.MaskedDocument · @(client.City ?? "Cidade não informada")</p></div>
    </div>
    <div class="client-head-actions">
        <a class="client-button primary" asp-page="/Documents/New" asp-route-clientId="@client.Id">Novo orçamento</a>
        @if (primary?.ContactType == ClientContactType.WhatsApp) { <a class="client-button secondary" href="https://wa.me/@primary.Value" rel="noopener">WhatsApp</a> }
        @if (primary?.ContactType == ClientContactType.Email) { <a class="client-button secondary" href="mailto:@primary.Value">E-mail</a> }
        <a class="client-button secondary" asp-page="/Clients/Edit" asp-route-id="@client.Id">Editar</a>
    </div>
</header>

<section class="client-summary" aria-label="Resumo do cliente">
    <div><span>Status</span><strong>@(client.IsActive ? "Ativo" : "Inativo")</strong></div>
    <div><span>Favorito</span><strong>@(client.IsFavorite ? "Sim" : "Não")</strong></div>
    <div><span>Canal preferido</span><strong>@(client.PreferredContactChannel ?? "Não definido")</strong></div>
    <div><span>Última atividade</span><strong>@(client.LastInteractionAt?.ToString("dd/MM/yyyy") ?? "Sem atividade")</strong></div>
    <div><span>Próximo acompanhamento</span><strong>@(client.NextFollowUpAt?.ToString("dd/MM/yyyy") ?? "Não agendado")</strong></div>
</section>

<div class="client-tags">@foreach (var tag in Model.Details.Tags) { <span data-color="@tag.ColorToken">@tag.Name</span> }</div>

<nav class="client-tabs" aria-label="Áreas do cliente">
    <a href="#summary">Resumo</a><a href="#contacts">Contatos</a><a href="#budgets">Orçamentos</a><a href="#orders">Ordens</a><a href="#payments">Pagamentos</a><a href="#receipts">Recibos</a><a href="#activities">Atividades</a><a href="#notes">Observações</a>
</nav>

<main class="client-workspace">
    <section id="summary" class="client-panel"><h2>Resumo</h2><dl><dt>Contato principal</dt><dd>@(primary?.Value ?? "Não definido")</dd><dt>Endereço</dt><dd>@(client.Address ?? "Não informado")</dd></dl></section>
    <section id="contacts" class="client-panel"><h2>Contatos</h2>
        @if (Model.Details.Contacts.Count == 0) { <p class="client-empty-copy">Nenhum contato cadastrado.</p> }
        @foreach (var contact in Model.Details.Contacts) { <article class="client-record"><div><strong>@contact.Name</strong><p>@contact.ContactType · @contact.Value</p><small>@(contact.IsPrimary ? "Principal · " : "")@(contact.ReceivesQuotes ? "Recebe orçamentos · " : "")@(contact.ReceivesReceipts ? "Recebe recibos" : "")</small></div><form method="post" asp-page-handler="RemoveContact"><input type="hidden" name="contactId" value="@contact.Id" /><button class="client-button danger" type="submit" disabled="@(contact.IsPrimary && contact.IsActive)">Remover</button></form></article> }
        <form method="post" asp-page-handler="Contact" class="client-inline-form"><label><span>Nome</span><input asp-for="Contact.Name" required /></label><label><span>Tipo</span><select asp-for="Contact.ContactType" asp-items="Html.GetEnumSelectList<ClientContactType>()"></select></label><label><span>Contato</span><input asp-for="Contact.Value" required /></label><label><input asp-for="Contact.IsPrimary" /> Principal</label><label><input asp-for="Contact.ReceivesQuotes" /> Orçamentos</label><label><input asp-for="Contact.ReceivesReceipts" /> Recibos</label><button class="client-button primary" type="submit">Adicionar contato</button></form>
    </section>
    <section id="budgets" class="client-panel"><h2>Propostas</h2><div class="client-metrics"><article><span>Abertas</span><strong>@Model.Details.Commercial.OpenQuotes</strong></article><article><span>Aprovadas</span><strong>@Model.Details.Commercial.ApprovedQuotes</strong></article><article><span>Recusadas</span><strong>@Model.Details.Commercial.RejectedQuotes</strong></article><article><span>Valor aprovado</span><strong>@Model.Details.Commercial.TotalApprovedAmount.ToString("C")</strong></article></div>@foreach(var item in Model.Details.Documents){<article class="client-record"><div><strong>@item.Number</strong><p>@item.Status · @item.Decision · @item.Total.ToString("C")</p><small>@item.Date.ToString("dd/MM/yyyy")</small></div><a class="client-button secondary" asp-page="/Documents/Details" asp-route-id="@item.Id">Abrir proposta</a></article>}@if(Model.Details.Documents.Count==0){<p class="client-empty-copy">Nenhuma proposta vinculada.</p>}</section>
    <section id="orders" class="client-panel"><h2>Ordens de serviço</h2>@foreach(var item in Model.Details.WorkOrders){<article class="client-record"><div><strong>@item.Number · @item.Title</strong><p>@item.Status · @item.Total.ToString("C")</p></div><a asp-page="/WorkOrders/Details" asp-route-id="@item.Id">Ver OS</a></article>}@if(Model.Details.WorkOrders.Count==0){<p class="client-empty-copy">Nenhuma ordem vinculada.</p>}</section>
    <section id="payments" class="client-panel"><h2>Pagamentos</h2><p><strong>Recebido:</strong> @Model.Details.Financial.ActivePaymentsAmount.ToString("C") · <strong>Saldo:</strong> @Model.Details.Financial.OutstandingBalance.ToString("C")</p>@foreach(var item in Model.Details.Payments){<article class="client-record"><div><strong>@item.Amount.ToString("C")</strong><p>@item.Method · @item.Status</p><small>@item.PaidAt.ToString("dd/MM/yyyy HH:mm")</small></div></article>}@if(Model.Details.Payments.Count==0){<p class="client-empty-copy">Nenhum pagamento vinculado.</p>}</section>
    <section id="receipts" class="client-panel"><h2>Recibos</h2>@foreach(var item in Model.Details.Receipts){<article class="client-record"><div><strong>@item.Number · @item.Amount.ToString("C")</strong><p>@(item.Cancelled ? "Cancelado" : "Emitido")</p><small>@item.IssuedAt.ToString("dd/MM/yyyy")</small></div><a asp-page="/Receipts/Details" asp-route-id="@item.Id">Ver recibo</a></article>}@if(Model.Details.Receipts.Count==0){<p class="client-empty-copy">Nenhum recibo emitido.</p>}</section>
    <section id="activities" class="client-panel"><h2>Follow-ups e timeline comercial</h2>
      @if(Model.Details.Documents.Count > 0){<form method="post" asp-page-handler="ScheduleFollowUp" class="client-inline-form"><label><span>Proposta</span><select name="documentId" required>@foreach(var doc in Model.Details.Documents){<option value="@doc.Id">@doc.Number</option>}</select></label><label><span>Agendar retorno</span><input name="nextFollowUpAt" type="datetime-local" required /></label><label><span>Contexto</span><input name="note" maxlength="1000" /></label><button type="submit" class="client-button primary">Agendar follow-up</button></form>}
      @foreach(var item in Model.Details.FollowUps){<article class="client-record"><div><strong>@item.DocumentNumber · @item.Status</strong><p>@(item.Note ?? "Sem observação")</p><small>@(item.DueAt?.ToString("dd/MM/yyyy HH:mm") ?? item.CompletedAt?.ToString("dd/MM/yyyy HH:mm"))</small></div>@if(!item.CompletedAt.HasValue){<form method="post" asp-page-handler="CompleteFollowUp"><input type="hidden" name="documentId" value="@item.DocumentId"/><button type="submit" class="client-button primary">Concluir</button></form>}</article>}
      <div class="client-timeline">@foreach(var item in Model.Details.Timeline){<article class="client-record"><div><strong>@item.Title</strong><p>@item.Description</p><small>@item.OccurredAt.ToString("dd/MM/yyyy HH:mm")</small></div></article>}</div>
    </section>
    <section id="notes" class="client-panel"><h2>Tags e observações</h2>
        <form method="post" asp-page-handler="Tag" class="client-inline-form"><label><span>Nova tag</span><input asp-for="TagName" required maxlength="60" /></label><label><span>Cor</span><select asp-for="TagColor"><option>neutral</option><option>blue</option><option>green</option><option>amber</option><option>red</option><option>purple</option><option>cyan</option></select></label><button type="submit" class="client-button primary">Atribuir tag</button></form>
        <div class="client-tag-editor">@foreach (var tag in Model.Details.Tags) { <form method="post" asp-page-handler="RemoveTag"><input type="hidden" name="tagId" value="@tag.Id" /><span data-color="@tag.ColorToken">@tag.Name</span><button type="submit">Remover</button></form> }</div>
        <p><strong>Visível somente para a sua equipe.</strong></p>
        <form method="post" asp-page-handler="Note" class="client-inline-form"><label><span>Observação interna</span><textarea asp-for="NoteContent" required maxlength="4000"></textarea></label><label><input asp-for="NotePinned" /> Fixar</label><button type="submit" class="client-button primary">Salvar observação</button></form>
        @if (Model.Details.Notes.Count == 0) { <p class="client-empty-copy">Nenhuma observação interna.</p> }
        @foreach (var note in Model.Details.Notes) { <article class="client-record"><div><strong>@(note.IsPinned ? "Fixada" : "Observação")</strong><p>@note.Content</p><small>@note.CreatedAt.ToString("dd/MM/yyyy HH:mm")</small></div><div><form method="post" asp-page-handler="PinNote"><input type="hidden" name="noteId" value="@note.Id" /><button type="submit" class="client-button secondary">@(note.IsPinned ? "Desafixar" : "Fixar")</button></form><form method="post" asp-page-handler="DeleteNote"><input type="hidden" name="noteId" value="@note.Id" /><button type="submit" class="client-button danger">Excluir</button></form></div></article> }
    </section>
</main>
