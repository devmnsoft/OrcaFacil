@model OrcaFacil.Web.Pages.Clients.ClientListItemDto
<div class="d-flex flex-wrap justify-content-end gap-2">
    <a class="btn btn-sm btn-outline-secondary" asp-page="/Clients/Details" asp-route-id="@Model.Id"><i class="bi bi-eye me-1"></i>Visualizar</a>
    <a class="btn btn-sm btn-outline-primary" asp-page="/Clients/Edit" asp-route-id="@Model.Id"><i class="bi bi-pencil me-1"></i>Editar</a>
    <form method="post" asp-page-handler="Delete" asp-route-id="@Model.Id" data-delete-client>
        <input type="hidden" name="Search" value="@(Context.Request.Query["Search"].ToString())" />
        <input type="hidden" name="Document" value="@(Context.Request.Query["Document"].ToString())" />
        <input type="hidden" name="PersonType" value="@(Context.Request.Query["PersonType"].ToString())" />
        <input type="hidden" name="City" value="@(Context.Request.Query["City"].ToString())" />
        <input type="hidden" name="Sort" value="@(Context.Request.Query["Sort"].ToString())" />
        <input type="hidden" name="PageNumber" value="@(Context.Request.Query["PageNumber"].ToString())" />
        <button class="btn btn-sm btn-outline-danger" type="submit"><i class="bi bi-trash me-1"></i>Excluir</button>
    </form>
</div>
