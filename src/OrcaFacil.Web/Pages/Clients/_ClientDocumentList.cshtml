@model IReadOnlyList<OrcaFacil.Web.Pages.Clients.ClientDocumentDto>
@if (Model.Count == 0)
{
    <p class="text-muted mb-0">Nenhum documento vinculado a este cliente.</p>
}
else
{
    <div class="list-group list-group-flush">
    @foreach (var document in Model)
    {
        <a class="list-group-item list-group-item-action d-flex justify-content-between align-items-center" asp-page="/Documents/Details" asp-route-id="@document.Id">
            <span><strong>@document.Number</strong><br /><small class="text-muted">@document.IssueDate.ToString("dd/MM/yyyy") • @document.Status</small></span>
            <span>@document.Total.ToString("C")</span>
        </a>
    }
    </div>
}
