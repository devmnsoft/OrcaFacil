@page
@model OrcaFacil.Web.Pages.Clients.IndexModel
@using OrcaFacil.Domain.Enums
@{
    ViewData["Title"] = "Clientes";
}

<header class="of-page-header">
    <div>
        <p class="of-eyebrow">Clientes</p>
        <h1>Clientes salvos</h1>
        <p>Cadastre clientes para reutilizar em orçamentos e recibos com segurança.</p>
    </div>
    <a class="btn btn-primary" asp-page="Create"><i class="bi bi-person-plus me-2"></i>Novo cliente</a>
</header>

<section class="of-card mb-4">
    <form method="get" class="row g-3">
        <div class="col-md-3"><label class="form-label">Nome</label><input class="form-control" asp-for="Search" /></div>
        <div class="col-md-3"><label class="form-label">CPF/CNPJ</label><input class="form-control" asp-for="Document" /></div>
        <div class="col-md-2"><label class="form-label">Tipo</label><select class="form-select" asp-for="PersonType"><option value="">Todos</option><option value="@PersonType.Individual">PF</option><option value="@PersonType.Company">PJ</option></select></div>
        <div class="col-md-2"><label class="form-label">Cidade</label><input class="form-control" asp-for="City" /></div>
        <div class="col-md-2"><label class="form-label">Ordenar</label><select class="form-select" asp-for="Sort"><option value="name">Nome A-Z</option><option value="name_desc">Nome Z-A</option><option value="city">Cidade</option><option value="created_desc">Mais recentes</option></select></div>
        <div class="col-12"><button class="btn btn-outline-primary" type="submit">Filtrar</button></div>
    </form>
</section>

<section class="of-card">
@if (Model.Clients.Count == 0)
{
    <partial name="Partials/_EmptyState" model='new EmptyStateViewModel { Title="Nenhum cliente encontrado.", Text="Crie seu primeiro cliente ou ajuste os filtros da busca.", ActionText="Novo cliente", ActionPage="/Clients/Create", Icon="bi-people" }' />
}
else
{
    <div class="table-responsive"><table class="table align-middle"><thead><tr><th>Nome</th><th>Tipo</th><th>Documento</th><th>Cidade</th><th>E-mail</th><th class="text-end">Ações</th></tr></thead><tbody>
    @foreach (var client in Model.Clients)
    {
        <tr><td>@client.Name</td><td>@(client.PersonType == PersonType.Company ? "PJ" : "PF")</td><td>@IndexModel.Mask(client)</td><td>@client.City</td><td>@client.Email</td><td class="text-end">
            <a class="btn btn-sm btn-outline-secondary" asp-page="Details" asp-route-id="@client.Id">Detalhar</a>
            <a class="btn btn-sm btn-outline-primary" asp-page="Edit" asp-route-id="@client.Id">Editar</a>
            <form method="post" asp-page-handler="Delete" asp-route-id="@client.Id" class="d-inline" onsubmit="return confirm('Excluir este cliente?');"><button class="btn btn-sm btn-outline-danger" type="submit">Excluir</button></form>
        </td></tr>
    }
    </tbody></table></div>
}
</section>
