@page
@model OrcaFacil.Web.Pages.Clients.IndexModel
@section Styles { <link rel="stylesheet" href="~/css/clients.css" asp-append-version="true" /> }
@using OrcaFacil.Domain.Enums
@{ ViewData["Title"] = "Clientes"; ViewData["Section"] = "Comercial"; }

<header class="client-page-head">
 <div><p class="of-eyebrow">Commercial Workspace 360</p><h1>Clientes</h1><p>Relacionamentos, oportunidades e próximos passos em um único lugar.</p></div>
 <div class="client-head-actions"><button type="button" class="client-button secondary" data-help-open data-help-code="clients">Como usar</button><a class="client-button primary" asp-page="/Clients/Create">Novo cliente</a></div>
</header>
<partial name="Partials/_ContextGuide" model='new ContextGuideViewModel("Construa relacionamentos com contexto","Reutilizar dados de pessoas e empresas em toda a jornada.","Contatos, documentos, tags e histórico comercial.","Use o cadastro em uma nova proposta ou ordem.","Evite duplicidades e mantenha o contato principal atualizado.")' />

<section class="client-metrics" aria-label="Indicadores de clientes">
 <article><span>Ativos</span><strong>@Model.Result.Active</strong></article><article><span>Favoritos</span><strong>@Model.Result.Favorites</strong></article><article><span>Novos em 30 dias</span><strong>@Model.Result.NewThisMonth</strong></article><article><span>Cadastro incompleto</span><strong>@Model.Result.Incomplete</strong></article>
</section>

<form method="get" class="client-filters" aria-label="Filtros de clientes">
 <label class="client-search"><span>Busca geral</span><input asp-for="Search" type="search" /></label>
 <label><span>Tipo</span><select asp-for="PersonType"><option value="">PF e PJ</option><option value="Individual">Pessoa física</option><option value="Company">Pessoa jurídica</option></select></label>
 <label><span>Cidade</span><input asp-for="City" /></label>
 <label><span>Situação</span><select asp-for="Active"><option value="">Todos</option><option value="true">Ativos</option><option value="false">Inativos</option></select></label>
 <label><span>Ordenar</span><select asp-for="Sort"><option value="name">Nome A–Z</option><option value="recent">Mais recentes</option><option value="activity">Última atividade</option><option value="name_desc">Nome Z–A</option></select></label>
 <button class="client-button primary" type="submit">Aplicar</button>@if(Model.HasFilters){<a class="client-clear" asp-page="/Clients/Index">Limpar</a>}
</form>

<div class="client-result-head"><p><strong>@Model.Result.Total</strong> clientes encontrados</p><span>Página @Model.Result.Page de @Model.Result.TotalPages</span></div>
@if (Model.Result.Items.Count == 0) {
 <section class="client-empty"><div class="client-avatar">OF</div><h2>@(Model.HasFilters ? "Nenhum cliente corresponde aos filtros" : "Sua carteira começa aqui")</h2><p>@(Model.HasFilters ? "Revise os termos ou limpe os filtros." : "Você ainda não cadastrou clientes. Comece por uma pessoa ou empresa para preencher propostas com mais rapidez.")</p><a class="client-button primary" asp-page="/Clients/Create">Cadastrar cliente</a></section>
} else {
 <div class="client-table-wrap"><table class="client-table"><thead><tr><th>Cliente</th><th>Contato principal</th><th>Cidade</th><th>Tags</th><th>Status</th><th>Próxima ação</th><th><span class="sr-only">Ações</span></th></tr></thead><tbody>
 @foreach(var client in Model.Result.Items){<tr><td><a class="client-identity" asp-page="/Clients/Details" asp-route-id="@client.Id"><span class="client-avatar">@client.Name[..1].ToUpperInvariant()</span><span><strong>@client.Name</strong><small>@(client.PersonType == PersonType.Company ? "PJ" : "PF") · @Model.Mask(client.DocumentType, client.DocumentNumber)</small></span></a></td><td>@(client.PrimaryContact ?? "Contato não informado")</td><td>@(client.City ?? "—")</td><td><div class="client-tags">@foreach(var tag in client.Tags){<span data-color="@tag.ColorToken">@tag.Name</span>}</div></td><td><span class="client-status @(client.IsActive ? "active" : null)">@(client.IsActive ? "Ativo" : "Inativo")</span></td><td><a class="client-next-action" asp-page="/Documents/New" asp-route-clientId="@client.Id">Criar proposta</a></td><td><div class="client-row-actions"><form method="post" asp-page-handler="Favorite" asp-route-id="@client.Id" data-client-action-form>@Html.AntiForgeryToken()<button class="client-icon-button" type="submit" aria-busy="false" title="@(client.IsFavorite ? "Remover dos favoritos" : "Adicionar aos favoritos")" aria-label="@(client.IsFavorite ? "Remover dos favoritos" : "Adicionar aos favoritos")"><partial name="Partials/_Icon" model='new IconViewModel("favorite", "sm", Decorative: true, Tone: client.IsFavorite ? "brand" : null)' /></button></form><a asp-page="/Clients/Details" asp-route-id="@client.Id">Abrir 360</a><button type="button" data-delete-client data-client-id="@client.Id" data-client-name="@client.Name">Excluir</button></div></td></tr>}
 </tbody></table></div>
 <div class="client-mobile-list">@foreach(var client in Model.Result.Items){<article><header><span class="client-avatar">@client.Name[..1].ToUpperInvariant()</span><div><h2>@client.Name</h2><p>@Model.Mask(client.DocumentType, client.DocumentNumber)</p></div></header><p>@(client.PrimaryContact ?? "Adicione um contato principal")</p><div class="client-tags">@foreach(var tag in client.Tags){<span data-color="@tag.ColorToken">@tag.Name</span>}</div><footer><a asp-page="/Documents/New" asp-route-clientId="@client.Id">Novo orçamento</a><a asp-page="/Clients/Details" asp-route-id="@client.Id">Abrir 360</a></footer></article>}</div>
 <nav class="client-pagination" aria-label="Paginação">@if(Model.Result.Page > 1){<a asp-route-pageNumber="@(Model.Result.Page-1)" asp-route-search="@Model.Search" asp-route-city="@Model.City">Anterior</a>}<span>@Model.Result.Page / @Model.Result.TotalPages</span>@if(Model.Result.Page < Model.Result.TotalPages){<a asp-route-pageNumber="@(Model.Result.Page+1)" asp-route-search="@Model.Search" asp-route-city="@Model.City">Próxima</a>}</nav>
}
<dialog class="client-dialog" data-delete-dialog><form method="dialog"><button class="client-icon-button" title="Fechar" aria-label="Fechar" aria-busy="false"><partial name="Partials/_Icon" model='new IconViewModel("close", "sm", Decorative: true)' /></button></form><h2>Remover <span data-delete-name></span>?</h2><p>O cliente sairá da lista. Orçamentos, revisões, ordens, pagamentos, recibos, contatos históricos e auditoria serão preservados.</p><div><button class="client-button secondary" type="button" data-dialog-cancel>Cancelar</button><form method="post" asp-page-handler="Delete" data-delete-form>@Html.AntiForgeryToken()<input type="hidden" name="id" /><button class="client-button danger" type="submit"><partial name="Partials/_Icon" model='new IconViewModel("delete", "sm", Decorative: true)' /> Confirmar remoção</button></form></div></dialog>
