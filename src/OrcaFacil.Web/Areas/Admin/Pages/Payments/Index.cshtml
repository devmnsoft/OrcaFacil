@page
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Policy="SuperAdmin")]
@{ViewData["Title"]="Pagamentos";}
<header class="of-page-header"><div><p class="of-eyebrow">Financeiro</p><h1><i class="bi bi-cash-coin"></i> Pagamentos</h1><p>Pix, boleto, status, vencimentos e ações manuais auditáveis.</p></div></header><div class="row g-3"><div class="col"><div class="of-metric"><span>Pendente</span><strong>R$ 0,00</strong></div></div><div class="col"><div class="of-metric"><span>Aprovado</span><strong>R$ 0,00</strong></div></div><div class="col"><div class="of-metric"><span>Vencido</span><strong>R$ 0,00</strong></div></div></div><section class="of-card mt-3"><div class="row g-2"><select class="form-select col"><option>Status</option></select><select class="form-select col"><option>Método</option></select><input class="form-control col" placeholder="Usuário"/></div><table class="table mt-3"><thead><tr><th>Usuário</th><th>Plano</th><th>Método</th><th>Valor</th><th>Status</th><th>Vencimento</th><th>Pago em</th><th>External id</th><th>Ações</th></tr></thead><tbody><tr><td colspan="9">Ações: aprovar manualmente, marcar vencido, suspender/liberar benefícios, reenviar cobrança e registrar observação.</td></tr></tbody></table></section>
