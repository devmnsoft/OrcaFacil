@page "/Admin/SystemLogs"
@model OrcaFacil.Web.Areas.Admin.Pages.SystemLogs.IndexModel
@{ViewData["Title"]="Logs do sistema";}
<section class="of-page-shell"><h1>Logs do sistema</h1><p>Até 250 eventos, sempre com detalhes técnicos protegidos. Tokens, senhas e strings de conexão nunca devem ser registrados.</p>
<form method="get" class="of-card of-filter-grid"><label>De<input type="date" asp-for="From" /></label><label>Até<input type="date" asp-for="To" /></label><label>Nível<input asp-for="Level" placeholder="Error" /></label><label>Categoria<input asp-for="Category" /></label><label>Usuário<input asp-for="User" /></label><label>Conta<input asp-for="Account" /></label><label>CorrelationId<input asp-for="CorrelationId" /></label><button type="submit" class="of-button of-button--primary">Filtrar</button><a class="of-button of-button--secondary" href="/Admin/SystemLogs">Limpar</a></form>
<div class="of-data-table-scroll"><table class="of-data-table"><thead><tr><th>Data (UTC)</th><th>Severidade</th><th>Categoria</th><th>Usuário</th><th>Mensagem</th><th>Detalhes técnicos</th></tr></thead><tbody>@if(Model.Items.Count==0){<tr><td colspan="6">Nenhum evento encontrado para os filtros informados.</td></tr>}@foreach(var item in Model.Items){<tr><td>@item.CreatedAt.ToString("g")</td><td><span class="of-status-badge">@item.Level</span></td><td>@item.Category</td><td>@(item.User ?? "—")</td><td>@item.Message</td><td><details><summary>Ver detalhes</summary><pre>@item.TechnicalDetails</pre></details></td></tr>}</tbody></table></div></section>
