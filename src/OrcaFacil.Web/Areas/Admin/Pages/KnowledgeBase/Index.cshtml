@page
@model OrcaFacil.Web.Areas.Admin.Pages.KnowledgeBase.IndexModel
@{ViewData["Title"]="Base de conhecimento";}<header class="of-admin-page-header"><div><p class="of-eyebrow">Conteúdo de ajuda</p><h1>Base de conhecimento</h1><p>Publique orientações revisadas sem aceitar HTML inseguro.</p></div></header><div class="of-admin-detail-grid"><section class="of-card"><h2>Novo artigo</h2><form method="post" class="of-form-stack"><div asp-validation-summary="ModelOnly"></div><label asp-for="Title">Título</label><input asp-for="Title"/><label asp-for="Slug">Endereço</label><input asp-for="Slug" placeholder="como-criar-orcamento"/><span asp-validation-for="Slug"></span><label asp-for="Summary">Resumo</label><textarea asp-for="Summary" rows="3"></textarea><label asp-for="Content">Conteúdo em texto simples</label><textarea asp-for="Content" rows="10"></textarea><label asp-for="Category">Categoria</label><input asp-for="Category"/><label asp-for="Audience">Público</label><select asp-for="Audience"><option value="All">Todos</option><option value="Public">Visitantes</option><option value="Authenticated">Usuários</option></select><label class="of-check"><input asp-for="IsPublished"/> Publicar agora</label><button type="submit" class="of-button of-button-primary">Salvar artigo</button></form></section><section class="of-card"><h2>Artigos</h2>@if(Model.Items.Count==0){<div class="of-empty-state"><h3>Nenhum artigo cadastrado</h3><p>Crie somente conteúdo útil e revisado.</p></div>}else{<div class="of-list-stack">@foreach(var x in Model.Items){<article class="of-list-row"><span><strong>@x.Title</strong><small>@x.Category · @(x.IsPublished?"Publicado":"Rascunho")</small></span>@if(x.IsPublished){<a asp-area="" asp-page="/Help/Article" asp-route-slug="@x.Slug">Visualizar</a>}</article>}</div>}</section></div>