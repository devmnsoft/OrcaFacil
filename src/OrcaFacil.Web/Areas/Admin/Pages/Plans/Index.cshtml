@page
@model OrcaFacil.Web.Areas.Admin.Pages.Plans.IndexModel
@{ ViewData["Title"]="Planos"; }
<div class="of-page"><header class="of-page-header"><div><p class="of-eyebrow">Catálogo SaaS</p><h1>Planos e versões</h1><p>Versões publicadas preservam os termos das assinaturas existentes.</p></div></header>
<section class="of-mobile-card-list">@if(Model.Items.Count==0){<div class="of-card of-empty-state"><h2>Catálogo não configurado</h2><p>Publique planos e limites antes de habilitar novas contratações.</p></div>}@foreach(var plan in Model.Items){<article class="of-card of-data-card"><div class="of-section-heading"><div><p class="of-eyebrow">@plan.Code</p><h2>@plan.Name</h2></div><span class="of-status-badge">@(plan.IsActive ? "Ativo" : "Inativo")</span></div><p>@plan.Description</p><dl><div><dt>Versões</dt><dd>@plan.Versions</dd></div><div><dt>Publicada</dt><dd>@(plan.PublishedVersion?.ToString() ?? "Nenhuma")</dd></div><div><dt>Assinaturas</dt><dd>@plan.Subscriptions</dd></div></dl></article>}</section></div>
