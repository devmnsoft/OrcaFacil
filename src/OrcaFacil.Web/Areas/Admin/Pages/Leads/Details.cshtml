@page
@model OrcaFacil.Web.Areas.Admin.Pages.Leads.DetailsModel
@{ ViewData["Title"] = "Detalhe do lead"; var phone = new string((Model.Lead.Phone ?? "").Where(char.IsDigit).ToArray()); }
<header class="of-page-header"><div><p class="of-eyebrow">Lead comercial</p><h1>@Model.Lead.Name</h1><p>@(Model.Lead.CompanyName ?? "Contato sem empresa informada") · @Model.Lead.Status</p></div><a class="of-button of-button-secondary" asp-page="Index">Voltar</a></header>
<div class="of-admin-detail-grid"><section class="of-card"><h2>Contato e interesse</h2><dl class="of-detail-list"><dt>Telefone</dt><dd>@(Model.Lead.Phone ?? "—")</dd><dt>E-mail</dt><dd>@(Model.Lead.Email ?? "—")</dd><dt>Segmento</dt><dd>@(Model.Lead.Segment ?? "—")</dd><dt>Orçamentos/mês</dt><dd>@(Model.Lead.MonthlyBudgetVolume?.ToString() ?? "—")</dd><dt>Origem</dt><dd>@Model.Lead.SourcePage</dd><dt>Recebido em</dt><dd>@Model.Lead.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</dd><dt>Mensagem</dt><dd>@(Model.Lead.Message ?? "—")</dd><dt>Consentimento</dt><dd>@(Model.Lead.ConsentAccepted ? "Aceito" : "Não aceito")</dd></dl><div class="of-inline-actions">@if(phone.Length >= 10){<a class="of-button of-button-primary" href="https://wa.me/55@phone" target="_blank" rel="noopener noreferrer">Abrir WhatsApp</a>}@if(Model.Lead.Email is not null){<a class="of-button of-button-secondary" href="mailto:@Model.Lead.Email">Enviar e-mail</a><button type="button" class="of-button of-button-secondary" data-copy-value="@Model.Lead.Email">Copiar e-mail</button>}</div></section>
<aside class="of-card"><h2>Acompanhamento</h2><div class="of-inline-actions"><form method="post" asp-page-handler="Contacted" asp-route-id="@Model.Lead.Id"><button type="submit" class="of-button of-button-secondary">Marcar contatado</button></form><form method="post" asp-page-handler="Qualified" asp-route-id="@Model.Lead.Id"><button type="submit" class="of-button of-button-primary">Qualificar</button></form></div><form method="post" asp-page-handler="Notes" asp-route-id="@Model.Lead.Id" class="of-field"><label asp-for="Notes">Observações internas</label><textarea asp-for="Notes" rows="6" maxlength="3000"></textarea><button type="submit" class="of-button of-button-primary">Salvar observações</button></form><form method="post" asp-page-handler="Discard" asp-route-id="@Model.Lead.Id" class="of-field"><label asp-for="DiscardReason">Motivo do descarte</label><textarea asp-for="DiscardReason" rows="3" maxlength="500"></textarea><span asp-validation-for="DiscardReason"></span><button type="submit" class="of-button of-button-secondary">Descartar lead</button></form></aside></div>
@section Scripts { <script>document.querySelector('[data-copy-value]')?.addEventListener('click',async e=>{await navigator.clipboard.writeText(e.currentTarget.dataset.copyValue);e.currentTarget.textContent='E-mail copiado';});</script> }
