@page "/Admin/Subscriptions"
@model OrcaFacil.Web.Areas.Admin.Pages.Subscriptions.IndexModel
@{ ViewData["Title"]="Assinaturas"; }
<div class="of-page"><header class="of-page-header"><div><p class="of-eyebrow">Receita recorrente</p><h1>Assinaturas e trials</h1><p>Acompanhe o estado real registrado pelo faturamento.</p></div></header><section class="of-card"><div class="of-admin-table-wrap"><table class="of-table"><thead><tr><th>Conta</th><th>Plano</th><th>Status</th><th>Trial</th><th>Próximo vencimento</th><th>Valor</th></tr></thead><tbody>@if(Model.Items.Count==0){<tr><td colspan="6"><div class="of-empty-state">Nenhuma assinatura encontrada.</div></td></tr>}@foreach(var item in Model.Items){<tr><td><a asp-page="/Accounts/Details" asp-route-id="@item.AccountId">@item.Account</a></td><td>@item.Plan</td><td><span class="of-status-badge">@item.Status</span></td><td>@(item.TrialEndsAt?.ToLocalTime().ToString("d") ?? "—")</td><td>@(item.NextDueAt?.ToLocalTime().ToString("d") ?? "—")</td><td>@item.Amount.ToString("C")</td></tr>}</tbody></table></div></section></div>
