@page
@model OrcaFacil.Web.Areas.Admin.Pages.Onboarding.IndexModel
@{ViewData["Title"]="Onboarding";}
<header class="admin-page-header"><div><p class="of-eyebrow">Ativação</p><h1>Primeira experiência</h1><p>Acompanhe o avanço sem expor dados pessoais.</p></div></header><section class="admin-metric-grid"><article><strong>@Model.TotalAccounts</strong><span>Contas criadas</span></article><article><strong>@Model.Incomplete</strong><span>Configurações incompletas</span></article><article><strong>@Model.FirstBudgets</strong><span>Primeiros orçamentos iniciados</span></article><article><strong>@Model.Abandoned</strong><span>Sem atividade há 7 dias</span></article></section><section class="admin-table-card"><table><thead><tr><th>Referência</th><th>Etapa</th><th>Orçamento</th><th>Situação</th><th>Último acesso</th></tr></thead><tbody>@foreach(var row in Model.Rows){<tr><td><code>@row.AccountReference</code></td><td>@row.Step</td><td>@(row.HasBudget?"Iniciado":"Ainda não")</td><td>@(row.Completed?"Concluído":row.Abandoned?"Precisa de atenção":"Em andamento")</td><td><time datetime="@row.LastSeen.ToString("O")">@row.LastSeen.ToString("dd/MM/yyyy HH:mm")</time></td></tr>}</tbody></table></section>
