@page
@model OrcaFacil.Web.Areas.Admin.Pages.Users.IndexModel
@{ ViewData["Title"]="Usuários"; }
<div class="of-page"><header class="of-page-header"><div><p class="of-eyebrow">Acesso global</p><h1>Usuários</h1><p>Identifique bloqueios, falhas de login e vínculos ativos em todas as contas.</p></div></header>
<section class="of-metric-grid"><article class="of-metric-card"><span>Ativos</span><strong>@Model.Active</strong></article><article class="of-metric-card"><span>Bloqueados</span><strong>@Model.Blocked</strong></article><article class="of-metric-card"><span>Inativos</span><strong>@Model.Inactive</strong></article></section>
<form method="get" class="of-card of-filter-bar"><label>Nome ou e-mail<input type="search" name="query" value="@Model.Query" /></label><label>Status<select name="status"><option value="">Todos</option><option value="active">Ativos</option><option value="blocked">Bloqueados</option><option value="inactive">Inativos</option></select></label><button type="submit" class="of-button-primary">Filtrar</button></form>
<section class="of-card"><div class="of-admin-table-wrap"><table class="of-table"><thead><tr><th>Usuário</th><th>Papel</th><th>Status</th><th>Último login</th><th>Última falha</th><th>Falhas</th></tr></thead><tbody>@if(Model.Items.Count==0){<tr><td colspan="6"><div class="of-empty-state">Nenhum usuário encontrado.</div></td></tr>}@foreach(var user in Model.Items){<tr><td><strong>@user.Name</strong><br/><small>@user.Email</small></td><td><span class="of-status-badge">@user.Role</span></td><td>@user.Status</td><td>@(user.LastLoginAt?.ToLocalTime().ToString("g") ?? "Nunca")</td><td>@(user.LastFailedLoginAt?.ToLocalTime().ToString("g") ?? "—")</td><td>@user.FailedAttempts</td></tr>}</tbody></table></div></section></div>
