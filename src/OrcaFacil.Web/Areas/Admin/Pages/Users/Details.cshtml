@page "{id?}"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Policy="SuperAdmin")]
@{ViewData["Title"]="Detalhes do usuário";}
<header class="of-page-header"><div><p class="of-eyebrow">SuperAdmin</p><h1>Detalhes do usuário</h1><p>Dados do usuário, perfil de cobrança, plano, assinatura, pagamentos, documentos, clientes, logs/auditoria e uso do mês.</p></div></header><section class="of-card"><button class="btn btn-danger">Bloquear usuário</button> <button class="btn btn-success">Liberar Pro manualmente</button> <button class="btn btn-outline-secondary">Voltar para Free</button> <button class="btn btn-warning">Marcar inadimplente</button><textarea class="form-control mt-3" placeholder="Observação administrativa"></textarea></section>
