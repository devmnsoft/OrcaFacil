@page
@model OrcaFacil.Web.Areas.Admin.Pages.Support.IndexModel
@{ViewData["Title"]="Suporte";}
<header class="of-admin-page-header"><div><p class="of-eyebrow">Atendimento</p><h1>Fila de suporte</h1><p>Priorize, investigue e acompanhe solicitações reais dos clientes.</p></div></header>
<div class="of-metric-grid"><article class="of-metric-card"><span>Em andamento</span><strong>@Model.OpenCount</strong></article><article class="of-metric-card"><span>Urgentes</span><strong>@Model.UrgentCount</strong></article><article class="of-metric-card"><span>Aguardando cliente</span><strong>@Model.WaitingCount</strong></article></div>
<form method="get" class="of-card of-filter-bar"><label>Status<select name="status"><option value="">Todos</option>@foreach(var x in Enum.GetNames<OrcaFacil.Domain.Enums.SupportTicketStatus>()){<option selected="@(Model.Status==x)">@x</option>}</select></label><label>Prioridade<select name="priority"><option value="">Todas</option>@foreach(var x in Enum.GetNames<OrcaFacil.Domain.Enums.SupportTicketPriority>()){<option selected="@(Model.Priority==x)">@x</option>}</select></label><label>Categoria<select name="category"><option value="">Todas</option>@foreach(var x in Enum.GetNames<OrcaFacil.Domain.Enums.SupportTicketCategory>()){<option selected="@(Model.Category==x)">@x</option>}</select></label><label>Conta, protocolo ou correlação<input name="search" value="@Model.Search"/></label><button type="submit" class="of-button of-button-primary">Filtrar fila</button></form>
<section class="of-card">@if(Model.Tickets.Count==0){<div class="of-empty-state"><h2>Nenhum chamado encontrado</h2><p>Ajuste os filtros ou comemore a fila vazia.</p></div>}else{<div class="of-table-wrap"><table class="of-table"><thead><tr><th>Chamado</th><th>Conta</th><th>Categoria</th><th>Prioridade</th><th>Status</th><th>Aberto em</th></tr></thead><tbody>@foreach(var t in Model.Tickets){<tr><td><a asp-page="Details" asp-route-id="@t.Id"><strong>@t.Subject</strong><small>@t.Protocol</small></a></td><td>@t.AccountId</td><td>@t.Category</td><td><span class="of-status-badge">@t.Priority</span></td><td>@t.Status</td><td>@t.CreatedAt.ToLocalTime().ToString("dd/MM HH:mm")</td></tr>}</tbody></table></div>}</section>
