@page
@model OrcaFacil.Web.Areas.Admin.Pages.Support.DetailsModel
@{ViewData["Title"]="Detalhe do chamado";}
<header class="of-admin-page-header"><div><p class="of-eyebrow">@Model.Ticket.Protocol</p><h1>@Model.Ticket.Subject</h1><p>@Model.Ticket.Category · @Model.Ticket.Priority · <span class="of-status-badge">@Model.Ticket.Status</span></p></div><a asp-page="Index" class="of-button of-button-secondary">Voltar à fila</a></header>
<div class="of-admin-detail-grid"><section class="of-card"><h2>Conversa</h2><div class="of-timeline">@foreach(var m in Model.Messages){<article class="of-timeline-item"><strong>@(m.IsAdminReply?"Equipe OrçaFácil":"Cliente")</strong><time>@m.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</time><p>@m.Body</p></article>}</div><form method="post" asp-page-handler="Reply" asp-route-id="@Model.Ticket.Id" class="of-form-stack"><label asp-for="Reply">Responder ao cliente</label><textarea asp-for="Reply" rows="6"></textarea><span asp-validation-for="Reply"></span><button type="submit" class="of-button of-button-primary">Enviar resposta</button></form></section><aside class="of-card"><h2>Contexto seguro</h2><dl><dt>Conta</dt><dd><a asp-area="Admin" asp-page="/Accounts/Details" asp-route-id="@Model.Ticket.AccountId">@Model.Ticket.AccountId</a></dd><dt>Usuário</dt><dd><a asp-area="Admin" asp-page="/Users/Details" asp-route-id="@Model.Ticket.OpenedByUserId">@Model.Ticket.OpenedByUserId</a></dd><dt>Página</dt><dd>@(Model.Ticket.RelatedPage??"Não informada")</dd><dt>Correlation ID</dt><dd><code>@(Model.Ticket.CorrelationId??"Não informado")</code> <a asp-area="Admin" asp-page="/SystemLogs/Index" asp-route-search="@Model.Ticket.CorrelationId">Pesquisar logs</a></dd><dt>Navegador</dt><dd>@(Model.Ticket.BrowserInfo??"Não informado")</dd></dl><form method="post" asp-page-handler="Status" asp-route-id="@Model.Ticket.Id" class="of-form-stack"><label asp-for="Status">Atualizar status</label><select asp-for="Status" asp-items="Html.GetEnumSelectList<OrcaFacil.Domain.Enums.SupportTicketStatus>()"></select><button class="of-button of-button-secondary" type="submit">Salvar status</button></form></aside></div>
