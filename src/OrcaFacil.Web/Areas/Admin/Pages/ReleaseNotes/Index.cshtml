@page
@model OrcaFacil.Web.Areas.Admin.Pages.ReleaseNotes.IndexModel
@{ViewData["Title"]="Release Notes";}<header class="of-admin-page-header"><div><p class="of-eyebrow">Comunicação de produto</p><h1>Release Notes</h1><p>Comunique apenas alterações verificadas e prontas para os clientes.</p></div><a asp-area="" asp-page="/ReleaseNotes/Index" class="of-button of-button-secondary">Ver página pública</a></header><div class="of-admin-detail-grid"><section class="of-card"><h2>Nova nota</h2><form method="post" class="of-form-stack"><label asp-for="Version">Versão</label><input asp-for="Version" placeholder="1.0.0"/><label asp-for="Title">Título</label><input asp-for="Title"/><label asp-for="Category">Categoria</label><select asp-for="Category"><option>Novidade</option><option>Melhoria</option><option>Correção</option><option>Segurança</option><option>Operação</option></select><label asp-for="ReleasedAt">Data</label><input asp-for="ReleasedAt" type="date"/><label asp-for="Description">Descrição</label><textarea asp-for="Description" rows="8"></textarea><label><input asp-for="IsPublished"/> Publicar</label><button type="submit" class="of-button of-button-primary">Salvar nota</button></form></section><section class="of-card"><h2>Histórico</h2>@if(Model.Items.Count==0){<div class="of-empty-state"><p>Nenhuma nota cadastrada.</p></div>}@foreach(var x in Model.Items){<article class="of-list-row"><span><strong>@x.Version · @x.Title</strong><small>@x.Category · @(x.IsPublished?"Publicada":"Rascunho")</small></span></article>}</section></div>
