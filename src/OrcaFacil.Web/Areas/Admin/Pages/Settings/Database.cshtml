@page
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Policy="SuperAdminOnly")]
@model OrcaFacil.Web.Areas.Admin.Pages.Settings.DatabaseModel
@using OrcaFacil.Persistence.Diagnostics
@{ ViewData["Title"] = "Banco de Dados"; var r = Model.Result; var ok = r?.CanConnect == true && r.SchemaExists && r.MissingTables.Count == 0 && (r.MissingColumns?.Count ?? 0) == 0; }
<header class="of-page-header"><div><p class="of-eyebrow">Admin Geral</p><h1>Banco de Dados</h1><p>Diagnóstico restrito de conexão, schema e dados fundamentais, sem expor segredos.</p></div><a class="of-button" href="/health/ready" target="_blank" rel="noopener">Readiness público</a></header>
@if (!Model.ConfigurationState.IsValid) { <div class="alert alert-danger"><strong>@Model.ConfigurationState.AdminMessage</strong><br />Nenhum segredo é exibido neste diagnóstico.</div> }
@if (Model.LocalSettingsMissing) { <div class="alert alert-warning"><strong>A configuração local do banco não foi encontrada.</strong><br />Caminho esperado: <code>@Model.LocalSettingsPath</code><br />Uma variável de ambiente ou user-secret válido também pode ser usado.</div> }
<div class="of-card mb-4"><span class="of-admin-status @(ok ? "ok" : r?.CanConnect == true ? "warn" : "error")">@(ok ? "OK" : r?.CanConnect == true ? "Atenção" : "Erro")</span><h2 class="h4 mt-3">@(ok ? "Banco conectado e schema validado." : "Banco com pendências de configuração.")</h2><div class="row g-3 mt-2"><div class="col-md-4"><strong>Ambiente</strong><p>@Environment.GetEnvironmentVariable("ASPNETCORE_ENVIRONMENT")</p></div><div class="col-md-4"><strong>Host e porta</strong><p>@Model.ConfigurationState.Host:@Model.ConfigurationState.Port</p></div><div class="col-md-4"><strong>Banco / usuário</strong><p>@Model.ConfigurationState.Database / @Model.ConfigurationState.Username</p></div><div class="col-md-4"><strong>Origem atual</strong><p>@Model.ConfigurationState.Source</p></div><div class="col-md-4"><strong>Senha presente</strong><p>@(Model.ConfigurationState.HasPassword ? "Sim" : "Não")</p></div><div class="col-md-4"><strong>Validação</strong><p>@Model.ConfigurationState.ValidationCode</p></div><div class="col-md-4"><strong>Fingerprint</strong><p><code>@Model.ConfigurationState.Fingerprint</code></p></div><div class="col-md-4"><strong>SSL</strong><p>@Model.ConfigurationState.SslMode</p></div><div class="col-md-4"><strong>Schema</strong><p>@DatabaseDiagnosticsService.ExpectedSchema</p></div><div class="col-md-4"><strong>Plano FREE</strong><p>@(r?.FreePlanExists == true ? "Encontrado" : "Ausente")</p></div><div class="col-md-4"><strong>Versão FREE publicada</strong><p>@(r?.PublishedFreeVersionExists == true ? "Encontrada" : "Ausente")</p></div><div class="col-md-4"><strong>CorrelationId</strong><p><code>@HttpContext.TraceIdentifier</code></p></div></div>@if (!string.IsNullOrWhiteSpace(r?.Error)) { <div class="alert alert-danger"><strong>Diagnóstico:</strong> @r.Error</div> }</div>
<div class="of-card"><h2 class="h5">Como corrigir</h2><ol><li>Abra <code>appsettings.Local.json</code>.</li><li>Informe uma senha válida, sem marcador de exemplo.</li><li>Verifique <code>ConnectionStrings__DefaultConnection</code> no ambiente.</li><li>Reinicie a aplicação.</li><li>Acesse <a href="/health/ready">/health/ready</a>.</li></ol></div>
@if (Model.SchemaContract is { } contract)
{
<div class="of-card mt-4">
  <h2 class="h5">Contrato do schema de cadastro</h2>
  <p>Última verificação: <time datetime="@contract.CheckedAt.ToString("O")">@contract.CheckedAt.ToString("dd/MM/yyyy HH:mm:ss 'UTC'")</time></p>
  @if (contract.Issues.Count == 0)
  {
    <p class="of-admin-status ok">Todas as tabelas, colunas, tipos, índices e constraints essenciais estão presentes.</p>
  }
  else
  {
    <div class="of-admin-alert" role="alert"><strong>Banco desatualizado: execute o script de atualização antes de continuar.</strong><br />Use <code>scripts/update-database-local.ps1</code>; nenhuma informação técnica sensível é exibida aqui.</div>
    <div class="table-responsive"><table class="of-data-table"><thead><tr><th>Tabela</th><th>Coluna</th><th>Estado</th><th>Migration recomendada</th></tr></thead><tbody>
    @foreach (var issue in contract.Issues)
    {
      <tr><td><code>@issue.Table</code></td><td><code>@(issue.Column ?? "—")</code></td><td>@issue.State</td><td><code>@issue.RecommendedMigration</code></td></tr>
    }
    </tbody></table></div>
  }
</div>
}
@if (Model.LocalSettingsPath is not null) { <p class="of-security-note"><span>Para alterar a conexão, edite <code>src/OrcaFacil.Web/appsettings.Local.json</code> e reinicie a aplicação.</span></p> }
<div class="of-admin-grid"><div ><div class="of-card"><h2 class="h5">Tabelas encontradas</h2>@if((r?.ExistingTables.Count ?? 0)==0){<partial name="Partials/_EmptyState" model='new EmptyStateViewModel { Title="Nenhuma tabela encontrada.", Text="Execute o script completo para criar a estrutura esperada.", Icon="bi-database-exclamation" }' />}else{<ul class="list-group list-group-flush">@foreach (var table in r?.ExistingTables ?? Array.Empty<string>()) { <li class="list-group-item"><span class="of-admin-status ok">OK</span> @table</li> }</ul>}</div></div><div ><div class="of-card"><h2 class="h5">Tabelas ausentes</h2>@if((r?.MissingTables.Count ?? 0)==0){<p><span class="of-admin-status ok">OK</span> Nenhuma tabela ausente.</p>}else{<ul class="list-group list-group-flush">@foreach (var table in r?.MissingTables ?? Array.Empty<string>()) { <li class="list-group-item"><span class="of-admin-status error">Erro</span> @table</li> }</ul>}</div></div></div>
<div class="of-card"><h2 class="h5">Colunas críticas ausentes</h2>@if ((r?.MissingColumns?.Count ?? 0) == 0) { <p><span class="of-admin-status ok">OK</span> Contrato de colunas validado.</p> } else { <ul>@foreach (var column in r?.MissingColumns ?? Array.Empty<string>()) { <li><code>@column</code></li> }</ul> }</div>
<div class="of-card"><h2 class="h5">Execução manual</h2><p>Execute <code>.\scripts\update-database-local.ps1 -Host localhost -Port 5432 -Database orcafacil -User postgres</code>. O atualizador aplica o script completo e o patch RC idempotentes, usando somente o schema <code>orcafacil</code> e sem apagar dados.</p></div>
