@page
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Policy="SuperAdmin")]
@model OrcaFacil.Web.Areas.Admin.Pages.Settings.DatabaseModel
@using OrcaFacil.Persistence.Diagnostics
@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@{ ViewData["Title"] = "Banco de Dados"; var r = Model.Result; var ok = r?.CanConnect == true && r.SchemaExists && r.MissingTables.Count == 0; }
<header class="of-page-header"><div><p class="of-eyebrow">Admin Geral</p><h1>Banco de Dados</h1><p>Esta área ajuda a verificar se o PostgreSQL está configurado corretamente.</p></div><a class="btn btn-outline-primary" href="/health/db" target="_blank">Abrir /health/db</a></header>
<div class="of-card mb-4"><span class="of-admin-status @(ok ? "ok" : r?.CanConnect == true ? "warn" : "error")">@(ok ? "OK" : r?.CanConnect == true ? "Atenção" : "Erro")</span><h2 class="h4 mt-3">@(ok ? "Banco conectado e schema validado." : "Banco com pendências de configuração.")</h2><div class="row g-3 mt-2"><div class="col-md-6"><strong>Banco conectado</strong><p>@(r?.CanConnect == true ? "Sim" : "Não")</p></div><div class="col-md-6"><strong>Schema esperado</strong><p>@DatabaseDiagnosticsService.ExpectedSchema</p></div><div class="col-md-6"><strong>PostgreSQL version</strong><p>@r?.PostgreSqlVersion</p></div><div class="col-md-6"><strong>Connection string</strong><p>@DatabaseDiagnosticsService.MaskConnectionString(Configuration.GetConnectionString("DefaultConnection"))</p></div></div>@if (!string.IsNullOrWhiteSpace(r?.Error)) { <div class="alert alert-danger"><strong>Erro:</strong> @r.Error</div> }</div>
<div class="row g-3"><div class="col-md-6"><div class="of-card"><h2 class="h5">Tabelas encontradas</h2>@if((r?.ExistingTables.Count ?? 0)==0){<partial name="Partials/_EmptyState" model='new { Title="Nenhuma tabela encontrada.", Text="Execute o script completo para criar a estrutura esperada.", Icon="bi-database-exclamation" }' />}else{<ul class="list-group list-group-flush">@foreach (var table in r?.ExistingTables ?? Array.Empty<string>()) { <li class="list-group-item"><span class="of-admin-status ok">OK</span> @table</li> }</ul>}</div></div><div class="col-md-6"><div class="of-card"><h2 class="h5">Tabelas ausentes</h2>@if((r?.MissingTables.Count ?? 0)==0){<p><span class="of-admin-status ok">OK</span> Nenhuma tabela ausente.</p>}else{<ul class="list-group list-group-flush">@foreach (var table in r?.MissingTables ?? Array.Empty<string>()) { <li class="list-group-item"><span class="of-admin-status error">Erro</span> @table</li> }</ul>}</div></div></div>
<div class="of-card mt-3"><h2 class="h5">Execução manual</h2><p>Execute <code>psql -h localhost -p 5432 -U orcafacil_user -d orcafacil -f database/script_completop.sql</code>. O script é idempotente e usa somente o schema <code>orcafacil</code>.</p></div>
