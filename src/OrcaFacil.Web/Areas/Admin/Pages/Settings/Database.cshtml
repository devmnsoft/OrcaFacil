@page
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Policy="SuperAdminOnly")]
@model OrcaFacil.Web.Areas.Admin.Pages.Settings.DatabaseModel
@using OrcaFacil.Persistence.Diagnostics
@{ ViewData["Title"] = "Banco de Dados"; var r = Model.Result; var ok = r?.CanConnect == true && r.SchemaExists && r.MissingTables.Count == 0; }
<header class="of-page-header"><div><p class="of-eyebrow">Admin Geral</p><h1><i class="bi bi-database-check me-2"></i>Banco de Dados</h1><p>Diagnóstico restrito de conexão, schema e dados fundamentais, sem expor segredos.</p></div><a class="btn btn-outline-primary" href="/health/ready" target="_blank"><i class="bi bi-activity"></i> Readiness público</a></header>
@if (Model.LocalSettingsMissing) { <div class="alert alert-warning"><strong>A configuração local do banco não foi encontrada.</strong><br />Caminho esperado: <code>@Model.LocalSettingsPath</code><br />Crie a partir do arquivo de exemplo.</div> }
<div class="of-card mb-4"><span class="of-admin-status @(ok ? "ok" : r?.CanConnect == true ? "warn" : "error")">@(ok ? "OK" : r?.CanConnect == true ? "Atenção" : "Erro")</span><h2 class="h4 mt-3">@(ok ? "Banco conectado e schema validado." : "Banco com pendências de configuração.")</h2><div class="row g-3 mt-2"><div class="col-md-4"><strong>Ambiente</strong><p>@Model.Descriptor?.Environment</p></div><div class="col-md-4"><strong>Host e porta</strong><p>@Model.Descriptor?.Host:@Model.Descriptor?.Port</p></div><div class="col-md-4"><strong>Banco / usuário</strong><p>@Model.Descriptor?.Database / @Model.Descriptor?.Username</p></div><div class="col-md-4"><strong>Origem lógica</strong><p>@Model.Descriptor?.Source</p></div><div class="col-md-4"><strong>Fingerprint</strong><p><code>@Model.Descriptor?.Fingerprint</code></p></div><div class="col-md-4"><strong>SSL</strong><p>@Model.Descriptor?.SslMode</p></div><div class="col-md-4"><strong>Schema</strong><p>@DatabaseDiagnosticsService.ExpectedSchema</p></div><div class="col-md-4"><strong>Plano FREE</strong><p>@(r?.FreePlanExists == true ? "Encontrado" : "Ausente")</p></div><div class="col-md-4"><strong>Versão FREE publicada</strong><p>@(r?.PublishedFreeVersionExists == true ? "Encontrada" : "Ausente")</p></div></div>@if (!string.IsNullOrWhiteSpace(r?.Error)) { <div class="alert alert-danger"><strong>Diagnóstico:</strong> @r.Error <strong>Código:</strong> @HttpContext.TraceIdentifier</div> }</div>
@if (Model.LocalSettingsPath is not null) { <p class="of-security-note"><i class="bi bi-info-circle"></i><span>Para alterar a conexão, edite <code>src/OrcaFacil.Web/appsettings.Local.json</code> e reinicie a aplicação.</span></p> }
<div class="row g-3"><div class="col-md-6"><div class="of-card"><h2 class="h5">Tabelas encontradas</h2>@if((r?.ExistingTables.Count ?? 0)==0){<partial name="Partials/_EmptyState" model='new EmptyStateViewModel { Title="Nenhuma tabela encontrada.", Text="Execute o script completo para criar a estrutura esperada.", Icon="bi-database-exclamation" }' />}else{<ul class="list-group list-group-flush">@foreach (var table in r?.ExistingTables ?? Array.Empty<string>()) { <li class="list-group-item"><span class="of-admin-status ok">OK</span> @table</li> }</ul>}</div></div><div class="col-md-6"><div class="of-card"><h2 class="h5">Tabelas ausentes</h2>@if((r?.MissingTables.Count ?? 0)==0){<p><span class="of-admin-status ok">OK</span> Nenhuma tabela ausente.</p>}else{<ul class="list-group list-group-flush">@foreach (var table in r?.MissingTables ?? Array.Empty<string>()) { <li class="list-group-item"><span class="of-admin-status error">Erro</span> @table</li> }</ul>}</div></div></div>
<div class="of-card mt-3"><h2 class="h5">Execução manual</h2><p>Execute <code>psql -h localhost -p 5432 -U orcafacil_user -d orcafacil -f database/script_completop.sql</code>. O script é idempotente e usa somente o schema <code>orcafacil</code>.</p></div>
