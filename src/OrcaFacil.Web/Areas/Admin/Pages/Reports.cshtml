@page "/Admin/Reports"
@model OrcaFacil.Web.Areas.Admin.Pages.ReportsModel
@{ ViewData["Title"]="Inteligência SaaS"; }
<header class="report-hero"><div><span class="eyebrow">ADMINISTRAÇÃO DA PLATAFORMA</span><h1>Inteligência SaaS</h1><p>Visão operacional agregada, protegida pela política de superadministrador.</p></div></header>
<section class="metric-grid"><article class="metric-card"><span>Contas ativas</span><strong>@Model.ActiveAccounts</strong></article><article class="metric-card"><span>Contas inativas</span><strong>@Model.InactiveAccounts</strong></article><article class="metric-card"><span>Contas em trial</span><strong>@Model.Trials</strong></article><article class="metric-card"><span>Contas pagas</span><strong>@Model.Paid</strong></article><article class="metric-card"><span>Orçamentos e documentos</span><strong>@Model.Documents</strong></article><article class="metric-card"><span>Clientes</span><strong>@Model.Clients</strong></article><article class="metric-card"><span>Recibos</span><strong>@Model.Receipts</strong></article><article class="metric-card"><span>Ordens de serviço</span><strong>@Model.WorkOrders</strong></article></section>
<div class="report-table-wrap"><table class="report-table"><thead><tr><th>Plano</th><th>Contas</th></tr></thead><tbody>@foreach(var row in Model.Usage){<tr><td data-label="Plano">@row.Plan</td><td data-label="Contas">@row.Accounts</td></tr>}</tbody></table></div>
