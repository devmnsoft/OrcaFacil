@page
@model OrcaFacil.Web.Areas.Admin.Pages.DashboardModel
@{ViewData["Title"]="Dashboard Admin"; var d=Model.Data;}
<header class="of-page-header"><div><p class="of-eyebrow">SuperAdmin</p><h1><i class="bi bi-speedometer2"></i> Dashboard Admin</h1><p>Visão financeira, operacional, inadimplência, pagamentos e saúde do sistema.</p></div><form method="post" asp-page-handler="RecalculateBilling"><button class="btn btn-warning"><i class="bi bi-arrow-repeat"></i> Recalcular inadimplência</button></form></header>
<div class="row g-3">@foreach(var card in new[]{("Usuários totais",d.TotalUsers,"bi-people"),("Ativos",d.ActiveUsers,"bi-person-check"),("Bloqueados",d.BlockedUsers,"bi-person-lock"),("Free",d.FreeUsers,"bi-gift"),("Pro",d.ProUsers,"bi-stars"),("Inadimplentes",d.PastDueUsers+d.SuspendedUsers,"bi-exclamation-octagon"),("Clientes",d.TotalClients,"bi-person-lines-fill"),("Orçamentos",d.TotalBudgets,"bi-file-earmark-text"),("Recibos",d.TotalReceipts,"bi-receipt"),("PDFs",d.TotalDocuments,"bi-filetype-pdf"),("Pagamentos",d.TotalPayments,"bi-cash-coin")}){<div class="col-md-3"><div class="of-metric"><span><i class="bi @card.Item3"></i> @card.Item1</span><strong>@card.Item2</strong></div></div>}<div class="col-md-3"><div class="of-metric"><span>Receita mês</span><strong>@d.ApprovedPaymentsAmountMonth.ToString("C")</strong></div></div><div class="col-md-3"><div class="of-metric"><span>MRR estimado</span><strong>@d.MrrEstimate.ToString("C")</strong></div></div></div>
<section class="of-card mt-4"><h2>Atividade dos usuários</h2><div class="table-responsive"><table class="table"><thead><tr><th>Usuário</th><th>E-mail</th><th>Plano</th><th>Documentos</th><th>Clientes</th><th>Último acesso</th><th>Status</th></tr></thead><tbody>@foreach(var u in d.RecentUsers){<tr><td>@u.Name</td><td>@u.Email</td><td><span class="badge text-bg-primary">@u.Plan</span></td><td>@u.Documents</td><td>@u.Clients</td><td>@u.LastAccess</td><td>@u.Status</td></tr>}</tbody></table></div><a class="btn btn-outline-primary" asp-area="Admin" asp-page="/Users/Index">Ver usuários</a></section>
<section class="of-card mt-4"><h2>Financeiro</h2><p>Pendente: @d.PendingPaymentsAmount.ToString("C") • Vencido: @d.OverduePaymentsAmount.ToString("C")</p><div class="table-responsive"><table class="table"><thead><tr><th>Usuário</th><th>Plano</th><th>Valor</th><th>Método</th><th>Status</th><th>Vencimento</th><th>Último pagamento</th><th>Ação</th></tr></thead><tbody>@foreach(var p in d.RecentPayments){<tr><td>@p.User</td><td>@p.Plan</td><td>@p.Amount.ToString("C")</td><td>@p.Method</td><td><span class="badge text-bg-info">@p.Status</span></td><td>@p.DueDate</td><td>@p.PaidAt</td><td><a asp-area="Admin" asp-page="/Payments/Details" asp-route-id="@p.ExternalId">ver</a></td></tr>}</tbody></table></div><a class="btn btn-primary" asp-area="Admin" asp-page="/Payments/Index">Ver pagamentos</a></section>
<section class="of-card mt-4"><h2>Saúde do sistema</h2><p>Banco monitorado por /health/db. Webhooks Mercado Pago recentes e filas pendentes serão exibidos conforme integração ativa.</p><ul>@foreach(var e in d.RecentErrors){<li>@e</li>}</ul></section>
