@page
@model OrcaFacil.Web.Areas.Admin.Pages.DashboardModel
@{ViewData["Title"]="Central de operação";var d=Model.Data;var attention=d.PastDueUsers+d.SuspendedUsers;}
<header class="of-page-heading"><p class="of-eyebrow">Estado da operação</p><h1>Central de operação</h1><p>Priorize receita, contas e infraestrutura sem perder o contexto da ação administrativa.</p></header>
<section class="of-admin-primary-metrics" aria-label="Indicadores principais"><article><span>Receita no mês</span><strong>@d.ApprovedPaymentsAmountMonth.ToString("C")</strong><small>Pagamentos aprovados</small></article><article><span>Receita recorrente</span><strong>@d.MrrEstimate.ToString("C")</strong><small>Estimativa atual</small></article><article><span>Contas pagas</span><strong>@d.ProUsers</strong><small>@d.FreeUsers no Grátis</small></article><article><span>Exigem atenção</span><strong>@attention</strong><small>Em atraso ou pausadas</small></article></section>
<div class="of-admin-operation-grid"><section class="of-admin-section"><p class="of-eyebrow">O que precisa de atenção</p><h2>Ações administrativas necessárias</h2>@if(attention>0){<p><strong>@attention contas com acesso financeiro pendente</strong><br/>Revise pagamento, carência e impacto antes de agir.</p>}@if(d.RecentErrors.Count>0){<p><strong>@d.RecentErrors.Count erros recentes</strong><br/>Use a correlação para investigar recorrências.</p>}@if(attention==0&&d.RecentErrors.Count==0){<p>Nenhuma ocorrência crítica nos dados disponíveis.</p>}</section><aside class="of-admin-section"><p class="of-eyebrow">Saúde</p><h2>Dependências essenciais</h2><dl><div><dt>Banco</dt><dd>Monitorado pelo readiness</dd></div><div><dt>E-mail e fila</dt><dd>Verificar mensagens pendentes</dd></div></dl><a href="/health/ready">Abrir readiness</a></aside></div>
<section class="of-admin-section"><div class="of-section-heading"><div><p class="of-eyebrow">Contas recentes</p><h2>Atividade que merece contexto</h2></div><a asp-area="Admin" asp-page="/Users">Ver usuários</a></div><table><thead><tr><th>Responsável</th><th>Plano</th><th>Documentos</th><th>Clientes</th><th>Situação</th></tr></thead><tbody>@foreach(var u in d.RecentUsers.Take(8)){<tr><td><strong>@u.Name</strong><br/><small>@u.Email</small></td><td>@u.Plan</td><td>@u.Documents</td><td>@u.Clients</td><td>@u.Status</td></tr>}</tbody></table></section>
<section class="of-admin-section"><div class="of-section-heading"><div><p class="of-eyebrow">Receita e inadimplência</p><h2>Pagamentos recentes</h2></div><form method="post" asp-page-handler="RecalculateBilling"><button type="submit">Recalcular inadimplência</button></form></div><p>Pendente: <strong>@d.PendingPaymentsAmount.ToString("C")</strong> · Vencido: <strong>@d.OverduePaymentsAmount.ToString("C")</strong></p><table><thead><tr><th>Conta</th><th>Plano</th><th>Valor</th><th>Situação</th><th>Vencimento</th></tr></thead><tbody>@foreach(var p in d.RecentPayments.Take(8)){<tr><td>@p.User</td><td>@p.Plan</td><td>@p.Amount.ToString("C")</td><td>@p.Status</td><td>@p.DueDate?.ToString("dd/MM/yyyy")</td></tr>}</tbody></table></section>
