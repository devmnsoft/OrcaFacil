@using OrcaFacil.Web.Services
@inject IAdminShellViewModelFactory ShellFactory
@{var shell=await ShellFactory.CreateAsync(Context.RequestAborted);var path=Context.Request.Path.Value??"";}
<!doctype html><html lang="pt-BR"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>@ViewData["Title"] · Operação OrçaFácil</title><link rel="stylesheet" href="~/css/tokens.css"/><link rel="stylesheet" href="~/css/base.css"/><link rel="stylesheet" href="~/css/admin.css"/></head><body class="of-admin-body"><a class="of-skip-link" href="#admin-content">Ir para o conteúdo</a><div class="of-admin-shell"><aside class="of-admin-sidebar"><a asp-area="Admin" asp-page="/Dashboard"><img src="~/img/brand/orcafacil-wordmark-light.svg" alt="OrçaFácil — operação MNSOFT"/></a><p>Central de operação</p><nav aria-label="Administração">@foreach(var group in shell.Menus){<section><h2>@group.Label</h2>@foreach(var item in group.Items){var active=path.Contains(item.Page,StringComparison.OrdinalIgnoreCase);<a class="@(active?"is-active":null)" asp-area="Admin" asp-page="@item.Page" aria-current="@(active?"page":null)"><svg class="of-icon"><use href="/img/icons/orcafacil-icons.svg#icon-@item.Icon"/></svg>@item.Label</a>}</section>}</nav><a asp-page="/Dashboard/Index" asp-area="">Voltar à conta</a></aside><div><header class="of-admin-topbar"><div><span>Operação / @ViewData["Title"]</span><strong>@ViewData["Title"]</strong></div><div><span class="of-admin-alert">@shell.CriticalAlertCount alertas críticos</span><span>@shell.SuperAdminName</span></div></header><main id="admin-content" class="of-admin-content" tabindex="-1"><partial name="/Pages/Shared/Partials/_ToastHost.cshtml"/>@RenderBody()</main></div></div><script src="~/js/experience.js"></script>@await RenderSectionAsync("Scripts",false)</body></html>
