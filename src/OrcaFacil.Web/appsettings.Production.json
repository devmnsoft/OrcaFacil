{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Information",
        "Microsoft.EntityFrameworkCore.Database.Command": "Information",
        "Microsoft.EntityFrameworkCore.Query": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      }
    ]
  },
  "ConnectionStrings": { "DefaultConnection": "" },
  "Security": {
    "TechnicalFingerprintPepper": "",
    "PasswordResetPepper": "",
    "SecurityEventPepper": "",
    "CookieSecureInProduction": true
  },
  "Email": { "Required": false, "Host": "", "Port": 587, "SocketOptions": "StartTls" },
  "Telegram": {
    "Enabled": false
  }
}
