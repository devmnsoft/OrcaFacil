{
  "DataProtection": { "ApplicationName": "OrcaFacil", "KeysPath": "C:\\ProgramData\\OrcaFacil\\keys" },
  "Application": { "PublicBaseUrl": "https://orcafacil.example.com" },
  "Uploads": { "Path": "C:\\ProgramData\\OrcaFacil\\uploads", "MaximumFileSizeMb": 10 },
  "SystemHealth": { "LogsPath": "C:\\ProgramData\\OrcaFacil\\logs", "BackupsPath": "C:\\ProgramData\\OrcaFacil\\backups" },
  "EmailOutbox": { "ActivePollingSeconds": 5, "IdlePollingSeconds": 30, "MaximumIdlePollingSeconds": 60, "BatchSize": 10, "MaximumAttempts": 5 },
  "RateLimit": { "PublicRequestsPerMinute": 20 },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Information",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
        "Microsoft.EntityFrameworkCore.Query": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": { "path": "C:\\ProgramData\\OrcaFacil\\logs\\orcafacil-.log", "rollingInterval": "Day", "retainedFileCountLimit": 30, "shared": true }
      }
    ]
  },
  "ConnectionStrings": { "DefaultConnection": "" },
  "Security": {
    "TechnicalFingerprintPepper": "",
    "PasswordResetPepper": "",
    "SecurityEventPepper": "",
    "CookieSecureInProduction": true
  },
  "Email": { "Required": false, "Host": "", "Port": 587, "SocketOptions": "StartTls", "UserName": "", "Password": "" },
  "Telegram": {
    "Enabled": false
  }
}
