{
  "DataProtection": { "KeysPath": ".keys" },
  "Application": { "PublicBaseUrl": "http://localhost:5080" },
  "Security": {
    "TechnicalFingerprintPepper": "orcafacil-development-only-change-before-production"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Information",
        "Microsoft.EntityFrameworkCore.Database.Command": "Information",
        "Microsoft.EntityFrameworkCore.Query": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      }
    ]
  }
}
