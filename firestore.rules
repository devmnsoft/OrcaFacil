rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedOwner(userId) { return request.auth != null && request.auth.uid == userId; }
    function userDoc(uid) { return get(/databases/$(database)/documents/users/$(uid)).data; }
    function isSuperAdmin() { return request.auth != null && userDoc(request.auth.uid).role == 'super_admin'; }
    function isNotBlocked() { return request.auth != null && userDoc(request.auth.uid).isActive != false && userDoc(request.auth.uid).isBlocked != true; }
    function onlyUserSafeFields() { return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name','email','phone','updatedAt','lastLoginAt','lastSeenAt','acceptedTermsAt','acceptedPrivacyAt','metadata']); }
    function validSeverity() { return request.resource.data.severity in ['info','success','warning','error','critical']; }
    function validLogText() { return (!('message' in request.resource.data) || (request.resource.data.message is string && request.resource.data.message.size() <= 2000)) && (!('title' in request.resource.data) || (request.resource.data.title is string && request.resource.data.title.size() <= 200)); }
    function validPublicQuote() {
      return request.resource.data.keys().hasOnly(['token','ownerUid','documentId','type','publicEnabled','issuer','client','document','decision','timeline','expiresAt','lastAccessAt','viewCount','issuerPublicName','issuerPublicContact','documentNumber','clientName','issueDate','validUntil','items','subtotal','discount','total','notes','status','clientDecision','clientDecisionAt','clientDecisionNote','evidenceHash','createdAt','updatedAt'])
        && request.resource.data.token is string
        && request.resource.data.token.size() >= 20
        && request.resource.data.ownerUid is string
        && request.resource.data.documentId is string
        && request.resource.data.publicEnabled is bool
        && (!('type' in request.resource.data) || request.resource.data.type == 'orcamento')
        && (!('document' in request.resource.data) || request.resource.data.document.status in ['rascunho','emitido','enviado','visualizado','aprovado','recusado','cancelado','convertido'])
        && (!('decision' in request.resource.data) || request.resource.data.decision.status in ['pendente','aprovado','recusado'])
        && request.resource.data.clientName is string && request.resource.data.clientName.size() <= 160
        && request.resource.data.notes is string && request.resource.data.notes.size() <= 2000
        && request.resource.data.status in ['rascunho','emitido','enviado','visualizado','aprovado','recusado','cancelado','convertido']
        && request.resource.data.clientDecision in ['pendente','aprovado','recusado'];
    }
    function publicDecisionOnly() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['clientDecision', 'clientDecisionAt', 'clientDecisionNote', 'evidenceHash', 'status', 'decision', 'document', 'timeline', 'lastAccessAt', 'viewCount', 'updatedAt'])
        && (!('clientDecision' in request.resource.data) || request.resource.data.clientDecision in ['pendente', 'aprovado', 'recusado'])
        && (!('decision' in request.resource.data) || request.resource.data.decision.status in ['pendente', 'aprovado', 'recusado'])
        && (!('document' in request.resource.data) || request.resource.data.document.diff(resource.data.document).affectedKeys().hasOnly(['status']))
        && request.resource.data.status in ['emitido', 'enviado', 'visualizado', 'aprovado', 'recusado']
        && (!('clientDecisionNote' in request.resource.data) || request.resource.data.clientDecisionNote.size() <= 1000);
    }

    match /publicQuotes/{token} {
      allow get: if resource.data.publicEnabled == true && token == resource.data.token;
      allow list: if false;
      allow create: if isNotBlocked() && request.resource.data.ownerUid == request.auth.uid && token == request.resource.data.token && validPublicQuote();
      allow update: if (isNotBlocked() && resource.data.ownerUid == request.auth.uid && request.resource.data.ownerUid == resource.data.ownerUid && validPublicQuote()) || (resource.data.publicEnabled == true && publicDecisionOnly());
      allow delete: if isNotBlocked() && resource.data.ownerUid == request.auth.uid;
    }

    match /users/{userId} {
      allow get: if signedOwner(userId) || isSuperAdmin();
      allow list: if isSuperAdmin();
      allow create: if signedOwner(userId) && request.resource.data.uid == request.auth.uid && request.resource.data.keys().hasOnly(['uid','name','email','phone','plan','role','isActive','isBlocked','blockReason','acceptedTermsAt','acceptedPrivacyAt','createdAt','updatedAt','lastLoginAt','lastSeenAt','loginCount','documentsCount','pdfGeneratedCount','freeLimitNotifiedAt','metadata']) && request.resource.data.role == 'user' && request.resource.data.plan == 'free' && request.resource.data.isBlocked == false && request.resource.data.isActive == true;
      allow update: if isSuperAdmin() || (signedOwner(userId) && onlyUserSafeFields());
      allow delete: if isSuperAdmin();

      match /documents/{documentId} {
        allow get, list: if signedOwner(userId) || isSuperAdmin();
        allow create, delete: if (signedOwner(userId) && isNotBlocked()) || isSuperAdmin();
        allow update: if (signedOwner(userId) && isNotBlocked()) || isSuperAdmin();
      }
      match /settings/{settingId} { allow read, write: if (signedOwner(userId) && isNotBlocked()) || isSuperAdmin(); }
      match /usage/{period} { allow read: if signedOwner(userId) || isSuperAdmin(); allow create, update: if (signedOwner(userId) && isNotBlocked()) || isSuperAdmin(); allow delete: if isSuperAdmin(); }
      match /billing/{docId} { allow read: if signedOwner(userId) || isSuperAdmin(); allow write: if isSuperAdmin();
        match /payments/{paymentId} { allow read: if signedOwner(userId) || isSuperAdmin(); allow write: if isSuperAdmin(); }
      }
    }

    match /systemLogs/{logId} { allow read: if isSuperAdmin(); allow create: if request.auth != null && request.resource.data.uid == request.auth.uid && request.resource.data.level in ['debug','info','success','warning','error','critical'] && validLogText(); allow update, delete: if isSuperAdmin(); }
    match /systemEvents/{eventId} { allow read: if isSuperAdmin(); allow create: if request.auth != null && request.resource.data.uid == request.auth.uid && request.resource.data.severity in ['info','success','warning','error','critical'] && request.resource.data.source in ['frontend','cloud_function','public_page','chatbot'] && validLogText(); allow update, delete: if isSuperAdmin(); }
    match /systemErrors/{errorId} { allow read: if isSuperAdmin(); allow create: if request.auth != null && request.resource.data.uid == request.auth.uid && request.resource.data.severity in ['warning','error','critical'] && validLogText(); allow update, delete: if isSuperAdmin(); }
    match /auditLogs/{logId} { allow read: if isSuperAdmin(); allow create: if request.auth != null && request.resource.data.uid == request.auth.uid && validLogText(); allow update, delete: if isSuperAdmin(); }
    match /adminSettings/{settingId} { allow read: if isSuperAdmin() || (request.auth != null && settingId in ['global','company','contact','chatbot','terms','theme','plans']); allow write: if isSuperAdmin(); }
    match /paymentWebhooks/{webhookId} { allow read: if isSuperAdmin(); allow write: if isSuperAdmin(); }
    match /telegramQueue/{messageId} {
      allow read, update, delete: if isSuperAdmin();
      allow create: if request.auth != null
        && request.resource.data.status == 'pending'
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['id','uid','type','title','message','severity','metadata','status','createdAt'])
        && request.resource.data.type is string
        && request.resource.data.type.size() <= 80
        && request.resource.data.title is string
        && request.resource.data.title.size() <= 200
        && request.resource.data.message is string
        && request.resource.data.message.size() <= 1000
        && request.resource.data.severity in ['info','success','warning','error','critical'];
    }
  }
}
