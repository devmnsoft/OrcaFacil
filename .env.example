# Copie os valores para variáveis do Windows/IIS; este arquivo nunca é carregado automaticamente em produção.
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://localhost:5080
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=orcafacil;Username=orcafacil_app;Password=CHANGE_ME
DataProtection__KeysPath=C:\ProgramData\OrcaFacil\keys
Application__PublicBaseUrl=https://orcafacil.example.com
Uploads__Path=C:\ProgramData\OrcaFacil\uploads
SystemHealth__LogsPath=C:\ProgramData\OrcaFacil\logs
SystemHealth__BackupsPath=C:\ProgramData\OrcaFacil\backups
Security__TechnicalFingerprintPepper=CHANGE_ME_LONG_RANDOM_VALUE
Security__PasswordResetPepper=CHANGE_ME_LONG_RANDOM_VALUE
Security__SecurityEventPepper=CHANGE_ME_LONG_RANDOM_VALUE
Email__Host=smtp.example.com
Email__Port=587
Email__UserName=CHANGE_ME
Email__Password=CHANGE_ME
ORCAFACIL_SUPERADMIN_EMAIL=admin@example.com
ORCAFACIL_SUPERADMIN_PASSWORD=CHANGE_ME_LONG_UNIQUE_PASSWORD
