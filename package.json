{
  "name": "orcafacil",
  "version": "1.0.0",
  "description": "OrçaFácil - Orçamentos e recibos profissionais em PDF, em segundos.",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "serve": "node server.js",
    "serve:public": "PUBLIC_DIR=public node server.js",
    "serve:root": "PUBLIC_DIR=. node server.js",
    "check": "node --check server.js",
    "check:js": "node scripts/check-js.mjs",
    "emulators:start": "firebase emulators:start --only auth,firestore,functions,hosting",
    "test:rules": "firebase emulators:exec --only firestore \"node tests/rules/run-rules-tests.mjs\"",
    "test:functions": "firebase emulators:exec --only firestore,functions \"node tests/functions/run-functions-tests.mjs\"",
    "test:security": "npm run test:rules && npm run test:functions",
    "deploy:hosting": "npm run build:prod && firebase deploy --only hosting",
    "deploy:rules": "firebase deploy --only firestore:rules",
    "deploy:functions": "firebase deploy --only functions",
    "deploy": "npm run build:prod && firebase deploy",
    "clean": "node scripts/clean.mjs",
    "build": "npm run clean && node scripts/build.mjs",
    "build:prod": "npm run clean && node scripts/build.mjs --prod",
    "security:check": "node scripts/security-check.mjs",
    "serve:dist": "node scripts/set-public-dir.mjs dist"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {},
  "devDependencies": {
    "esbuild": "latest",
    "terser": "latest",
    "javascript-obfuscator": "latest"
  }
}