{
  "name": "orcafacil",
  "version": "1.0.0",
  "description": "OrçaFácil - Orçamentos e recibos profissionais em PDF, em segundos.",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "serve": "node server.js",
    "serve:public": "PUBLIC_DIR=public node server.js",
    "serve:root": "PUBLIC_DIR=. node server.js",
    "check": "node --check server.js",
    "check:js": "node scripts/check-js.mjs",
    "check:csharp-test-types": "node scripts/check-csharp-test-type-collisions.mjs",
    "emulators:start": "firebase emulators:start --only auth,firestore,functions,hosting",
    "test:rules": "firebase emulators:exec --only firestore \"node tests/rules/run-rules-tests.mjs\"",
    "test:functions": "firebase emulators:exec --only firestore,functions \"node tests/functions/run-functions-tests.mjs\"",
    "test:security": "npm run test:rules && npm run test:functions",
    "deploy:hosting": "npm run validate && firebase deploy --only hosting",
    "deploy:rules": "firebase deploy --only firestore:rules",
    "deploy:functions": "firebase deploy --only functions",
    "deploy": "npm run validate && firebase deploy",
    "clean": "node scripts/clean.mjs",
    "build": "node scripts/build.mjs",
    "build:prod": "node scripts/build.mjs --prod",
    "security:check": "node scripts/security-check.mjs",
    "serve:dist": "node server.js --dist",
    "validate": "npm run check && npm run check:js && npm run build:prod && npm run security:check",
    "release:patch": "node scripts/release.mjs patch",
    "release:minor": "node scripts/release.mjs minor",
    "release:major": "node scripts/release.mjs major",
    "publish:iis": "node scripts/publish-iis.mjs",
    "build:iis": "node scripts/publish-iis.mjs",
    "check:public-contracts": "node scripts/check-public-contract-collisions.mjs",
    "check:public-navigation": "node scripts/check-public-navigation.mjs",
    "check:js-safety": "node scripts/check-js-safety.mjs",
    "check:aspnet-scope": "node scripts/check-aspnet-scope.mjs",
    "check:commercial-automation": "node scripts/check-commercial-automation.mjs",
    "check:build-blockers": "node scripts/check-build-blockers.mjs",
    "check:razor-static-instance": "node scripts/check-razor-static-instance.mjs",
    "check:authenticated-navigation": "node scripts/check-authenticated-navigation.mjs",
    "check:routes": "node scripts/check-routes.mjs",
    "check:razor-pages": "node scripts/check-razor-pages.mjs",
    "check:open-features": "node scripts/check-open-features.mjs",
    "check:release-readiness": "node scripts/check-release-readiness.mjs",
    "check:authenticated-ui": "node scripts/check-authenticated-ui-legacy-dependencies.mjs",
    "check:database-schema": "node scripts/check-database-schema.mjs",
    "check:design-consistency": "node scripts/check-design-consistency.mjs",
    "check:admin-security": "node scripts/check-admin-security.mjs",
    "check:permissions": "node scripts/check-permissions.mjs",
    "check:persona-flows": "node scripts/check-persona-flows.mjs",
    "check:deploy-readiness": "node scripts/check-deploy-readiness.mjs",
    "check:release-v1": "node scripts/check-release-v1.mjs",
    "check:support-readiness": "node scripts/check-support-readiness.mjs",
    "check:help-center": "node scripts/check-help-center.mjs",
    "check:commercial-flow": "node scripts/check-commercial-flow.mjs",
    "check:public-quote-security": "node scripts/check-public-quote-security.mjs",
    "check:payment-receipt-flow": "node scripts/check-payment-receipt-flow.mjs",
    "check:financial-flow": "node scripts/check-financial-flow.mjs",
    "check:contracts-flow": "node scripts/check-contracts-flow.mjs",
    "check:receipts-compliance": "node scripts/check-receipts-compliance.mjs",
    "check:commercial-actions": "node scripts/check-commercial-actions.mjs",
    "check:message-templates": "node scripts/check-message-templates.mjs",
    "check:operational-flow": "node scripts/check-operational-flow.mjs",
    "check:work-order-status": "node scripts/check-work-order-status.mjs",
    "check:schedule-flow": "node scripts/check-schedule-flow.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {},
  "devDependencies": {
    "esbuild": "latest",
    "terser": "latest",
    "javascript-obfuscator": "latest"
  }
}
